import cas
import math

// ── 符号常量：cas.pi() / cas.e() / cas.i() ──
// 全局 pi()/e() 保持浮点（数值代码不受影响），符号场景走 cas 命名空间的工厂。
// 常量是独立的 SymType::CONST 节点，不是普通变量，因此不会被同名用户符号冒充。

test_const_display() = {
    assert(str(cas.pi()) == "pi", "cas.pi() should print as pi")
    assert(str(cas.e()) == "e", "cas.e() should print as e")
    assert(str(cas.i()) == "i", "cas.i() should print as i")
}
test_const_display()

test_const_symbolic_arithmetic() = {
    // 保持符号性，不被折叠成浮点
    assert(str(2 * cas.pi()) == "2 * pi", "2*pi should stay symbolic")
    assert(str(cas.pi() + cas.pi()) == "2 * pi", "pi+pi should be 2*pi")
    assert(str(cas.e() * cas.e()) == "e^2", "e*e should be e^2")
}
test_const_symbolic_arithmetic()

test_imaginary_unit_exact() = {
    // i 的整数次幂必须精确折叠（曾落到复数浮点路径，得到 -1.0 + 1.22e-16i）
    assert(cas.i() ^ 1 == cas.i(), "i^1 = i")
    assert(cas.i() ^ 2 == -1, "i^2 = -1")
    assert(cas.i() ^ 3 == -cas.i(), "i^3 = -i")
    assert(cas.i() ^ 4 == 1, "i^4 = 1")
    assert(cas.i() ^ 0 == 1, "i^0 = 1")
}
test_imaginary_unit_exact()

test_const_numeric_value() = {
    // 常量仍能数值化
    assert(cas.evalv(cas.pi()) > 3.14159 && cas.evalv(cas.pi()) < 3.1416, "evalv(pi) approx")
    assert(cas.evalv(cas.e()) > 2.71828 && cas.evalv(cas.e()) < 2.71829, "evalv(e) approx")
    assert(cas.evalv(cas.i() ^ 2) == -1, "evalv(i^2) = -1")
}
test_const_numeric_value()

test_global_pi_e_stay_float() = {
    // 全局工厂函数保持浮点语义
    assert(pi() > 3.14159 && pi() < 3.1416, "pi() stays float")
    assert(e() > 2.71828 && e() < 2.71829, "e() stays float")
    assert(abs(pi() * 2 - 6.283185307179586) < 1e-12, "pi()*2 numeric")
}
test_global_pi_e_stay_float()

test_const_in_calculus() = {
    // 常量参与求导/展开/求解时保持符号
    x = sym("x")
    assert(str(cas.diff(sin(cas.pi() * x), x)) == "cos(pi * x) * pi", "diff with pi")
    // 根按 (实部, 虚部) 升序排列（solveEq 出口的规范化），所以 -√pi 在前
    assert(str(cas.solve(x ^ 2 - cas.pi(), x)) == "@[-sqrt(pi), sqrt(pi)]", "exact solve with pi")
    assert(str(cas.subs(cas.pi() * x, x, 2)) == "2 * pi", "subs with pi")
}
test_const_in_calculus()

test_const_names_are_unified() = {
    // ★ 常量身份唯一：sym("pi") / sym("PI") / sym("E") / sym("i") 与
    //   cas.pi() / cas.e() / cas.i() 产出同一个 SymConst 节点，
    //   不存在"用户符号冒充常量"的那条劫持路径（曾是 <var:PI> 转义）。
    assert(sym("pi") == cas.pi(), "sym(\"pi\") is the pi constant")
    assert(sym("PI") == cas.pi(), "sym(\"PI\") is the pi constant")
    assert(sym("Pi") == cas.pi(), "const name lookup ignores case")
    assert(sym("e") == cas.e(), "sym(\"e\") is the e constant")
    assert(sym("E") == cas.e(), "sym(\"E\") is the e constant")
    assert(sym("i") == cas.i(), "sym(\"i\") is the imaginary constant")
    assert(sym("I") == cas.i(), "sym(\"I\") is the imaginary constant")
    // 三个常量彼此不得混同
    assert(sym("PI") != sym("e"), "pi and e stay distinct")
    assert(sym("i") != cas.pi(), "i and pi stay distinct")
}
test_const_names_are_unified()

test_const_names_fold_like_constants() = {
    // 既然是常量节点，就该有常量的代数行为（旧设计里 sym("i")^2 停在 i^2）
    assert(str(cas.simplify(sym("i") ^ 2)) == "-1", "sym(\"i\")^2 folds to -1")
    assert(str(cas.simplify(sym("PI") * 2)) == "2 * pi", "sym(\"PI\")*2 stays symbolic 2*pi")
    assert(str(cas.simplify(sym("E"))) == "e", "sym(\"E\") prints as e")
    assert(str(cas.simplify(log(sym("E")))) == "1", "log of the e constant is 1")
    assert(cas.evalv(sym("PI")) > 3.14159 && cas.evalv(sym("PI")) < 3.1416, "evalv(sym(PI)) approx")
    assert(cas.evalv(sym("E")) > 2.71828 && cas.evalv(sym("E")) < 2.71829, "evalv(sym(E)) approx")
}
test_const_names_fold_like_constants()

test_similar_names_stay_free_variables() = {
    // 只有 pi/e/i 本身是常量：名字相似或更长的仍是普通自由变量
    x = sym("x")
    assert(str(sym("pi2")) == "pi2", "pi2 is a free variable")
    assert(str(sym("PIX")) == "PIX", "PIX is a free variable")
    assert(str(sym("ee")) == "ee", "ee is a free variable")
    assert(str(sym("ii")) == "ii", "ii is a free variable")
    assert(str(cas.diff(sym("pi2") * x, x)) == "pi2", "free variable behaves as constant in x")
    assert(str(cas.simplify(sym("ee") ^ 2)) == "ee^2", "free variable is not folded")
}
test_similar_names_stay_free_variables()

test_const_in_rules_table() = {
    // ★ 回归：SymRules.h 的规则表用 makeVar("PI") 表达 √π。
    //   转义方案实施后 PI 变成普通变量，integ(exp(-x^2), x) 曾吐出
    //   1/2 * erf(x) * sqrt(PI) —— 形式对、π 却是自由变量，导致
    //   d/dx(结果) != exp(-x^2)。现在必须落在常量 pi 上。
    x = sym("x")
    I = cas.integ(exp(-(x ^ 2)), x)
    assert(str(I) == "1/2 * erf(x) * sqrt(pi)",
           f"gaussian integral should use the pi constant, got {str(I)}")
    assert(cas.evalv(cas.subs(I, x, 1.0)) > 0.74 && cas.evalv(cas.subs(I, x, 1.0)) < 0.75,
           "erf-based gaussian integral evaluates numerically")
}
test_const_in_rules_table()

test_factor_with_constants() = {
    // 常量系数不应破坏因式分解：既不能崩（曾有 bad variant access），
    // 也不能把原式缩放成首一形式（x^2 - pi 曾变成 x^2 * pi^(-1) - 1）。
    x = sym("x")
    assert(str(cas.factor(x ^ 2 - cas.pi())) == "x^2 - pi", "factor keeps constant polys intact")
    assert(str(cas.factor(cas.pi() * x ^ 2 - cas.pi())) == "pi * (x + 1) * (x - 1)", "factor extracts const content")
    assert(str(cas.factor(x ^ 2 - 1)) == "(x + 1) * (x - 1)", "integer factoring still works")
}
test_factor_with_constants()
