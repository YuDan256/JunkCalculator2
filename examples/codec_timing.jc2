// 100KB gunzip 计时驱动脚本（**不是测试套件**：tests/ 下的文件必须静默且会被
// 全部收集，所以计时输出放在 examples/ 下；解压逻辑与
// tests/modules/test_inflate.jc2 的 test_large_gunzip_roundtrip 相同）。
//
// 用法（在仓库根目录或 out\build\x64-release 下都行）：
//   out\build\x64-release\jc2.exe examples\codec_timing.jc2

import inflate
import io
import json
import sys

all = json.parse(io.readFile("data/codec_vectors/vectors.json"))
payload = ""
want = ""
for (v in all["vectors"]) {
    if (v["name"] == "mixed_100k_gzip_l6") {
        payload = v["payload"]
        want = v["data_sha256"]
    }
}
assert(payload != "", "the 100KB gzip vector must exist")

rounds = 20
t0 = sys.clock()
decoded = inflate.gunzip(payload)
first = sys.clock() - t0
assert(decoded.len() == 204800, "100KB -> 204800 hex chars")
assert(want.len() == 64, "sha256 of the original must be in the vector file")

t1 = sys.clock()
for (i in range(rounds)) {
    decoded = inflate.gunzip(payload)
}
total = sys.clock() - t1
mean = total / rounds

print("=== 100KB gunzip timing (mixed_100k_gzip_l6) ===")
print("compressed stream : " + str(idiv(payload.len(), 2)) + " bytes")
print("decompressed      : 102400 bytes")
print("first run         : " + str(first * 1000.0) + " ms")
print(str(rounds) + " runs            : " + str(total * 1000.0) + " ms total")
print("mean              : " + str(mean * 1000.0) + " ms/op")
print("throughput        : " + str(0.1 / mean) + " MB/s")
