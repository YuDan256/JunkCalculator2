// ── syntax/test_lexer.jc2 ─────────────────────────────────────────────
{


import math
test_token_class() = {
    t = Token("IDENTIFIER", "foo", 10, 5)
    assert(t.type == "IDENTIFIER", "Token type mismatch")
    assert(t.lexeme == "foo", "Token lexeme mismatch")
    assert(t.line == 10, "Token line mismatch")
    assert(t.position == 5, "Token position mismatch")
    
    t.lexeme = "bar"
    assert(t.lexeme == "bar", "Token mutability failed")
}
test_token_class()

test_basic_syntax_macro() = {
    syntax concat_tokens(stream) = {
        // 提取所有 token 的 lexeme 并拼接
        str_val = stream.tokens().map((t) => t.lexeme).join("")
        return ASTNode("Literal", 0, %{value: str_val, isString: true})
    }
    
    res = @concat_tokens { a b c 1 2 3 }
    assert(res == "abc123", "Basic syntax macro failed to collect and process tokens")
}
test_basic_syntax_macro()

test_parse_single() = {
    syntax change_plus_to_mul(stream) = {
        // 遍历 Token，把加号篡改为乘号
        for (t in stream.tokens()) {
            if (t.lexeme == "+") {
                t.type = "STAR"
                t.lexeme = "*"
            }
        }
        // 重新解析为 AST
        return stream.parse()
    }
    
    res = @change_plus_to_mul { 3 + 4 }
    assert(res == 12, "parse or token manipulation failed")
}
test_parse_single()

test_parse_block() = {
    syntax inject_local(stream) = {
        // 在用户提供的 token 列表前强行插入一个 local 关键字
        stream.insert(0, Token("LOCAL", "local", 0, 0))
        stream.cursor = 0 // 重置游标，确保新插入的 token 被解析
        // 解析为 AST
        return stream.parse()
    }
    injected_var = 0
    // 这里的 injected_var 会被宏加上 local 修饰符
    {
        @inject_local { injected_var = 99 }
        assert(injected_var == 99, "parse failed to set local variable")
    }
    assert(injected_var == 0, "parse failed to generate valid statement (leaked to outer scope)")
}
test_parse_block()

test_parse_multi() = {
    syntax inject_two(stream) = {
        return stream.parse()
    }
    
    a = 0
    b = 0
    {
        @inject_two { local a = 1; local b = 2 }
        assert(a == 1 && b == 2, "parse multi failed to set locals")
    }
    assert(a == 0 && b == 0, "parse multi leaked to outer scope")
}
test_parse_multi()

test_lexer_error_tolerance() = {
    syntax count_errors(stream) = {
        // 统计 ERROR 类型的 token 数量
        err_count = stream.tokens().countIf((t) => t.type == "ERROR")
        return ASTNode("Literal", 0, %{value: str(err_count), isString: false})
    }
    
    // 反引号 ` 在 JC2 中是非法字符，正常情况下 Lexer 会直接抛出异常。
    // 但在 Token 宏的 {} 内部，它应该被宽容地收集为 ERROR token。
    res = @count_errors { ` }
    assert(res == 1, "Lexer error tolerance failed: did not generate ERROR token")
}
test_lexer_error_tolerance()

test_syntax_macro_errors() = {
    try {
        eval("syntax bad_return(s) = { return 1 }; @bad_return { 1 }")
        assert(false, "Should throw when syntax macro doesn't return ASTNode")
    } catch (e) {
        msg = str(e.message)
        assert("ASTNode" in msg, "Wrong error for invalid syntax macro return: " + msg)
    }

    try {
        eval("syntax bad_parse(s) = { return s.parse() }; @bad_parse { * 2 }")
        assert(false, "Should throw when parse receives invalid syntax")
    } catch (e) {
        msg = str(e.message)
        assert("Expect expression" in msg || "Parser Error" in msg || "Syntax Error" in msg || "Lexer Error" in msg || "Token Macro Execution Error" in msg, "Wrong error for invalid parse input: " + msg)
    }
    
    try {
        eval("syntax multi_arg(a, b) = { return quote { none } }")
        assert(false, "Should throw when syntax macro has more than one parameter")
    } catch (e) {
        msg = str(e.message)
        assert("exactly one parameter" in msg, "Wrong error for multi-parameter syntax macro: " + msg)
    }
}
test_syntax_macro_errors()

test_fstring() = {
    x = 10
    s = f"Value: {x * 2}"
    assert(s == "Value: 20", "f-string basic failed")
    
    pi_str = f"PI: {math.pi()::.2f}"
    assert(pi_str == "PI: 3.14", "f-string formatting failed")
}
test_fstring()

test_rstring() = {
    s = r"C:\new\folder"
    assert(len(s) == 13, "r-string length failed (should not escape)")
    
    s2 = r"TAG(nested \n \t)TAG"
    assert(len(s2) == 12, "r-string custom delimiter failed")
}
test_rstring()

test_string_methods() = {
    s = "hello"
    assert(s.upper() == "HELLO", "upper() failed")
    assert(s.replace("l", "w") == "hewwo", "replace() failed")
    assert(s[::-1] == "olleh", "string reverse slice failed")
    assert(s[1:4] == "ell", "string slicing failed")
}
test_string_methods()

test_string_split_join() = {
    parts = "a,b,c".split(",")
    assert(parts == @["a", "b", "c"], "split() failed")
    
    joined = parts.join("-")
    assert(joined == "a-b-c", "join() failed")
}
test_string_split_join()
}

// ── syntax/test_errors.jc2 ─────────────────────────────────────────────
{
// try/catch 基础与类型化 catch（原 core/test_error + syntax/test_catch_chain）

class MyError extends Exception {}
class OtherError extends Exception {}

test_catch_chain_type_match() = {
    r = try {
        throw MyError("x")
    } catch {
        e: OtherError => "other",
        e: MyError => "mine"
    }
    assert(r == "mine", "catch chain type match")
}
test_catch_chain_type_match()

test_catch_type_mismatch_rethrow() = {
    threw = false
    try {
        try {
            throw MyError("x")
        } catch {
            e: OtherError => "other"
        }
    } catch (e) {
        threw = true
    }
    assert(threw, "type mismatch rethrows")
}
test_catch_type_mismatch_rethrow()

test_catch_or_pattern() = {
    r = try {
        throw OtherError("x")
    } catch {
        e: MyError, e: OtherError => "mine or other"
    }
    assert(r == "mine or other", "or pattern")
}
test_catch_or_pattern()

test_catch_guard() = {
    r = try {
        throw MyError("big error")
    } catch {
        e: MyError if (e.message == "big error") => "big",
        e: MyError => "small"
    }
    assert(r == "big", "guard")
}
test_catch_guard()

test_catch_shorthand_keeps_type() = {
    r = try {
        throw MyError("x")
    } catch (e) {
        type(e) == MyError
    }
    assert(r, "shorthand keeps exception type")
}
test_catch_shorthand_keeps_type()

// ── try/catch 表达式与 assert ──

test_try_catch() = {
    res = try {
        throw "custom error"
        0
    } catch (e) {
        1
    }
    assert(res == 1, "try/catch expression failed")
    
    res2 = try {
        42
    } catch (e) {
        -1
    }
    assert(res2 == 42, "try/catch success path failed")
}
test_try_catch()

test_assert() = {
    caught = false
    try {
        assert(1 == 2, "Math is broken")
    } catch (e) {
        caught = true
        assert("Math is broken" in e.message, "assert message mismatch")
    }
    assert(caught, "assert failed to throw")
}
test_assert()


test_error_model() = {
    try {
        1 + "x"
    } catch (e) {
        assert(e.type == "TypeError", "builtin error type field")
        assert(type(e) == TypeError, "builtin error class")
        assert("Cannot add" in e.message, "builtin error message")
        assert(type(e.traceback) == string, "traceback is a string")
    }

    r = try {
        throw Exception("HttpError", %{code: 500, detail: "down"})
    } catch (e) {
        assert(e.type == "HttpError", "structured error type")
        assert(e.message.code == 500 && e.message.detail == "down", "structured message")
        e
    }
    assert(r.type == "HttpError", "catch returns value")

    r2 = try {
        throw %{code: 404, msg: "Not Found"}
    } catch (e) {
        assert(e.type == "Exception", "raw value wrapped as Exception")
        assert(e.message.code == 404, "raw dict becomes message")
        e.message.msg
    }
    assert(r2 == "Not Found", "raw dict catch value")

    assert((try { throw "x" }) == none, "bare try swallows and returns none")

    caught = false
    try {
        assert("eq", 1, 2)
    } catch (e) {
        caught = true
        assert(e.type == "RuntimeError", "three-arg assert type")
        assert("[eq]" in e.message, "three-arg assert label")
        assert("Expected" in e.message && "Got" in e.message, "three-arg assert detail")
    }
    assert(caught, "three-arg assert throws")
}
test_error_model()


test_error_hierarchy() = {
    assert(TypeError <: Exception, "builtin error class extends Exception")
    caught = false
    try { 1 + "x" } catch { e: Exception => caught = true }
    assert(caught, "base Exception catches builtin errors")
    caught = false
    try { throw TypeError("tm") } catch (e) { caught = type(e) == TypeError && e.type == "TypeError" && e.message == "tm" }
    assert(caught, "throwing an error class keeps type and message")
}
test_error_hierarchy()
}
