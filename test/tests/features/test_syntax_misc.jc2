// ── features/test_ast_literal.jc2 ─────────────────────────────────────────────
{
import ast

assert(ast.toValue(ast.toNode(42)) == 42, "int literal")
assert(ast.toValue(ast.toNode(-7)) == -7, "negative int literal")
assert(ast.toValue(ast.toNode(3.5)) == 3.5, "float literal")
assert(ast.toValue(ast.toNode("hello")) == "hello", "string literal")
assert(ast.toValue(ast.toNode(true)) == true, "bool literal")
assert(ast.toValue(ast.toNode(none)) is none, "none literal")

v = ast.toNode(1, 12, 34)
assert(v.line == 12 && v.position == 34, "location")

g = ast.gensym("tmp", 7, 9)
assert(g.type == "Variable", "gensym type")
assert(g.line == 7 && g.position == 9, "gensym location")
assert("tmp#" in g.name, "gensym name")

syntax answer(stream) = {
    import ast
    return ast.toNode(42)
}
assert(@answer {} == 42, "macro returns constant node")

try {
    ast.toNode(1 + 2i)
    assert(false, "complex must be rejected")
} catch (e) {
    assert("unsupported value type" in e.message, "complex error")
}
}

// ── features/test_directive_version.jc2 ─────────────────────────────────────────────
{
#version >= 2.6.5.0
#version 2.6.5.0
#version == 2.6.5.0

assert(true, "version directives accepted")
#warning "expected test warning"
}

// ── features/test_enum_folding.jc2 ─────────────────────────────────────────────
{
import sys

// 全局常量枚举
const enum Color { RED = 3, GREEN, BLUE }

// 函数内常量枚举
pick(x) = {
    const enum Local { OK = 10, ERR }
    return Color.BLUE + Local.OK + x
}

assert(Color.RED == 3, "global enum value")
assert(Color.BLUE == 5, "global enum auto increment")
assert(pick(0) == 15, "local + global enum values")
assert(pick(2) == 17, "enum member in expression")
}

// ── features/test_set.jc2 ─────────────────────────────────────────────
{
test_set_basic() = {
    s = @{1, 2, 2, 3}
    assert(len(s) == 3, "Set deduplication failed")
    assert(2 in s, "Set membership failed")
    assert(!(99 in s), "Set negative membership failed")
}
test_set_basic()

test_set_symbolic_bool_dedup() = {
    assert(true == sym(1), "true equals symbolic 1")
    assert(sym(1) == true, "symbolic 1 equals true")
    s = @{true, sym(1)}
    assert(len(s) == 1, "true and symbolic 1 deduplicate")
}
test_set_symbolic_bool_dedup()

test_set_ops() = {
    a = @{1, 2}
    b = @{2, 3}
    
    assert(a | b == @{1, 2, 3}, "Set union failed")
    assert(a & b == @{2}, "Set intersection failed")
    assert(a - b == @{1}, "Set difference failed")
    assert(a ^^ b == @{1, 3}, "Set symmetric difference failed")
}
test_set_ops()

test_set_predicates() = {
    a = @{1, 2}
    b = @{1, 2, 3}
    
    assert(a.issubset(b), "issubset failed")
    assert(b.issuperset(a), "issuperset failed")
    assert(a.isdisjoint(@{99}), "isdisjoint failed")
}
test_set_predicates()

test_set_mutation() = {
    s = @{1}
    s.add(2)
    assert(2 in s, "Set add failed")
    
    s.remove(1)
    assert(!(1 in s), "Set remove failed")
}
test_set_mutation()
throws(f) = {
    try { f(); return false } catch (e) { return true }
}


// ★ Set 上的聚合与谓词方法：此前实现体只写了 LIST 分支（`any`/`all` 还多一层
//   iterateAndCheck 的 else 抛错），导致这 7 个方法在 Set 上全部失效。
test_set_aggregates_and_predicates() = {
    s = @{1, 2, 3, 4}
    l = @[1, 2, 3, 4]

    assert(s.sum() == l.sum(), "Set sum must match List sum")
    assert(s.prod() == l.prod(), "Set prod must match List prod")
    assert(s.max() == l.max(), "Set max must match List max")
    assert(s.min() == l.min(), "Set min must match List min")
    assert(s.span() == l.span(), "Set span must match List span")

    assert(s.any((x) => x > 3), "Set any must see a matching element")
    assert(!s.any((x) => x > 9), "Set any must be false when none match")
    assert(!s.all((x) => x > 3), "Set all must be false when some fail")
    assert(s.all((x) => x > 0), "Set all must be true when all match")

    e = set()
    assert(e.sum() == 0, "empty Set sum is 0")
    assert(e.prod() == 1, "empty Set prod is 1")
    assert(throws(() => e.max()), "empty Set max must throw")
    assert(throws(() => e.min()), "empty Set min must throw")
    assert(throws(() => e.span()), "empty Set span must throw")

    // apply 是“把元素当位置实参展开调用”，不是 map；Set 与 List 同样支持
    assert(@[1, 2, 3].apply((a, b, c) => a + b + c) == 6, "apply spreads elements positionally")
    assert(@{1, 2, 3}.apply((a, b, c) => a + b + c) == 6, "apply works on Set too")
}
test_set_aggregates_and_predicates()
}

// ── features/test_print_truncate.jc2 ─────────────────────────────────────────────
{
// Display must stringify only the items that will actually be shown.
m = zeros(100, 100)
sm = str(m)
assert(sm.len() < 2000, "large matrix is truncated before formatting")
assert(sm.find("...") >= 0, "large matrix marks truncation")

l = @[i for (i in range(1000))]
sl = str(l)
assert(sl.len() < 500, "large list is truncated")
assert(sl.find("...") >= 0, "large list marks truncation")

nested = @[@[i for (i in range(100))]]
sn = str(nested)
assert(sn.len() < 500, "nested list is truncated")
assert(sn.find("...") >= 0, "nested list marks truncation")
}
