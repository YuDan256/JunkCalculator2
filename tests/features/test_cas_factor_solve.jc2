import cas
import math

// ── factor / solve 增强回归 ──
// 覆盖：有理根分母吸收、二项式分圆分解、等价判定规范化。

test_rational_roots_no_denominators() = {
    // 有理根路径曾产出 6 * (x + 1/2) * (x + 1/3)：数值对但不是惯用形式。
    // 现应把分母吸收进因子，得到整系数因式。
    x = sym("x")
    assert(str(cas.factor(6 * x ^ 2 + 5 * x + 1)) == "(2 * x + 1) * (3 * x + 1)", "absorb denominators")
    assert(str(cas.factor(2 * x ^ 2 + 7 * x + 3)) == "(2 * x + 1) * (x + 3)", "absorb one denominator")
    assert(str(cas.factor(12 * x ^ 2 + 7 * x + 1)) == "(3 * x + 1) * (4 * x + 1)", "absorb two denominators")
    // 无分母时不应改变既有输出
    assert(str(cas.factor(x ^ 2 + 5 * x + 6)) == "(x + 2) * (x + 3)", "no denominators untouched")
}
test_rational_roots_no_denominators()

test_cyclotomic_factorization() = {
    // x^n - 1 = ∏_{d|n} Φ_d(x)
    x = sym("x")
    assert(str(cas.factor(x ^ 4 - 1)) == "(x + 1) * (x - 1) * (x^2 + 1)", "x^4-1")
    assert(str(cas.factor(x ^ 3 - 1)) == "(x - 1) * (x^2 + x + 1)", "x^3-1")
    assert(str(cas.factor(x ^ 6 - 1)) == "(x + 1) * (x - 1) * (x^2 + x + 1) * (x^2 - x + 1)", "x^6-1")
    assert(str(cas.factor(x ^ 8 - 1)) == "(x + 1) * (x - 1) * (x^2 + 1) * (x^4 + 1)", "x^8-1")
}
test_cyclotomic_factorization()

test_solve_all_roots_present() = {
    // 分圆分解后 solve 走因式分解，根数必须等于次数
    x = sym("x")
    assert(len(cas.solve(x ^ 3 - 1, x)) == 3, "x^3-1 has 3 roots")
    assert(len(cas.solve(x ^ 4 - 1, x)) == 4, "x^4-1 has 4 roots")
    assert(len(cas.solve(x ^ 5 - 1, x)) == 5, "x^5-1 has 5 roots")
    // x^6-1 曾因等价判定假阳性把共轭根当成同一个，只剩 4 个根
    assert(len(cas.solve(x ^ 6 - 1, x)) == 6, "x^6-1 has 6 roots")
    assert(len(cas.solve(x ^ 7 - 1, x)) == 7, "x^7-1 has 7 roots")
    assert(len(cas.solve(x ^ 8 - 1, x)) == 8, "x^8-1 has 8 roots")
}
test_solve_all_roots_present()

test_structural_equality() = {
    // 相等判定曾只比指针，代数等价一律判不等
    x = sym("x")
    y = sym("y")
    assert(x + x == 2 * x, "x+x == 2x")
    assert(2 * (x + y) == 2 * x + 2 * y, "distribute")
    assert(x * (y + 1) == x * y + x, "factor out")
    assert((x + 1) * (x - 1) == x ^ 2 - 1, "(x+1)(x-1) == x^2-1")
    assert(cas.factor(x ^ 2 - 1) == x ^ 2 - 1, "factor result equals input")
    assert((x - y) ^ 2 == (y - x) ^ 2, "square sign")
    assert((y - x) * (x + y) == (x - y) * (x + y) * -1, "sign normalization")
    assert(sqrt(4) == 2, "sqrt(4) == 2")
    assert(cas.i() ^ 2 == -1, "i^2 == -1")
}
test_structural_equality()

test_structural_inequality() = {
    // 规范化不得制造假阳性（假阳性比假阴性危险：会让 solve 吃掉不同的根）
    x = sym("x")
    y = sym("y")
    assert(!(x + 1 == x + 2), "x+1 != x+2")
    assert(!(x ^ 2 - 1 == x ^ 2 + 1), "different polys")
    assert(!((x + 1) * (x - 1) == x ^ 2 + 1), "(x+1)(x-1) != x^2+1")
    assert(!(sin(x) == cos(x)), "sin != cos")
    assert(!(x == y), "x != y")
    assert(!(cas.pi() == cas.e()), "pi != e")
    assert(!(cas.i() == 1), "i != 1")
    assert(!(sqrt(2) == sqrt(3)), "sqrt2 != sqrt3")
}
test_structural_inequality()

test_cube_identities() = {
    // A^3 ± B^3 = (A ± B)(A^2 ∓ A*B + B^2)
    // 注意：这里直接断言因式形式，而不是用 expand(...) == expand(...) 比对——
    // cas.expand 不合并同类项（expand((x+1)(x^2-x+1)) 会留下 x^2 - x^2），
    // 所以那种写法会因"相等判定拿不到规范形"而误报失败。
    x = sym("x")
    y = sym("y")
    assert(str(cas.factor(x ^ 3 + y ^ 3)) == "(-x * y + x^2 + y^2) * (x + y)", "x^3+y^3")
    assert(str(cas.factor(x ^ 3 + 1)) == "(x + 1) * (x^2 - x + 1)", "x^3+1")
    assert(str(cas.factor(x ^ 3 - y ^ 3)) != "x^3 - y^3", "x^3-y^3 factored")
    // 不匹配的形状不应被改写
    assert(str(cas.factor(x ^ 2 + y ^ 2)) == "x^2 + y^2", "x^2+y^2 untouched")
    assert(str(cas.factor(x ^ 3 + y ^ 2)) == "x^3 + y^2", "x^3+y^2 untouched")
}
test_cube_identities()

test_high_degree_roots_stay_rootof() = {
    // 4 次及以上保留 RootOf：Ferrari 展开会给出几十行嵌套根式，无可用性收益。
    // 1~3 次仍给紧凑根式。
    x = sym("x")
    assert(str(cas.solve(x ^ 5 - 1, x)) != "", "x^5-1 solvable")
    r = cas.solve(x ^ 4 + x + 1, x)
    assert(len(r) == 4, "quartic has 4 roots")
    assert(str(r) != "", "quartic roots printable")
    // RootOf 必须可数值化
    assert(cas.evalf(cas.subs(x ^ 5 - 1, x, cas.solve(x ^ 5 - 1, x)[0])) == 0, "RootOf numeric")
}
test_high_degree_roots_stay_rootof()

test_like_terms_merge_across_number_forms() = {
    // 同一个数曾有 int32(2) / BigInt(2) / 2.0 多种存储形态，导致内部化池把
    // 同一个 x^2 存成两个节点，operator+ 的同类项合并（按指针）失效：
    // 展开式化简不出正确结果，cas.simplify 曾直接崩溃。
    // 现已在 valueToCasVal 处把整数统一为 BigInt，这里锁住行为。
    x = sym("x")
    assert(str(cas.simplify(cas.expand((x + 1) * (x ^ 2 - x + 1)))) == "x^3 + 1", "expand+simplify combines like terms")
    assert(str(cas.simplify(cas.expand((x + 1) * (x - 1)))) == "x^2 - 1", "difference of squares simplifies")
    assert(cas.expand(cas.factor(x ^ 3 + 1)) == cas.expand(x ^ 3 + 1), "factor round-trip")
}
test_like_terms_merge_across_number_forms()

test_trigsimp_only_touches_trig() = {
    // trigsimp 曾在纯多项式上崩溃（cas.simplify(x^2 + 2*x)）。
    // 它现在先检查表达式是否含三角函数，不含则直接返回。
    x = sym("x")
    assert(str(cas.simplify(x ^ 2 + 2 * x)) == "x * (x + 2)", "x^2+2x")
    assert(str(cas.simplify(x ^ 2 + 2 * x + 1)) == "(x + 1)^2", "x^2+2x+1")
    assert(str(cas.simplify(x ^ 2 + x)) == "x * (x + 1)", "x^2+x")
    // 含三角时 trigsimp 仍必须正常工作
    assert(str(cas.simplify(sin(x) ^ 2 + cos(x) ^ 2)) == "1", "sin^2+cos^2")
    assert(str(cas.trigsimp(sin(x) ^ 2 + cos(x) ^ 2)) == "1", "trigsimp identity")
    assert(str(cas.simplify(tan(x) - sin(x) / cos(x))) == "0", "tan - sin/cos")
    assert(str(cas.expand(sin(2 * x))) == "2 * cos(x) * sin(x)", "sin double angle")
    // 直接调用 trigsimp（此前这条路在纯多项式上会访问越界崩溃）
    assert(str(cas.trigsimp(x ^ 2 + 2 * x)) == "x^2 + 2 * x", "trigsimp on polynomial")
    assert(str(cas.trigsimp(x ^ 2 + 2 * x + 1)) == "x^2 + 2 * x + 1", "trigsimp on polynomial 2")
}
test_trigsimp_only_touches_trig()
