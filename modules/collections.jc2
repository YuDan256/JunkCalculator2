// ═══════════════════════════════════════════════════════════════
// collections.jc2 — Advanced Data Structures Standard Library
// Pure JC2 Implementation (Stacks, Queues, Heaps, Trees)
// ═══════════════════════════════════════════════════════════════


// ─── Stack (LIFO) ─────────────────────────────────────────────

// ─── 迭代器（__iter__ 返回它；__next__ 耗尽时抛 StopIteration）──────────
class _SeqIter {
    init(items: list) = {
        self.items = items
        self.i = 0
    }
    __next__() = {
        if (self.i >= self.items.len()) throw StopIteration()
        self.i += 1
        return self.items[self.i - 1]
    }
}

class Stack {
    init() = {
        self.data = @[]
    }
    
    push(item: any) = {
        self.data.push(item)
        return self
    }
    
    pop() = {
        if (self.isEmpty()) throw IndexError("pop from empty Stack")
        return self.data.pop()
    }
    
    peek() = {
        if (self.isEmpty()) throw IndexError("peek from empty Stack")
        return self.data[-1]
    }
    
    isEmpty() -> bool = return self.data.len() == 0
    size() -> int     = return self.data.len()
    clear() = {
        self.data = @[]
        return self
    }
    // 迭代：自顶向下（快照，不消耗栈；可重复遍历）
    __iter__() = {
        snap = @[]
        i = self.data.len() - 1
        while (i >= 0) { snap.push(self.data[i]); i -= 1 }
        return _SeqIter(snap)
    }

    // 快照列表（顺序与 __iter__ 相同）
    toList() -> list = {
        snap = @[]
        for (v in self) { snap.push(v) }
        return snap
    }

    __len__() -> int = return self.size()

    __contains__(x: any) -> bool = {
        for (v in self) { if (v == x) return true }
        return false
    }

    __eq__(other: any) -> bool = {
        if (!isinstance(other, Stack)) return false
        a = self.toList()
        b = other.toList()
        if (a.len() != b.len()) return false
        i = 0
        while (i < a.len()) {
            if (!(a[i] == b[i])) return false
            i += 1
        }
        return true
    }

    __str__() -> string = return "Stack(size=" + str(self.size()) + ")"

}


// ─── Queue (FIFO) ─────────────────────────────────────────────

class Queue {
    // 双栈队列：enqueue 摊还 O(1)，dequeue 摊还 O(1)（旧实现用 list.shift()，为 O(n)）
    init() = {
        self.front = @[]
        self.back = @[]
        self._size = 0
    }

    local _transfer() = {
        while (self.back.len() > 0) { self.front.push(self.back.pop()) }
    }

    enqueue(item: any) -> Queue = {
        self.back.push(item)
        self._size += 1
        return self
    }

    dequeue() -> any = {
        if (self._size == 0) throw IndexError("dequeue from empty Queue")
        if (self.front.len() == 0) { self._transfer() }
        self._size -= 1
        return self.front.pop()
    }

    peek() -> any = {
        if (self._size == 0) throw IndexError("peek from empty Queue")
        if (self.front.len() == 0) { self._transfer() }
        return self.front[self.front.len() - 1]
    }

    isEmpty() -> bool = return self._size == 0
    size() -> int     = return self._size

    clear() = {
        self.front = @[]
        self.back = @[]
        self._size = 0
    }

    __len__() -> int = return self._size
    __str__() -> string = return "Queue(size=" + str(self._size) + ")"
    // 迭代：自队首至队尾（快照，不出队；可重复遍历）
    __iter__() = {
        snap = @[]
        i = self.front.len() - 1
        while (i >= 0) { snap.push(self.front[i]); i -= 1 }
        i = 0
        while (i < self.back.len()) { snap.push(self.back[i]); i += 1 }
        return _SeqIter(snap)
    }

    // 快照列表（顺序与 __iter__ 相同）
    toList() -> list = {
        snap = @[]
        for (v in self) { snap.push(v) }
        return snap
    }

    __contains__(x: any) -> bool = {
        for (v in self) { if (v == x) return true }
        return false
    }

    __eq__(other: any) -> bool = {
        if (!isinstance(other, Queue)) return false
        a = self.toList()
        b = other.toList()
        if (a.len() != b.len()) return false
        i = 0
        while (i < a.len()) {
            if (!(a[i] == b[i])) return false
            i += 1
        }
        return true
    }

}


class Deque {
    // 双端队列：两端 push/pop 均摊还 O(1)（旧实现 pushLeft/popLeft 走 prepend/shift，为 O(n)）
    // front 逆序存放左半（栈顶=最左元素），back 正序存放右半（栈顶=最右元素）。
    init() = {
        self.front = @[]
        self.back = @[]
        self._size = 0
    }

    local _rebalanceLeft() = {
        // 把 back 的一半搬到 front（取半而非全部，保证交替两端的操作也是摊还 O(1)）
        n = self.back.len()
        half = n - n / 2
        i = 0
        while (i < half) { self.front.push(self.back.pop()); i += 1 }
    }

    local _rebalanceRight() = {
        n = self.front.len()
        half = n - n / 2
        i = 0
        while (i < half) { self.back.push(self.front.pop()); i += 1 }
    }

    pushRight(item: any) -> Deque = {
        self.back.push(item)
        self._size += 1
        return self
    }

    pushLeft(item: any) -> Deque = {
        self.front.push(item)
        self._size += 1
        return self
    }

    popRight() -> any = {
        if (self._size == 0) throw IndexError("popRight from empty Deque")
        if (self.back.len() == 0) { self._rebalanceRight() }
        self._size -= 1
        return self.back.pop()
    }

    popLeft() -> any = {
        if (self._size == 0) throw IndexError("popLeft from empty Deque")
        if (self.front.len() == 0) { self._rebalanceLeft() }
        self._size -= 1
        return self.front.pop()
    }

    peekLeft() -> any = {
        if (self._size == 0) throw IndexError("peekLeft from empty Deque")
        if (self.front.len() == 0) { self._rebalanceLeft() }
        return self.front[self.front.len() - 1]
    }

    peekRight() -> any = {
        if (self._size == 0) throw IndexError("peekRight from empty Deque")
        if (self.back.len() == 0) { self._rebalanceRight() }
        return self.back[self.back.len() - 1]
    }

    isEmpty() -> bool = return self._size == 0
    size() -> int     = return self._size

    clear() = {
        self.front = @[]
        self.back = @[]
        self._size = 0
    }

    __len__() -> int = return self._size
    __str__() -> string = return "Deque(size=" + str(self._size) + ")"
    // 迭代：自左至右（快照，不弹出；可重复遍历）
    __iter__() = {
        snap = @[]
        i = self.front.len() - 1
        while (i >= 0) { snap.push(self.front[i]); i -= 1 }
        i = 0
        while (i < self.back.len()) { snap.push(self.back[i]); i += 1 }
        return _SeqIter(snap)
    }

    // 快照列表（顺序与 __iter__ 相同）
    toList() -> list = {
        snap = @[]
        for (v in self) { snap.push(v) }
        return snap
    }

    __contains__(x: any) -> bool = {
        for (v in self) { if (v == x) return true }
        return false
    }

    __eq__(other: any) -> bool = {
        if (!isinstance(other, Deque)) return false
        a = self.toList()
        b = other.toList()
        if (a.len() != b.len()) return false
        i = 0
        while (i < a.len()) {
            if (!(a[i] == b[i])) return false
            i += 1
        }
        return true
    }

}


class DefaultDict {
    init(defaultFactory: function) = {
        self.data = {}
        self.factory = defaultFactory
    }
    
    __getitem__(key: any) = {
        if (!(key in self.data)) {
            self.data[key] = self.factory()
        }
        return self.data[key]
    }
    
    __setitem__(key: any, val: any) = { self.data[key] = val }
    __contains__(key: any) -> bool  = return (key in self.data)
    
    keys() -> list   = return self.data.keys()
    values() -> list = return self.data.values()
}


// ─── Counter (Frequency Hash Map) ─────────────────────────────

class Counter {
    init(iterable: any = none) = {
        self.data = {}
        if (iterable != none) self.update(iterable)
    }
    
    update(iterable: any) = {
        for (item in iterable) {
            if ((item in self.data)) { self.data[item] += 1 } 
            else { self.data[item] = 1 }
        }
        return self
    }
    
    get(key: any) -> int = {
        return (key in self.data) ? self.data[key] : 0
    }
    
    mostCommon(n: int | float = 1) -> list = {
        n = round(n)
        L = @[]
        for (@[k, v] in self.data) L.push(@[k, v])
        sorted = L.sort((a, b) => a[1] > b[1])
        return sorted.slice(0, n)
    }
}


// ─── PriorityQueue (Binary Heap) ──────────────────────────────

class PriorityQueue {
    init(cmp: function = (a, b) => a < b) = {
        self.data = @[]
        self.cmp = cmp   
    }
    
    push(item: any) = {
        self.data.push(item)
        self._siftUp(self.data.len() - 1)
        return self
    }
    
    pop() = {
        n = self.data.len()
        if (n == 0) throw IndexError("pop from empty PriorityQueue")
        
        result = self.data[0]
        last = self.data.pop()
        
        if (n > 1) {
            self.data[0] = last
            self._siftDown(0)
        }
        return result
    }
    
    peek() = {
        if (self.isEmpty()) throw IndexError("peek from empty PriorityQueue")
        return self.data[0]
    }
    
    isEmpty() -> bool = return self.data.len() == 0
    size() -> int     = return self.data.len()

    local _siftUp(idx: int | float) = {
        idx = round(idx)
        while (idx > 0) {
            parent = idiv(idx - 1, 2)
            if (self.cmp(self.data[idx], self.data[parent])) {
                tmp = self.data[idx]
                self.data[idx] = self.data[parent]
                self.data[parent] = tmp
                idx = parent
            } else { break }
        }
    }
    
    local _siftDown(idx: int | float) = {
        idx = round(idx)
        n = self.data.len()
        while (true) {
            left = 2 * idx + 1
            right = 2 * idx + 2
            best = idx
            
            if (left < n && self.cmp(self.data[left], self.data[best])) best = left
            if (right < n && self.cmp(self.data[right], self.data[best])) best = right
            
            if (best != idx) {
                tmp = self.data[idx]
                self.data[idx] = self.data[best]
                self.data[best] = tmp
                idx = best
            } else { break }
        }
    }
    // 迭代：按优先级升序（用副本堆排序，不改动自身；可重复遍历）
    __iter__() = {
        copy = PriorityQueue(self.cmp)
        i = 0
        while (i < self.data.len()) { copy.push(self.data[i]); i += 1 }
        snap = @[]
        while (!copy.isEmpty()) { snap.push(copy.pop()) }
        return _SeqIter(snap)
    }

    // 快照列表（顺序与 __iter__ 相同）
    toList() -> list = {
        snap = @[]
        for (v in self) { snap.push(v) }
        return snap
    }

    __len__() -> int = return self.size()

    __contains__(x: any) -> bool = {
        for (v in self) { if (v == x) return true }
        return false
    }

    __eq__(other: any) -> bool = {
        if (!isinstance(other, PriorityQueue)) return false
        a = self.toList()
        b = other.toList()
        if (a.len() != b.len()) return false
        i = 0
        while (i < a.len()) {
            if (!(a[i] == b[i])) return false
            i += 1
        }
        return true
    }

    __str__() -> string = return "PriorityQueue(size=" + str(self.size()) + ")"

}


// ─── TreeNode & Binary Search Tree (BST) ──────────────────────

local class TreeNode {
    init(val: any) = {
        self.val = val
        self.left = none
        self.right = none
    }

}

class BST {
    init() = {
        self.root = none
        self._size = 0
    }
    
    insert(val: any) = {
        if (self.root == none) {
            self.root = TreeNode(val)
            self._size += 1
        } else {
            self._insertNode(self.root, val)
        }
        return self
    }
    
    local _insertNode(node: TreeNode, val: any) = {
        if (val < node.val) {
            if (node.left == none) { node.left = TreeNode(val); self._size += 1 } 
            else { self._insertNode(node.left, val) }
        } else if (val > node.val) {
            if (node.right == none) { node.right = TreeNode(val); self._size += 1 } 
            else { self._insertNode(node.right, val) }
        }
    }
    
    contains(val: any) -> bool = {
        curr = self.root
        while (curr != none) {
            if (val == curr.val) return true
            if (val < curr.val) curr = curr.left
            else curr = curr.right
        }
        return false
    }
    
    size() -> int = return self._size
    
    inorder() -> list = {
        result = @[]
        self._inorderTraversal(self.root, result)
        return result
    }
    
    local _inorderTraversal(node: any, res: list) = {
        if (node != none) {
            self._inorderTraversal(node.left, res)
            res.push(node.val)
            self._inorderTraversal(node.right, res)
        }
    }
    // 迭代：中序（快照，不改动树；可重复遍历）
    __iter__() = return _SeqIter(self.inorder())

    // 快照列表（顺序与 __iter__ 相同）
    toList() -> list = {
        snap = @[]
        for (v in self) { snap.push(v) }
        return snap
    }

    __len__() -> int = return self.size()

    __contains__(x: any) -> bool = {
        for (v in self) { if (v == x) return true }
        return false
    }

    __eq__(other: any) -> bool = {
        if (!isinstance(other, BST)) return false
        a = self.toList()
        b = other.toList()
        if (a.len() != b.len()) return false
        i = 0
        while (i < a.len()) {
            if (!(a[i] == b[i])) return false
            i += 1
        }
        return true
    }

    __str__() -> string = return "BST(size=" + str(self.size()) + ")"

}


// ─── Dynamic Help Registry ────────────────────────────────────

const local import sys

class IndexError extends Exception {
    init(msg) = { super.init(msg) }
}

try {
    sys.register_help("collections", r"DOC(
═══ Collections (Standard Library) ═══

  Requires: import collections

  High-performance, OOP-based data structures backed by JC2 native lists 
  and hash dictionaries.

  Linear Structures
  ──────────────────────
    Stack()                   LIFO constraint.
                              Methods: push(x), pop(), peek(), isEmpty(), size()

    Queue()                   FIFO constraint.
                              Methods: enqueue(x), dequeue(), peek(), isEmpty(), size()

    Deque()                   Double-ended queue.
                              Methods: pushRight(x), pushLeft(x), popRight(), popLeft()

  Hash Structures
  ──────────────────────
    DefaultDict(factory)      Dict that generates default values for missing keys.
                              Usage: d = DefaultDict(() => @[])

    Counter(iterable)         Frequency map for counting occurrences.
                              Methods: update(iter), get(key), mostCommon(n)

  Tree & Heap Structures
  ──────────────────────
    PriorityQueue([cmp])      Binary heap. Min-heap by default.
                              For Max-heap: PriorityQueue((a, b) => a > b)
                              Methods: push(x), pop(), peek(), isEmpty(), size()

    BST()                     Binary Search Tree. (Ignores duplicates).
                              Methods: insert(x), contains(x), size(), inorder()

  Errors
  ──────────────────────
    IndexError      pop / peek / dequeue on an empty container.

  Complexity & Iteration
  ──────────────────────
    Stack          push/pop O(1); iteration is top-down.
    Queue          enqueue/dequeue amortized O(1) (two-stack queue); iteration is
                   front-to-back, across both internal stacks.
    Deque          push/pop at either end amortized O(1) (half-transfer rebalance);
                   iteration is left-to-right.
    PriorityQueue  push/pop O(log n) (binary heap); iteration is in priority order,
                   measured on a private copy so the queue itself is untouched.
    BST            insert/contains O(h) for tree height h (worst case O(n) when the
                   input is sorted; no rebalancing); iteration is in-order.
    Counter        get O(1); mostCommon sorts, so O(k log k) for k distinct keys.

    for (x in container) never consumes the container, and repeated loops yield the
    same sequence. toList() returns that same snapshot order as a plain list.
    clear() replaces the internal storage, so it is O(1).
)DOC")
}
