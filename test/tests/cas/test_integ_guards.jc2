import cas

// 符号假设环境与分支守卫。
//
// 背景：sqrt(z) 在 simplifyCore 里先变成 z^(1/2)，于是
//   sqrt(x^2) = (x^2)^(1/2) 会走"幂的幂法则"变成 x —— x<0 时这是错的（|x| 才对）；
//   sqrt(-p^2) = (-p^2)^(1/2) 会走"乘积分配律"拆成 i*p —— 这是分支穿越的来源。
// 现在这两条规则在【用户侧化简】下要求可证成立：底可证非负、或新指数为偶整数。
// 推导过程（integrate 内部）暂时挂起守卫，理由见 Symbolic.h 的 branchGuardsActive。
//
// 注意：假设环境是【全局】的（与 SymConfig 一致），所以每个用例都要自己收尾清理，
// 否则会污染后续测试文件。


x = sym("x")
y = sym("y")
p = sym("p")

clearAssumptions() = {
    cas.clearAssumptions()
    assert(len(cas.assumptions()) == 0, "assumptions must start empty")
}

test_assume_default_is_empty() = {
    cas.clearAssumptions()
    assert(len(cas.assumptions()) == 0, "no assumptions by default")
}
test_assume_default_is_empty()

test_assume_set_query_clear() = {
    clearAssumptions()
    cas.assume(x, "positive")
    cas.assume(y, "nonzero")
    a = cas.assumptions()
    assert(len(a) == 2, "two assumptions expected")
    assert(a["x"] == "positive", "x must be positive")
    assert(a["y"] == "nonzero", "y must be nonzero")

    cas.assume(x)                       // 只清 x
    a = cas.assumptions()
    assert(len(a) == 1 && a["y"] == "nonzero", "clearing one variable must keep the other")

    cas.clearAssumptions()
    assert(len(cas.assumptions()) == 0, "clearAssumptions must empty the environment")
}
test_assume_set_query_clear()

test_assume_accepts_string_and_all_tags() = {
    clearAssumptions()
    cas.assume("x", "positive")         // 字符串形式同样接受
    assert(cas.assumptions()["x"] == "positive", "string variable form must work")
    for (t in @["positive", "negative", "real", "nonzero"]) {
        cas.assume(y, t)
        assert(cas.assumptions()["y"] == t, "tag must round-trip: " + t)
    }
    cas.clearAssumptions()
}
test_assume_accepts_string_and_all_tags()

test_assume_rejects_bad_input() = {
    clearAssumptions()
    try {
        cas.assume(x, "bogus")
        assert(false, "unknown tag must be rejected")
    } catch (e) {
        assert("unknown tag" in e.message, "wrong error for unknown tag")
    }
    try {
        cas.assume(x, 1)
        assert(false, "non-string tag must be rejected")
    } catch (e) {
        assert("tag string" in e.message, "wrong error for non-string tag")
    }
    cas.clearAssumptions()
}
test_assume_rejects_bad_input()

// 保守侧：没有假设时不做分支不安全的开方重写
test_sqrt_of_square_is_conservative() = {
    clearAssumptions()
    assert(str(cas.simplify(sqrt(x^2))) == "sqrt(x^2)", "sqrt(x^2) must not become x without an assumption")
    assert(str(cas.simplify(sqrt(x^2 * y^2))) != "x * y", "sqrt(x^2*y^2) must not become x*y")
    assert(str(cas.simplify(sqrt(-p^2))) != "p * i", "sqrt(-p^2) must not become p*i")
    // 不受影响的仍要化简
    assert(str(cas.simplify(sqrt(x^4))) == "x^2", "sqrt(x^4) is x^2 for every real x")
    assert(str(cas.simplify(sqrt(8))) == "2 * sqrt(2)", "numeric square factors still extract")
    assert(str(cas.simplify(sqrt(2) * sqrt(2))) == "2", "numeric radicals still combine")
}
test_sqrt_of_square_is_conservative()

// 有假设时按假设化简
test_positive_assumption_enables_rewrite() = {
    clearAssumptions()
    cas.assume(x, "positive")
    assert(str(cas.simplify(sqrt(x^2))) == "x", "positive x makes sqrt(x^2) collapse to x")
    cas.clearAssumptions()
    assert(str(cas.simplify(sqrt(x^2))) == "sqrt(x^2)", "clearing the assumption restores the conservative form")
}
test_positive_assumption_enables_rewrite()

// negative / real 不足以支撑这条重写，不得误判
test_insufficient_assumptions_do_not_enable_rewrite() = {
    clearAssumptions()
    cas.assume(x, "negative")
    assert(str(cas.simplify(sqrt(x^2))) == "sqrt(x^2)", "negative x must not enable sqrt(x^2) -> x")
    cas.assume(x, "real")
    assert(str(cas.simplify(sqrt(x^2))) == "sqrt(x^2)", "real x alone must not enable sqrt(x^2) -> x")
    cas.clearAssumptions()
}
test_insufficient_assumptions_do_not_enable_rewrite()

// cas.verifyInteg 作为积分器自检，把已知正确与已知出错的积分钉住。
//
// 背景：换元类策略（广义 / 根式 / 三角）靠纯语法回代还原变量。内层若给出
// 复对数形式的原函数，回代后 √(负数) 的开方分支选择会让结果整体翻号 ——
// 实测 integ(p^2/sqrt(1-p^2)) 返回的原函数导数为 -f。
// 现在：推导过程中的策略级自检让后续策略接手；出口再做一次自检，宁可不给答案。


p = sym("p")

assert_verifies(f) = {
    assert(cas.verifyInteg(f, p), "cas.verifyInteg must accept: " + str(f))
}

test_verify_integ_known_good() = {
    assert_verifies(sqrt(1 - p^2))
    assert_verifies(1 / sqrt(1 - p^2))
    assert_verifies(p / sqrt(1 - p^2))
    assert_verifies(p^3 / sqrt(1 - p^2))
    assert_verifies(sqrt(1 - p^2) / p^2)
    assert_verifies(sqrt(p^2 - 1))
    assert_verifies(p^2 / sqrt(p^2 - 1))
    assert_verifies(1 / sqrt(p^2 + 1))
    assert_verifies(sqrt(p^2 + 1))
    assert_verifies(p^2 / sqrt(p^2 + 1))
    assert_verifies(p * sqrt(1 - p^2))
    assert_verifies(1 / (1 - p^2))
    assert_verifies(1 / (1 + p^2))
    assert_verifies(p / (1 + p^2))
    assert_verifies(1 / (p^2 + 2 * p + 5))
    assert_verifies(p^2 / (1 + p^2))
    assert_verifies(exp(-p^2))
    assert_verifies(p * exp(-p^2))
    assert_verifies(exp(p) * sin(p))
    assert_verifies(log(p))
    assert_verifies(p * log(p))
    assert_verifies(log(p)^2)
    assert_verifies(sin(p)^2)
    assert_verifies(cos(p)^2)
    assert_verifies(sin(p)^3)
    assert_verifies(tan(p))
    assert_verifies(1 / sin(p))
    assert_verifies(1 / (1 + cos(p)))
    assert_verifies(sin(p) * cos(p))
    assert_verifies(p * sin(p))
    assert_verifies(p^2 * sin(p))
}
test_verify_integ_known_good()

// 曾返回符号相反原函数的三例：现在必须给出能通过自检的结果
test_verify_integ_previously_sign_flipped() = {
    assert_verifies(p^2 / sqrt(1 - p^2))
    assert_verifies(1 / (p^2 * sqrt(1 - p^2)))
    assert_verifies(1 / sqrt(p * (1 - p)))
}
test_verify_integ_previously_sign_flipped()

// 不变量：cas.integ 要么给出能通过自检的原函数，要么拒绝 —— 绝不返回未通过自检的结果。
// 这一例曾由出口自检兜底：推导期自检用 evalUniversal（无函数求值器）算不出残差数值，
// 判 Unknown 后被放行，占住了 p^2*sqrt(1-p^2) 的位置。B5 后最外层不再采信 Unknown。
// 这样写的好处：将来若真正修好它，本测试仍然成立。
test_integ_never_returns_unverified_antiderivative() = {
    f = p^2 * sqrt(1 - p^2)
    accepted = false
    try {
        cas.integ(f, p)
        accepted = cas.verifyInteg(f, p)
    } catch (e) {
        accepted = "failed verification" in e.message
    }
    assert(accepted, "cas.integ must either verify its result or refuse to return it")
}
test_integ_never_returns_unverified_antiderivative()

// B5 回归：最外层把自检的 Unknown 视为"不可采信"后，根式换元那条注入 i 的候选不再占位，
// 圆分支三角换元接手给出可通过自检的实形式结果（1/8*asin(p) - 1/32*sin(4*asin(p))）。
test_verify_integ_circular_branch_takes_over() = {
    assert_verifies(p^2 * sqrt(1 - p^2))
}
test_verify_integ_circular_branch_takes_over()

// log 族分支守卫（P3）。
//
// 背景：log(a^b) → b·log(a) 与 log(∏aᵢ) → Σlog(aᵢ) 只在所有参数 > 0 时成立。
// 实测（本 CAS 的 log 走主分支复值）：
//   a = -2, b = 2：log((-2)^2) = 1.38629，而 2*log(-2) = 1.38629 + 6.28319*i
//   a = b = -1  ：log(1)       = 0     ，而 log(-1)+log(-1) = 6.28319*i
// 现在这两条在【用户侧化简】下要求参数可证为正（isProvablyPositive）；
// 推导期（integrate 内部）挂起守卫，理由见 Symbolic.h 的 branchGuardsActive。
// log(exp z) → z 按实域语义保留（D-P3-2=a），不加守卫。
//
// 注意：假设环境是【全局】的，每个用例自己收尾清理，否则会污染后续测试文件。


x = sym("x")
y = sym("y")
EE = cas.e()

// 保守侧：没有前提时不做分支不安全的 log 重写
test_log_power_is_conservative() = {
    cas.clearAssumptions()
    assert(str(cas.simplify(log(x^2))) == "log(x^2)", "log(x^2) must not become 2*log(x) without a premise")
    assert(str(cas.simplify(log(x^3))) == "log(x^3)", "log(x^3) must not become 3*log(x) without a premise")
    assert(str(cas.simplify(log(sqrt(x)))) == "log(sqrt(x))", "log(sqrt(x)) must not split without a premise")
    assert(str(cas.simplify(log(2*x))) == "log(2 * x)", "log(2*x) must not split without a premise on x")
    cas.clearAssumptions()
}
test_log_power_is_conservative()

test_log_product_is_conservative() = {
    cas.clearAssumptions()
    assert(str(cas.simplify(log(x*y) - log(x) - log(y))) == "log(x * y) - log(x) - log(y)", "log(x*y) - log(x) - log(y) is not identically zero")
    assert(str(cas.simplify(log(x*y) - log(x))) == "log(x * y) - log(x)", "log(x*y) - log(x) must not collapse to log(y)")
    cas.clearAssumptions()
}
test_log_product_is_conservative()

// 有前提时按前提化简
test_positive_premise_enables_log_rewrite() = {
    cas.clearAssumptions()
    cas.assume(x, "positive")
    assert(str(cas.simplify(log(x^2))) == "2 * log(x)", "positive x makes log(x^2) collapse")
    cas.assume(y, "positive")
    assert(str(cas.simplify(log(x*y) - log(x) - log(y))) == "0", "both positive makes the log difference vanish")
    cas.clearAssumptions()
    assert(str(cas.simplify(log(x^2))) == "log(x^2)", "clearing the assumption restores the conservative form")
}
test_positive_premise_enables_log_rewrite()

// 与前提无关的恒等式不收紧
test_unconditional_log_identities_kept() = {
    cas.clearAssumptions()
    assert(str(cas.simplify(exp(log(x)))) == "x", "exp(log(x)) is x for x != 0")
    assert(str(cas.simplify(log(exp(x)))) == "x", "log(exp(x)) stays the real-domain identity")
    assert(str(cas.simplify(log(1))) == "0.0", "log(1) is 0")
    assert(str(cas.simplify(log(EE))) == "1", "log(e) is 1")
    cas.clearAssumptions()
}
test_unconditional_log_identities_kept()
