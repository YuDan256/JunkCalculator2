// 矩阵构造与转换的顺序契约。
// 此前 tests/ 对 matrix() / symmatrix() / toMatrix() / toList() 零覆盖。
//
// 两个轴要分清：
//   构造（字面量、matrix()、toMatrix()）按行
//   索引与遍历（A[i]、迭代、解包）按列

// toMatrix：每个内层列表是一行
test_toMatrix_inner_list_is_a_row() = {
    assert(toMatrix(@[@[1, 2], @[3, 4]]) == [1, 2; 3, 4], "inner lists must become rows")
    assert(toMatrix(@[@[1, 2, 3], @[4, 5, 6]]) == [1, 2, 3; 4, 5, 6], "non-square: inner lists must become rows")
    assert(toMatrix(@[@[1], @[2], @[3]]) == [1; 2; 3], "single-column nested list")
    assert(toMatrix(@[@[1, 2, 3]]) == [1, 2, 3], "single-row nested list")
}
test_toMatrix_inner_list_is_a_row()

// toList：矩阵变成它的行
test_toList_emits_rows() = {
    assert(toList([1, 2, 3; 4, 5, 6]) == @[@[1, 2, 3], @[4, 5, 6]], "toList must emit rows")
    assert(toList([1, 2; 3, 4]) == @[@[1, 2], @[3, 4]], "square toList must emit rows")
}
test_toList_emits_rows()

// toList / toMatrix 互逆
test_toList_toMatrix_round_trip() = {
    assert(toMatrix(toList([1, 2, 3; 4, 5, 6])) == [1, 2, 3; 4, 5, 6], "non-square round-trip")
    assert(toMatrix(toList([1, 2; 3, 4])) == [1, 2; 3, 4], "square round-trip")
    assert(toMatrix(toList([7; 8; 9])) == [7; 8; 9], "column round-trip")
    assert(toMatrix(toList([1, 2, 3])) == [1, 2, 3], "row round-trip")
}
test_toList_toMatrix_round_trip()

// 复数与符号矩阵同样按行
test_toMatrix_complex_and_symbolic() = {
    assert(toMatrix(@[@[1i, 2i], @[3i, 4i]]) == [1i, 2i; 3i, 4i], "complex inner lists must become rows")
    x = sym("x")
    assert(toMatrix(@[@[x, 1], @[2, 3]]) == [x, 1; 2, 3], "symbolic inner lists must become rows")
}
test_toMatrix_complex_and_symbolic()

// 单下标仍返回列：构造顺序与索引顺序是两个轴
test_single_index_is_a_column() = {
    A = [1, 2; 3, 4]
    assert(A[0] == [1; 3], "A[0] must be the first column")
    assert(A[1] == [2; 4], "A[1] must be the second column")
    C = [1, 2, 3; 4, 5, 6]
    assert(C[2] == [3; 6], "C[2] must be the third column")
}
test_single_index_is_a_column()

// 非法输入仍被拒绝
test_toMatrix_rejects_bad_input() = {
    try {
        toMatrix(@[1, 2, 3])
        assert(false, "toMatrix must reject a flat list")
    } catch (e) {
        assert("expects a List of Lists" in e.message, "wrong error for a flat list")
    }

    try {
        toMatrix(@[@[1, 2], @[3]])
        assert(false, "toMatrix must reject ragged rows")
    } catch (e) {
        assert("rows must have equal length" in e.message, "wrong error for ragged rows")
    }
}
test_toMatrix_rejects_bad_input()

// matrix()：展平序列按行填充
test_matrix_variadic_fills_by_rows() = {
    assert(matrix(2, 2, 1, 2, 3, 4) == [1, 2; 3, 4], "square variadic fill must be by rows")
    assert(matrix(3, 2, 1, 2, 3, 4, 5, 6) == [1, 2; 3, 4; 5, 6], "3x2 variadic fill must be by rows")
    assert(matrix(2, 3, 1, 2, 3, 4, 5, 6) == [1, 2, 3; 4, 5, 6], "2x3 variadic fill must be by rows")
    assert(matrix(3, 1, 1, 2, 3) == [1; 2; 3], "single-column variadic fill")
    assert(matrix(1, 3, 1, 2, 3) == [1, 2, 3], "single-row variadic fill")
}
test_matrix_variadic_fills_by_rows()

// matrix() 的复数与符号分支同样按行
test_matrix_variadic_complex_and_symbolic() = {
    assert(matrix(2, 2, 1i, 2i, 3i, 4i) == [1i, 2i; 3i, 4i], "complex variadic fill must be by rows")
    x = sym("x")
    assert(matrix(2, 2, x, 1, 2, 3) == [x, 1; 2, 3], "symbolic variadic fill must be by rows")
}
test_matrix_variadic_complex_and_symbolic()

// symmatrix()：展平序列按行填充
// 符号 1 与实数 1.0 不按矩阵等值，故逐元素比
test_symmatrix_variadic_fills_by_rows() = {
    S = symmatrix(2, 3, 1, 2, 3, 4, 5, 6)
    assert(S[0, 0] == 1 && S[0, 1] == 2 && S[0, 2] == 3, "symmatrix first row must be 1 2 3")
    assert(S[1, 0] == 4 && S[1, 1] == 5 && S[1, 2] == 6, "symmatrix second row must be 4 5 6")

    T = symmatrix(3, 2, 1, 2, 3, 4, 5, 6)
    assert(T[0, 0] == 1 && T[0, 1] == 2, "3x2 symmatrix first row")
    assert(T[2, 0] == 5 && T[2, 1] == 6, "3x2 symmatrix last row")
}
test_symmatrix_variadic_fills_by_rows()

// 三种构造入口顺序一致
test_construction_orders_agree() = {
    A = [1, 2, 3; 4, 5, 6]
    assert(matrix(2, 3, 1, 2, 3, 4, 5, 6) == A, "matrix() must agree with the literal")
    assert(matrix(2, 3, 1, 2, 3, 4, 5, 6) == toMatrix(toList(A)), "matrix() must agree with toMatrix(toList())")

    S = symmatrix(2, 3, 1, 2, 3, 4, 5, 6)
    assert(S[0, 0] == 1 && S[1, 2] == 6, "symmatrix() must place elements at the literal's positions")
    assert(S == matrix(2, 3, sym(1), 2, 3, 4, 5, 6), "symmatrix() must agree with the symbolic matrix() branch")
}
test_construction_orders_agree()

// 维度与元素个数校验不变
test_matrix_rejects_bad_args() = {
    try {
        matrix(2, 2, 1, 2, 3)
        assert(false, "matrix must reject a wrong element count")
    } catch (e) {
        assert("element count mismatch" in e.message, "wrong error for element count")
    }

    try {
        matrix(0, 2)
        assert(false, "matrix must reject non-positive dimensions")
    } catch (e) {
        assert("dimensions must be positive" in e.message, "wrong error for dimensions")
    }

    try {
        symmatrix(2, 2, 1, 2, 3)
        assert(false, "symmatrix must reject a wrong element count")
    } catch (e) {
        assert("element count mismatch" in e.message, "wrong error for symmatrix element count")
    }
}
test_matrix_rejects_bad_args()
