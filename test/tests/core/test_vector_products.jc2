a = [1; 2; 3]
b = [4; 5; 6]
c = [7; 8; 9]

// Real inputs keep real result types.
assert(type(a.dot(b)) == float, "real dot returns float")
assert(a.dot(b) == 32, "real dot value")

assert(type(a.cross(b)) == realmatrix, "real cross returns realmatrix")
cr = a.cross(b)
assert(cr[0, 0] == -3 && cr[1, 0] == 6 && cr[2, 0] == -3, "real cross value")

assert(type(a.triple(b, c)) == float, "real triple returns float")
assert(a.triple(b, c) == 0, "real triple value")

// Any complex input keeps complex result types.
cx = [1 + 1i; 0; 0]
cy = [1; 0; 0]
ez = [0; 0; 1]

assert(type(cx.dot(cy)) == complex, "mixed dot returns complex")
assert(cx.dot(cy) == 1 - 1i, "mixed dot uses conjugate")
assert(type(cx.cross(cy)) == complexmatrix, "mixed cross returns complexmatrix")
assert(type(cx.triple(cy, ez)) == complex, "mixed triple returns complex")

print("vector product battery OK")
