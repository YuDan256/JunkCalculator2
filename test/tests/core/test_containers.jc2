import math

// ═══════════════════════════════════════════════════════════════
// Merged battery: matrix, matrix_const, slice_bounds, string_iter, vector_products, sum_identity
// ═══════════════════════════════════════════════════════════════

// ── core/test_matrix.jc2 ─────────────────────────────────────────────
{
// 矩阵构造与转换的顺序契约。
// 此前 tests/ 对 matrix() / symmatrix() / toMatrix() / toList() 零覆盖。
//
// 两个轴要分清：
//   构造（字面量、matrix()、toMatrix()）按行
//   索引与遍历（A[i]、迭代、解包）按列

// toMatrix：每个内层列表是一行
test_toMatrix_inner_list_is_a_row() = {
    assert(toMatrix(@[@[1, 2], @[3, 4]]) == [1, 2; 3, 4], "inner lists must become rows")
    assert(toMatrix(@[@[1, 2, 3], @[4, 5, 6]]) == [1, 2, 3; 4, 5, 6], "non-square: inner lists must become rows")
    assert(toMatrix(@[@[1], @[2], @[3]]) == [1; 2; 3], "single-column nested list")
    assert(toMatrix(@[@[1, 2, 3]]) == [1, 2, 3], "single-row nested list")
}
test_toMatrix_inner_list_is_a_row()

// toList：矩阵变成它的行
test_toList_emits_rows() = {
    assert(toList([1, 2, 3; 4, 5, 6]) == @[@[1, 2, 3], @[4, 5, 6]], "toList must emit rows")
    assert(toList([1, 2; 3, 4]) == @[@[1, 2], @[3, 4]], "square toList must emit rows")
}
test_toList_emits_rows()

// toList / toMatrix 互逆
test_toList_toMatrix_round_trip() = {
    assert(toMatrix(toList([1, 2, 3; 4, 5, 6])) == [1, 2, 3; 4, 5, 6], "non-square round-trip")
    assert(toMatrix(toList([1, 2; 3, 4])) == [1, 2; 3, 4], "square round-trip")
    assert(toMatrix(toList([7; 8; 9])) == [7; 8; 9], "column round-trip")
    assert(toMatrix(toList([1, 2, 3])) == [1, 2, 3], "row round-trip")
}
test_toList_toMatrix_round_trip()

// 复数与符号矩阵同样按行
test_toMatrix_complex_and_symbolic() = {
    assert(toMatrix(@[@[1i, 2i], @[3i, 4i]]) == [1i, 2i; 3i, 4i], "complex inner lists must become rows")
    x = sym("x")
    assert(toMatrix(@[@[x, 1], @[2, 3]]) == [x, 1; 2, 3], "symbolic inner lists must become rows")
}
test_toMatrix_complex_and_symbolic()

// 单下标仍返回列：构造顺序与索引顺序是两个轴
test_single_index_is_a_column() = {
    A = [1, 2; 3, 4]
    assert(A[0] == [1; 3], "A[0] must be the first column")
    assert(A[1] == [2; 4], "A[1] must be the second column")
    C = [1, 2, 3; 4, 5, 6]
    assert(C[2] == [3; 6], "C[2] must be the third column")
}
test_single_index_is_a_column()

// 非法输入仍被拒绝
test_toMatrix_rejects_bad_input() = {
    try {
        toMatrix(@[1, 2, 3])
        assert(false, "toMatrix must reject a flat list")
    } catch (e) {
        assert("expects a List of Lists" in e.message, "wrong error for a flat list")
    }

    try {
        toMatrix(@[@[1, 2], @[3]])
        assert(false, "toMatrix must reject ragged rows")
    } catch (e) {
        assert("rows must have equal length" in e.message, "wrong error for ragged rows")
    }
}
test_toMatrix_rejects_bad_input()

// matrix()：展平序列按行填充
test_matrix_variadic_fills_by_rows() = {
    assert(matrix(2, 2, 1, 2, 3, 4) == [1, 2; 3, 4], "square variadic fill must be by rows")
    assert(matrix(3, 2, 1, 2, 3, 4, 5, 6) == [1, 2; 3, 4; 5, 6], "3x2 variadic fill must be by rows")
    assert(matrix(2, 3, 1, 2, 3, 4, 5, 6) == [1, 2, 3; 4, 5, 6], "2x3 variadic fill must be by rows")
    assert(matrix(3, 1, 1, 2, 3) == [1; 2; 3], "single-column variadic fill")
    assert(matrix(1, 3, 1, 2, 3) == [1, 2, 3], "single-row variadic fill")
}
test_matrix_variadic_fills_by_rows()

// matrix() 的复数与符号分支同样按行
test_matrix_variadic_complex_and_symbolic() = {
    assert(matrix(2, 2, 1i, 2i, 3i, 4i) == [1i, 2i; 3i, 4i], "complex variadic fill must be by rows")
    x = sym("x")
    assert(matrix(2, 2, x, 1, 2, 3) == [x, 1; 2, 3], "symbolic variadic fill must be by rows")
}
test_matrix_variadic_complex_and_symbolic()

// symmatrix()：展平序列按行填充
// 符号 1 与实数 1.0 不按矩阵等值，故逐元素比
test_symmatrix_variadic_fills_by_rows() = {
    S = symmatrix(2, 3, 1, 2, 3, 4, 5, 6)
    assert(S[0, 0] == 1 && S[0, 1] == 2 && S[0, 2] == 3, "symmatrix first row must be 1 2 3")
    assert(S[1, 0] == 4 && S[1, 1] == 5 && S[1, 2] == 6, "symmatrix second row must be 4 5 6")

    T = symmatrix(3, 2, 1, 2, 3, 4, 5, 6)
    assert(T[0, 0] == 1 && T[0, 1] == 2, "3x2 symmatrix first row")
    assert(T[2, 0] == 5 && T[2, 1] == 6, "3x2 symmatrix last row")
}
test_symmatrix_variadic_fills_by_rows()

// 三种构造入口顺序一致
test_construction_orders_agree() = {
    A = [1, 2, 3; 4, 5, 6]
    assert(matrix(2, 3, 1, 2, 3, 4, 5, 6) == A, "matrix() must agree with the literal")
    assert(matrix(2, 3, 1, 2, 3, 4, 5, 6) == toMatrix(toList(A)), "matrix() must agree with toMatrix(toList())")

    S = symmatrix(2, 3, 1, 2, 3, 4, 5, 6)
    assert(S[0, 0] == 1 && S[1, 2] == 6, "symmatrix() must place elements at the literal's positions")
    assert(S == matrix(2, 3, sym(1), 2, 3, 4, 5, 6), "symmatrix() must agree with the symbolic matrix() branch")
}
test_construction_orders_agree()

// 维度与元素个数校验不变
test_matrix_rejects_bad_args() = {
    try {
        matrix(2, 2, 1, 2, 3)
        assert(false, "matrix must reject a wrong element count")
    } catch (e) {
        assert("element count mismatch" in e.message, "wrong error for element count")
    }

    try {
        matrix(0, 2)
        assert(false, "matrix must reject non-positive dimensions")
    } catch (e) {
        assert("dimensions must be positive" in e.message, "wrong error for dimensions")
    }

    try {
        symmatrix(2, 2, 1, 2, 3)
        assert(false, "symmatrix must reject a wrong element count")
    } catch (e) {
        assert("element count mismatch" in e.message, "wrong error for symmatrix element count")
    }
}
test_matrix_rejects_bad_args()

// 整数幂不得引入转置（曾因 real->complex 转换按行主序组装 flat 而整体转置）
test_matrix_integer_power() = {
    B = matrix(2, 2, 5, 7, 6, 8)
    assert(repr(B^1) == repr(B), "A^1 must equal A")
    assert(repr(B^2) == repr(B * B), "A^2 must equal A*A")
    assert(repr(B^0) == repr(matrix(2, 2, 1, 0, 0, 1)), "A^0 is the identity")
    assert(repr(B^-1) == repr(B.inv()), "A^-1 must equal A.inv()")
    assert(repr(B^-2) == repr(B.inv()^2), "A^-2 must equal inv(A)^2")
    C = matrix(2, 2, 1, 2, 3, 5)
    assert(repr(C^1) == repr(C), "asymmetric A^1 must equal A")
    assert(repr(C^2) == repr(C * C), "asymmetric A^2 must equal A*A")
    S = symmatrix(2, 2, 1, 2, 3, 5)
    assert(repr(S^1) == repr(S), "symmatrix^1 must equal itself")
}

test_matrix_integer_power()

// isapprox 的矩阵路径：同形状逐元素容差比较，形状不同为 false
test_isapprox_matrix() = {
    B = matrix(2, 2, 5, 7, 6, 8)
    I2 = matrix(2, 2, 1, 0, 0, 1)
    assert(math.isapprox(B, B), "identical matrices")
    assert(math.isapprox(B * B.inv(), I2), "A*A^-1 is approximately the identity")
    assert(math.isapprox(B.inv(), matrix(2, 2, -4, 3.5, 3, -2.5)), "tolerance covers the 1e-15 residual")
    assert(!math.isapprox(B, matrix(2, 2, 5, 7, 6, 9)), "differing elements are not approximately equal")
    assert(!math.isapprox(B, matrix(2, 2, 5, 7, 6, 0)), "large difference")
    assert(!math.isapprox(matrix(2, 2, 1, 2, 3, 4), matrix(3, 3, 1, 2, 3, 4, 5, 6, 7, 8, 9)), "shape mismatch -> false")
    assert(math.isapprox(B.inv(), matrix(2, 2, -4, 3.5, 3, -2.5), 1e-9), "explicit rtol")
    assert(!math.isapprox(B.inv(), matrix(2, 2, -4, 3.5, 3, -2.5), 1e-30), "tight rtol rejects the residual")
}

test_isapprox_matrix()


test_matrix_index_shape_and_immutability() = {
    A = [1, 2; 3, 4]
    assert(A.rows() == 2 && A.cols() == 2 && len(A) == 4, "matrix shape/len")
    assert(A[0] == [1; 3], "single index is a column")
    assert(A[0, :] == [1, 2], "row slice")
    assert(A[:, 0] == [1; 3], "column slice")
    assert(A[0:2, 0:2] == [1, 2; 3, 4], "block slice")

    threw = false
    try { A[0, 0] = 9 } catch (e) { threw = true }
    assert(threw, "matrix index write is rejected")

    B = A.setElement(0, 0, 9)
    assert(B[0, 0] == 9 && A[0, 0] == 1, "setElement returns a new matrix")

    cols = @[]
    for (c in A) { cols.push(c) }
    assert(cols[0] == [1; 3] && cols[1] == [2; 4], "matrix iterates columns")

    assert(A.trans() == [1, 3; 2, 4], "transpose")
    assert(math.isapprox(A / A, [1, 0; 0, 1], 1e-12, 1e-12), "right division")
    assert(math.isapprox(A \ [1; 0], [-2; 3 / 2]), "left division solves")
}
test_matrix_index_shape_and_immutability()


test_matrix_empty_slice_reshape_edges() = {
    E = zeros(0, 1)
    assert(E.rows() == 0 && E.cols() == 0 && len(E) == 0, "empty matrix collapses to 0x0")
    assert(!E, "empty matrix is falsy")

    A = [1, 2; 3, 4]
    assert(A.getSlice(slice(0, 2), slice(0, 1)) == [1; 3], "getSlice")
    assert(A.setSlice(slice(0, 1), slice(0, 1), [9]) == [9, 2; 3, 4], "setSlice returns new")
    assert(A == [1, 2; 3, 4], "setSlice leaves source unchanged")

    assert(A.reshape(1, 4) == [1, 3, 2, 4], "reshape is column-major")
    assert(A.hcat([5, 6; 7, 8]) == [1, 2, 5, 6; 3, 4, 7, 8], "hcat")
    assert(A.vcat([5, 6; 7, 8]) == [1, 2; 3, 4; 5, 6; 7, 8], "vcat")

    S = [1, 2; 2, 4]
    assert(S.det() == 0, "singular determinant")
    threw = false
    try { S.inv() } catch (e) { threw = true }
    assert(threw, "singular inverse errors")

    B = [1, 2; 3, 4; 5, 6]
    threw = false
    try { A * B } catch (e) { threw = true }
    assert(threw, "shape mismatch multiply")
    threw = false
    try { A / B } catch (e) { threw = true }
    assert(threw, "shape mismatch division")
}
test_matrix_empty_slice_reshape_edges()
}

// ── core/test_matrix_const.jc2 ─────────────────────────────────────────────
{
// Constant matrix literals are folded into the constant pool.
throws(f) = {
    try { f(); return false } catch (e) { return true }
}

f() = [1, 2; 3, 4]
assert(f() == [1, 2; 3, 4], "constant matrix roundtrip")
assert(f()[0, 0] == 1 && f()[1, 1] == 4, "constant matrix values")

// Identical matrix constants share one pool slot.
g() = @[[1, 2; 3, 4], [1, 2; 3, 4]]
assert(g()[0] == g()[1], "deduplicated matrix constants")

// Constant concatenation keeps VM semantics for invalid elements.
assert(throws(() => [1, "x"]), "invalid constant matrix stays runtime")
}

// ── core/test_slice_bounds.jc2 ─────────────────────────────────────────────
{
s = "hello"
m = %{start: 1, end: 4}

assert(s[m.start : m.end] == "ell", "slice bounds from properties")
assert(s[m.start :] == "ello", "open end slice")
assert(s[: m.end] == "hell", "open start slice")
assert(s[m.start : m.end : 2] == "el", "step slice")
assert(s[1 : 3] == "el", "literal slice still works")

x: int = 1
assert(x == 1, "type annotation still parses")
}

// ── core/test_string_iter.jc2 ─────────────────────────────────────────────
{
// 字符串的迭代与高阶方法。
//
// 背景：字符串迭代语义在语言里早已确立（for-in、s[i]、charAt、enumerate、reverse、
// f(*s) 都按 UTF-8 code point，元素是长度 1 的字符串），但 map / filter / reduce /
// any / all / countIf / groupBy / indexOf / count / join 在 stringProto 上注册了却没有
// 字符串分支，调用必然抛 TypeError。helpers::iterateIterable 补上字符串分支后一次全通。
// 返回类型：map → list；filter / sort → string（与已有的 reverse 一致）。

test_string_iterates_by_code_point() = {
    u = "中文a"
    assert(len(u) == 3, "len counts code points")
    assert(u[0] == "中", "indexing is code-point based")
    assert(u.charAt(1) == "文", "charAt is code-point based")
    assert(u.reversed() == "a文中", "reversed is code-point based")
    seen = ""
    for (c in u) { seen = seen + c }
    assert(seen == u, "for-in walks code points")
}
test_string_iterates_by_code_point()

test_string_higher_order_methods() = {
    s = "cab"
    assert(str(s.map((c) => c + "!")) == '@["c!", "a!", "b!"]', "map returns a list")
    assert(s.filter((c) => c != "a") == "cb", "filter returns a string")
    assert(s.reduce((acc, c) => acc + c, "") == "cab", "reduce folds over characters")
    assert(s.any((c) => c == "a"), "any sees characters")
    assert(s.all((c) => c != "z"), "all sees characters")
    assert(s.countIf((c) => c == "a") == 1, "countIf counts characters")
    assert(s.sorted() == "abc", "sorted returns a string")
    assert(str(s.groupBy((c) => c)) == '%{"c": @["c"], "a": @["a"], "b": @["b"]}', "groupBy keys on characters")
}
test_string_higher_order_methods()

test_string_search_methods() = {
    s = "cab"
    assert(s.indexOf("a") == 1, "indexOf finds a character")
    assert(s.indexOf("z") == -1, "indexOf returns -1 when absent")
    assert(s.count("a") == 1, "count counts characters")
    assert("中文abc".indexOf("abc") == 2, "indexOf returns UTF-8 code-point index")
    assert("a--b--c".replace("--", "-") == "a-b-c", "replace handles all occurrences")
    assert("aaa".replace("aa", "b") == "ba", "replace is non-overlapping")
    assert("a--b--c".count("--") == 2, "count counts non-overlapping substrings")
    assert("".count("a") == 0, "count on empty string")
    assert(s.join("-") == "c-a-b", "join uses characters as elements")
}
test_string_search_methods()

test_string_methods_handle_utf8() = {
    u = "中文a"
    assert(str(u.map((c) => c)) == '@["中", "文", "a"]', "map splits by code point")
    assert(u.filter((c) => c != "文") == "中a", "filter keeps code points")
    assert(u.sorted() == "a中文", "sorted compares code points")
    assert(u.count("中") == 1, "count works on non-ASCII")
    assert(u.join("|") == "中|文|a", "join works on non-ASCII")
}
test_string_methods_handle_utf8()

test_string_methods_handle_empty() = {
    assert(str("".map((c) => c)) == "@[]", "map of an empty string is an empty list")
    assert("".filter((c) => true) == "", "filter of an empty string is empty")
    assert("".sorted() == "", "sorted of an empty string is empty")
    assert("".join("-") == "", "join of an empty string is empty")
    assert("".reduce((acc, c) => acc + c, "S") == "S", "reduce of an empty string returns the init value")
}
test_string_methods_handle_empty()


test_string_conversion_and_formatting() = {
    assert(ord("A") == 65 && "A".ord() == 65, "ord global and method")
    assert(ord("中") == 20013, "ord Unicode codepoint")
    assert(chr(65) == "A" && chr(20013) == "中", "chr Unicode")
    assert(parseNum("42") == 42 && "42".parseNum() == 42, "parseNum int")
    assert(parseNum("3.5") == 3.5 && "3.5".parseNum() == 3.5, "parseNum float")
    assert(parseNum(" 42 ") == 42, "parseNum trims whitespace")
    assert(parseNum("1e3") == 1000.0, "parseNum exponent")
    threw = false
    try { parseNum("bad") } catch (e) { threw = e.type == "MathError" }
    assert(threw, "parseNum invalid")
    threw = false
    try { parseNum("0xFF") } catch (e) { threw = e.type == "MathError" }
    assert(threw, "parseNum rejects hex without consuming a prefix")
    threw = false
    try { parseNum("0b101") } catch (e) { threw = e.type == "MathError" }
    assert(threw, "parseNum rejects binary without consuming a prefix")

    assert("abc" * 3 == "abcabcabc", "string repetition")
    assert(3 * "ha" == "hahaha", "string commutative repetition")
    assert("hello"[::-1] == "olleh", "reverse slice")
    assert("hello"[1:5:2] == "el", "step slice")
    assert(r"\n" == "\\n", "raw string")
    assert(len(r"\n") == 2, "raw string length")

    name = "Alice"
    assert(f"{255::x}" == "ff", "hex format")
    assert(f"{7::+03d}" == "+07", "sign/width format")
    assert(f"{10000::,}" == "10,000", "grouping format")
    assert(f"{3.14159::.2f}" == "3.14", "fixed format")
    assert(f"{name::>10}" == "     Alice", "right align")
    assert(f"{name::^10}" == "  Alice   ", "center align")
    assert(f"{0.25::%}" == "25%", "percent format")
    assert(f"{name::.3s}" == "Ali", "string precision")
}
test_string_conversion_and_formatting()
}

// ── core/test_vector_products.jc2 ─────────────────────────────────────────────
{
a = [1; 2; 3]
b = [4; 5; 6]
c = [7; 8; 9]

// Real inputs keep real result types.
assert(type(a.dot(b)) == float, "real dot returns float")
assert(a.dot(b) == 32, "real dot value")

assert(type(a.cross(b)) == realmatrix, "real cross returns realmatrix")
cr = a.cross(b)
assert(cr[0, 0] == -3 && cr[1, 0] == 6 && cr[2, 0] == -3, "real cross value")

assert(type(a.triple(b, c)) == float, "real triple returns float")
assert(a.triple(b, c) == 0, "real triple value")

// Any complex input keeps complex result types.
cx = [1 + 1i; 0; 0]
cy = [1; 0; 0]
ez = [0; 0; 1]

assert(type(cx.dot(cy)) == complex, "mixed dot returns complex")
assert(cx.dot(cy) == 1 - 1i, "mixed dot uses conjugate")
assert(type(cx.cross(cy)) == complexmatrix, "mixed cross returns complexmatrix")
assert(type(cx.triple(cy, ez)) == complex, "mixed triple returns complex")
}

// ── core/test_sum_identity.jc2 ─────────────────────────────────────────────
{
assert(type(@[].sum()) == int, "empty list sum is int")
assert(@[].sum() == 0, "empty list sum is zero")
assert(type(@{}.sum()) == int, "empty set sum is int")
assert(@{}.sum() == 0, "empty set sum is zero")

assert(@[1, 2].sum() == 3, "integer list sum stays int")
assert(type(@[1, 2].sum()) == int, "integer list sum type")
assert(@[1.0, 2.0].sum() == 3.0, "float list sum stays float")

f(a, ...b; c, ...d) = a + b.sum() + c + d.len()
assert(f(c=3, a=1) == 4, "empty rest sum does not promote to float")
assert(type(f(c=3, a=1)) == int, "empty rest result is int")
}

// ── Kronecker product preserves matrix kind ───────────────────
test_kron_preserves_matrix_kind() = {
    A = [1, 2; 3, 4]
    B = [0, 5; 6, 7]
    C = A.kron(B)
    assert(type(C) == realmatrix, "real.kron(real) must return realmatrix")
    assert(C.rows() == 4 && C.cols() == 4, "kron shape")
    assert(C[0, 0] == 0 && C[0, 1] == 5 && C[1, 0] == 6 && C[3, 3] == 28, "kron values")

    Z = [1i, 0; 0, 1i]
    assert(type(A.kron(Z)) == complexmatrix, "real.kron(complex) must return complexmatrix")

    S = symmatrix(2, 2, sym("x"), 1, 2, 3)
    assert(type(A.kron(S)) == symmatrix, "real.kron(symbolic) must return symmatrix")
}
test_kron_preserves_matrix_kind()

// ── reshape / flatten order flag ───────────────────────────────
test_reshape_order_flag() = {
    A = [1, 2; 3, 4]

    // default: column-major, backward compatible
    assert(A.reshape(1, 4) == [1, 3, 2, 4], "reshape default is col")
    assert(A.reshape(1, 4, "col") == [1, 3, 2, 4], "reshape col")
    assert(A.reshape(1, 4, "row") == [1, 2, 3, 4], "reshape row")

    assert(A.flatten() == [1, 3, 2, 4], "flatten default is col")
    assert(A.flatten("col") == [1, 3, 2, 4], "flatten col")
    assert(A.flatten("row") == [1, 2, 3, 4], "flatten row")

    // non-contiguous view must use the same order rules
    T = A.trans()
    assert(T.reshape(1, 4, "col") == [1, 2, 3, 4], "transposed reshape col")
    assert(T.reshape(1, 4, "row") == [1, 3, 2, 4], "transposed reshape row")

    bad = false
    try { A.reshape(1, 4, "C") } catch (e) { bad = true }
    assert(bad, "unknown order must fail")
}
test_reshape_order_flag()


