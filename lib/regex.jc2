// ═══════════════════════════════════════════════════════════════
// regex.jc2 — Regular Expression Standard Library
// Pure JC2 2.4.2.0 Implementation (Backtracking NFA)
// ═══════════════════════════════════════════════════════════════

const _RE_SHORTHANDS = set("d", "D", "w", "W", "s", "S")

_re_shorthand(kind: string, c: string) -> bool = match (kind) {
    "d" => c.isdigit(),
    "D" => !c.isdigit(),
    "w" => c.isalnum() || c == "_",
    "W" => !(c.isalnum() || c == "_"),
    "s" => c.isspace(),
    "S" => !c.isspace(),
    _ => false
}

// ─── Match Object ─────────────────────────────────────────────

class ReMatch {
    init(matched: string, start: whole, end: whole, groups: list) = {
        self.matched = matched
        self.start = start
        self.end = end
        self.groups = groups
    }
    __str__() = f"<ReMatch \"{self.matched}\" span={self.start}:{self.end}>"
}

// ─── Parser State ─────────────────────────────────────────────

class _RePS {
    init(pat: string) = {
        self.s = pat; self.p = 0; self.n = pat.len(); self.gc = 0
    }
    pk() -> string = self.p < self.n ? self.s[self.p] : ""
    
    nx() -> string = { 
        c = self.pk()
        self.p += 1
        return c 
    }
    
    ok() -> bool = self.p < self.n

    parse() = {
        nodes = self.alt()
        if (isdict(nodes)) nodes = @[nodes]
        if (self.ok()) throw f"Regex Error: Unexpected '{self.pk()}' at position {self.p}"
        return nodes
    }

    alt() = {
        left = self.seq()
        if (self.ok() && self.pk() == "|") {
            self.nx()
            right = self.alt()
            if (isdict(right)) right = @[right]
            return {type: "alt", a: left, b: right}
        }
        return left
    }

    seq() -> list = {
        nodes = @[]
        while (self.ok() && self.pk() != ")" && self.pk() != "|") { 
            nodes.push(self.quant()) 
        }
        return nodes
    }

    quant() = {
        node = self.atom()
        if (self.ok()) {
            is_quant = false
            match (self.pk()) {
                "*" => { self.nx(); node = {type: "star", inner: node}; is_quant = true },
                "+" => { self.nx(); node = {type: "plus", inner: node}; is_quant = true },
                "?" => { self.nx(); node = {type: "opt", inner: node}; is_quant = true },
                "{" => {
                    saved_p = self.p; self.nx() 
                    min_str = ""
                    while (self.ok() && self.pk().isdigit()) { min_str += self.nx() }
                    
                    has_comma = false
                    max_str = ""
                    if (self.ok() && self.pk() == ",") {
                        has_comma = true; self.nx() 
                        while (self.ok() && self.pk().isdigit()) { max_str += self.nx() }
                    }
                    
                    if (self.ok() && self.pk() == "}") {
                        self.nx()
                        min_val = min_str.len() > 0 ? int(min_str) : 0
                        max_val = -1
                        if (has_comma) { 
                            if (max_str.len() > 0) max_val = int(max_str)
                        } else { 
                            max_val = min_str.len() > 0 ? min_val : 0 
                        }
                        node = {type: "bound", inner: node, min: min_val, max: max_val}
                        is_quant = true
                    } else { 
                        self.p = saved_p 
                    }
                },
                _ => {}
            }
            if (is_quant) {
                if (self.ok() && self.pk() == "?") {
                    self.nx()
                    node.lazy = true
                } else {
                    node.lazy = false
                }
            }
        }
        return node
    }

    atom() = {
        if (!self.ok()) throw "Regex Error: Unexpected end of pattern"
        c = self.pk()
        match (c) {
            "(" => {
                self.nx()
                self.gc += 1
                idx = self.gc
                inner = self.alt()
                if (isdict(inner)) inner = @[inner]
                if (!self.ok() || self.pk() != ")") throw "Regex Error: Unmatched '('"
                self.nx()
                return {type: "group", inner: inner, idx: idx}
            },
            "[" => return self.cls(),
            "." => { self.nx(); return {type: "dot"} },
            "^" => { self.nx(); return {type: "start"} },
            "$" => { self.nx(); return {type: "end"} },
            "\\" => {
                self.nx()
                if (!self.ok()) throw "Regex Error: Trailing backslash"
                e = self.nx()
                if (e.isdigit() && e != "0") {
                    num_str = e
                    while (self.ok() && self.pk().isdigit()) { num_str += self.nx() }
                    return {type: "backref", idx: int(num_str)}
                }
                if (e in _RE_SHORTHANDS) return {type: "esc", kind: e}
                return {type: "lit", ch: e}
            },
            _ => {
                if (c in ")*+?") throw f"Regex Error: Unexpected '{c}' at pos {self.p}"
                self.nx()
                return {type: "lit", ch: c}
            }
        }
    }

    cls() = {
        self.nx()
        neg = false
        if (self.ok() && self.pk() == "^") { neg = true; self.nx() }
        specs = @[]
        if (self.ok() && self.pk() == "]") { specs.push({t: "c", v: "]"}); self.nx() }
        
        while (self.ok() && self.pk() != "]") {
            c = self.nx()
            if (c == "\\" && self.ok()) {
                e = self.nx()
                if (e in _RE_SHORTHANDS) specs.push({t: "sh", v: e})
                else specs.push({t: "c", v: e})
            } else if (self.ok() && self.pk() == "-") {
                self.nx()
                if (self.ok() && self.pk() != "]") specs.push({t: "r", lo: c, hi: self.nx()})
                else { specs.push({t: "c", v: c}); specs.push({t: "c", v: "-"}) }
            } else { specs.push({t: "c", v: c}) }
        }
        if (!self.ok()) throw "Regex Error: Unmatched '['"
        self.nx()
        return {type: "class", specs: specs, neg: neg}
    }
}

class _ReCaps {
    init(numGroups: whole) = { 
        self.data = @[]
        for (_ in range(numGroups + 1)) self.data.push([-1, -1])
    }
    set(idx: whole, s: whole, e: whole) = { self.data[idx] = [s, e] }
    getStart(idx: whole) -> whole = self.data[idx][0]
    getEnd(idx: whole) -> whole   = self.data[idx][1]
}

_re_in_class(node: dict, ch: string) -> bool = {
    found = false
    for (spec in node.specs) {
        res = match (spec) {
            {t: "c", v} => ch == v,
            {t: "r", lo, hi} => ch.ord() >= lo.ord() && ch.ord() <= hi.ord(),
            {t: "sh", v} => _re_shorthand(v, ch),
            _ => false
        }
        if (res) {
            found = true
            break
        }
    }
    return node.neg ? !found : found
}

_re_rm_one(node: dict, text: string, pos: whole, tl: whole) -> whole = {
    if (pos >= tl) return -1
    c = text[pos]
    match (node) {
        {type: "lit", ch} => return ch == c ? pos + 1 : -1,
        {type: "dot"} => return c != "\n" ? pos + 1 : -1,
        {type: "esc", kind} => return _re_shorthand(kind, c) ? pos + 1 : -1,
        {type: "class"} => return _re_in_class(node, c) ? pos + 1 : -1,
        _ => return -1
    }
}

_re_rm_single(node: dict, text: string, pos: whole, tl: whole, caps: _ReCaps) -> whole = match (node) {
    {type: "group", inner, idx} => {
        r = _re_rm(inner, 0, text, pos, tl, caps)
        if (r >= 0) caps.set(idx, pos, r)
        return r
    },
    {type: "alt", a, b} => {
        ra = _re_rm(a, 0, text, pos, tl, caps)
        if (ra >= 0) return ra
        return _re_rm(b, 0, text, pos, tl, caps)
    },
    {type: "backref", idx: ref_idx} => {
        if (ref_idx > caps.data.len() - 1) return -1
        s = caps.getStart(ref_idx)
        e = caps.getEnd(ref_idx)
        if (s < 0 || e < 0) return -1
        len = e - s
        if (pos + len > tl) return -1
        if (text[pos : pos + len] == text[s : e]) return pos + len
        return -1
    },
    _ => _re_rm_one(node, text, pos, tl)
}

_re_rm(nodes: list, idx: whole, text: string, pos: whole, tl: whole, caps: _ReCaps) -> whole = {
    if (idx >= nodes.len()) return pos
    node = nodes[idx]
    
    match (node) {
        {type: "_cs", idx: cidx} => {
            caps.set(cidx, pos, -1)
            return _re_rm(nodes, idx + 1, text, pos, tl, caps)
        },
        {type: "_ce", idx: cidx} => {
            caps.set(cidx, caps.getStart(cidx), pos)
            return _re_rm(nodes, idx + 1, text, pos, tl, caps)
        },
        {type: "start"} => return pos == 0 ? _re_rm(nodes, idx + 1, text, pos, tl, caps) : -1,
        {type: "end"} => return pos == tl ? _re_rm(nodes, idx + 1, text, pos, tl, caps) : -1,
        {type: "group", inner, idx: gidx} => {
            comb = @[{type: "_cs", idx: gidx}]
            for (n in inner) comb.push(n)
            comb.push({type: "_ce", idx: gidx})
            for (k in range(idx + 1, nodes.len())) comb.push(nodes[k])
            return _re_rm(comb, 0, text, pos, tl, caps)
        },
        {type: "alt", a, b} => {
            ra = _re_rm(a, 0, text, pos, tl, caps)
            if (ra >= 0) {
                rest = _re_rm(nodes, idx + 1, text, ra, tl, caps)
                if (rest >= 0) return rest
            }
            rb = _re_rm(b, 0, text, pos, tl, caps)
            return (rb >= 0) ? _re_rm(nodes, idx + 1, text, rb, tl, caps) : -1
        },
        {type: "bound", inner, min, max, lazy} => return _re_rm_quant(nodes, idx, text, pos, tl, caps, inner, min, max, lazy),
        {type: "star", inner, lazy} => return _re_rm_quant(nodes, idx, text, pos, tl, caps, inner, 0, -1, lazy),
        {type: "plus", inner, lazy} => return _re_rm_quant(nodes, idx, text, pos, tl, caps, inner, 1, -1, lazy),
        {type: "opt", inner, lazy} => return _re_rm_quant(nodes, idx, text, pos, tl, caps, inner, 0, 1, lazy),
        {type: "backref", idx: ref_idx} => {
            if (ref_idx > caps.data.len() - 1) return -1
            s = caps.getStart(ref_idx)
            e = caps.getEnd(ref_idx)
            if (s < 0 || e < 0) return -1
            len = e - s
            if (pos + len > tl) return -1
            if (text[pos : pos + len] == text[s : e]) {
                return _re_rm(nodes, idx + 1, text, pos + len, tl, caps)
            }
            return -1
        },
        _ => {
            np = _re_rm_one(node, text, pos, tl)
            return (np >= 0) ? _re_rm(nodes, idx + 1, text, np, tl, caps) : -1
        }
    }
}

_re_rm_quant(nodes: list, idx: whole, text: string, pos: whole, tl: whole, caps: _ReCaps, inner: dict, min_v: whole, max_v: whole, lazy: bool) -> whole = {
    positions = @[pos]; cur = pos; count = 0
    while (max_v < 0 || count < max_v) {
        np = _re_rm_single(inner, text, cur, tl, caps)
        if (np < 0 || np == cur) break
        positions.push(np)
        cur = np
        count += 1
    }
    if (lazy) {
        for (k in range(min_v, positions.len())) {
            rest = _re_rm(nodes, idx + 1, text, positions[k], tl, caps)
            if (rest >= 0) return rest
        }
    } else {
        for (k in range(positions.len() - 1, min_v - 1, -1)) {
            rest = _re_rm(nodes, idx + 1, text, positions[k], tl, caps)
            if (rest >= 0) return rest
        }
    }
    return -1
}

// ─── Regex Object (Compiled Pattern) ──────────────────────────

class Regex {
    init(pattern: string) = {
        self.pattern = pattern
        st = _RePS(pattern)
        self.nodes = st.parse()
        self.groups = st.gc
    }

    _run(text: string, startPos: whole) = {
        tl = text.len()
        caps = _ReCaps(self.groups)
        endPos = _re_rm(self.nodes, 0, text, startPos, tl, caps)
        if (endPos < 0) return 0
        
        matched = text[startPos : endPos]
        groups = @[
            caps.getStart(gi) >= 0 && caps.getEnd(gi) >= 0 
                ? text[caps.getStart(gi) : caps.getEnd(gi)] 
                : "" 
            for (gi in range(1, self.groups + 1))
        ]
        
        return ReMatch(matched, startPos, endPos, groups)
    }

    test(text: string) -> bool = {
        tl = text.len()
        for (i in range(tl + 1)) {
            if (_re_rm(self.nodes, 0, text, i, tl, _ReCaps(self.groups)) >= 0) return true
        }
        return false
    }

    matchStart(text: string) = self._run(text, 0)
    
    search(text: string) = {
        for (i in range(text.len() + 1)) { 
            r = self._run(text, i)
            if (r != 0) return r 
        }
        return 0
    }

    findall(text: string) -> list = {
        tl = text.len(); res = @[]; i = 0
        while (i <= tl) {
            m = self._run(text, i)
            if (m != 0) {
                res.push(m.matched)
                i = m.end == m.start ? m.end + 1 : m.end
            } else { i += 1 }
        }
        return res
    }

    subst(text: string, repl: string) -> string = {
        tl = text.len(); res = ""; i = 0
        while (i <= tl) {
            m = self._run(text, i)
            if (m != 0) {
                r = ""; j = 0; rl = repl.len()
                while (j < rl) {
                    ch = repl[j]
                    if (ch == "$" && j + 1 < rl) {
                        nc = repl[j + 1]
                        if (nc.isdigit()) {
                            gi = int(nc)
                            if (gi >= 1 && gi <= m.groups.len()) { r += m.groups[gi - 1] }
                            j += 2; continue
                        }
                        if (nc == "&") { r += m.matched; j += 2; continue }
                    }
                    r += ch; j += 1
                }
                res += r
                i = m.end == m.start ? m.end + 1 : m.end
                if (m.end == m.start && i - 1 < tl) { res += text[i - 1] }
            } else {
                if (i < tl) { res += text[i] }
                i += 1
            }
        }
        return res
    }

    splitBy(text: string) -> list = {
        tl = text.len(); res = @[]; lastEnd = 0; i = 0
        while (i <= tl) {
            m = self._run(text, i)
            if (m != 0 && m.end > lastEnd) {
                res.push(text[lastEnd : m.start])
                lastEnd = m.end
                i = m.end == m.start ? m.end + 1 : m.end
            } else { i += 1 }
        }
        res.push(text[lastEnd : ])
        return res
    }

    __call__(text: string) = self.search(text)

    __str__() = f"Regex(r\"{self.pattern}\")"
}

// ─── Global API (Auto-Compiles or uses cached Regex) ───

compile(pat: string) -> Regex                     = Regex(pat)
_ensure(pat: any) -> Regex                        = isinstance(pat, Regex) ? pat : Regex(str(pat))

test(pat: any, text: string) -> bool              = _ensure(pat).test(text)
matchStart(pat: any, text: string)                = _ensure(pat).matchStart(text)
search(pat: any, text: string)                    = _ensure(pat).search(text)
findall(pat: any, text: string) -> list           = _ensure(pat).findall(text)
subst(pat: any, text: string, rep: string) -> string = _ensure(pat).subst(text, rep)
splitBy(pat: any, text: string) -> list           = _ensure(pat).splitBy(text)

// ─── Dynamic Help Registry ────────────────────────────────────

if (isfunction(__register_help)) {
    __register_help("regex", r"DOC(
═══ Regular Expressions (Standard Library v2.1) ═══

  Requires: import regex

  A pure-JC2 Regex engine based on a recursive backtracking NFA. 
  Supports capture groups, alternation, character classes, and greedy quantifiers.

  Pattern Compilation (Object-Oriented API)
  ──────────────────────
    It is highly recommended to instantiate a Regex object when reusing patterns, 
    as it caches the compiled syntax tree.
    
    r = Regex(r"(\w+) (\d+)")      // Instantiate Regex object
    r.test("Alice 30")             // → true
    m = r.search("Bob 25")         // Returns a ReMatch object
    r("Bob 25")                    // Callable syntax sugar for search()
    m.matched                      // → "Bob 25"
    m.groups[0]                    // → "Bob"
    m.start, m.end                 // → Matching span indices
    
    r.findall("A 1 B 2")           // → ["A 1", "B 2"]
    r.subst("A 1", "$2-$1")        // → "1-A"
    r.splitBy("A 1, B 2")          // Splits by match

  Global Functional API (via namespace)
  ──────────────────────
    regex.compile(pat)            Returns a Regex object.
    regex.test(pat, text)         Returns true if pattern matches anywhere, else false.
    regex.matchStart(pat, text)   Matches exactly at the start of text.
    regex.search(pat, text)       Searches for first match anywhere. Returns ReMatch or 0.
    regex.findall(pat, text)      Returns a List of all matched substrings.
    regex.splitBy(pat, text)      Splits text by pattern, returns a List.
    regex.subst(pat, text, rep)   Replaces matches with `rep` (supports $1, $2, &).

  Supported Syntax
  ──────────────────────
    .             Any character (except newline)
    \d \w \s      Digit, word character (alphanumeric + _), whitespace
    \D \W \S      Negated shorthands
    [abc], [a-z]  Character class and ranges
    [^abc]        Negated character class
    ^  $          Start / End anchors
    *  +  ?       Greedy quantifiers
    *? +? ??      Lazy (non-greedy) quantifiers
    {m,n}         Bounded quantifiers (append ? for lazy)
    (...)         Capturing group
    \1, \2        Backreferences
    |             Alternation (OR)
)DOC")
}
