// collections 标准库冒烟：线性结构 / 哈希结构 / 堆 / 树 + 空结构错误类型。

import collections

test_stack() = {
    s = collections.Stack()
    s.push(1)
    s.push(2)
    assert(s.size() == 2 && !s.isEmpty(), "stack size/empty")
    assert(s.peek() == 2, "stack peek")
    assert(s.pop() == 2 && s.pop() == 1, "stack is LIFO")
    assert(s.isEmpty(), "stack empties after pops")
}
test_stack()

test_queue() = {
    q = collections.Queue()
    q.enqueue("a")
    q.enqueue("b")
    assert(q.peek() == "a", "queue peek")
    assert(q.dequeue() == "a" && q.dequeue() == "b", "queue is FIFO")
    assert(q.isEmpty(), "queue empties after dequeues")
}
test_queue()

test_deque() = {
    d = collections.Deque()
    d.pushLeft(1)
    d.pushRight(2)
    assert(d.popLeft() == 1 && d.popRight() == 2, "deque pops both ends")
    assert(d.isEmpty(), "deque empties")
}
test_deque()

test_counter() = {
    c = collections.Counter(@["a", "b", "a", "c", "a"])
    assert(c.get("a") == 3, "counter counts")
    assert(c.get("z") == 0, "missing key yields 0")
    top = c.mostCommon(2)
    assert(top[0][0] == "a" && top[0][1] == 3, "mostCommon is sorted desc")
}
test_counter()

test_priority_queue() = {
    pq = collections.PriorityQueue()
    for (v in @[3, 1, 4, 1, 5]) { pq.push(v) }
    out = ""
    while (!pq.isEmpty()) { out += str(pq.pop()) }
    assert(out == "11345", "min-heap pops ascending")

    maxpq = collections.PriorityQueue((a, b) => a > b)
    for (v in @[3, 1, 4]) { maxpq.push(v) }
    mo = ""
    while (!maxpq.isEmpty()) { mo += str(maxpq.pop()) }
    assert(mo == "431", "custom comparator inverts heap")
}
test_priority_queue()

test_bst() = {
    bst = collections.BST()
    for (v in @[5, 3, 8, 1, 4]) { bst.insert(v) }
    assert(bst.contains(4), "bst finds inserted")
    assert(!bst.contains(9), "bst rejects missing")
    assert(bst.size() == 5, "bst size counts inserts")
    assert(bst.inorder() == @[1, 3, 4, 5, 8], "inorder is sorted")
}
test_bst()

test_default_dict() = {
    dd = collections.DefaultDict(() => @[])
    dd["x"].push(7)
    assert(dd["x"] == @[7], "factory fills missing key")
    assert("x" in dd, "__contains__ works")
    assert(dd.keys() == @["x"], "keys()")
    assert(dd.values() == @[@[7]], "values()")
}
test_default_dict()

test_empty_structure_errors_are_typed() = {
    caught = false
    try {
        collections.Stack().pop()
    } catch (e) {
        caught = e.type == "IndexError" && e.message == "pop from empty Stack"
    }
    assert(caught, "empty Stack pop raises a typed IndexError")

    caught = false
    try {
        collections.Queue().dequeue()
    } catch (e) {
        caught = e.type == "IndexError" && e.message == "dequeue from empty Queue"
    }
    assert(caught, "empty Queue dequeue raises a typed IndexError")
}
test_empty_structure_errors_are_typed()

test_internals_are_not_exported() = {
    assert(!("TreeNode" in collections), "TreeNode is an internal node type")

    caught = false
    try {
        x = collections.TreeNode
    } catch (e) {
        caught = "not found" in e.message
    }
    assert(caught, "touching the internal node type must fail")

    // 内部实现方法标了 local：外部拿不到
    caught = false
    try {
        collections.PriorityQueue()._siftUp(0)
    } catch (e) {
        caught = "Cannot invoke method" in e.message
    }
    assert(caught, "_siftUp is private")

    caught = false
    try {
        collections.BST()._inorderTraversal(none, @[])
    } catch (e) {
        caught = "Cannot invoke method" in e.message
    }
    assert(caught, "_inorderTraversal is private")
}
test_internals_are_not_exported()

// 标准库错误类（升级后新增的能力；同时锁住 e.type / e.message 的向后兼容）
test_std_error_classes() = {
    s = collections.Stack()

    got = none
    try { s.pop() } catch { e: collections.IndexError => got = e }
    assert(got != none, "typed catch by collections.IndexError")
    assert(isinstance(got, collections.IndexError), "isinstance against the error class")
    assert(isinstance(got, Exception), "error classes extend Exception")
    assert(got.type == "IndexError", "e.type unchanged (non-breaking)")
    assert(got.message == "pop from empty Stack", "e.message unchanged (non-breaking)")

    legacy = none
    try { s.pop() } catch (e) { legacy = e.type }
    assert(legacy == "IndexError", "legacy e.type reading still works")
}

test_std_error_classes()

// Queue/Deque 的摊还 O(1) 改写：与参考模型逐操作比对（顺序 + 长度一致性）
test_queue_deque_model() = {
    q = collections.Queue()
    expect = @[]
    i = 0
    while (i < 60) {
        q.enqueue(i)
        expect.push(i)
        if (i % 3 == 2) {
            assert(q.dequeue() == expect.shift(), "Queue FIFO order at step " + str(i))
        }
        i += 1
    }
    while (expect.len() > 0) {
        assert(q.dequeue() == expect.shift(), "Queue drains in FIFO order")
    }
    assert(q.isEmpty() && q.size() == 0, "Queue empty after drain")

    d = collections.Deque()
    model = @[]
    k = 0
    while (k < 200) {
        if (k % 4 == 0) { d.pushLeft(k); model.prepend(k) }
        else if (k % 4 == 1) { d.pushRight(k); model.push(k) }
        else if (k % 4 == 2) {
            assert(d.popLeft() == model.shift(), "Deque popLeft matches model at " + str(k))
        } else {
            assert(d.popRight() == model.pop(), "Deque popRight matches model at " + str(k))
        }
        assert(d.size() == model.len(), "Deque size matches model at " + str(k))
        k += 1
    }
    // 交替两端的高频场景（针对"折半搬运"的摊还性）
    m = 0
    while (m < 300) {
        d.pushLeft(m)
        model.prepend(m)
        assert(d.popRight() == model.pop(), "alternating left-push/right-pop at " + str(m))
        m += 1
    }
    // clear()：容器清空（原实现误用 list 上不存在的 .clear() 方法，已修正）
    d.clear()
    assert(d.isEmpty(), "Deque cleared")
    q2 = collections.Queue(); q2.enqueue(1); q2.enqueue(2); q2.clear()
    assert(q2.isEmpty(), "Queue cleared")
    s2 = collections.Stack(); s2.push(1); s2.clear()
    assert(s2.isEmpty(), "Stack cleared")
    d.pushLeft(1); d.pushRight(2)
    assert(d.peekLeft() == 1 && d.peekRight() == 2, "Deque usable after clear")
    assert(d.popLeft() == 1 && d.popRight() == 2, "Deque drains after clear")
}

test_queue_deque_model()

// 迭代协议：__iter__ 返回带 __next__ 的迭代器；快照语义、可重复遍历
test_container_iteration() = {
    s = collections.Stack()
    s.push(1); s.push(2); s.push(3)
    got = @[]
    for (x in s) { got.push(x) }
    assert(got == @[3, 2, 1], "Stack iterates top-down: " + str(got))
    again = @[]
    for (x in s) { again.push(x) }
    assert(again == @[3, 2, 1] && s.size() == 3, "Stack iteration is repeatable and non-consuming")

    q = collections.Queue()
    q.enqueue("a"); q.enqueue("b"); q.enqueue("c")
    q.dequeue()
    q.enqueue("d")
    got2 = @[]
    for (x in q) { got2.push(x) }
    assert(got2 == @["b", "c", "d"], "Queue iterates front-to-back across the two stacks: " + str(got2))
    assert(q.size() == 3, "Queue iteration does not dequeue")

    d = collections.Deque()
    d.pushRight(2); d.pushLeft(1); d.pushRight(3)
    got3 = @[]
    for (x in d) { got3.push(x) }
    assert(got3 == @[1, 2, 3], "Deque iterates left-to-right: " + str(got3))

    pq = collections.PriorityQueue()
    pq.push(5); pq.push(1); pq.push(3)
    got4 = @[]
    for (x in pq) { got4.push(x) }
    assert(got4 == @[1, 3, 5], "PriorityQueue iterates in priority order: " + str(got4))
    assert(pq.size() == 3, "PriorityQueue iteration does not pop")

    b = collections.BST()
    b.insert(5); b.insert(3); b.insert(8); b.insert(4)
    got5 = @[]
    for (x in b) { got5.push(x) }
    assert(got5 == @[3, 4, 5, 8], "BST iterates in order: " + str(got5))

    assert(isiterable(s) && isiterable(q) && isiterable(d) && isiterable(pq) && isiterable(b), "isiterable true")
}

test_container_iteration()

// 容器 dunder 与 toList：len / in / str / 结构相等（含顺序与类型敏感）
test_container_dunders() = {
    s = collections.Stack(); s.push(1); s.push(2)
    assert(len(s) == 2, "len(Stack)")
    assert(2 in s, "in finds an element")
    assert(!(9 in s), "in rejects a missing element")
    assert(str(s) == "Stack(size=2)", "str(Stack) = " + str(s))
    assert(s.toList() == @[2, 1], "toList follows iteration order (top-down)")

    s2 = collections.Stack(); s2.push(1); s2.push(2)
    assert(s == s2, "structural equality")
    s3 = collections.Stack(); s3.push(2); s3.push(1)
    assert(!(s == s3), "order matters for equality")
    q = collections.Queue(); q.enqueue(2); q.enqueue(1)
    assert(!(s == q), "different container types are not equal")

    pq = collections.PriorityQueue(); pq.push(5); pq.push(1); pq.push(3)
    assert(len(pq) == 3, "len(PriorityQueue)")
    assert(3 in pq && !(4 in pq), "contains scans the priority-ordered snapshot")
    assert(str(pq) == "PriorityQueue(size=3)", "str(PriorityQueue) = " + str(pq))
    pq2 = collections.PriorityQueue(); pq2.push(1); pq2.push(3); pq2.push(5)
    assert(pq == pq2, "PriorityQueue equality is by priority order, not push order")

    b = collections.BST()
    b.insert(5); b.insert(3); b.insert(8)
    assert(len(b) == 3, "len(BST)")
    assert(3 in b && !(4 in b), "contains(BST)")
    assert(str(b) == "BST(size=3)", "str(BST) = " + str(b))
    assert(b.toList() == @[3, 5, 8], "toList is in-order")

    d = collections.Deque(); d.pushRight(2); d.pushLeft(1)
    assert(len(d) == 2 && (1 in d) && str(d) == "Deque(size=2)", "Deque dunders")
}

test_container_dunders()
