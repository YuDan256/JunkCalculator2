// discrete 标准库冒烟：组合数学 / 命题逻辑 / 关系 / 图 / 真值表 + 类型化错误。

import discrete

test_permutations_and_combinations() = {
    assert(str(discrete.permutations(@[1, 2])) == "@[@[1, 2], @[2, 1]]", "permutations of 2")
    assert(discrete.permutations(@[1, 2, 3]).len() == 6, "permutations of 3")
    assert(str(discrete.combinations(@[1, 2, 3], 2)) == "@[@[1, 2], @[1, 3], @[2, 3]]", "combinations")
    assert(discrete.combinations(@[1, 2], 0) == @[@[]], "k = 0 yields the empty pick")
}
test_permutations_and_combinations()

test_propositional_logic() = {
    p = discrete.Var("p")
    q = discrete.Var("q")
    andpq = p & q
    assert(str(andpq) == "(p & q)", "expression printing")
    assert(andpq.vars() == @{"p", "q"}, "vars() collects symbols")
    assert(andpq.eval({"p": 1, "q": 1}) == 1, "eval true case")
    assert(andpq.eval({"p": 1, "q": 0}) == 0, "eval false case")
    assert((p | (-p)).isTautology(), "p | !p is a tautology")
    assert((p & (-p)).isContradiction(), "p & !p is a contradiction")
    assert((p | q).table().len() == 4, "table() enumerates 2^n rows")
}
test_propositional_logic()

test_relation() = {
    r = discrete.Relation(@{1, 2, 3}, @[@[1, 2], @[2, 3]])
    assert(str(r) == "Relation(|S|=3, |R|=2)", "relation __str__")
    assert(!r.isReflexive(), "not reflexive")
    assert(!r.isTransitive(), "not transitive as given")
    assert(str(r.transitiveClosure()) == "Relation(|S|=3, |R|=3)", "transitive closure grows")
    assert(r(1, 2), "call syntax tests membership")
    assert(!r.hasPair(2, 1), "missing pair")
}
test_relation()

test_graph() = {
    g = discrete.Graph()
    g.addVertex("a")
    g.addVertex("b")
    g.addEdge("a", "b", 5)
    assert(g.hasVertex("a") && !g.hasVertex("c"), "vertex membership")
    assert(g.hasEdge("a", "b") && !g.hasEdge("b", "a"), "directed edge")
    assert(g.getWeight("a", "b") == 5, "edge weight")
    assert(g.topSort() == @["a", "b"], "topological order")
    assert(g.vertices() == @["a", "b"], "vertices()")
}
test_graph()

test_truth_table() = {
    tt = discrete.truthTable(2, (a, b) => a & b)
    assert(tt.len() == 4, "4 rows for 2 variables")
    assert(tt[3]["output"] == 1 && tt[0]["output"] == 0, "conjunction column")
    assert(tt[3]["inputs"] == @[1, 1], "input column")
}
test_truth_table()

test_typed_errors() = {
    caught = false
    try {
        discrete.Relation(@{1, 2}, @[@[1, 2]]).equivalenceClasses()
    } catch (e) {
        caught = e.type == "RelationError"
    }
    assert(caught, "equivalenceClasses requires an equivalence relation")

    caught = false
    try {
        discrete.Graph(true).components()
    } catch (e) {
        caught = e.type == "GraphError"
    }
    assert(caught, "components() requires an undirected graph")
}
test_typed_errors()

test_internal_pair_normalizer_is_private() = {
    r = discrete.Relation(@{1, 2}, @[@[1, 2]])
    caught = false
    try {
        r._mp(1, 2)
    } catch (e) {
        caught = "Cannot invoke method" in e.message
    }
    assert(caught, "_mp is private to Relation")
    assert(r(1, 2), "public membership check still works")
}
test_internal_pair_normalizer_is_private()

// dijkstra（堆版）：手算经典图 + 不可达 + 单点 + 与独立 Floyd-Warshall 差分
test_dijkstra_heap() = {
    g = discrete.Graph(true)
    g.addEdge("a", "b", 4); g.addEdge("a", "c", 2)
    g.addEdge("c", "b", 1); g.addEdge("c", "d", 8)
    g.addEdge("b", "d", 5); g.addEdge("d", "e", 3)
    r = g.dijkstra("a")
    assert(r.dist["a"] == 0, "source distance is 0")
    assert(r.dist["c"] == 2, "a->c = 2")
    assert(r.dist["b"] == 3, "a->c->b = 3 (beats direct 4)")
    assert(r.dist["d"] == 8, "a->c->b->d = 8 (beats a->c->d = 10)")
    assert(r.dist["e"] == 11, "a->c->b->d->e = 11")
    assert(r.prev["b"] == "c", "predecessor of b is c")

    sp = g.shortestPath("a", "e")
    assert(sp.dist == 11 && sp.path.len() == 5, "shortestPath stays consistent")

    // 不可达顶点
    g2 = discrete.Graph(true)
    g2.addEdge(1, 2, 7)
    g2.addVertex(99)
    r2 = g2.dijkstra(1)
    assert(r2.dist[99] is none, "unreachable vertex keeps none")
    assert(g2.shortestPath(1, 99).dist is none, "unreachable path reports none")

    // 单点图
    g3 = discrete.Graph(true); g3.addVertex("x")
    r3 = g3.dijkstra("x")
    assert(r3.dist["x"] == 0, "single vertex distance 0")

    // 差分：与独立实现的 Floyd-Warshall 逐点比对（含等权与多路径）
    g4 = discrete.Graph(true)
    for (e in @[@["s","a",1], @["s","b",4], @["a","b",2], @["a","c",5], @["b","c",1], @["c","d",2], @["b","d",9]]) {
        g4.addEdge(e[0], e[1], e[2])
    }
    vs = g4.vertices().sort()
    n = vs.len()
    INF = 1000000
    M = @[]
    i = 0
    while (i < n) { row = @[]; j = 0; while (j < n) { row.push(i == j ? 0 : INF); j += 1 }; M.push(row); i += 1 }
    idx = (v) => { k = 0; while (k < n) { if (vs[k] == v) return k; k += 1 }; return -1 }
    for (e in g4.edges()) {
        u = idx(e[0]); v = idx(e[1])
        if (e[2] < M[u][v]) { M[u][v] = e[2] }
    }
    k = 0
    while (k < n) {
        i = 0
        while (i < n) {
            j = 0
            while (j < n) { if (M[i][k] + M[k][j] < M[i][j]) { M[i][j] = M[i][k] + M[k][j] }; j += 1 }
            i += 1
        }
        k += 1
    }
    r4 = g4.dijkstra("s")
    si = idx("s")
    t = 0
    while (t < n) {
        want = M[si][t] >= INF ? none : M[si][t]
        got = r4.dist[vs[t]]
        assert(got == want, "dijkstra vs Floyd-Warshall at " + str(vs[t]) + ": " + str(got) + " vs " + str(want))
        t += 1
    }
}

test_dijkstra_heap()

// Graph 算法：Kruskal MST（对拍 Prim 手算）、Floyd–Warshall（对拍 dijkstra）、Bellman–Ford（负权与负环）
test_graph_algorithms() = {
    // 经典 7 顶点图：手算 MST 权为 1+2+2+4+3+5 = 17
    g = discrete.Graph(false)
    for (e in @[@["s","a",4], @["s","b",3], @["a","b",1], @["a","c",2], @["b","c",4],
                @["c","d",2], @["d","e",4], @["b","e",5], @["e","f",6], @["d","f",5]]) {
        g.addEdge(e[0], e[1], e[2])
    }
    mst = g.kruskal()
    assert(mst.components == 1, "graph is connected")
    assert(mst.edges.len() == 6, "MST of 7 vertices has 6 edges")
    assert(mst.weight == 17, "MST weight 17 (hand-computed), got " + str(mst.weight))

    // 非连通图：生成森林
    g2 = discrete.Graph(false)
    g2.addEdge(1, 2, 1); g2.addEdge(3, 4, 2); g2.addVertex(9)
    f = g2.kruskal()
    assert(f.edges.len() == 2 && f.components == 3, "spanning forest on a disconnected graph")

    // Floyd–Warshall 与 dijkstra 逐点对拍（有向、正权）
    g3 = discrete.Graph(true)
    for (e in @[@["s","a",1], @["s","b",4], @["a","b",2], @["a","c",5], @["b","c",1], @["c","d",2], @["b","d",9]]) {
        g3.addEdge(e[0], e[1], e[2])
    }
    fw = g3.floydWarshall()
    assert(!fw.negativeCycle, "no negative cycle")
    dk = g3.dijkstra("s")
    for (v in g3.vertices()) {
        assert(fw.dist["s"][v] == dk.dist[v], "FW vs dijkstra at " + str(v))
    }
    assert(fw.dist["a"]["c"] == 3, "a->b->c = 3 beats the direct edge 5")
    assert(fw.dist["a"]["d"] == 5, "a->b->c->d = 5, got " + str(fw.dist["a"]["d"]))
    assert(fw.dist["d"]["s"] is none, "no path back to the source")

    // Bellman–Ford：负权（dijkstra 不适用）
    g4 = discrete.Graph(true)
    g4.addEdge("s", "a", 4); g4.addEdge("s", "b", 5); g4.addEdge("a", "b", -3); g4.addEdge("b", "t", 2)
    bf = g4.bellmanFord("s")
    assert(!bf.negativeCycle, "no negative cycle here")
    assert(bf.dist["b"] == 1, "s->a->b = 1, got " + str(bf.dist["b"]))
    assert(bf.dist["t"] == 3, "s->a->b->t = 3")
    assert(bf.prev["b"] == "a", "predecessor recorded")

    // 负环检测
    g5 = discrete.Graph(true)
    g5.addEdge("x", "y", 1); g5.addEdge("y", "z", -2); g5.addEdge("z", "x", -1)
    assert(g5.bellmanFord("x").negativeCycle, "negative cycle detected")
    assert(g5.floydWarshall().negativeCycle, "Floyd–Warshall also reports it")

    // 无向图中的负边必然构成负环（来回各走一次），这属于数学事实而非实现缺陷
    g6 = discrete.Graph(false)
    g6.addEdge(1, 2, 3); g6.addEdge(2, 3, -1); g6.addEdge(1, 3, 5)
    bf6 = g6.bellmanFord(1)
    assert(bf6.negativeCycle, "an undirected negative edge is a negative cycle (2->3->2 = -2)")

    // 无向正权：1->2->3 = 4 优于直连 5
    g7 = discrete.Graph(false)
    g7.addEdge(1, 2, 3); g7.addEdge(2, 3, 1); g7.addEdge(1, 3, 5)
    bf7 = g7.bellmanFord(1)
    assert(!bf7.negativeCycle, "no negative cycle with positive weights")
    assert(bf7.dist[3] == 4, "undirected positive: 1->2->3 = 4, got " + str(bf7.dist[3]))
    assert(g7.floydWarshall().dist[1][3] == 4, "Floyd-Warshall agrees on the undirected graph")
}

test_graph_algorithms()

// 强连通分量（Kosaraju）：经典两团 + 桥、DAG、单点、无向图报错、与双向可达一致
test_scc() = {
    g = discrete.Graph(true)
    g.addEdge(1, 2, 0); g.addEdge(2, 3, 0); g.addEdge(3, 1, 0)      // {1,2,3}
    g.addEdge(4, 5, 0); g.addEdge(5, 6, 0); g.addEdge(6, 4, 0)      // {4,5,6}
    g.addEdge(3, 4, 0)                                              // 桥
    comps = g.stronglyConnectedComponents()
    assert(comps.len() == 2, "two SCCs, got " + str(comps.len()))
    sizes = @[]
    for (c in comps) { sizes.push(c.len()) }
    sizes = sizes.sort()
    assert(sizes == @[3, 3], "sizes are 3 and 3, got " + str(sizes))

    // 每个分量内部两两双向可达
    for (c in comps) {
        for (u in c) {
            for (v in c) {
                assert(u == v || (g.findPath(u, v).len() > 0 && g.findPath(v, u).len() > 0), "mutually reachable inside a component")
            }
        }
    }
    // 跨分量不可能双向可达
    assert(g.findPath(1, 6).len() > 0 && g.findPath(6, 1).len() == 0, "one-way across components")

    // DAG：每个顶点自成分量
    d = discrete.Graph(true)
    d.addEdge("a", "b", 0); d.addEdge("b", "c", 0)
    assert(d.stronglyConnectedComponents().len() == 3, "DAG has one SCC per vertex")

    // 单点与孤立点
    s1 = discrete.Graph(true); s1.addVertex("x")
    assert(s1.stronglyConnectedComponents().len() == 1, "single vertex")

    // 无向图不允许
    u = discrete.Graph(false); u.addEdge(1, 2, 1)
    threw = false
    try { u.stronglyConnectedComponents() } catch (e) { threw = true }
    assert(threw, "undirected graphs are rejected")
}

test_scc()

// DPLL 风格搜索：与真值表法逐例对拍（可满足性必须完全一致），并验证返回的赋值确实满足公式
test_prop_dpll_search() = {
    mk = (n) => discrete.Prop("var", n, none)
    a = mk("a"); b = mk("b"); c = mk("c")

    cases = @[
        a,                          // 可满足
        a & -a,                     // 矛盾
        a | -a,                     // 重言
        a.implies(b),               // 可满足
        (a & b) | (-a & c),         // 可满足
        (a | b) & (-a | b) & (a | -b) & (-a | -b),   // 四式合取：矛盾
        a.iff(b),                   // 可满足
        (a.implies(b)) & (b.implies(c)) & a & -c    // 矛盾（传递性）
    ]
    for (f in cases) {
        want = f.isSatisfiable()
        got = f.satisfiableBySearch()
        assert(got.found == want, "search matches the truth table: want " + str(want) + " got " + str(got.found))
        if (got.found) {
            assert(f.eval(got.env) == true, "the returned assignment satisfies the formula")
        }
    }
    assert(!(a & -a).satisfiableBySearch().found, "explicit contradiction is unsatisfiable")
    assert((a | -a).satisfiableBySearch().found, "explicit tautology is satisfiable")

    // 剪枝的效果：矛盾式在大变量数下也应迅速返回
    big = mk("v0") & -mk("v0")
    i = 1
    while (i < 12) { big = big & (mk("v" + str(i)) | -mk("v" + str(i))); i += 1 }
    r = big.satisfiableBySearch()
    assert(!r.found, "a formula containing v0 & !v0 is unsatisfiable regardless of other clauses")

    // 可满足式：应给出满足赋值
    f2 = (mk("x") | mk("y")) & (-mk("x") | mk("z")) & mk("y")
    r2 = f2.satisfiableBySearch()
    assert(r2.found && f2.eval(r2.env) == true, "witness assignment verified")
}
test_prop_dpll_search()

// CNF / DNF：与真值表逐行对拍（每一行赋值下两者取值必须与原公式一致）
test_prop_cnf_dnf() = {
    litSat = (lit, env) => env[lit[0]] != lit[1]
    cnfTrue = (cnf, env) => {
        for (cl in cnf) {
            ok = false
            for (lit in cl) { if (litSat(lit, env)) { ok = true } }
            if (!ok) return false
        }
        return true
    }
    dnfTrue = (dnf, env) => {
        if (dnf.len() == 0) return false
        for (tm in dnf) {
            all = true
            for (lit in tm) { if (!litSat(lit, env)) { all = false } }
            if (all) return true
        }
        return false
    }

    mk = (n) => discrete.Prop("var", n, none)
    a = mk("a"); b = mk("b"); c = mk("c")
    cases = @[a, a & b, a | b, -a, a.implies(b), a.iff(b),
              (a & b) | (-a & c), -(a | b), (a.implies(b)) & (b.implies(c)),
              a | -a,                                  // 重言：CNF 应剪成 @[]（TRUE）
              a & -a,                                  // 矛盾
              -(a & b), -(a | b), -(a.implies(b)), -(a.iff(b)),
              a.iff(b) & b.iff(c) & -(a.iff(c))]       // iff 传递性矛盾（暴露过 iff 取反缺陷）
    for (f in cases) {
        cnf = f.cnf(); dnf = f.dnf()
        for (row in f.table()) {
            assert(cnfTrue(cnf, row.env) == row.result, "CNF agrees with the truth table")
            assert(dnfTrue(dnf, row.env) == row.result, "DNF agrees with the truth table")
        }
    }
    assert((a | -a).cnf().len() == 0, "tautology collapses to an empty CNF")
    assert((a | -a).dnf().len() > 0, "tautology is a non-empty DNF")
    // 矛盾在 CNF 里表现为互补单元子句（本实现不做归结，故不产生空子句）
    cc = (a & -a).cnf()
    assert(cc.len() == 2 && cc[0].len() == 1 && cc[1].len() == 1, "contradiction yields two unit clauses")
    assert(cc[0][0][0] == "a" && cc[1][0][0] == "a" && cc[0][0][1] != cc[1][0][1], "the two units are complementary")
    assert((a & -a).dnf().len() == 0, "contradiction collapses to an empty DNF")
    assert(a.cnf() == @[@[@["a", false]]], "single variable CNF")
    assert((a & b).cnf().len() == 2, "conjunction keeps two clauses")
}
test_prop_cnf_dnf()

// 三方互证：DPLL（子句级）↔ 剪枝搜索 ↔ 真值表 必须完全一致
test_prop_three_way() = {
    mk = (n) => discrete.Prop("var", n, none)
    a = mk("a"); b = mk("b"); c = mk("c")
    cases = @[a, -a, a & b, a | b, a.implies(b), a.iff(b), a & -a, a | -a,
              (a & b) | (-a & c), (a.implies(b)) & (b.implies(c)),
              (a | b) & (-a | b) & (a | -b) & (-a | -b),        // 不可满足
              a.iff(b) & b.iff(c) & -a.iff(c)                   // 不可满足（等价传递）
              ]
    for (f in cases) {
        want = f.isSatisfiable()
        dpll = f.satisfiableDpll()
        search = f.satisfiableBySearch()
        assert(dpll.sat == want, "DPLL agrees with the truth table")
        assert(search.found == want, "search agrees with the truth table")
        if (dpll.sat) assert(f.eval(dpll.env) == true, "DPLL witness satisfies the formula")
        assert(f.isTautology() == !(-f).isSatisfiable(), "isTautology = negation unsatisfiable")
        assert(f.isContradiction() == !want, "isContradiction = unsatisfiable")
    }
    assert((a | -a).isTautology() && !(a & -a).isTautology(), "tautology detection")
    assert((a & -a).isContradiction() && !(a | -a).isContradiction(), "contradiction detection")

    // 剪枝效果：含直接矛盾的公式即便加很多永真子句也应迅速判不可满足
    big = mk("z") & -mk("z")
    i = 1
    while (i < 14) { big = big & (mk("w" + str(i)) | -mk("w" + str(i))); i += 1 }
    assert(big.isContradiction(), "pruning keeps a large contradiction cheap to decide")
}
test_prop_three_way()

// 变量代入：在任意扩充赋值下与原式等价；全代入后必为常量；未代入变量集合正确
test_prop_substitute() = {
    mk = (n) => discrete.Prop("var", n, none)
    a = mk("a"); b = mk("b"); c = mk("c")
    cases = @[a, -a, a & b, a | b, a.implies(b), a.iff(b), (a & b) | (-a & c), a.iff(b) & b.iff(c)]
    for (f in cases) {
        for (row in f.table()) {
            // 取该行赋值的一个真子集做代入，再在整行赋值下比较
            part = {}
            first = true
            for (k in row.env.keys()) { if (first) { part[k] = row.env[k]; first = false } }
            sub = f.substitute(part)
            assert(sub.eval(row.env) == f.eval(row.env), "substitute preserves the value under every extension")
            // 更强的语义性质：代入后该变量再翻转也不影响取值（内联常量 (v|-v)/(v&-v) 仍提到 v，
            // 但它已不再起作用，因此 vars() 不去除它属预期行为）
            for (k in part.keys()) {
                flip = {}
                for (kk in row.env.keys()) { flip[kk] = row.env[kk] }
                flip[k] = !row.env[k]
                assert(sub.eval(flip) == sub.eval(row.env), "substituted variable is semantically irrelevant")
            }
        }
        // 全部变量代入后必为常量（重言或矛盾）
        full = {}
        for (v in toList(f.vars())) { full[v] = true }
        allTrue = f.substitute(full)
        assert(allTrue.isTautology() || allTrue.isContradiction(), "full substitution yields a constant")
    }
    // 具体一例：a & b 代入 a=true 后等价于 b
    r = (a & b).substitute({a: true})
    assert(r.isSatisfiable() && !r.isContradiction(), "a&b with a=true is satisfiable")
    // 代入后公式里仍内联提到 a，故 eval 需要完整赋值；顺带验证 a 已无关
    assert(r.eval({a: true, b: false}) == false && r.eval({a: true, b: true}) == true, "a&b with a=true behaves like b")
    assert(r.eval({a: false, b: true}) == r.eval({a: true, b: true}), "a is irrelevant after substitution")
    r2 = (a & b).substitute({a: false})
    assert(r2.isContradiction(), "a&b with a=false is a contradiction")
    // 代入后 a 翻转不再影响结果（其名仍出现在内联常量里，属预期）
    r3 = (a | b).substitute({a: false})
    assert(r3.eval({a: true, b: false}) == r3.eval({a: false, b: false}), "a is irrelevant after substitution")
}
test_prop_substitute()

// 文本解析：与 str() 互逆（逐行对拍真值表），并覆盖别名、括号与错误输入
test_prop_parse() = {
    mk = (n) => discrete.Prop("var", n, none)
    a = mk("a"); b = mk("b"); c = mk("c")
    cases = @[a, -a, a & b, a | b, a.implies(b), a.iff(b), (a & b) | (-a & c), a.iff(b) & b.iff(c)]
    for (f in cases) {
        text = str(f)
        back = discrete.parseProp(text)
        for (row in f.table()) {
            assert(back.eval(row.env) == row.result, "parse(str(f)) agrees on every row: " + text)
        }
        assert(back.isTautology() == f.isTautology(), "tautology preserved through parse/print")
    }
    // 别名与括号
    x = discrete.parseProp("a -> b")
    assert(x.eval({a: true, b: false}) == false, "'->' is implication")
    y = discrete.parseProp("a <-> b")
    assert(y.isTautology() == false && y.eval({a: true, b: true}) == true, "'<->' is equivalence")
    z = discrete.parseProp("!(a & b) | c")
    assert(z.eval({a: true, b: true, c: false}) == false, "'!' and '&' and '|' together")
    assert(discrete.parseProp("~a").eval({a: true}) == false, "'~' is negation")
    assert(discrete.parseProp("(a)").eval({a: true}) == true, "redundant parentheses")
    assert(discrete.parseProp("a_1 & b2").vars().len() == 2, "identifiers may contain digits after the first char")
    // 优先级：& 比 | 紧
    p1 = discrete.parseProp("a | b & c")
    assert(p1.eval({a: false, b: true, c: false}) == false, "& binds tighter than |")
    // 错误输入
    for (bad in @["", "a &", "(a", "a )", "a $ b"]) {
        threw = false
        try { discrete.parseProp(bad) } catch (e) { threw = true }
        assert(threw, "rejects bad input: " + str(bad))
    }
}
test_prop_parse()

// Relation：定义域/值域/像/原像 与函数性质四问
test_relation_functions() = {
    S = toSet(@[1, 2, 3])
    r = discrete.Relation(S)
    r.addPair(1, 2); r.addPair(2, 3)
    assert(r.domain() == toSet(@[1, 2]), "domain")
    assert(r.range() == toSet(@[2, 3]), "range")
    assert(r.image(toSet(@[1])) == toSet(@[2]), "image of a subset")
    assert(r.preimage(toSet(@[3])) == toSet(@[2]), "preimage of a subset")
    assert(r.isFunction(), "each source has at most one image")
    assert(r.isInjective(), "distinct sources have distinct images")
    assert(!r.isSurjective(), "3 is not in the range")
    assert(!r.isBijective(), "not bijective")

    // 满射：值域覆盖 S（此处 S = {1,2}）
    onto = discrete.Relation(toSet(@[1, 2]))
    onto.addPair(1, 1); onto.addPair(1, 2)
    assert(onto.isSurjective(), "range covers the codomain")
    assert(!onto.isFunction(), "1 maps to both 1 and 2, so it is not a function")

    // 双射：S = {1,2}，1->2，2->1
    bij = discrete.Relation(toSet(@[1, 2]))
    bij.addPair(1, 2); bij.addPair(2, 1)
    assert(bij.isFunction() && bij.isInjective() && bij.isSurjective() && bij.isBijective(), "bijection")

    // 非单射：1->1，2->1
    dup = discrete.Relation(toSet(@[1, 2]))
    dup.addPair(1, 1); dup.addPair(2, 1)
    // 值域是 {1}，不覆盖陪域 S = {1,2}，故既非单射也非满射
    assert(dup.range() == toSet(@[1]), "range of the duplicate-image relation")
    assert(dup.isFunction() && !dup.isInjective() && !dup.isSurjective() && !dup.isBijective(), "not injective, not onto")

    // 空关系
    empty = discrete.Relation(toSet(@[1, 2]))
    assert(empty.domain().len() == 0 && empty.range().len() == 0, "empty relation has empty domain and range")
    assert(empty.isFunction() && empty.isInjective() && !empty.isSurjective(), "empty relation is a function, not onto")
}
test_relation_functions()
