// JC2 标准库错误类型（供各模块 import errors 后使用）
// 语义与升级前的标签写法完全一致：throw errors.HttpError(x) 的 e.type == "HttpError"，
// e.message 即 x（字符串或结构化 dict），因此对既有捕获方与测试是非破坏性升级；
// 额外获得 isinstance(e, errors.HttpError) 与 catch { e: errors.HttpError => ... }。

class HttpError extends Exception {
    init(msg) = { super.init(msg) }
}

class NetworkError extends Exception {
    init(msg) = { super.init(msg) }
}

class GraphError extends Exception {
    init(msg) = { super.init(msg) }
}

class RelationError extends Exception {
    init(msg) = { super.init(msg) }
}

class IndexError extends Exception {
    init(msg) = { super.init(msg) }
}

// ─── Dynamic Help Registry ────────────────────────────────────

const local import sys
try {
    sys.register_help("errors", r"DOC(
═══ Standard Library Error Classes ═══

  Requires: import errors

  The `errors` module holds the error classes thrown by the JC2 standard-library
  modules. All of them extend `Exception`.

  [1] Error Classes
  ──────────────────────
    HttpError        HTTP protocol failures: malformed or truncated response,
                     redirect loops, oversized headers or body.
    NetworkError     Connection closed while reading, socket not connected,
                     TCP server not bound to a port.
    GraphError       Graph algorithm preconditions (directedness, cycles).
    RelationError    Relation and equivalence-class preconditions.
    IndexError       pop / peek / dequeue on an empty container.

  [2] Catching by Type
  ──────────────────────
    import errors

    try { stack.pop() }
    catch { e: errors.IndexError => print("empty container:", e.message) }

    try { http.get(url) }
    catch { e: errors.HttpError => print("http failed:", e.message) }

  [3] Catching Several Classes
  ──────────────────────
    A try block takes a single catch. To branch on several error classes, use one
    handler and test with isinstance:

    try { risky() }
    catch (e) {
        if isinstance(e, errors.HttpError) { print("http:", e.message) }
        else if isinstance(e, errors.NetworkError) { print("net:", e.message) }
    }

  [4] Fields
  ──────────────────────
    e.type           The class name as a string, e.g. "HttpError".
    e.message        The thrown payload, passed through unchanged (a message
                     string for the standard-library modules).
)DOC")
} catch (e) {
    // 运行时未提供帮助注册接口时静默跳过
}
