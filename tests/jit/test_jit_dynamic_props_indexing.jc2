import sys

// ============================================================================
// JIT End-to-End Test: Dynamic Properties & Indexing (Step 98)
// ============================================================================

class Dummy {
    init(v) = { self.val = v }
}

// 1. 字典键值读写测试
test_dict(d, k) = {
    d[k] = d[k] + 1
    return d[k]
}

// 2. 矩阵切片读写测试
test_matrix(ref m) = {
    m[0:2, 0:2] = [9, 9; 9, 9]
    return m[1, 1]
}

// 3. 动态对象属性读写测试
test_obj(o) = {
    o.val = o.val + 1
    return o.val
}

main() = {
    d = {"a": 0}
    m = [1, 2, 3; 4, 5, 6; 7, 8, 9]
    o = Dummy(0)

    // 循环 1500 次，确保触发 Tier 2 JIT 编译 (阈值 1000)
    for (i = 0; i < 1500; i += 1) {
        test_dict(d, "a")
        test_matrix(m)
        test_obj(o)
        
        // 施加 GC 压力，验证 JIT Callout 期间的 Eager Sync 机制是否安全
        if (i % 100 == 0) {
            temp = list(1, 2, 3, 4, 5)
            sys.gc()
        }
    }

    // 验证 JIT 编译后的执行结果是否正确
    assert(d["a"] == 1500, "Dict JIT failed")
    assert(m[1, 1] == 9, "Matrix slice JIT failed")
    assert(o.val == 1500, "Object prop JIT failed")
    
    println("JIT Dynamic Properties & Indexing Test Passed!")
}

main()
