check(name, actual, expected) = {
    assert(str(actual) == str(expected), f"[{name}] Expected {expected}, got {actual}")
}

test_const_params() = {
    try {
        eval("f(const x) = { x = 2 }; f(1)")
        assert(false, "Should throw when modifying const param")
    } catch (e) {
        assert("Cannot modify const variable" in e.message, "Wrong error for const param")
    }
}
test_const_params()

test_destruct_params() = {
    // 测试函数参数直接解构
    get_info(const {name, age=20}) = f"{name} is {age}"
    
    assert(get_info({name: "Bob"}) == "Bob is 20", "Destruct param with default")
    assert(get_info({name: "Charlie", age: 30}) == "Charlie is 30", "Destruct param provided")
}
test_destruct_params()

test_partial_application() = {
    my_add(a, b) = a + b
    add_five = my_add(5, _)
    assert(add_five(10) == 15, "Basic partial application failed")

}
test_partial_application()

// 闭包捕获局部变量。
// 回归：JIT 的 CLOSURE callout 走「变参 callout」约定（首个形参是值数组指针），
// 但 jc2_jit_closure 少声明了这个形参，于是 CodeEmitter 放进 rcx 的数组指针被
// 当成 fnIdx —— 任何捕获局部变量的闭包在 --jit 下都会以
// InternalError: Invalid function index 崩掉（解释器侧则完全正常）。
// 本段在解释器与 --jit 两种模式下都必须给出同样结果（测试套件两种模式都会跑）。
test_closure_capture() = {
    make_adder(n) = {
        add(x) = x + n
        return add
    }
    assert(make_adder(10)(5) == 15, "closure captures a parameter")

    outer(a) = {
        local base = a * 2
        inner(b) = base + b
        return inner
    }
    assert(outer(3)(4) == 10, "closure captures a local")

    // 多个闭包共享同一份捕获环境
    make_pair(n) = {
        inc() = n + 1
        dec() = n - 1
        return @[inc, dec]
    }
    p = make_pair(7)
    assert(p[0]() == 8 && p[1]() == 6, "sibling closures share the capture")

    // 循环里反复建闭包（逼 JIT 编译该函数）
    total = 0
    for (local i = 0; i < 300; i += 1) {
        total += make_adder(i)(1)
    }
    assert(total == 300 + 299 * 300 / 2, "repeated closure creation")
}
test_closure_capture()
