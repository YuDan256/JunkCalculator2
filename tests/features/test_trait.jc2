// Trait 测试套件
// 覆盖 docs/TRAIT_DESIGN.md 的验证点

throws(f) = { try { f(); return false } catch (e) { return true } }

// 1. trait 定义 + 实现 + 默认方法 + isinstance
test_trait_basic() = {
    trait Drawable {
        draw(ctx)
        describe() = "a drawable"
    }

    class Circle with Drawable {
        draw(ctx) = { self.ctx = ctx }
    }

    c = Circle()
    c.draw("test")
    assert(c.ctx == "test", "abstract method implementation failed")
    assert(c.describe() == "a drawable", "default method failed")
    assert(isinstance(c, Drawable), "isinstance with trait failed")
}
test_trait_basic()

// 2. trait 不可实例化
test_trait_instantiation() = {
    trait I { run(x) }
    assert(throws(() => I()), "trait instantiation should throw TypeError")
}
test_trait_instantiation()

// 3. 抽象方法未实现 → 类定义时抛 TypeError
test_trait_abstract_unimplemented() = {
    trait I { run(x) }
    caught = false
    try {
        class C with I {}
    } catch (e) {
        caught = e.type == "TypeError"
    }
    assert(caught, "unimplemented abstract method should throw TypeError")
}
test_trait_abstract_unimplemented()

// 4. 签名不符 → 抛 TypeError（参数个数、参数名、返回类型）
test_trait_signature_mismatch() = {
    trait I { run(x, y) -> int }

    // 参数个数不符
    assert(throws(() => class with I { run(x) -> int = x }), "wrong param count should throw")

    // 参数名不符
    assert(throws(() => class with I { run(a, b) -> int = a }), "wrong param name should throw")

    // 返回类型不符
    assert(throws(() => class with I { run(x, y) -> string = "x" }), "wrong return type should throw")

    // 正确实现
    class C with I { run(x, y) -> int = x + y }
    assert(C().run(1, 2) == 3, "correct implementation failed")
}
test_trait_signature_mismatch()

// 5. 默认方法可选覆盖
test_trait_default_override() = {
    trait I {
        describe() = "default"
    }
    class A with I {}
    class B with I {
        describe() = "override"
    }
    assert(A().describe() == "default", "default method should be used")
    assert(B().describe() == "override", "override should win")
}
test_trait_default_override()

// 5b. 抽象方法带默认值/const/static → trait 定义时抛错（编译期，用 eval 捕获）
test_trait_abstract_invalid() = {
    assert(throws(() => eval("trait I1 { run(x = 1) }")), "abstract method with default param should throw")
    assert(throws(() => eval("trait I2 { const run(x) }")), "abstract method with const should throw")
    assert(throws(() => eval("trait I3 { static run(x) }")), "abstract method with static should throw")
}
test_trait_abstract_invalid()

// 6. 多 trait 组合 + 后覆盖先
test_trait_multi_trait() = {
    trait A { name() = "A" }
    trait B { name() = "B" }
    class C with A, B {}
    class D with B, A {}
    assert(C().name() == "B", "later trait should override (C with A, B)")
    assert(D().name() == "A", "later trait should override (D with B, A)")
}
test_trait_multi_trait()

// 7. trait 组合 trait + 平铺
test_trait_composition() = {
    trait Base { base() = "base" }
    trait Derived with Base { derived() = "derived" }
    class E with Derived {}
    e = E()
    assert(e.base() == "base", "composed trait method failed")
    assert(e.derived() == "derived", "own trait method failed")
    assert(isinstance(e, Base), "flattened ancestor trait isinstance failed")
    assert(isinstance(e, Derived), "direct trait isinstance failed")
}
test_trait_composition()

// 8. 父类已实现抽象方法，子类不实现也算已实现
test_trait_parent_implements() = {
    trait I { run() = "impl" }
    class Parent with I {
        run() = "parent impl"
    }
    class Child extends Parent {}
    assert(Child().run() == "parent impl", "parent implementation should be inherited")
    assert(isinstance(Child(), I), "inherited trait should be recognized")
}
test_trait_parent_implements()

// 9. isinstance 父类 with 的 trait 子类也命中
test_trait_isinstance_inheritance() = {
    trait I { m() = "m" }
    class Parent with I {}
    class Child extends Parent {}
    assert(isinstance(Child(), I), "child should inherit parent's trait")
    assert(isinstance(Parent(), I), "parent should have trait")
}
test_trait_isinstance_inheritance()

// 10. 修饰符 local/const/static 复制
test_trait_modifiers() = {
    trait I {
        local hidden() = "hidden"
        static const MAX = 100
        static get_max() = I.MAX
    }
    class C with I {}
    c = C()
    assert(C.MAX == 100, "static const should be copied")
    assert(C.get_max() == 100, "static method should be copied")
    // ★ static 只住类袋子，实例查找不经过它（docs/OOP_MODEL_DESIGN.md §2.7）。
    assert(throws(() => c.get_max()), "static method should not be reachable from an instance")
    assert(throws(() => c.MAX), "static const should not be reachable from an instance")
    assert(throws(() => c.hidden()), "local method should stay private")
}
test_trait_modifiers()

// 11. trait 字段默认值 + 冻结
test_trait_frozen() = {
    trait I {
        const version = "1.0"
        get_version() = self.version
    }
    class C with I {}
    assert(C().get_version() == "1.0", "trait field should be copied")

    // 冻结后修改成员抛错
    assert(throws(() => { trait J { m() = "m" }; J.x = 1 }), "frozen trait field modification should throw")
    assert(throws(() => { trait K { m() = "m" }; K.m = 2 }), "frozen trait method modification should throw")
}
test_trait_frozen()

// 12. trait 组合 trait：父 trait 的抽象方法由类实现（回归：曾误报未实现）
test_trait_composition_abstract() = {
    trait I { run(x) }
    trait B with I { extra() = "b" }
    class D with B { run(x) = "D" }
    d = D()
    assert(d.run(1) == "D", "class implementation of inherited abstract method failed")
    assert(d.extra() == "b", "composed trait default method failed")
    assert(isinstance(d, I), "inherited abstract trait should be recognized")
}
test_trait_composition_abstract()

// 13. trait 组合 trait：父 trait 的抽象方法由子 trait 默认实现满足
test_trait_composition_default_satisfies() = {
    trait I { run(x) }
    trait B with I { run(x) = "B" }
    class D with B {}
    assert(D().run(1) == "B", "child trait default should satisfy parent abstract method")
}
test_trait_composition_default_satisfies()

// 14. 三层 trait 组合 + 同名方法派生覆盖祖先
test_trait_composition_chain() = {
    trait A { name() = "A" }
    trait B with A { name() = "B" }
    trait C with B { }
    class D with C {}
    assert(D().name() == "B", "derived trait should override ancestor trait default")
    assert(isinstance(D(), A), "3-level flattened ancestor trait isinstance failed")
    assert(isinstance(D(), B) && isinstance(D(), C), "3-level direct trait isinstance failed")

    // 子 trait 无覆盖时沿用祖先默认实现
    trait E with A { extra() = "e" }
    class F with E {}
    assert(F().name() == "A", "ancestor default should be inherited when child does not override")
}
test_trait_composition_chain()

// 15. trait 组合后签名校验仍然生效（错误发生在继承来的抽象方法上）
test_trait_composition_signature() = {
    trait I { run(x, y) -> int }
    trait B with I { extra() = "b" }

    assert(throws(() => class with B { run(x) -> int = x }), "inherited abstract param count should be checked")
    assert(throws(() => class with B { run(a, b) -> int = a }), "inherited abstract param name should be checked")
    assert(throws(() => class with B { run(x, y) -> string = "s" }), "inherited abstract return type should be checked")

    class C with B { run(x, y) -> int = x + y }
    assert(C().run(1, 2) == 3, "valid inherited abstract implementation failed")
    assert(C().extra() == "b", "composed default method should still be copied")
}
test_trait_composition_signature()

// 15b. 默认方法被覆盖时同样要做严格的签名校验
//      回归：原先只有**抽象**方法走签名校验，trait 里的默认方法一旦被覆盖就成了
//      "随便写都行" —— 改参数个数、改参数名、改返回类型、改参数类型全部静默通过。
//      默认方法在 trait 里的签名和抽象方法一样是对外契约，覆盖必须一致。
test_trait_default_override_signature() = {
    trait I { run(x, y) -> int = x + y }

    // ① 类直接组合 trait 后覆盖默认方法
    assert(throws(() => class with I { run(x) -> int = x }), "default override: param count")
    assert(throws(() => class with I { run(a, b) -> int = a }), "default override: param name")
    assert(throws(() => class with I { run(x, y) -> string = "s" }), "default override: return type")
    assert(throws(() => class with I { run(x: string, y: string) -> int = 0 }), "default override: param type")

    // ② 子类覆盖「继承自 trait 的默认方法」（编译顺序是 继承 → 自身成员 → with，
    //    所以这条只能在方法定义处拦，不能靠 applyTrait）
    class Base with I {}
    assert(throws(() => class extends Base { run(x) -> int = x }), "subclass override: param count")
    assert(throws(() => class extends Base { run(a, b) -> int = a }), "subclass override: param name")
    assert(throws(() => class extends Base { run(x, y) -> string = "s" }), "subclass override: return type")
    class Middle extends Base {}
    assert(throws(() => class extends Middle { run(x) -> int = x }), "grandchild override: param count")

    // ③ 派生 trait 覆盖祖先 trait 的默认方法同样受约束
    trait A { g(x) -> int = x }
    assert(throws(() => trait B with A { g() -> int = 1 }), "derived trait override: param count")

    // ④ 签名一致时必须放行，且覆盖确实生效
    class Ok with I { run(x, y) -> int = x * y }
    assert(Ok().run(3, 4) == 12, "matching override should work")
    class Sub extends Base { run(x, y) -> int = x * y }
    assert(Sub().run(3, 4) == 12, "matching subclass override should work")
    class Inherit extends Base {}
    assert(Inherit().run(2, 3) == 5, "no override -> trait default still used")
    trait A2 { g2(x) -> int = x }
    trait B2 with A2 { g2(x) -> int = x * 3 }
    class E with B2 {}
    assert(E().g2(5) == 15, "derived trait default should win when signature matches")

    // ⑤ 普通继承（方法不是来自 trait）覆盖不受影响
    class Plain { f() = "plain" }
    class Plain2 extends Plain { f() = "over" }
    assert(Plain2().f() == "over", "plain override must stay unrestricted")
}
test_trait_default_override_signature()

// 16. trait 定义的 local（私有）方法可从 trait 默认方法内调用
test_trait_private_method() = {
    trait I {
        local hidden() = "h"
        call() = self.hidden()
    }
    class C with I {}
    c = C()
    assert(c.call() == "h", "trait private method should be callable from trait default method")
    assert(throws(() => c.hidden()), "trait private method should stay private")
}
test_trait_private_method()

// 17. trait 私有字段 + 私有方法组合访问
test_trait_private_state() = {
    trait Counter {
        local count = 0
        local bump() = { self.count = self.count + 1; return self.count }
        inc() = self.bump()
    }
    class C with Counter {}
    c = C()
    assert(c.inc() == 1, "trait private state first increment failed")
    assert(c.inc() == 2, "trait private state second increment failed")
    assert(c.inc() == 3, "trait private state third increment failed")
}
test_trait_private_state()

// 18. trait 的 local 成员与类的同名 local 成员互不干扰（各自的私有命名空间）
test_trait_private_namespace_isolation() = {
    trait I {
        local tag() = "trait"
        traitTag() = self.tag()
    }
    class C with I {
        local tag() = "class"
        classTag() = self.tag()
    }
    c = C()
    assert(c.classTag() == "class", "class own method should see class own private")
    assert(c.traitTag() == "trait", "trait method should see trait own private")
    assert(throws(() => c.tag()), "private members should stay private")
}
test_trait_private_namespace_isolation()

// 19. 不同 trait 的同名私有成员按**词法作用域**各自解析（确定性，不依赖哈希顺序）
//     回归：早期实现按 mangled 名后缀模糊匹配，命中哪个取决于哈希表遍历顺序。
test_trait_private_lexical_scope() = {
    trait A {
        local tag() = "A"
        readA() = self.tag()
    }
    trait B {
        local tag() = "B"
        readB() = self.tag()
    }

    // 类未定义同名私有成员：各 trait 的默认方法看到各自 trait 的私有方法
    class C2 with A, B {}
    c2 = C2()
    assert(c2.readA() == "A", "trait A method should see trait A private (A,B order)")
    assert(c2.readB() == "B", "trait B method should see trait B private (A,B order)")

    class C3 with B, A {}
    c3 = C3()
    assert(c3.readA() == "A", "trait A method should see trait A private (B,A order)")
    assert(c3.readB() == "B", "trait B method should see trait B private (B,A order)")

    // 类自身也定义同名私有成员：类的私有归类的，trait 的私有归 trait 的
    class C4 with A, B {
        local tag() = "C"
        readC() = self.tag()
    }
    c4 = C4()
    assert(c4.readC() == "C", "class own method should see class private")
    assert(c4.readA() == "A", "trait A private should stay lexically scoped to A")
    assert(c4.readB() == "B", "trait B private should stay lexically scoped to B")

    // 反复构造仍应稳定（排除依赖容器状态的偶然性）
    for (i = 0; i < 50; i = i + 1) {
        assert(C2().readA() == "A", "private resolution must be stable across instances")
        assert(C2().readB() == "B", "private resolution must be stable across instances")
    }
}
test_trait_private_lexical_scope()

// 21. trait 组合链上的私有方法按词法作用域解析（不做跨作用域兜底）
//     `trait Deep with LA` 的 body 在 LA 被组合进来之前就已编译，其中的 self.tg() 是普通
//     调用，LA 的私有 tg 对它不可见 —— 报错是词法作用域的正确结果，而不是缺陷。
test_trait_private_composed_chain() = {
    trait LA {
        local tg() = "A"
        readA() = self.tg()
    }
    trait Deep with LA {
        readD() = self.tg()
        // 要跨层复用私有逻辑，应在声明它的 trait 体内完成（readA 即如此）
    }

    class LD with Deep {}
    assert(LD().readA() == "A", "leaf trait private via its own body should work")
    assert(throws(() => LD().readD()), "composed-trait method must not see ancestor trait private")

    // 消费者类定义同名私有成员：也不会被跨作用域取用
    class LE with Deep {
        local tg() = "E"
        readOwn() = self.tg()
    }
    assert(LE().readOwn() == "E", "class own method should see class own private")
    assert(LE().readA() == "A", "leaf trait private should stay lexically scoped to LA")
    assert(throws(() => LE().readD()), "class private must not leak into composed-trait method")
}
test_trait_private_composed_chain()

// 22. trait 私有字段跨方法读写 + trait 定义后冻结
test_trait_private_state_across_methods() = {
    trait Counter {
        local hits = 0
        bump() = { self.hits = self.hits + 1; return self.hits }
        peek() = self.hits
    }
    class C with Counter {}
    c = C()
    assert(c.bump() == 1, "trait private field first bump failed")
    assert(c.bump() == 2, "trait private field second bump failed")
    assert(c.peek() == 2, "trait private field should be shared across trait methods")
    assert(throws(() => c.hits), "trait private field should stay private")

    // 冻结：定义后不可增改成员
    assert(throws(() => { trait T { static const X = 1 }; T.X = 2 }), "frozen trait static const should be read-only")
    assert(throws(() => { trait U { m() = "m" }; U.added = 1 }), "frozen trait should reject new members")
}
test_trait_private_state_across_methods()

// 23. 字段默认值初始化：多个 trait 的同名字段各归其主
//     回归：字段初始化器曾统一叫 <init>，按名复制时后组合的 trait 覆盖前一个，
//     导致两个 trait 的同名字段收敛成同一个值（读到 2 2 而不是 1 2）。
test_trait_field_defaults_distinct() = {
    trait F1 { local v = 1; get1() = self.v }
    trait F2 { local v = 2; get2() = self.v }
    class FF with F1, F2 {}
    ff = FF()
    assert(ff.get1() == 1, "trait F1 private field default should stay 1")
    assert(ff.get2() == 2, "trait F2 private field default should stay 2")

    // 反序组合同样各归其主
    class GG with F2, F1 {}
    gg = GG()
    assert(gg.get1() == 1, "reversed composition: F1 field should stay 1")
    assert(gg.get2() == 2, "reversed composition: F2 field should stay 2")

    // 每个实例各自持有一份，修改互不影响
    trait M1 { local n = 0; bump() = { self.n = self.n + 1; return self.n } }
    class MM with M1 {}
    m1 = MM()
    m2 = MM()
    assert(m1.bump() == 1 && m1.bump() == 2, "first instance private counter failed")
    assert(m2.bump() == 1, "second instance should have its own field copy")
}
test_trait_field_defaults_distinct()

// 24. 类自身 init 与 trait 字段默认值共存
//     回归：类写了 init 时，trait 的字段默认值初始化器被 init 覆盖而整个丢失（读字段报未找到）。
test_trait_field_defaults_with_user_init() = {
    trait Seeded { local seeded = 7; getSeed() = self.seeded }
    class C with Seeded {
        init() = { self.tag = "x" }
        getTag() = self.tag
    }
    c = C()
    assert(c.getTag() == "x", "user init body should run")
    assert(c.getSeed() == 7, "trait field default should survive a user-defined init")

    // 字段默认值先于用户 init：init 内可经 trait 的公开方法读到默认值
    // （trait 的 local 字段对消费者类不可见，需由 trait 自己暴露——这是既有的封装边界，
    // 与「trait 私有成员按词法作用域解析」一致）
    trait Base2 { local base = 5; getBase() = self.base }
    class D with Base2 {
        init() = { self.doubled = self.getBase() * 2 }
        getDoubled() = self.doubled
    }
    assert(D().getDoubled() == 10, "field defaults must be ready before user init runs")

    // trait 自己的默认方法内部直接读私有字段
    trait Calc { local n = 3; calc() = self.n * 7 }
    class E with Calc {
        init() = { self.r = self.calc() }
        getR() = self.r
    }
    assert(E().getR() == 21, "trait default method should read own private field")
}
test_trait_field_defaults_with_user_init()

// 25. 字段默认值沿类继承链逐级初始化（且 super.init() 仍可用）
test_field_defaults_inheritance() = {
    class Base { x = 10; getX() = self.x }
    class Mid extends Base { y = 20; getY() = self.y }
    class Leaf extends Mid { z = 30; getZ() = self.z }
    leaf = Leaf()
    assert(leaf.getX() == 10, "grandparent field default missing")
    assert(leaf.getY() == 20, "parent field default missing")
    assert(leaf.getZ() == 30, "own field default missing")

    // 子类 init 里调用 super.init() 不应报「父类没有 <init>」
    class P2 { a = 1; getA() = self.a }
    class C2 extends P2 { init() = { super.init(); self.b = 2 }; getB() = self.b }
    c2 = C2()
    assert(c2.getA() == 1, "parent field default missing when child defines init")
    assert(c2.getB() == 2, "child init body should run after super.init()")
}
test_field_defaults_inheritance()

// 26. trait 组合必须参与全部类型判定，而不只是 isinstance
//     回归：类型从属判定曾在 8 处各写一遍「沿 parent 链做指针比较」，全都漏掉 traits 表，
//     于是 `class B with A` 的实例 isinstance(B(), A) 为 true，却
//     `B <: A` 为 false、`x: A = B()` 抛 TypeError、`B() in A` 为 false——
//     同一件事实在不同入口给出互相矛盾的答案。现在统一走 ObjClass::conformsTo。
test_trait_conformance_everywhere() = {
    trait A { draw(x) }
    trait D with A { extra() }
    class B with A { draw(x) = 1 }
    class B2 with D { draw(x) = 1; extra() = 2 }
    class R extends B { r() = 3 }

    // ① 子类型运算符 <:
    assert(B <: A, "B <: A (direct trait)")
    assert(B2 <: A, "B2 <: A (flattened ancestor trait)")
    assert(B2 <: D, "B2 <: D (direct trait)")
    assert(R <: A, "R <: A (trait inherited through the class chain)")
    assert(A <: A, "trait is a subtype of itself")
    assert(!(A <: B), "A <: B must stay false (conformance is not symmetric)")

    // ② 变量 / 参数 / 返回值标注
    x: A = B()
    assert(x.draw(1) == 1, "B instance usable through an A-typed variable")
    x2: A = R()
    assert(x2.draw(1) == 1, "R instance usable through an A-typed variable")
    take(v: A) = v.draw(1)
    assert(take(B()) == 1, "trait-typed parameter accepts a composing class")
    assert(take(R()) == 1, "trait-typed parameter accepts a subclass of a composing class")
    make() -> A = B()
    assert(make().draw(1) == 1, "trait-typed return accepts a composing class")
    assert(throws(() => { bad: A = 5; }), "non-instance must still fail a trait annotation")

    // ③ 联合类型
    u(v: A | int) = 1
    assert(u(B()) == 1, "union with trait accepts composing class")
    assert(u(3) == 1, "union with trait accepts the other member")
    assert(throws(() => u("s")), "union with trait still rejects unrelated types")

    // ④ 成员测试 in 与 isinstance 必须同口径
    assert(B() in A, "'B() in A' must agree with isinstance")
    assert(isinstance(B(), A), "isinstance with trait")
    assert("draw" in B, "string needle still does member lookup on a class")
    assert(!("nope" in B), "missing member lookup still false")

    // ⑤ match 类型模式
    classify(v) = { match (v) { y: A => "A"; _ => "other" } }
    assert(classify(B()) == "A", "match type pattern with trait")
    assert(classify(5) == "other", "match type pattern with trait rejects non-instances")

    // ⑥ 异常体系也同样适用
    trait Loggable { log() = "logged" }
    class E4 extends Exception with Loggable { }
    assert(E4 <: Loggable, "exception class composing a trait")
    assert(E4 <: Exception, "exception class still derives from Exception")
}
test_trait_conformance_everywhere()
