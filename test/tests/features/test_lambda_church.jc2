// ═══════════════════════════════════════════════════════════════
// Merged battery: lambda_lexical, church_encoding, ref_closure
// ═══════════════════════════════════════════════════════════════

// ── features/test_lambda_lexical.jc2 ─────────────────────────────────────────────
{
throws(f) = {
    try { f(); return false } catch (e) { return true }
}

// self is receiver-only: a lambda does not capture the creation-site self.
test_lambda_self_is_call_site() = {
    class A {
        x = 1
        make() = () => self.x
    }
    f = A().make()
    assert(throws(() => f()), "torn-off lambda has no self")
    assert(A().f() == 1, "dot call supplies the receiver")
}

// A lambda with a lexical class can read that class's private members.
test_lambda_private_lexical() = {
    class A {
        local secret = 7
        local read() = self.secret
        make() = () => self.secret
        makeRead() = () => self.read()
    }
    class B {
        local secret = 9
    }
    f = A().make()
    assert(A().f() == 7, "lambda reads its lexical private field")
    field_msg = false
    try {
        B().f()
    } catch (e) {
        field_msg = e.type == "RuntimeError" &&
                    "not accessible on this receiver" in e.message
    }
    assert(field_msg, "wrong receiver reports private accessibility")

    g = A().makeRead()
    assert(A().g() == 7, "lambda invokes its lexical private method")
    method_msg = false
    try {
        B().g()
    } catch (e) {
        method_msg = e.type == "RuntimeError" &&
                     "not accessible on this receiver" in e.message
    }
    assert(method_msg, "wrong receiver reports private method accessibility")
}

test_lambda_private_assignment() = {
    class A {
        local x = 1
        makeWrite() = () => { self.x = 5; return self.x }
        read() = self.x
    }
    class B {}
    w = A().makeWrite()
    assert(A().w() == 5, "lambda writes its lexical private field")
    assert(A().read() == 5, "write is visible on the same receiver")
    assert(throws(() => B().w()), "lambda must not write another class's private field")
}

test_nested_lambda_lexical_owner() = {
    class A {
        local x = 3
        make() = () => () => self.x
    }
    outer = A().make()
    inner = A().outer()
    assert(A().inner() == 3, "nested lambda inherits the lexical owner")
}

// public fields still follow the dynamic receiver.
test_lambda_public_field_dynamic_receiver() = {
    class A {
        x = 1
        make() = () => self.x
    }
    class B {
        x = 2
    }
    f = A().make()
    assert(B().f() == 2, "public field uses the call-site receiver")
}

test_method_private_does_not_retarget() = {
    class A {
        local x = 1
        get() = self.x
    }
    class B {
        local x = 2
    }
    f = A().get
    assert(A().f() == 1, "method reads its defining class's private")
    assert(throws(() => B().f()), "method must not read B's private")
}

// class keyword is lexical, not the call-site receiver.
test_lambda_class_keyword_lexical() = {
    class A {
        make() = () => class
    }
    f = A().make()
    assert(f() == A, "lambda class is the lexical class")
    class B {}
    assert(B().f() == A, "call-site B does not retarget class")
}

test_top_level_lambda_class() = {
    assert(throws(() => eval("f = () => class; f()")),
        "top-level lambda has no class context")
}

// trait methods keep their own lexical class and private storage.
test_trait_lambda_lexical() = {
    trait T {
        local secret = 10
        make() = () => self.secret
        makeClass() = () => class
    }
    class C with T {
        local secret = 20
    }
    m = C().make()
    assert(C().m() == 10, "trait lambda reads trait private")
    assert(C().makeClass()() == T, "trait lambda class is the trait")
}

// Property lambdas are methods, including static ones.
test_property_lambda_class_context() = {
    class A {
        f = () => class
        static g = () => class
    }
    assert(A().f() == A, "instance property lambda class")
    assert(A.g() == A, "static property lambda class")
}
}

// ── features/test_church_encoding.jc2 ─────────────────────────────────────────────
{
// Church encoding battery: closures, Y combinator, booleans, numerals,
// arithmetic, predecessor and factorial.

True = (t) => (f) => t
False = (t) => (f) => f
If = (c) => (t) => (f) => c(t)(f)

Zero = (f) => (x) => x
One = (f) => (x) => f(x)
Two = (f) => (x) => f(f(x))
Three = (f) => (x) => f(f(f(x)))

Add = (m) => (n) => (f) => (x) => m(f)(n(f)(x))
Mul = (m) => (n) => (f) => (x) => m(n(f))(x)

IsZero = (n) => n((_) => False)(True)

Pred = (n) => (f) => (x) =>
    n((g) => (h) => h(g(f)))((_) => x)((u) => u)

Y = (f) => ((x) => f(() => x(x)))((x) => f(() => x(x)))

Fact = Y((rec) => (n) =>
    If(IsZero(n))
        (() => One)
        (() => Mul(n)(rec()(Pred(n))))
    ()
)

ToInt = (n) => n((x) => x + 1)(0)

// Pointwise addition of two curried binary functions: (* + *) applied to
// Church numerals computes (2*3) + (2*3).
AddFunc = (f) => (g) => (x) => (y) => Add(f(x)(y))(g(x)(y))
StarPlusStar = AddFunc(Mul)(Mul)
assert(ToInt(StarPlusStar(Two)(Three)) == 12, "(* + *) Two Three")

assert(If(True)(1)(2) == 1, "Church True selects the first branch")
assert(If(False)(1)(2) == 2, "Church False selects the second branch")
assert(If(IsZero(Zero))(1)(2) == 1, "IsZero(Zero)")
assert(If(IsZero(One))(1)(2) == 2, "IsZero(One)")

assert(ToInt(Zero) == 0, "decode Zero")
assert(ToInt(One) == 1, "decode One")
assert(ToInt(Two) == 2, "decode Two")
assert(ToInt(Three) == 3, "decode Three")
assert(ToInt(Add(Two)(Three)) == 5, "Church addition")
assert(ToInt(Mul(Two)(Three)) == 6, "Church multiplication")
assert(ToInt(Pred(Three)) == 2, "Church predecessor")
assert(ToInt(Pred(Zero)) == 0, "predecessor of zero")
assert(ToInt(Fact(Zero)) == 1, "0!")
assert(ToInt(Fact(Two)) == 2, "2!")
assert(ToInt(Fact(Three)) == 6, "3!")
}

// ── features/test_ref_closure.jc2 ─────────────────────────────────────────────
{
// A closure may capture a ref parameter and outlive the callee frame.
make(ref x) = { () => x }

a = 1
f = make(a)
a = 99
assert(f() == 99, "global ref captured by closure")

h() = {
    local a = 1
    local f = make(a)
    a = 99
    return f()
}
assert(h() == 99, "local ref captured by closure")

f(ref x) = { x += 1 }
b = 1
f(b)
assert(b == 2, "ref write-through")

bad(ref x) = { throw ValueError("boom") }
try { bad(b) } catch (e) {}
g2(ref x) = { x += 1 }
g2(b)
assert(b == 3, "failed ref call must not pollute the next call")
}
