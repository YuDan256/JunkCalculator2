

test_basic_1d() = {
    @[a, b, c] = @[10, 20, 30]
    assert(a == 10 && b == 20 && c == 30, "1D Array Destructuring Failed")
    @[la, lb] = list("hello", "world")
    assert(la == "hello" && lb == "world", "List Destructuring Failed")
    // 字符串不参与解构：历史遗留的"string 当 char 矩阵"分支已删除
    threw = false
    try { @[s1, s2, s3] = "ABC" } catch (e) { threw = true }
    assert(threw, "String Destructuring should be rejected")
}
test_basic_1d()

test_matrix_2d() = {
    [m1, m2; m3, m4] = [1, 2; 3, 4]
    assert(m1 == 1 && m2 == 2 && m3 == 3 && m4 == 4, "2D Matrix Destructuring Failed")
}
test_matrix_2d()

test_rest_1d() = {
    @[head, ...tail] = @[1, 2, 3, 4]
    assert(head == 1 && tail == @[2, 3, 4], "1D Tail Rest Failed")
    @[first, ...mid, last] = @[1, 2, 3, 4, 5]
    assert(first == 1 && mid == @[2, 3, 4] && last == 5, "1D Middle Rest Failed")
    @[...all] = @[7, 8, 9]
    assert(all == @[7, 8, 9], "1D Full Rest Failed")
}
test_rest_1d()

test_rest_2d() = {
    [tl, ...top_right; ...bottom_rows] = [1, 2, 3; 4, 5, 6; 7, 8, 9]
    assert(tl == 1, "2D Rest TL Failed")
    assert(top_right == [2, 3], "2D Rest Top Right Failed")
    assert(bottom_rows == [4, 5, 6; 7, 8, 9], "2D Rest Bottom Rows Failed")
}
test_rest_2d()

test_dict() = {
    obj = {x: 100, y: 200, z: 300, w: 400}
    {x, y: y_val, ...dict_rest} = obj
    assert(x == 100, "Dict Shorthand Destructuring Failed")
    assert(y_val == 200, "Dict Alias Destructuring Failed")
    assert(dict_rest.z == 300 && dict_rest.w == 400, "Dict Rest Failed")
}
test_dict()

test_complex_lvalues() = {
    arr = @[0, 0]
    target = {val: 0}
    @[arr[0], target.val] = @[99, 88]
    assert(arr[0] == 99 && target.val == 88, "Complex L-Value Destructuring Failed")
}
test_complex_lvalues()

global_counter = 0
test_modifiers() = {
    inner() = {
        @[local a, ref global_counter, state c] = @[10, 20, 30]
        c += 5
        return c
    }
    res1 = inner()
    res2 = inner()
    assert(global_counter == 20, "Ref Modifier Failed")
    assert(res1 == 35 && res2 == 40, "State Modifier Failed")
}
test_modifiers()

test_forin() = {
    sum_keys = ""
    sum_vals = 0
    for (@[k, v] in {A: 1, B: 2, C: 3}) {
        sum_keys += k
        sum_vals += v
    }
    assert(sum_keys == "ABC" && sum_vals == 6, "For-In Dict Destructuring Failed")

    row_sum = 0
    for (@[r1, ...r_rest] in @[@[1, 2, 3], @[4, 5, 6]]) {
        row_sum += r1 + r_rest.sum()
    }
    assert(row_sum == 21, "For-In Matrix Rest Destructuring Failed")
}
test_forin()

test_comprehension() = {
    comp_res = [x * y for (@[x, y] in @[@[1, 2], @[3, 4], @[5, 6]])]
    assert(comp_res == [2, 12, 30], "List Comprehension Destructuring Failed")

    comp_dict = @[k + str(v) for ({k, v} in @[{k: "X", v: 1}, {k: "Y", v: 2}])]
    assert(comp_dict == @["X1", "Y2"], "List Comprehension Dict Destructuring Failed")
}
test_comprehension()

test_match() = {
    match_test(val) = {
        return match (val) {
            [a, b; c, d] => a + d,
            @[head, ...tail] if (head == 99) => tail.sum(),
            {type: t, ...data} => t + str(data.id),
            _ => -1
        }
    }
    assert(match_test([1, 2; 3, 4]) == 5, "Match 2D Failed")
    assert(match_test(@[99, 10, 20]) == 30, "Match 1D Rest + Guard Failed")
    assert(match_test({type: "User", id: 42, active: true}) == "User42", "Match Dict Failed")
    assert(match_test("unknown") == -1, "Match Fallback Failed")
}
test_match()

test_strict_shape() = {
    try { [a, b, c] = [1, 2]; assert(false, "Should fail") } catch (e) {}
    try { [a, b] = [1, 2, 3]; assert(false, "Should fail") } catch (e) {}
    try { [a; b] = [1, 2]; assert(false, "Should fail") } catch (e) {}
}
test_strict_shape()

test_edge_cases() = {
    [] = []
    assert(true, "Empty Matrix Destructuring Failed")
    
    block_res = {
        a = 10
        b = 20
        a + b
    }
    assert(block_res == 30, "Block vs Dict Ambiguity Failed")
}
test_edge_cases()

check(name, actual, expected) = {
    assert(str(actual) == str(expected), f"[{name}] Expected {expected}, got {actual}")
}

test_list_destruct() = {
    @[a, b, ...rest] = @[1, 2, 3, 4, 5]
    assert(a == 1, "List destruct a")
    assert(b == 2, "List destruct b")
    check("List destruct rest", rest, @[3, 4, 5])
    
    // 默认值测试
    @[x, y=10] = @[1]
    assert(x == 1, "List destruct x")
    assert(y == 10, "List destruct default y")
}
test_list_destruct()

test_dict_destruct() = {
    {name, age=18, ...other} = {name: "Alice", city: "Wonderland"}
    assert(name == "Alice", "Dict destruct name")
    assert(age == 18, "Dict destruct default age")
    check("Dict destruct rest", other, {city: "Wonderland"})
}
test_dict_destruct()

test_nested_destruct() = {
    {user: {id, role="guest"}} = {user: {id: 42}}
    assert(id == 42, "Nested destruct id")
    assert(role == "guest", "Nested destruct default role")
}
test_nested_destruct()

test_destruct_const() = {
    try {
        eval("f() = { const {a, b} = {a: 1, b: 2}; a = 10 }; f()")
        assert(false, "Should throw when modifying const destructured variable")
    } catch (e) {
        assert("Cannot modify const variable" in e.message, "Wrong error for const destruct")
    }
}
test_destruct_const()

// 位置解包（list）
test_spread_positional_list() = {
    f(a, ...rest) = a + rest.sum()
    args = @[2, 3, 4]
    assert(f(...args) == 9, "list spread failed")
    assert(f(1, ...args) == 10, "list spread with leading arg failed")
    assert(f(0, ...args, 9) == 18, "mid spread failed")
}
test_spread_positional_list()

// set 解包
test_spread_set() = {
    g(a, b) = a + b
    assert(g(...@{3, 4}) == 7, "set spread failed")
}
test_spread_set()

// 1D matrix 解包
test_spread_matrix() = {
    h(a, b, c) = a * 100 + b * 10 + c
    assert(h(...@[1, 2, 3]) == 123, "matrix spread failed")
}
test_spread_matrix()

// 字符串解包
test_spread_string() = {
    j(a, b, c) = str(a) + str(b) + str(c)
    assert(j(..."abc") == "abc", "string spread failed")
}
test_spread_string()

// 关键字解包（dict，写在 ; 后）
test_spread_keyword() = {
    k(a, b, c) = a * 100 + b * 10 + c
    opts = {b: 2, c: 3}
    assert(k(1; ...opts) == 123, "kw spread failed")
    assert(k(a=1; ...opts) == 123, "kw spread with named arg failed")
}
test_spread_keyword()

// 位置 + 关键字混合解包
test_spread_mixed() = {
    m(a, ...rest; c, ...kw) = a + rest.sum() + c + kw.len()
    args = @[2, 3]
    opts = {x: 5}
    assert(m(...args; c=4, ...opts) == 10, "mixed spread failed")
}
test_spread_mixed()

// 多个位置解包 + 空解包
test_spread_multi_empty() = {
    n(a, b, c, d) = a + b + c + d
    assert(n(...@[1, 2], ...@[3, 4]) == 10, "multi spread failed")
    assert(n(1, 2, ...@[], 3, 4) == 10, "empty spread failed")
}
test_spread_multi_empty()

// 不写分号的关键字传参保持现状
test_spread_no_semicolon() = {
    f(a, b) = a + b
    assert(f(a=1, b=2) == 3, "no semicolon kwargs failed")
}
test_spread_no_semicolon()

// __unpack__ / __mapping__ dunder
test_spread_dunder() = {
    class Pair {
        init(x, y) = { self.x = x; self.y = y }
        __unpack__() = @[self.x, self.y]
        __mapping__() = dict("a", self.x, "b", self.y)
    }
    p = Pair(7, 8)
    g(a, b) = a + b
    assert(g(...p) == 15, "__unpack__ spread failed")
    h(a; b) = a + b
    assert(h(; ...p) == 15, "__mapping__ spread failed")
}
test_spread_dunder()

// 解包错误
test_spread_errors() = {
    f(a, b) = a + b

    try {
        f(...1)
        assert(false, "should throw for non-iterable positional spread")
    } catch (e) {
        assert("positional spread expects" in e.message, "wrong error for positional spread")
    }

    try {
        f(1; ...2)
        assert(false, "should throw for non-dict keyword spread")
    } catch (e) {
        assert("keyword spread expects" in e.message, "wrong error for keyword spread")
    }
}
test_spread_errors()

// 字面量解包（列表/集合/字典）
test_literal_spread() = {
    a = @[1, 2]
    s = @{3, 4}
    d = {x: 1, y: 2}
    assert(@[...a, 5] == @[1, 2, 5], "list literal spread failed")
    assert(@{...s, 9} == @{3, 4, 9}, "set literal spread failed")

    // 字典解包：后者覆盖，显式 key 优先级最高
    d1 = {a: 1, b: 2}
    d2 = {b: 9, c: 3}
    r = {...d1, ...d2}
    assert(r["a"] == 1 && r["b"] == 9 && r["c"] == 3, "dict spread cover failed")
    r2 = {...d1, a: 99}
    assert(r2["a"] == 99 && r2["b"] == 2, "dict spread explicit key priority failed")

    // 字面量里的 __unpack__ / __mapping__ dunder
    class P {
        init(x, y) = { self.x = x; self.y = y }
        __unpack__() = @[self.x, self.y]
        __mapping__() = dict("m", self.x, "n", self.y)
    }
    p = P(7, 8)
    assert(@[...p, 9] == @[7, 8, 9], "list literal __unpack__ failed")
    r3 = {...p, q: 1}
    assert(r3["m"] == 7 && r3["n"] == 8 && r3["q"] == 1, "dict literal __mapping__ failed")
}
test_literal_spread()


test_modifier_conflict() = {
    threw = false
    try {
        eval("local @[ref a] = @[1]")
    } catch (e) {
        threw = true
        assert("modifier conflict" in e.message, "conflict message")
    }
    assert(threw, "mismatched pattern/target modifiers must fail")

    local @[local a] = @[1]
    assert(a == 1, "matching pattern/target modifiers")
}
test_modifier_conflict()


test_atomic_destructuring() = {
    a = 10
    b = 20
    threw = false
    try {
        @[a, b: int] = @[1, "x"]
    } catch (e) {
        threw = true
    }
    assert(threw, "type mismatch must fail")
    assert(a == 10 && b == 20, "failed destructuring must not commit")

    @[a, b = a] = @[1]
    assert(a == 1 && b == 1, "default may read earlier staged target")
}
test_atomic_destructuring()


test_state_targets() = {
    f() = {
        @[state a, state b] = @[1, 2]
        return a + b
    }
    assert(f() == 3, "target state init")
    assert(f() == 3, "target state persists")

    outer = 1
    g() = {
        @[ref outer, state s] = @[7, 8]
        return s
    }
    assert(g() == 8, "ref + state target")
    assert(outer == 7, "ref writes outer")

    bad() = {
        @[ref outer, state s: int] = @[9, "x"]
    }
    threw = false
    try { bad() } catch (e) { threw = true }
    assert(threw, "mixed state/ref failure")
    assert(outer == 7, "failed mixed pattern must not write ref")
}
test_state_targets()


pattern_state_calls = 0
pattern_retry_calls = 0
test_pattern_state() = {
    f() = {
        state @[a, b] = @[ (pattern_state_calls += 1), 2 ]
        return a + b + pattern_state_calls
    }
    assert(f() == 4, "pattern state first")
    assert(f() == 4, "pattern state cached")
    assert(pattern_state_calls == 1, "pattern state expr once")

    bad() = {
        state @[c, d: int] = @[ (pattern_retry_calls += 1), "x" ]
        return c
    }
    threw = 0
    try { bad() } catch (e) { threw += 1 }
    try { bad() } catch (e) { threw += 1 }
    assert(threw == 2, "pattern state retries after failure")
    assert(pattern_retry_calls == 2, "pattern state retry evaluates expr again")

    threw = false
    try {
        eval("f() = { const state @[x, y] = @[1, 2]; x = 9 }")
    } catch (e) {
        threw = true
    }
    assert(threw, "const state pattern is read-only")
}
test_pattern_state()


test_commit_preflight() = {
    a = 1
    f() = { ref @[a, missing] = @[9, 8] }
    threw = false
    try { f() } catch (e) { threw = true }
    assert(threw, "missing ref must fail")
    assert(a == 1, "missing ref must not partially commit")

    threw = false
    try {
        eval("a = 1; const b = 2; f() = { ref @[a, b] = @[9, 8] }; f()")
    } catch (e) {
        threw = true
    }
    assert(threw, "ref to const must fail before writes")
}
test_commit_preflight()


test_complex_lvalue_modifiers() = {
    a = @[0]
    b = @[0]
    @[a[0], b[0]] = @[5, 6]
    assert(a[0] == 5 && b[0] == 6, "plain complex l-values")

    cases = @[
        "a = @[0]; local @[a[0]] = @[5]",
        "a = @[0]; ref @[a[0]] = @[5]",
        "a = @[0]; const @[a[0]] = @[5]",
        "a = @[0]; local @[{k: a[0]}] = @[{k: 5}]",
        "a = @[0]; local @[a[0] = 1] = @[5]",
        "f() = { local a = @[0]; state @[a[0]] = @[5] }"
    ]
    for (src in cases) {
        threw = false
        try { eval(src) } catch (e) { threw = true }
        assert(threw, "modifier on complex l-value must fail: " + src)
    }
}
test_complex_lvalue_modifiers()
