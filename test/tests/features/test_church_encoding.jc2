// Church encoding battery: closures, Y combinator, booleans, numerals,
// arithmetic, predecessor and factorial.

True = (t) => (f) => t
False = (t) => (f) => f
If = (c) => (t) => (f) => c(t)(f)

Zero = (f) => (x) => x
One = (f) => (x) => f(x)
Two = (f) => (x) => f(f(x))
Three = (f) => (x) => f(f(f(x)))

Add = (m) => (n) => (f) => (x) => m(f)(n(f)(x))
Mul = (m) => (n) => (f) => (x) => m(n(f))(x)

IsZero = (n) => n((_) => False)(True)

Pred = (n) => (f) => (x) =>
    n((g) => (h) => h(g(f)))((_) => x)((u) => u)

Y = (f) => ((x) => f(() => x(x)))((x) => f(() => x(x)))

Fact = Y((rec) => (n) =>
    If(IsZero(n))
        (() => One)
        (() => Mul(n)(rec()(Pred(n))))
    ()
)

ToInt = (n) => n((x) => x + 1)(0)

assert(If(True)(1)(2) == 1, "Church True selects the first branch")
assert(If(False)(1)(2) == 2, "Church False selects the second branch")
assert(If(IsZero(Zero))(1)(2) == 1, "IsZero(Zero)")
assert(If(IsZero(One))(1)(2) == 2, "IsZero(One)")

assert(ToInt(Zero) == 0, "decode Zero")
assert(ToInt(One) == 1, "decode One")
assert(ToInt(Two) == 2, "decode Two")
assert(ToInt(Three) == 3, "decode Three")
assert(ToInt(Add(Two)(Three)) == 5, "Church addition")
assert(ToInt(Mul(Two)(Three)) == 6, "Church multiplication")
assert(ToInt(Pred(Three)) == 2, "Church predecessor")
assert(ToInt(Pred(Zero)) == 0, "predecessor of zero")
assert(ToInt(Fact(Zero)) == 1, "0!")
assert(ToInt(Fact(Two)) == 2, "2!")
assert(ToInt(Fact(Three)) == 6, "3!")
