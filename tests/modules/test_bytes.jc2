import bytes

test_bytes_basic() = {
    b = bytes.alloc(16)
    assert(b.len() == 16, "alloc/len failed")
    
    b.set(0, 255, "u8")
    assert(b.get(0, "u8") == 255, "set/get u8 failed")
    
    b.set(1, -128, "i8")
    assert(b.get(1, "i8") == -128, "set/get i8 failed")
    
    b.set(2, 65535, "u16")
    assert(b.get(2, "u16") == 65535, "set/get u16 failed")
    
    b.set(4, 3.14, "f64")
    assert(abs(b.get(4, "f64") - 3.14) < 1e-5, "set/get f64 failed")
}
test_bytes_basic()

test_bytes_pack() = {
    b = bytes.pack([65, 66, 67])
    assert(b.len() == 3, "pack len failed")
    assert(b.get(0, "str", 3) == "ABC", "pack/get str failed")
}
test_bytes_pack()

test_bytes_out_of_bounds() = {
    b = bytes.alloc(4)
    try {
        b.get(2, "u32")
        assert(false, "Should throw out of bounds error")
    } catch (e) {
        assert("out of bounds" in e.message, "Wrong error message thrown")
    }
}
test_bytes_out_of_bounds()

test_bytes_hex() = {
    b = bytes.pack([255, 0, 170])
    hex_str = b.toHex()
    assert(hex_str == "ff00aa", "toHex failed")
    
    b2 = bytes.fromHex("ff00aa")
    assert(b2.len() == 3, "fromHex len failed")
    assert(b2.get(0, "u8") == 255, "fromHex data failed")
    assert(b2.get(2, "u8") == 170, "fromHex data failed")
}
test_bytes_hex()

test_bytes_base64() = {
    b = bytes.pack([72, 101, 108, 108, 111]) // "Hello"
    b64_str = b.toBase64()
    assert(b64_str == "SGVsbG8=", "toBase64 failed")
    
    b2 = bytes.fromBase64("SGVsbG8=")
    assert(b2.len() == 5, "fromBase64 len failed")
    assert(b2.get(0, "str", 5) == "Hello", "fromBase64 data failed")
}
test_bytes_base64()

test_bytes_view() = {
    b = bytes.pack([10, 20, 30, 40, 50])
    v = b.view(1, 3)
    assert(v.len() == 3, "view len failed")
    assert(v.get(0, "u8") == 20, "view read failed")
    assert(v.get(2, "u8") == 40, "view read failed")
    
    // Modify view, check original
    v.set(1, 99, "u8")
    assert(b.get(2, "u8") == 99, "view write to original failed")
    
    // Out of bounds view
    try {
        b.view(4, 5)
        assert(false, "Should throw out of bounds error for view")
    } catch (e) {
        assert("out of bounds" in e.message, "Wrong error message thrown for view")
    }
}
test_bytes_view()

// ─── truncate：按已写长度写出（save 写的是 len()，不是游标）──────────

test_truncate_saves_only_the_used_prefix() = {
    dir = "D:\\Temp\\jc2_truncate\\"
    const local import io
    const local import bytes
    io.mkdir(dir, true)

    b = bytes.alloc(16)
    b.writeStr("abc")
    assert(b.len() == 16, "allocated size before truncate")
    assert(round(b.tell()) == 3, "cursor after writing 3 bytes")

    b.truncate(3)
    assert(b.len() == 3, "size after truncate")
    b.save(dir + "one.bin")
    saved = bytes.fromFile(dir + "one.bin")
    assert(saved.len() == 3, "save writes len() bytes, got " + str(saved.len()))
    assert(saved.toHex() == "616263", "saved bytes are exactly the written prefix")

    // 链式写法：truncate 返回自身
    c = bytes.alloc(8)
    c.writeU8(1)
    c.writeU8(2)
    c.truncate(2).save(dir + "two.bin")
    two = bytes.fromFile(dir + "two.bin")
    assert(two.len() == 2 && two.toHex() == "0102", "chained truncate+save")
}

test_truncate_bounds_and_cursor() = {
    const local import bytes

    b = bytes.alloc(8)
    caught = false
    try {
        b.truncate(9)
    } catch (e) {
        caught = e.type == "BytesError"
    }
    assert(caught, "truncating beyond the current length must fail")

    caught = false
    try {
        b.truncate(-1)
    } catch (e) {
        caught = e.type == "BytesError"
    }
    assert(caught, "negative truncate length must fail")

    // 游标会被夹到新长度，之后写入越界
    d = bytes.alloc(8)
    d.seek(6)
    d.truncate(4)
    assert(d.len() == 4, "size after truncate")
    assert(round(d.tell()) == 4, "cursor clamped to the new length")
    assert(d.isEnd(), "cursor is at the end after clamping")
    caught = false
    try {
        d.writeU8(9)
    } catch (e) {
        caught = e.type == "BytesError"
    }
    assert(caught, "writing past the truncated length must fail")

    // 缩容后原数据保留（前 2 字节还在）
    e = bytes.alloc(8)
    e.writeStr("xy")
    e.truncate(2)
    assert(e.toHex() == "7879", "kept prefix after truncate")

    // view 只缩自己，不影响父缓冲
    f = bytes.alloc(8)
    f.writeStr("abcdefgh")
    v = f.view(2, 4)
    v.truncate(2)
    assert(v.len() == 2, "view size after truncate")
    assert(f.len() == 8, "parent buffer keeps its size")
    assert(f.toHex() == "6162636465666768", "parent contents untouched")
}
test_truncate_saves_only_the_used_prefix()
test_truncate_bounds_and_cursor()
