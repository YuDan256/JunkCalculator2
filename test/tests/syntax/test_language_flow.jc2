// ═══════════════════════════════════════════════════════════════
// Merged battery: control_flow, dict
// ═══════════════════════════════════════════════════════════════

// ── syntax/test_control_flow.jc2 ─────────────────────────────────────────────
{


test_for_in_destruct() = {
    sum = 0
    for (@[k, v] in %{a: 1, b: 2, c: 3}) {
        sum += v
    }
    assert(sum == 6, "for-in dict destruct failed")
    
    // 测试复杂左值在 for-in 中的解构
    obj = %{totals: @[0, 0]}
    for (@[idx, val] in @[@[0, 10], @[1, 20]]) {
        obj.totals[idx] += val
    }
    assert(obj.totals[0] == 10 && obj.totals[1] == 20, "for-in complex lvalue destruct failed")
}
test_for_in_destruct()

test_try_catch_destruct() = {
    try {
        throw %{code: 404, msg: "Not Found"}
    } catch (%{message: %{code, msg}}) {
        assert(code == 404, "catch destruct code")
        assert(msg == "Not Found", "catch destruct msg")
    }
    
    // 测试 catch 匹配失败时的 rethrow
    try {
        try {
            throw %{error: "Fatal"}
        } catch (%{value: %{code}}) {
            assert(false, "Should not match this catch block")
        }
    } catch (e) {
        assert(e.message.error == "Fatal", "Rethrow on catch mismatch failed")
    }
}
test_try_catch_destruct()

test_match_expr() = {
    process(data) = match (data) {
        %{type: "user", id} => f"User {id}"
        %{type: "admin", ..._} => "Admin"
        @[a, b] if (a > b) => "Descending"
        _ => "Unknown"
    }
    
    assert(process(%{type: "user", id: 123}) == "User 123", "Match dict pattern")
    assert(process(%{type: "admin", level: 1}) == "Admin", "Match dict rest pattern")
    assert(process(@[5, 2]) == "Descending", "Match list with guard")
    assert(process("hello") == "Unknown", "Match default")
}
test_match_expr()

check(name, actual, expected) = {
    assert(str(actual) == str(expected), f"[{name}] Expected {expected}, got {actual}")
}

test_list_comp_destruct() = {
    // 字典解构推导
    res1 = @[f"{k}:{v}" for (@[k, v] in %{a: 1, b: 2})]
    assert("a:1" in res1 && "b:2" in res1, "List comp dict destruct failed")
    
    // 列表解构推导带条件
    points = @[@[1, 2], @[3, 4], @[5, 6]]
    res2 = [x + y for (@[x, y] in points) if (x > 2)]
    check("List comp list destruct with condition", res2, [7, 11])
}
test_list_comp_destruct()

test_list_comp_partial() = {
    // 结合偏函数占位符 (顶层参数)
    mul(a, b) = a * b
    funcs = @[mul(x, _) for (x in @[1, 2, 3])]
    res = [f(10) for (f in funcs)]
    check("List comp with partial application", res, [10, 20, 30])
}
test_list_comp_partial()

test_while_loop() = {
    i = 0
    sum = 0
    while (i < 5) {
        i += 1
        if (i == 3) continue
        sum += i
    }
    // 1 + 2 + 4 + 5 = 12
    assert(sum == 12, "While loop with continue failed")
}
test_while_loop()

test_for_loop() = {
    sum = 0
    for (i = 0; i < 5; i += 1) {
        if (i == 3) break
        sum += i
    }
    // 0 + 1 + 2 = 3
    assert(sum == 3, "For loop with break failed")
}
test_for_loop()

test_for_in_loop() = {
    sum = 0
    for (x in @[10, 20, 30]) {
        sum += x
    }
    assert(sum == 60, "For-in loop over list failed")
    
    str_concat = ""
    for (c in "JC2") {
        str_concat += c
    }
    assert(str_concat == "JC2", "For-in loop over string failed")
}
test_for_in_loop()

// 块内的普通赋值绑定到函数作用域，只有 local 留在块内。
test_auto_local_bypasses_block() = {
    f1() = { if (true) a = 1; a }
    assert(f1() == 1, "assignment in an if-branch is visible after the if")

    f2() = { if (true) a = 1 else a = 2; a }
    assert(f2() == 1, "assignment in if/else, true branch")

    f3() = { if (false) a = 1 else a = 2; a }
    assert(f3() == 2, "assignment in if/else, false branch")

    f4(n) = { if (n > 0) a = 7; a }
    assert(f4(1) == 7, "assignment under a non-constant condition")

    f5() = { r = 0; for (i = 0; i < 3; i += 1) { r = r + i }; r }
    assert(f5() == 3, "assignment in a for body")

    f6() = { r = 0; while (r < 4) { r = r + 1 }; r }
    assert(f6() == 4, "assignment in a while body")

    f7() = { if (true) { a = 5 }; a + 1 }
    assert(f7() == 6, "assignment in a braced if body")

    // 对照：local 仍然只在块内可见
    f8() = { if (true) local z = 1; z }
    threw = false
    try { f8() } catch (e) { threw = true }
    assert(threw, "local stays block-scoped")
}
test_auto_local_bypasses_block()
}

// ── syntax/test_dict.jc2 ─────────────────────────────────────────────
{
test_empty_dict() = {
    d1 = %{}
    assert(type(d1) == dict && len(d1) == 0, "Empty dict failed")
}
test_empty_dict()

test_dict_rendering() = {
    d = %{a: 1, "b": 2}
    assert(str(d) == "%{\"a\": 1, \"b\": 2}", "dict str uses %{...}")
    assert(repr(d) == "%{\"a\": 1, \"b\": 2}", "dict repr uses %{...}")
}
test_dict_rendering()

test_standard_dict() = {
    d2 = %{a: 1, b: 2}
    assert(type(d2) == dict && d2.a == 1 && d2.b == 2, "Standard dict failed")
}
test_standard_dict()

test_shorthand_dict() = {
    a = 10
    d3 = %{a}
    assert(type(d3) == dict && d3.a == 10, "Single shorthand dict failed")

    b = 20
    d4 = %{a, b}
    assert(type(d4) == dict && d4.a == 10 && d4.b == 20, "Multiple shorthand dict failed")
}
test_shorthand_dict()

test_block_ambiguity() = {
    f1() = { x = 1; %{x} }
    assert(type(f1()) == dict && f1().x == 1, "Block returning shorthand dict failed")

    f2() = { x = 1; }
    assert(f2() == 1, "Block with semicolon failed")

    f3() = { c = 3 }
    assert(f3() == 3, "Block with assignment failed")

    f4() = { true ? 4 : 5 }
    assert(f4() == 4, "Block with ternary failed")

    f5() = { a = 10; b = 20; a + b }
    assert(f5() == 30, "Block with complex expression failed")

    f6() = { 1, 2 }
    assert(f6() == 2, "Block with comma expression failed")
}
test_block_ambiguity()

test_multiline() = {
    f7() = {
        x = 1
        y = 2
        x + y
    }
    assert(f7() == 3, "Multi-line block failed")

    a = 10
    b = 20
    d5 = %{
        a,
        b
    }
    assert(type(d5) == dict && d5.a == 10 && d5.b == 20, "Multi-line shorthand dict failed")

    f8() = {
        a = 10
        b = 20
    }
    assert(f8() == 20, "Multi-line block with identifiers failed")
}
test_multiline()

test_computed_keys() = {
    d6 = %{"a": 1, "b": 2}
    assert(type(d6) == dict && d6["a"] == 1, "Dict with string keys failed")

    d7 = %{(10): 100}
    assert(type(d7) == dict && d7[10] == 100, "Dict with computed keys failed")

    d8 = %{a: true ? 1 : 2}
    assert(type(d8) == dict && d8.a == 1, "Dict with ternary value failed")

    d9 = %{a: c = 99}
    assert(type(d9) == dict && d9.a == 99 && c == 99, "Dict with assignment value failed")
}
test_computed_keys()

test_destructuring_modifiers() = {
    y = 0
    f9() = {
        %{local x, ref y, const z} = %{x: 1, y: 2, z: 3}
        return x + y + z
    }
    assert(f9() == 6 && y == 2, "Destructuring dict pattern with modifiers failed")
}
test_destructuring_modifiers()


test_get_and_pop() = {
    d = %{"a": 1, "b": 2}
    assert(d.get("a") == 1, "get returns the value")
    assert(d.get("z") == none, "get returns none for a missing key")
    assert(d.get("z", 42) == 42, "get returns the default for a missing key")
    assert(d.size() == 2, "get does not modify the dict")

    assert(d.pop("a") == 1, "pop returns the removed value")
    assert(!d.has("a") && d.size() == 1, "pop removes the key")

    threw = false
    try { d.pop("a") } catch (e) { threw = true }
    assert(threw, "pop throws for a missing key")
}
test_get_and_pop()
}

// ── multiline comprehensions ───────────────────────────────────
test_multiline_comprehensions() = {
    a = @[
        x * 2
        for (local x in @[1, 2])
    ]
    assert(a == @[2, 4], "multiline list comprehension")

    s = @{
        x * 2
        for (local x in @[1, 2])
    }
    assert(s == @{2, 4}, "multiline set comprehension")

    d = %{
        str(x): x * 2
        for (local x in @[1, 2])
    }
    assert(d["1"] == 2 && d["2"] == 4, "multiline dict comprehension")
}
test_multiline_comprehensions()
