

test_for_in_destruct() = {
    sum = 0
    for (@[k, v] in {a: 1, b: 2, c: 3}) {
        sum += v
    }
    assert(sum == 6, "for-in dict destruct failed")
    
    // 测试复杂左值在 for-in 中的解构
    obj = {totals: @[0, 0]}
    for (@[idx, val] in @[@[0, 10], @[1, 20]]) {
        obj.totals[idx] += val
    }
    assert(obj.totals[0] == 10 && obj.totals[1] == 20, "for-in complex lvalue destruct failed")
}
test_for_in_destruct()

test_try_catch_destruct() = {
    try {
        throw {code: 404, msg: "Not Found"}
    } catch ({message: {code, msg}}) {
        assert(code == 404, "catch destruct code")
        assert(msg == "Not Found", "catch destruct msg")
    }
    
    // 测试 catch 匹配失败时的 rethrow
    try {
        try {
            throw {error: "Fatal"}
        } catch ({value: {code}}) {
            assert(false, "Should not match this catch block")
        }
    } catch (e) {
        assert(e.message.error == "Fatal", "Rethrow on catch mismatch failed")
    }
}
test_try_catch_destruct()

test_match_expr() = {
    process(data) = match (data) {
        {type: "user", id} => f"User {id}"
        {type: "admin", ..._} => "Admin"
        @[a, b] if (a > b) => "Descending"
        _ => "Unknown"
    }
    
    assert(process({type: "user", id: 123}) == "User 123", "Match dict pattern")
    assert(process({type: "admin", level: 1}) == "Admin", "Match dict rest pattern")
    assert(process(@[5, 2]) == "Descending", "Match list with guard")
    assert(process("hello") == "Unknown", "Match default")
}
test_match_expr()

check(name, actual, expected) = {
    assert(str(actual) == str(expected), f"[{name}] Expected {expected}, got {actual}")
}

test_list_comp_destruct() = {
    // 字典解构推导
    res1 = @[f"{k}:{v}" for (@[k, v] in {a: 1, b: 2})]
    assert("a:1" in res1 && "b:2" in res1, "List comp dict destruct failed")
    
    // 列表解构推导带条件
    points = @[@[1, 2], @[3, 4], @[5, 6]]
    res2 = [x + y for (@[x, y] in points) if (x > 2)]
    check("List comp list destruct with condition", res2, [7, 11])
}
test_list_comp_destruct()

test_list_comp_partial() = {
    // 结合偏函数占位符 (顶层参数)
    mul(a, b) = a * b
    funcs = @[mul(x, _) for (x in @[1, 2, 3])]
    res = [f(10) for (f in funcs)]
    check("List comp with partial application", res, [10, 20, 30])
}
test_list_comp_partial()

test_while_loop() = {
    i = 0
    sum = 0
    while (i < 5) {
        i += 1
        if (i == 3) continue
        sum += i
    }
    // 1 + 2 + 4 + 5 = 12
    assert(sum == 12, "While loop with continue failed")
}
test_while_loop()

test_for_loop() = {
    sum = 0
    for (i = 0; i < 5; i += 1) {
        if (i == 3) break
        sum += i
    }
    // 0 + 1 + 2 = 3
    assert(sum == 3, "For loop with break failed")
}
test_for_loop()

test_for_in_loop() = {
    sum = 0
    for (x in @[10, 20, 30]) {
        sum += x
    }
    assert(sum == 60, "For-in loop over list failed")
    
    str_concat = ""
    for (c in "JC2") {
        str_concat += c
    }
    assert(str_concat == "JC2", "For-in loop over string failed")
}
test_for_in_loop()
