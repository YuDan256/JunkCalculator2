assert(type(@[].sum()) == int, "empty list sum is int")
assert(@[].sum() == 0, "empty list sum is zero")
assert(type(@{}.sum()) == int, "empty set sum is int")
assert(@{}.sum() == 0, "empty set sum is zero")

assert(@[1, 2].sum() == 3, "integer list sum stays int")
assert(type(@[1, 2].sum()) == int, "integer list sum type")
assert(@[1.0, 2.0].sum() == 3.0, "float list sum stays float")

f(a, ...b; c, ...d) = a + b.sum() + c + size(d)
assert(f(c=3, a=1) == 4, "empty rest sum does not promote to float")
assert(type(f(c=3, a=1)) == int, "empty rest result is int")
