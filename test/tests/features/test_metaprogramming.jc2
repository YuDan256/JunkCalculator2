// ── features/test_macro.jc2 ─────────────────────────────────────────────
{
test_basic_quote() = {
    macro twice(node) = {
        return quote {
            $node
            $node
        }
    }
    
    counter = 0
    @twice { counter += 1 }
    assert(counter == 2, "Basic quote/unquote failed")
}
test_basic_quote()

test_ast_manipulation() = {
    macro swap(node) = {
        match (node) {
            %{type: "Block", statements: stmts} => {
                a = stmts[0]
                b = stmts[1]
                return quote {
                    local temp = $a
                    $a = $b
                    $b = temp
                }
            }
            _ => throw "Expected a block"
        }
    }
    
    x = 10
    y = 20
    @swap { x; y }
    assert(x == 20 && y == 10, "AST manipulation (swap) failed")
}
test_ast_manipulation()

test_quote_returns_ast() = {
    node = quote { 1 + 2 }
    assert(node.type == "Block", "Quote should return ASTNode Block")
    
    bin_op = node.statements[0]
    assert(bin_op.type == "Binary" && bin_op.op == "+", "Quote inner AST structure failed")
    assert(bin_op.left.value == "1" && bin_op.right.value == "2", "Quote inner AST values failed")
}
test_quote_returns_ast()

test_macro_errors() = {
    try {
        eval("macro bad(n) = { return 1 }; @bad { 1 }")
        assert(false, "Should throw when macro doesn't return ASTNode")
    } catch (e) {
        assert("Expected ASTNode instance" in e.message || "did not return a valid ASTNode" in e.message, "Wrong error for invalid macro return")
    }

    try {
        eval("x = 1; $x")
        assert(false, "Should throw when unquote is used outside quote")
    } catch (e) {
        assert("Syntax Error" in e.message, "Wrong error for unquote outside quote")
    }
    
    try {
        eval("macro foo(n) = { return quote { 1 } }; foo(1)")
        assert(false, "Should throw when macro is called as a normal function")
    } catch (e) {
        assert("Undefined" in e.message || "not defined" in e.message, "Wrong error for normal macro call")
    }

    try {
        eval("syntax empty_arg(s) = { x = none; return @[quote { print(1, $x) }] }; @empty_arg {}")
        assert(false, "Should throw when an unquoted none becomes a call argument")
    } catch (e) {
        msg = str(e.message)
        assert("empty argument" in msg || "Macro expansion" in msg, "Wrong error for empty macro argument: " + msg)
    }
}
test_macro_errors()

test_macro_expr_arg() = {
    macro square_macro(node) = {
        return quote {
            $node * $node
        }
    }
    
    res = @square_macro(5 + 2)
    assert(res == 49, "Macro with expression argument failed")
}
test_macro_expr_arg()

test_ast_tamper() = {
    macro tamper(node) = {
        match (node) {
            %{type: "Block", statements: stmts} => {
                bin_op = stmts[0]
                // 把加号强行篡改为乘号
                bin_op.op = "*"
                return quote { $bin_op }
            }
            _ => throw "Expected a block"
        }
    }

    res = @tamper { 2 + 3 }
    assert(res == 6, "AST tampering failed")
}
test_ast_tamper()

test_macro_control_flow() = {
    macro repeat_three(node) = {
        import ast
        i_var = ast.gensym("i")
        return quote {
            for (local $i_var = 0; $i_var < 3; $i_var += 1) {
                $node
            }
        }
    }
    
    count = 0
    @repeat_three { count += 10 }
    assert(count == 30, "Macro generating control flow failed")
}
test_macro_control_flow()

test_macro_generate_function() = {
    macro make_adder(node) = {
        return quote {
            (x) => x + $node
        }
    }
    
    add_five = @make_adder(5)
    assert(add_five(10) == 15, "Macro generating function failed")
}
test_macro_generate_function()

test_no_arg_macro() = {
    macro inject_logger() = {
        return quote {
            logger = (msg) => msg
        }
    }
    
    @inject_logger()
    assert(logger("hello") == "hello", "No-arg macro failed")
    
    @inject_logger
    assert(logger("world") == "world", "No-arg macro without parens failed")
}
test_no_arg_macro()

test_no_arg_macro_safety() = {
    macro get_one() = {
        return quote { 1 }
    }
    
    // 确保无参宏后面的 { 2 } 不会被当作宏参数吃掉
    arr = @[@get_one, { 2 }]
    assert(arr[0] == 1, "No-arg macro safety failed")
}
test_no_arg_macro_safety()

test_multi_arg_macro() = {
    macro repeat(n_node, body_node) = {
        import ast
        i_var = ast.gensym("i")
        return quote {
            for (local $i_var = 0; $i_var < $n_node; $i_var += 1) {
                $body_node
            }
        }
    }
    
    count = 0
    @repeat(3) {
        count += 5
    }
    assert(count == 15, "Multi-arg macro with trailing block failed")
    
    count2 = 0
    @repeat(2, { count2 += 10 })
    assert(count2 == 20, "Multi-arg macro with standard call failed")
}
test_multi_arg_macro()

test_variadic_macro() = {
    macro build_list(...nodes) = {
        return ASTNode("Call", 0, %{
            callee: "list",
            arguments: nodes
        })
    }
    
    res = @build_list(1, 2, 3)
    assert(len(res) == 3 && res[0] == 1 && res[2] == 3, "Variadic macro failed")
    
    res2 = @build_list(10) { 20 }
    assert(len(res2) == 2 && res2[0] == 10 && res2[1] == 20, "Variadic macro with trailing block failed")
}
test_variadic_macro()

test_macro_identifier_unquote() = {
    macro def_memo(func_name, arg_name, body) = {
        import ast
        cache_var = ast.gensym("cache")
        res_var = ast.gensym("res")
        return quote {
            local $cache_var = %{}
            $func_name($arg_name) = {
                if ($arg_name in $cache_var) {
                    return $cache_var[$arg_name]
                }
                local $res_var = $body
                $cache_var[$arg_name] = $res_var
                return $res_var
            }
            none
        }
    }
    
    eval_count = 0
    local my_fib = none
    @def_memo(my_fib, n, {
        ref eval_count += 1;
        if (n <= 1) n else my_fib(n - 1) + my_fib(n - 2)
    })
    
    res = my_fib(10)
    assert(res == 55, "Memoized function returned wrong result")
    assert(eval_count == 11, "Memoized function evaluated too many times")
}
test_macro_identifier_unquote()

test_hygienic_macro() = {
    macro hygienic_swap(a_node, b_node) = {
        import ast
        temp_var = ast.gensym("temp")
        return quote {
            local $temp_var = $a_node
            $a_node = $b_node
            $b_node = $temp_var
        }
    }
    
    temp = 100
    x = 10
    @hygienic_swap(temp, x)
    assert(temp == 10 && x == 100, "Hygienic macro failed")
}
test_hygienic_macro()

test_local_macro_scope() = {
    // 测试局部宏在块级作用域内有效
    res = eval("{ macro local_mac() = quote { 42 }; @local_mac() }")
    assert(res == 42, "Local macro should work inside its scope")
    
    // 测试局部宏不会泄漏到外部作用域
    try {
        eval("@local_mac()")
        assert(false, "Local macro should not leak outside its scope")
    } catch (e) {
        assert("not defined" in e.message || "Undefined" in e.message, "Expected undefined macro error")
    }
}
test_local_macro_scope()

test_macro_shadowing() = {
    macro shadow_mac() = quote { 1 }
    res1 = @shadow_mac()
    assert(res1 == 1, "Global macro should return 1")
    
    res2 = 0
    {
        // 内部作用域定义同名宏，形成遮蔽 (Shadowing)
        macro shadow_mac() = quote { 2 }
        res2 = @shadow_mac()
    }
    assert(res2 == 2, "Local macro should shadow global macro")
    
    // 离开内部作用域后，外部宏恢复可见
    res3 = @shadow_mac()
    assert(res3 == 1, "Global macro should be restored after block")
}
test_macro_shadowing()

test_macro_deletion() = {
    // 定义一个宏然后立即使用 delete @macro 卸载它
    eval("macro temp_mac() = quote { 99 }; delete @temp_mac")
    
    // 验证卸载后该宏不再可用
    try {
        eval("@temp_mac()")
        assert(false, "Deleted macro should not be accessible")
    } catch (e) {
        assert("not defined" in e.message || "Undefined" in e.message, "Expected undefined macro error after deletion")
    }
}
test_macro_deletion()

test_macro_splicing() = {
    macro declare_two() = {
        // 返回一个 List，实现多语句平铺注入（不引入作用域）
        return @[
            quote local splice_a = 100,
            quote local splice_b = 200
        ]
    }
    
    @declare_two()
    assert(splice_a == 100 && splice_b == 200, "Macro list splicing failed")
}
test_macro_splicing()

test_comptime_import() = {
    import io
    // 动态创建一个包含辅助函数和宏的库文件
    lib_code = "make_prefix(name) = \"PREFIX_\" + name\n" +
               "macro generate_var(name) = {\n" +
               "    new_name = make_prefix(name.value)\n" +
               "    return quote local $new_name = 42\n" +
               "}\n"
    f = io.open("temp_macro_lib.jc2", "w")
    f.write(lib_code)
    f.close()
    
    // 在编译期导入该库，并调用宏
    res = eval("import @temp_macro_lib\n@generate_var(\"test\")\nPREFIX_test")
    assert(res == 42, "Compile-time import and execution failed")
    
    io.remove("temp_macro_lib.jc2")
}
test_comptime_import()


// Successful syntax macro expansion and token manipulation.
syntax macro_passthrough(stream) = stream.parse()
syntax macro_one(stream) = stream.parseOne()
syntax macro_plus_to_star(stream) = {
    for (t in stream.tokens()) {
        if (t.type == "PLUS") {
            t.type = "STAR"
            t.lexeme = "*"
        }
    }
    return stream.parse()
}

test_syntax_macros_success() = {
    assert((@macro_passthrough { 1 + 2 }) == 3, "syntax passthrough")
    assert((@macro_one { 5 * 6 }) == 30, "syntax parseOne")
    assert((@macro_plus_to_star { 2 + 3 }) == 6, "syntax token mutation")
}
test_syntax_macros_success()

// Recursive macro expansion and gensym hygiene.
macro fold_plus_macro(node) = {
    match (node) {
        %{type: "Binary", op: "+", left: l, right: r} => {
            return quote @fold_plus_macro($l) * @fold_plus_macro($r)
        }
        _ => node
    }
}

macro gensym_pair() = {
    import ast
    a = ast.gensym("tmp")
    b = ast.gensym("tmp")
    return quote {
        local $a = 1
        local $b = 2
        $a + $b
    }
}

test_recursive_and_gensym_macros() = {
    assert((@fold_plus_macro(6 + 7 + 8)) == 336, "recursive macro expands")
    assert((@gensym_pair()) == 3, "gensym names are distinct")
}
test_recursive_and_gensym_macros()
}

// ── features/test_macros_platform.jc2 ─────────────────────────────────────────────
{
import @macros

result = ""

@windows {
    result = "windows"
}

@linux {
    result = "linux"
}

@macos {
    result = "macos"
}

assert(result != "", "selected platform branch")
}

// ── @lambda: lambda-calculus syntax macro ───────────────────────────────
{
import @macros

id = @lambda { \x. x }
assert(id(7) == 7, "lambda identity")

konst = @lambda { \x. \y. x }
assert(konst(1)(2) == 1, "curried constant")

twice = @lambda { \f. \x. f (f x) }
inc = (n) => n + 1
assert(twice(inc)(3) == 5, "application is left-associative")

three = @lambda { \f. \x. f (f (f x)) }
to_int = (n) => n((x) => x + 1)(0)
assert(to_int(three) == 3, "Church numeral parsed from lambda syntax")
assert(@lambda { (\x. x) 42 } == 42, "numeric literal as an atom")

bad = false
try {
    eval("import @macros; @lambda { \\x y. x }")
} catch (e) {
    bad = true
}
assert(bad, "multi-binder sugar is rejected")
}

// ── features/test_namespace.jc2 ─────────────────────────────────────────────
{
test_namespace_basic() = {
    namespace MathUtils {
        const PI_APPROX = 3.14
        add(a, b) = a + b
        local hidden = 42
    }
    
    assert(MathUtils.PI_APPROX == 3.14, "Namespace const access failed")
    assert(MathUtils.add(2, 3) == 5, "Namespace method call failed")
    assert(!("hidden" in MathUtils), "Namespace local hiding failed")
}
test_namespace_basic()

test_namespace_dynamic() = {
    namespace Dyn {}
    
    Dyn.val = 100
    assert(Dyn.val == 100, "Namespace dynamic assignment failed")
    
    Dyn.mul = (x) => x * 2
    assert(Dyn.mul(5) == 10, "Namespace dynamic method failed")
}
test_namespace_dynamic()

test_namespace_freeze() = {
    namespace Locked {
        val = 1
    }
    freeze(Locked)
    
    caught = false
    try {
        Locked.val = 2
    } catch (e) {
        caught = true
    }
    assert(caught, "Namespace freeze failed to protect")
}
test_namespace_freeze()

test_anonymous_namespace_and_self_ref() = {
    const Factory = namespace {
        val = 42
        
        // 返回命名空间自身
        get_self() = namespace
        
        // 动态向自身挂载属性
        register(k, v) = {
            namespace[k] = v
        }
    }
    
    assert(Factory.val == 42, "Anonymous namespace property access failed")
    assert(Factory.get_self() == Factory, "The 'namespace' keyword should evaluate to the namespace itself")
    
    Factory.register("dynamic_field", 100)
    assert(Factory.dynamic_field == 100, "Self-reference mutation failed")
}
test_anonymous_namespace_and_self_ref()

// 命名空间字段未命中 → 兜底到同名全局内建函数时，接收者不得占实参位。
// 回归：cas.sin(10) 曾调用 sin(<namespace cas>, 10) → args[0].asFloat() 抛
// "Expected a real number."；只有该全局名被物化后（先写过 sin(10)）才碰巧走对分支。
import cas

test_namespace_falls_back_to_global_builtin() = {
    assert(cas.sin(10) == sin(10), "cas.sin(10) must match the global sin(10)")
    assert(cas.cbrt(27) == 3, "cas.cbrt(27) must be 3")
    assert(cas.asinh(0) == 0, "cas.asinh(0) must be 0")
    assert(cas.trunc(2.7) == 2, "cas.trunc(2.7) must be 2")
    assert(cas.abs(-3) == 3, "cas.abs(-3) must be 3")
}
test_namespace_falls_back_to_global_builtin()

test_namespace_builtin_fallback_keeps_arity_check() = {
    caught = false
    try {
        cas.sin()
    } catch (e) {
        caught = "expects 1 arguments" in e.message
    }
    assert(caught, "the fallback still enforces arity")
}
test_namespace_builtin_fallback_keeps_arity_check()

test_anonymous_namespace_postfix() = {
    assert(namespace "AnonNs" { n = 3 }.n == 3, "anonymous namespace postfix")
}
test_anonymous_namespace_postfix()

test_anonymous_enum_postfix() = {
    assert(enum "AnonEnum" { A, B }.A == 0, "anonymous enum postfix A")
    assert(enum "AnonEnum2" { A, B }.B == 1, "anonymous enum postfix B")
}
test_anonymous_enum_postfix()
}

// ── features/test_namespace_export.jc2 ─────────────────────────────────────────────
{
namespace A {
    a = 1
    include namespace { b = 2 }
}
assert(A.a == 1, "namespace own member")
assert(A.b == 2, "include into namespace")

namespace O {
    namespace I {
        include namespace { x = 3 }
    }
}
assert(O.I.x == 3, "nested namespace include")

namespace C {
    include namespace D { e = 1 }
}
assert(C.e == 1, "include named namespace contents")
assert(C.D.e == 1, "include named namespace binding")


f(flag) = {
    if (flag) include namespace { x = 1 }
    else include namespace { y = 2 }
}
namespace C { f(true) }
assert(C.x == 1, "conditional include true branch")
namespace D { f(false) }
assert(D.y == 2, "conditional include false branch")
}

// ── features/test_namespace_include.jc2 ─────────────────────────────────────────────
{
// Include merge must not partially mutate on conflict.
caught = false
try {
    namespace Bad {
        include namespace { a = 1 }
        include namespace { a = 2 }
        c = 3
    }
} catch (e) {
    caught = true
    assert("Include conflict" in e.message, "include conflict message")
}
assert(caught, "include conflict must throw")

namespace Good {
    include namespace { a = 1 }
    include namespace { b = 2 }
    c = 3
}
assert(Good.a == 1 && Good.b == 2 && Good.c == 3, "include success")

// A failed namespace construction must not leave a pending include context.
try {
    namespace Leak {
        include namespace { x = 1 }
        throw ValueError("boom")
    }
} catch (e) {}

leaked = false
try {
    include namespace { y = 2 }
} catch (e) {
    leaked = true
}
assert(leaked, "pending namespace context must be cleaned")

// 	ry include import math must still bind math in the namespace.
namespace WithTry {
    try include import math
}
assert(WithTry.math != none, "try include import binds math")

// local import must stay local even inside try/include.
namespace WithLocal {
    try include local import math
}
assert(!("math" in getFields(WithLocal)), "local import must not become a field")
assert(WithLocal.PI != none, "include still merges math fields")

// Private fields stay private; const fields keep their constness.
namespace ConstSrc {
    const c = 1
    local hidden = 2
    vis = 3
    get() = hidden
}
namespace ConstDst {
    include ConstSrc
}
assert(ConstDst.c == 1, "include copies const field")
assert(ConstDst.vis == 3, "include copies public field")
assert(ConstDst.get() == 2, "include keeps closure over private field")
assert(!("hidden" in getFields(ConstDst)), "include does not copy private field")
threw = false
try { ConstDst.c = 9 } catch (e) { threw = true }
assert(threw, "included const field remains read-only")

// A direct namespace field must not overwrite an included member.
try {
    namespace BadBefore {
        c = 1
        include ConstSrc
    }
    assert(false, "direct field before include must conflict")
} catch (e) {
    assert("Include conflict" in e.message, "direct-before conflict message")
}
try {
    namespace BadAfter {
        include ConstSrc
        c = 1
    }
    assert(false, "direct field after include must conflict")
} catch (e) {
    assert("Include conflict" in e.message, "direct-after conflict message")
}

// Namespace functions are lexical closures: exported x is the final value,
// but later N.x writes do not rewrite the captured binding.
namespace Lex {
    x = 1
    f() = x
    x = 2
}
assert(Lex.x == 2, "namespace exports captured final value")
assert(Lex.f() == 2, "namespace function sees captured value")
Lex.x = 5
assert(Lex.f() == 2, "namespace function keeps lexical capture")
}
