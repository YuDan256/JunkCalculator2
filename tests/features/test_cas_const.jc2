import cas
import math

// ── 符号常量：cas.pi() / cas.e() / cas.i() ──
// 全局 pi()/e() 保持浮点（数值代码不受影响），符号场景走 cas 命名空间的工厂。
// 常量是独立的 SymType::CONST 节点，不是普通变量，因此不会被同名用户符号冒充。

test_const_display() = {
    assert(str(cas.pi()) == "pi", "cas.pi() should print as pi")
    assert(str(cas.e()) == "e", "cas.e() should print as e")
    assert(str(cas.i()) == "i", "cas.i() should print as i")
}
test_const_display()

test_const_symbolic_arithmetic() = {
    // 保持符号性，不被折叠成浮点
    assert(str(2 * cas.pi()) == "2 * pi", "2*pi should stay symbolic")
    assert(str(cas.pi() + cas.pi()) == "2 * pi", "pi+pi should be 2*pi")
    assert(str(cas.e() * cas.e()) == "e^2", "e*e should be e^2")
}
test_const_symbolic_arithmetic()

test_imaginary_unit_exact() = {
    // i 的整数次幂必须精确折叠（曾落到复数浮点路径，得到 -1.0 + 1.22e-16i）
    assert(cas.i() ^ 1 == cas.i(), "i^1 = i")
    assert(cas.i() ^ 2 == -1, "i^2 = -1")
    assert(cas.i() ^ 3 == -cas.i(), "i^3 = -i")
    assert(cas.i() ^ 4 == 1, "i^4 = 1")
    assert(cas.i() ^ 0 == 1, "i^0 = 1")
}
test_imaginary_unit_exact()

test_const_numeric_value() = {
    // 常量仍能数值化。注意两条通道的不同：
    //   evalf 走 double/Complex，能把常量（含 i）解析成数值；
    //   evalv 走精确保值通道，其载体 CASVal 不含复数，i 保持符号。
    assert(cas.evalv(cas.pi()) > 3.14159 && cas.evalv(cas.pi()) < 3.1416, "evalv(pi) approx")
    assert(cas.evalv(cas.e()) > 2.71828 && cas.evalv(cas.e()) < 2.71829, "evalv(e) approx")
    // i 的整数幂在符号层就折成精确值，所以 evalv 拿到的是实数 -1
    assert(cas.evalv(cas.i() ^ 2) == -1, "evalv(i^2) = -1")
    // 但裸的 i 本身没有精确保值通道，evalv 只能原样返回符号
    assert(str(cas.evalv(cas.i())) == "i", "evalv(i) stays symbolic (CASVal has no complex)")
    // evalf 才有复数通道
    assert(str(cas.evalf(cas.i() * 2)) == "2.0i", "evalf(i*2) = 2.0i")
    assert(str(cas.evalf(cas.i() ^ 2)) == "-1.0", "evalf(i^2) = -1.0")
}
test_const_numeric_value()

test_symbolic_numbers_survive_the_vm_boundary() = {
    // ★ 回归：符号层的数值结果（SymNum）不再在 Value(SymExpr) 边界被拆成
    //   原生 int/float/BigInt/Fraction。曾在此降级，于是每个 CAS 出口都掉类型：
    //   cas.diff(x,x) → int 1。而数学函数的符号捕获判据是"参数是否 symbolic"，
    //   掉成原生值后再喂回去（exp(cas.diff(x,x))）就走数值分支变成浮点，
    //   精确形式再也拿不回来。
    x = sym("x")

    d = cas.diff(x, x)
    assert(str(d) == "1", "the value still prints as 1")
    assert(type(d) == symbolic, "but it stays symbolic")

    // 关键收益：纯常数结果喂回数学函数时保持精确
    assert(str(exp(cas.diff(x, x))) == "exp(1)", "exp of a symbolic constant stays exact")
    assert(str(sin(cas.diff(x, x))) == "sin(1)", "sin of a symbolic constant stays exact")
    assert(type(exp(cas.diff(x, x))) == symbolic, "and the result is symbolic")

    // 含变量的表达式不受影响
    assert(str(cas.diff(x ^ 2, x)) == "2 * x", "variable expressions unchanged")
    assert(type(cas.diff(x ^ 2, x)) == symbolic, "and stay symbolic")

    // 整族出口口径一致（含 subs，它曾额外单独降级）
    assert(type(cas.simplify(x - x)) == symbolic, "simplify of a constant is symbolic")
    assert(type(cas.limit(1 / x, x, 1)) == symbolic, "limit of a constant is symbolic")
    assert(type(cas.subs(x, x, 5)) == symbolic, "subs of a constant is symbolic")
}
test_symbolic_numbers_survive_the_vm_boundary()

test_symbolic_numbers_compare_and_hash_like_numbers() = {
    // ★ 回归：符号数值必须能与原生数值互操作，否则新语义不可用。
    //   两条不变量：
    //     1) 跨类型相等：cas.diff(x,x) == 1 必须为 true（打印是 1，不等于 1 是坑）
    //     2) 相等 ⇒ 等哈希：否则 dict/set 混用符号值与原生值时查不到
    x = sym("x")
    d = cas.diff(x, x)

    // ① 跨类型相等（两个方向）
    assert((cas.i() ^ 2) == -1, "symbolic -1 equals native -1")
    assert(d == 1, "symbolic 1 equals native 1")
    assert(1 == d, "and the comparison is symmetric")
    assert(!(d == 2), "different values still differ")
    assert(cas.simplify(x - x) == 0, "symbolic 0 equals native 0")

    // ② 相等 ⇒ 等哈希
    assert(hash(d) == hash(1), "equal values must hash equally (int)")
    assert(hash(d) == hash(1.0), "equal values must hash equally (float)")

    // ③ dict / set 双向混用
    m = {}
    m[d] = "v"
    assert(m[cas.diff(x, x)] == "v", "symbolic key, symbolic lookup")
    assert(m[1] == "v", "symbolic key, native lookup")
    n = {}
    n[1] = "w"
    assert(n[d] == "w", "native key, symbolic lookup")

    assert(1 in toSet(@[d]), "native value found in a set of a symbolic number")
    assert(d in toSet(@[1]), "symbolic value found in a set of a native number")
}
test_symbolic_numbers_compare_and_hash_like_numbers()

test_global_pi_e_stay_float() = {
    // 全局工厂函数保持浮点语义
    assert(pi() > 3.14159 && pi() < 3.1416, "pi() stays float")
    assert(e() > 2.71828 && e() < 2.71829, "e() stays float")
    assert(abs(pi() * 2 - 6.283185307179586) < 1e-12, "pi()*2 numeric")
}
test_global_pi_e_stay_float()

test_const_in_calculus() = {
    // 常量参与求导/展开/求解时保持符号
    x = sym("x")
    assert(str(cas.diff(sin(cas.pi() * x), x)) == "cos(pi * x) * pi", "diff with pi")
    // 根按 (实部, 虚部) 升序排列（solveEq 出口的规范化），所以 -√pi 在前
    assert(str(cas.solve(x ^ 2 - cas.pi(), x)) == "@[-sqrt(pi), sqrt(pi)]", "exact solve with pi")
    assert(str(cas.subs(cas.pi() * x, x, 2)) == "2 * pi", "subs with pi")
}
test_const_in_calculus()

test_user_symbols_not_hijacked() = {
    // ★ 常量节点与用户符号互不冒充，两个方向都要挡住：
    //   1) 用户定义的同名符号必须保持自由变量，不能被常量逻辑悄悄当成常数
    //      （曾出现 log(sym("E")) 直接被化简成 1，evalv(sym("PI")) 得到 3.14159）；
    //   2) 常量也不能被用户符号定义覆盖 —— 常量身份只经 cas.pi()/cas.e()/cas.i()
    //      与 SymConst 节点存在，sym("PI") 造出来的是另一个东西。
    x = sym("x")
    E = sym("E")
    PI = sym("PI")
    I = sym("i")
    assert(str(E) == "E", "user E prints as E")
    assert(str(PI) == "PI", "user PI prints as PI")
    assert(str(I) == "i", "user i prints as i")
    assert(str(cas.simplify(log(E))) == "log(E)", "user E must not become e")
    assert(str(cas.diff(E * x, x)) == "E", "user E is a constant w.r.t. x")
    assert(str(cas.expand(E ^ 2)) == "E^2", "user E^2 stays symbolic")
    assert(str(I ^ 2) == "i^2", "user i must not fold to -1")
    // 同名但不同身份：用户符号与常量节点不得判等
    assert(E != cas.e(), "user E is not the constant e")
    assert(PI != cas.pi(), "user PI is not the constant pi")
    assert(I != cas.i(), "user i is not the imaginary constant")
}
test_user_symbols_not_hijacked()

test_const_in_rules_table() = {
    // ★ 回归：SymRules.h 的规则表曾用 makeVar("PI") 表达 √π。
    //   常量名会被 makeVar 转义成自由变量，于是 integ(exp(-x^2), x) 吐出
    //   1/2 * erf(x) * sqrt(PI) —— 形式对、π 却是自由变量，导数回验不过。
    //   规则表现在直写 makeConst(SymConstId::Pi)，必须落在常量 pi 上。
    x = sym("x")
    I = cas.integ(exp(-(x ^ 2)), x)
    assert(str(I) == "1/2 * erf(x) * sqrt(pi)",
           f"gaussian integral should use the pi constant, got {str(I)}")
    assert(cas.evalv(cas.subs(I, x, 1.0)) > 0.74 && cas.evalv(cas.subs(I, x, 1.0)) < 0.75,
           "erf-based gaussian integral evaluates numerically")
}
test_const_in_rules_table()

test_factor_with_constants() = {
    // 常量系数不应破坏因式分解：既不能崩（曾有 bad variant access），
    // 也不能把原式缩放成首一形式（x^2 - pi 曾变成 x^2 * pi^(-1) - 1）。
    x = sym("x")
    assert(str(cas.factor(x ^ 2 - cas.pi())) == "x^2 - pi", "factor keeps constant polys intact")
    assert(str(cas.factor(cas.pi() * x ^ 2 - cas.pi())) == "pi * (x + 1) * (x - 1)", "factor extracts const content")
    assert(str(cas.factor(x ^ 2 - 1)) == "(x + 1) * (x - 1)", "integer factoring still works")
}
test_factor_with_constants()
