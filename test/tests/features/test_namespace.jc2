test_namespace_basic() = {
    namespace MathUtils {
        const PI_APPROX = 3.14
        add(a, b) = a + b
        local hidden = 42
    }
    
    assert(MathUtils.PI_APPROX == 3.14, "Namespace const access failed")
    assert(MathUtils.add(2, 3) == 5, "Namespace method call failed")
    assert(!("hidden" in MathUtils), "Namespace local hiding failed")
}
test_namespace_basic()

test_namespace_dynamic() = {
    namespace Dyn {}
    
    Dyn.val = 100
    assert(Dyn.val == 100, "Namespace dynamic assignment failed")
    
    Dyn.mul = (x) => x * 2
    assert(Dyn.mul(5) == 10, "Namespace dynamic method failed")
}
test_namespace_dynamic()

test_namespace_freeze() = {
    namespace Locked {
        val = 1
    }
    freeze(Locked)
    
    caught = false
    try {
        Locked.val = 2
    } catch (e) {
        caught = true
    }
    assert(caught, "Namespace freeze failed to protect")
}
test_namespace_freeze()

test_anonymous_namespace_and_self_ref() = {
    const Factory = namespace {
        val = 42
        
        // 返回命名空间自身
        get_self() = namespace
        
        // 动态向自身挂载属性
        register(k, v) = {
            namespace[k] = v
        }
    }
    
    assert(Factory.val == 42, "Anonymous namespace property access failed")
    assert(Factory.get_self() == Factory, "The 'namespace' keyword should evaluate to the namespace itself")
    
    Factory.register("dynamic_field", 100)
    assert(Factory.dynamic_field == 100, "Self-reference mutation failed")
}
test_anonymous_namespace_and_self_ref()

// 命名空间字段未命中 → 兜底到同名全局内建函数时，接收者不得占实参位。
// 回归：cas.sin(10) 曾调用 sin(<namespace cas>, 10) → args[0].asFloat() 抛
// "Expected a real number."；只有该全局名被物化后（先写过 sin(10)）才碰巧走对分支。
import cas

test_namespace_falls_back_to_global_builtin() = {
    assert(cas.sin(10) == sin(10), "cas.sin(10) must match the global sin(10)")
    assert(cas.cbrt(27) == 3, "cas.cbrt(27) must be 3")
    assert(cas.asinh(0) == 0, "cas.asinh(0) must be 0")
    assert(cas.trunc(2.7) == 2, "cas.trunc(2.7) must be 2")
    assert(cas.abs(-3) == 3, "cas.abs(-3) must be 3")
}
test_namespace_falls_back_to_global_builtin()

test_namespace_builtin_fallback_keeps_arity_check() = {
    caught = false
    try {
        cas.sin()
    } catch (e) {
        caught = "expects 1 arguments" in e.message
    }
    assert(caught, "the fallback still enforces arity")
}
test_namespace_builtin_fallback_keeps_arity_check()
