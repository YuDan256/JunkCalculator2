// ── features/test_class.jc2 ─────────────────────────────────────────────
{
test_basic_class() = {
    class Point {
        init(x, y) = {
            self.x = x
            self.y = y
        }
        move(dx, dy) = {
            self.x += dx
            self.y += dy
        }
    }
    p = Point(10, 20)
    assert(p.x == 10 && p.y == 20, "Class init failed")
    
    p.move(5, -5)
    assert(p.x == 15 && p.y == 15, "Class method failed")
}
test_basic_class()

test_inheritance() = {
    class Animal {
        speak() = "..."
    }
    class Dog extends Animal {
        speak() = "Woof"
    }
    a = Animal()
    d = Dog()
    assert(a.speak() == "...", "Base method failed")
    assert(d.speak() == "Woof", "Overridden method failed")
}
test_inheritance()

test_dunder_methods() = {
    class Vector {
        init(x, y) = { 
            self.x = x
            self.y = y 
        }
        __add__(other) = Vector(self.x + other.x, self.y + other.y)
        __eq__(other) = self.x == other.x && self.y == other.y
    }
    v1 = Vector(1, 2)
    v2 = Vector(3, 4)
    v3 = v1 + v2
    assert(v3 == Vector(4, 6), "Dunder __add__ or __eq__ failed")
}
test_dunder_methods()

test_super_call() = {
    class Base {
        greet() = "Hello from Base"
    }
    class Derived extends Base {
        greet() = super.greet() + " and Derived"
    }
    obj = Derived()
    assert(obj.greet() == "Hello from Base and Derived", "Super method call failed")
}
test_super_call()

test_anonymous_class_and_self_ref() = {
    const Point = class {
        init(x, y) = { 
            self.x = x
            self.y = y 
        }
        // 使用 class 关键字进行自引用实例化
        clone() = class(self.x, self.y)
        // 返回当前类对象
        get_class() = class
    }
    
    p1 = Point(10, 20)
    p2 = p1.clone()
    
    assert(p1 != p2, "Clone should be a new instance (reference inequality)")
    assert(p2.x == 10 && p2.y == 20, "Clone should have the same field values")
    assert(p1.get_class() == Point, "The 'class' keyword should evaluate to the class object itself")
}
test_anonymous_class_and_self_ref()

test_anonymous_class_keeps_its_name() = {
    // 回归：匿名 class / trait 的显示名必须来自定义本身，不能来自绑定位置。
    // 曾把赋值目标名写进 Class 节点，于是 `a = class {}` 显示 <class a>，
    // 且换绑（b = a）仍显示 <class a> —— 名字成了绑定的属性而非对象的属性。
    // 现在保持空名，统一显示 <anonymous class>，与匿名 enum 的既有做法一致。
    local A = class {}
    local B = trait {}
    local C = class {}
    assert(str(A) == "<anonymous class>", "an anonymous class does not inherit the variable name")
    assert(str(B) == "<anonymous class>", "nor does an anonymous trait")
    assert(str(C) == "<anonymous class>", "nor a second one bound elsewhere")
    assert(str(A) == str(C), "two anonymous classes display the same way")
    assert(A != C, "but they are still distinct objects")

    // 匿名 namespace 同一口径（class / trait / namespace 一致的规则）
    local NS = namespace {}
    assert(str(NS) == "<anonymous namespace>", "an anonymous namespace does not inherit the variable name")

    // 具名定义不受影响
    local Named = class Named {}
    assert(str(Named) == "<class Named>", "a named class still shows its name")
    local NamedNS = namespace NamedNS {}
    assert(str(NamedNS) == "<namespace NamedNS>", "a named namespace still shows its name")
    // 匿名 trait 仍是 trait
    assert(istrait(B), "an anonymous trait is still a trait")
}
test_anonymous_class_keeps_its_name()

test_access_control() = {
    throws(f) = { try { f(); return false } catch (e) { return true } }
    class Account {
        const id = 12345
        local balance = 0
        static local const MAX = 999
        static const MIN = 0
        
        init(b) = {
            self.balance = b
        }
        
        local helper() = self.balance * 2
        
        get_balance() = self.balance
        get_helper() = self.helper()
        static get_max() = Account.MAX
        
        test_reflection() = {
            assert(self["balance"] == 100, "Reflection read failed inside class")
            self["balance"] = 300
            assert(self.balance == 300, "Reflection write failed inside class")
            assert("balance" in self, "Reflection 'in' failed inside class")
            self.balance = 100 // restore
        }
    }
    
    acc = Account(100)
    
    // Public const
    assert(acc.id == 12345, "Public const read failed")
    assert(throws(() => acc.id = 54321), "Public const should be read-only")
    
    // Private instance field
    assert(acc.get_balance() == 100, "Private field internal read failed")
    acc.test_reflection()
    assert(throws(() => acc.balance), "Private field should be invisible externally")
    acc.balance = 200
    assert(acc.balance == 200, "Public property can shadow private name externally")
    assert(acc.get_balance() == 100, "Private field remains unaffected by public shadowing")
    
    // Private instance method
    assert(acc.get_helper() == 200, "Private method internal call failed")
    assert(throws(() => acc.helper()), "Private method should be invisible externally")
    
    // Static const
    assert(Account.MIN == 0, "Static const read failed")
    assert(throws(() => Account.MIN = 1), "Static const should be read-only")
    
    // Static private const
    assert(Account.get_max() == 999, "Static private const internal read failed")
    assert(throws(() => Account.MAX), "Static private const should be invisible externally")
    
    // Static method tearing
    f = Account.get_max
    assert(f() == 999, "Static method tearing lost class context")
}
test_access_control()

test_private_inheritance() = {
    throws(f) = { try { f(); return false } catch (e) { return true } }
    class Parent {
        local secret = 42
        local hidden() = 100
        get_secret() = self.secret
    }
    class Child extends Parent {
        init() = { super.init() }
        try_access() = self.secret
        try_call() = self.hidden()
    }
    
    c = Child()
    assert(c.get_secret() == 42, "Parent method should access its own private field")
    assert(throws(() => c.try_access()), "Child should not access parent's private field")
    assert(throws(() => c.try_call()), "Child should not access parent's private method")
}
test_private_inheritance()


// Inherited and overridden init
test_inherited_init() = {
    class InitBase {
        x
        init(v) = { self.x = v }
    }
    class InitChild extends InitBase {}
    assert(InitChild(5).x == 5, "inherited init runs")

    class InitOverride extends InitBase {
        init(v) = { self.x = v + 1 }
    }
    assert(InitOverride(5).x == 6, "override init runs")

    class InitSuper extends InitBase {
        init(v) = { super.init(v * 2) }
    }
    assert(InitSuper(5).x == 10, "super.init runs")
}
test_inherited_init()


test_finalize() = {
    import sys
    class Fin {
        static count = 0
        finalize() = { Fin.count += 1 }
    }
    f = Fin()
    f = none
    sys.gc()
    sys.gc()
    assert(Fin.count == 1, "GC runs finalize once")
    threw = false
    try { Fin().finalize() } catch (e) { threw = true }
    assert(threw, "finalize cannot be called manually")
}
test_finalize()


field_order_events = @[]
field_order_record(x) = { field_order_events.push(x); return x }

test_inheritance_field_order() = {
    class BaseOrder {
        a = field_order_record("base")
    }
    class ChildOrder extends BaseOrder {
        b = field_order_record("child")
        fromBase = str(self.a) + "1"
    }
    c = ChildOrder()
    assert(field_order_events == @["base", "child"], "base fields initialize before child fields")
    assert(c.a == "base" && c.b == "child", "inherited/own field values")
    assert(c.fromBase == "base1", "child field default can read inherited field")
}
test_inheritance_field_order()


test_reflected_and_call_dunders() = {
    class Ops {
        init(x) = { self.x = x }
        __add__(o) = Ops(self.x + (type(o) == Ops ? o.x : o))
        __radd__(o) = Ops(o + self.x)
        __call__(y) = self.x + y
        __getitem__(i) = self.x * i
    }
    a = Ops(2)
    b = Ops(3)
    assert((a + b).x == 5, "__add__")
    assert((a + 5).x == 7, "__add__ scalar")
    assert((5 + a).x == 7, "__radd__")
    assert(a(10) == 12, "__call__")
    assert(a[3] == 6, "__getitem__")
}
test_reflected_and_call_dunders()

test_anonymous_class_call() = {
    // A class literal at statement start must keep its postfix call.
    class "Anon" { init() = { self.ready = true } }()

    C = class "Anon2" { init(x) = { self.x = x }; get() = self.x }
    assert(C(7).get() == 7, "anonymous class assignment call")
}
test_anonymous_class_call()

test_named_class_call() = {
    class NamedClass { init() = { self.x = 8 } }()
    assert(NamedClass().x == 8, "named class definition keeps its call value")
}
test_named_class_call()
}

// ── features/test_member_model.jc2 ─────────────────────────────────────────────
{
// ★ 成员模型不变式（docs/OOP_MODEL_DESIGN.md §八 的验证点，逐条落成断言）
//   这些断言在第二阶段（模板冻结 / 实例成员编号 / 桶预留）落地后仍然成立。

throws(f) = {
    try { f(); return false } catch (e) { return true }
}

test_member_read_is_raw() = {
    class A {
        v = 7
        who() = self.v
        static tag() = "tag"
    }
    a = A()
    // §八 1：读两次是同一个函数对象（不复制、不包装、不绑定）
    assert(a.who == a.who, "reading a member twice must yield the same function object")
    // §八 4
    assert(a.who() == 7, "member call still works")
    // §八 2：取出来再调用没有接收者
    g = a.who
    assert(throws(() => g()), "extracted method has no self")
    // §八 3：字典的键作为 self，不占实参位
    d = %{ "f": sin }
    assert(abs(d.f(1.0) - 0.841471) < 1e-6, "dict key's closure gets the dict as self")
    // §八 5：挂上去的闭包拿实例当 self，取出来就没有
    h = A()
    h.cb = () => self
    assert(h.cb() == h, "hung closure gets the instance as self")
    k = h.cb
    assert(throws(() => k()), "extracted hung closure has no self")
}
test_member_read_is_raw()

test_class_exposes_only_statics() = {
    class A {
        v = 7
        who() = self.v
        static tag() = "tag"
    }
    a = A()
    // §八 6：类上只有 static 域，实例方法模板不从类上取
    assert(throws(() => A.who), "instance method template is not readable from the class")
    assert(throws(() => A.who()), "and not invokable from the class")
    assert(throws(() => A.who(a)), "and not invokable with an explicit receiver")
    // §八 7 / static 照旧
    assert(A.tag() == "tag", "static method still callable from the class")
    assert(throws(() => a.tag), "static member is not reachable from an instance")
    assert(throws(() => a.tag()), "and not invokable from an instance")
}
test_class_exposes_only_statics()

test_dot_call_fills_self() = {
    // §八 8 / 9：点号调用把接收者交给隐藏通道 self，不占实参位
    free_self() = self
    assert(throws(() => free_self()), "plain call has no self")
    assert(5.free_self() == 5, "dot call passes the receiver through self")
    echo_self(x) = self
    assert(1.echo_self(0) == 1, "receiver does not occupy an argument slot")
}
test_dot_call_fills_self()

test_receiver_is_not_an_argument() = {
    // §八 10 / 12：接收者不再被隐式填进实参位
    assert(throws(() => 1.0.sin()), "dot call to a global math function needs the argument explicitly")
    assert(abs(sin(1.0) - 0.841471) < 1e-6, "sin(1.0) works")
    // §八 11 / 12：长度与原型成员照旧
    assert(@[1, 2, 3].len() == 3, "list length via prototype method")
    assert(len(@[1, 2, 3]) == 3, "and via the global function")
    assert(@[1, 2, 3].sum() == 6, "prototype methods keep working")
    assert("ab".upper() == "AB", "string prototype methods keep working")
    assert("ab".reversed() == "ba", "chained prototype calls keep working")
    assert(len(%{ x: 1 }.keys()) == 1, "dict prototype methods keep working")
    // §八 18：0 参原生方法不再静默吞掉多余实参
    assert(throws(() => @[1, 2, 3].sum(5)), "extra args to a 0-param native are rejected")
    assert(throws(() => "ab".upper(5)), "same for string natives")
}
test_receiver_is_not_an_argument()

test_const_and_static_boundaries() = {
    class K {
        const cf = 1
        const cm() = 2
        static const scf = 3
        nf = 4
        nm() = 5
    }
    k = K()
    // §八 13：const 只管它所在的那个域
    assert(throws(() => { k.cf = 11 }), "instance write to a const field is rejected")
    assert(throws(() => { k.cm = 12 }), "instance write to a const method is rejected")
    // §2.6：const 只管它所在的那个域——实例域的 const 不管类上的写入
    K.cm = 22
    assert(K.cm == 22, "class write to a const method template creates a static")
    assert(k.cm() == 2, "the instance still uses its own method template")
    assert(throws(() => { K.scf = 23 }), "class write to a static const is rejected")
    assert(throws(() => k.scf), "static const is not reachable from an instance")
    // §八 14：字段声明名在类上写 => 新建一个 static
    K.cf = 21
    assert(K.cf == 21, "class write to a field declaration name creates a static")
    // 非 const 成员照旧可写
    k.nf = 41
    assert(k.nf == 41, "non-const instance field stays writable")
    k.nm = 51
    assert(k.nm == 51, "non-const instance member can be shadowed")
}
test_const_and_static_boundaries()

test_class_writes_only_touch_the_static_domain() = {
    // §2.6 统一写规则：C.名字 = 值 命中 static 就覆盖、没命中就新建一个 static；
    // 它写不到实例成员模板，所以模板永远不改，新对象仍用老方法
    class T {
        m() = 1
    }
    t0 = T()
    T.m = () => 2
    assert(T.m() == 2, "the assignment created a static m")
    assert(t0.m() == 1, "an existing instance keeps its own template")
    t1 = T()
    assert(t1.m() == 1, "a new instance still uses the method template")
    T["m"] = () => 3
    assert(T.m() == 3, "index write follows the same rule")
    // static 域与模板互不干扰
    T.s = 5
    assert(T.s == 5, "statics stay writable")
    t = T()
    assert(throws(() => t.s), "statics are not reachable from an instance")
    assert(t.m() == 1, "the method template is untouched")
}
test_class_writes_only_touch_the_static_domain()

test_snapshot_intent() = {
    // §八 19 的意图：改类（重新定义 = 换一个新类对象）不影响已经造出来的对象
    class A {
        v = 1
        who() = "old"
    }
    a = A()
    A = class {
        v = 2
        who() = "new"
    }
    b = A()
    assert(a.who() == "old", "old object keeps its old method")
    assert(a.v == 1, "old object keeps its old field")
    assert(b.who() == "new", "new object uses the new method")
    assert(b.v == 2, "new object uses the new field")
    assert(!isinstance(a, A), "old object is not an instance of the redefined class")
    assert(isinstance(b, A), "new object is an instance of the redefined class")
}
test_snapshot_intent()

test_lookup_order_is_shared() = {
    // §八 23 / §2.1：自己的袋子 -> 原型 -> 全局，读与调用同一条顺序
    d = %{ keys: 5 }
    assert(d.keys == 5, "dict key shadows the prototype method for reads")
    assert(throws(() => d.keys()), "and for calls the key's value is used (not callable)")
    l = @[1, 2]
    assert(l.len() == 2, "prototype method works when no key shadows it")
}
test_lookup_order_is_shared()

test_containers_are_not_instances() = {
    // §八 22：原生容器不受实例语义影响
    l1 = @[1]
    l2 = @[2]
    assert(l1.append == l2.append, "prototype methods are one shared function object")
    assert(throws(() => { l1.x = 1 }), "containers cannot take new fields")
    d = %{ a: 1 }
    d.x = 1
    assert(d.x == 1, "a dict takes a new key")
    assert(l1.len() == 1, "and reading still works")
}
test_containers_are_not_instances()

test_freeze_covers_the_whole_class() = {
    class F {
        v = 1
        m() = 2
    }
    f = F()
    assert(!isfrozen(F), "a plain class is not frozen")
    freeze(F)
    assert(isfrozen(F), "freeze() marks the class frozen")
    assert(throws(() => { F.s = 1 }), "a frozen class rejects static writes")
    assert(throws(() => { F.m = () => 3 }), "a frozen class rejects template writes")
    assert(f.m() == 2, "existing instances keep working after the class is frozen")
    f.v = 9
    assert(f.v == 9, "instance-domain writes are unaffected by the class freeze")
    trait FT {
        tm() = 1
    }
    assert(isfrozen(FT), "a trait is frozen at definition")
}
test_freeze_covers_the_whole_class()

test_members_are_snapshotted_per_instance() = {
    // §2.4 / §六 第 9 步：类体里的每个成员定义 = 构造时对这个实例求值一次
    class S {
        v = 1
        who() = "old"
    }
    a = S()
    b = S()
    // 实例能改自己那份，别的实例不受影响
    a.who = () => "shadow"
    assert(a.who() == "shadow", "an instance can shadow its own member")
    assert(b.who() == "old", "other instances keep their own copy")
    a.v = 5
    assert(b.v == 1, "fields stay per instance")
    // 无捕获的方法共享同一个函数对象（可观察等价）
    class T {
        f() = 42
    }
    assert(T().f == T().f, "capture-free methods share one function object")
    assert(T().f() == 42, "and still call correctly")
    // 私有字段的状态不跨实例
    class C {
        local n = 0
        local bump() = { self.n = self.n + 1; return self.n }
        inc() = self.bump()
    }
    c1 = C()
    c2 = C()
    assert(c1.inc() == 1 && c1.inc() == 2, "first instance counts on its own")
    assert(c2.inc() == 1, "second instance starts from its own default")
    assert(c1.inc() == 3, "and the first instance keeps counting")
}
test_members_are_snapshotted_per_instance()

test_dunders_resolve_in_the_class_domain_only() = {
    // §2.1 的例外：dunder 是语言协议，只在类域解析，不看实例袋子里的那份
    class D {
        v = 1
        __str__() = "D(" + str(self.v) + ")"
        __len__() = 7
    }
    d = D()
    assert(str(d) == "D(1)", "dunder comes from the class template")
    assert(len(d) == 7, "len() goes through __len__")
    // 实例影子读得到，但派发不用它（与 Python 一致）
    d.__len__ = () => 99
    assert(d.__len__() == 99, "the shadow is readable and callable on its own")
    assert(len(d) == 7, "but len() keeps using the class template")
    assert(len(D()) == 7, "other instances are unaffected")
    // 类上写同名只新建 static：既碰不到模板，也碰不到实例袋子
    c0 = D()
    D.__len__ = () => 5
    assert(D.__len__() == 5, "the class write created a static")
    assert(len(c0) == 7, "an existing instance is unaffected")
    assert(len(D()) == 7, "and a new instance still uses the template")
}
test_dunders_resolve_in_the_class_domain_only()

test_hash_dunder_is_found_in_the_member_table() = {
    // 回归：类袋子分两张表后，实例方法住在 members。散列能力探测如果只看
    // properties，就会「明明定义了 __hash__ 却报 unhashable」。
    class H {
        k = 1
        __hash__() = self.k
        __eq__(o) = self.k == o.k
    }
    h = H()
    assert(ishashable(h), "an instance with __hash__ is hashable")
    assert(hash(h) == hash(H()), "hash() is stable across equal instances")
    assert(h.__hash__() == 1, "and __hash__ itself returns the declared value")
    d = %{}
    d[h] = "v"
    assert(d[H()] == "v", "and it works as a dict key")
    // 父类提供的 __hash__ 同样算数
    class H2 extends H { }
    assert(ishashable(H2()), "an inherited __hash__ counts too")
    // 没有 __hash__ 的普通实例照旧不可哈希
    class Plain { x = 1 }
    assert(!ishashable(Plain()), "a plain instance stays unhashable")
}
test_hash_dunder_is_found_in_the_member_table()
test_hash_of_dunder_result_is_type_consistent() = {
    // 回归：hash(obj) 必须等于 hash(obj.__hash__())，对 __hash__ 的每种合法
    // 返回类型都成立。曾经 BigInt 返回值在实例分支里被单独走了
    // sipHash24String(十进制)，而顶层哈希器对能塞进 ±2^53 的 BigInt 走
    // sipHash24Double —— 同一个哈希器内部自我不一致：
    //   __hash__() = hash(1001) 时 hash(obj) != hash(hash(1001))，
    //   反而 hash(str(hash(1001))) == hash(obj)。
    // 判定依据是「与同值直接哈希一致」，不是任何字面数值。
    class HNum { __hash__() = 7 }
    assert(hash(HNum()) == hash(7), "number-returning __hash__ hashes as that number")

    class HBig { __hash__() = hash(1001) }
    r = hash(1001)
    assert(hash(HBig()) == hash(r), "hash(obj) == hash(obj.__hash__()) for BigInt results")
    assert(HBig().__hash__() == r, "sanity: __hash__ really returns that BigInt")

    class HStr { __hash__() = "abc" }
    assert(hash(HStr()) == hash("abc"), "string-returning __hash__ hashes as that string")

    // dict/set 仍然正确（哈希值因修复而改变，这里守住功能）
    class HKey {
        init(k) = { self.k = k }
        __hash__() = self.k
        __eq__(o) = self.k == o.k
    }
    d = %{}
    d[HKey(1234567890123456789)] = "big"
    assert(d[HKey(1234567890123456789)] == "big", "BigInt-valued key still round-trips")
    st = set()
    st.add(HKey(1001))
    assert(HKey(1001) in st, "and set membership still works")
}
test_hash_of_dunder_result_is_type_consistent()

// ★ 实例自省全局函数 getFields / hasField（实例没有原型 ⇒ 只能走全局）：
//   语义与 Dict 方法 keys/getFields、hasKey/hasField 共用同一实现，故结果一致；
//   私有（local）字段既不出现在 getFields，也不被 hasField 命中。
test_instance_introspection_globals() = {
    class P {
        x = 1
        y = 2
        local s = 9
    }
    p = P()

    fs = getFields(p)
    assert("x" in fs && "y" in fs, "public fields are listed")
    assert(!("s" in fs), "private field must not be listed")

    assert(hasField(p, "x"), "public field is visible")
    assert(!hasField(p, "s"), "private field is invisible")
    assert(!hasField(p, "nope"), "missing field is false")
    assert(!hasField(p, 42), "non-string key is false")

    d = %{"a": 1, "b": 2}
    assert(getFields(d) == d.keys(), "getFields agrees with d.keys()")
    assert(hasField(d, "a") == d.hasField("a"), "hasField agrees with d.hasField()")

    // Dict 的键可以是任意可哈希值（非字符串键按原值查找，不是"拒绝"）
    d2 = %{42: "x", true: "y"}
    assert(hasField(d2, 42), "integer key is looked up as-is")
    assert(hasField(d2, true), "boolean key is looked up as-is")
    assert(!hasField(d2, 43), "missing integer key is false")
    assert(getFields(d2) == d2.keys(), "getFields returns dict keys of any type")

    import sys
    assert("buildIndex" in getFields(sys), "namespace fields are listed")

    assert(throws(() => getFields(42)), "getFields rejects non-containers")
    assert(throws(() => hasField(42, "x")), "hasField rejects non-containers")
}
test_instance_introspection_globals()

// ★ 住在槽位里的常量成员同样受 const 保护
test_slot_const_member_is_protected() = {
    class WithConstMethod {
        init() = %{ }
        const m() = return 1
    }
    assert(throws(() => clear(WithConstMethod())), "clear must refuse to delete a const member")

    class NoConst {
        init() = %{ }
        m() = return 1
    }
    assert(!throws(() => clear(NoConst())), "clear works when no const member exists")
}
test_slot_const_member_is_protected()
}

// ── features/test_trait.jc2 ─────────────────────────────────────────────
{
// Trait 测试套件
// 覆盖 docs/TRAIT_DESIGN.md 的验证点

throws(f) = { try { f(); return false } catch (e) { return true } }

// 1. trait 定义 + 实现 + 默认方法 + isinstance
test_trait_basic() = {
    trait Drawable {
        draw(ctx)
        describe() = "a drawable"
    }

    class Circle with Drawable {
        draw(ctx) = { self.ctx = ctx }
    }

    c = Circle()
    c.draw("test")
    assert(c.ctx == "test", "abstract method implementation failed")
    assert(c.describe() == "a drawable", "default method failed")
    assert(isinstance(c, Drawable), "isinstance with trait failed")
}
test_trait_basic()

// 2. trait 不可实例化
test_trait_instantiation() = {
    trait I { run(x) }
    assert(throws(() => I()), "trait instantiation should throw TypeError")
}
test_trait_instantiation()

test_trait_cannot_be_superclass() = {
    trait I { run(x) }
    assert(throws(() => eval("class Bad extends I { run(x) = x }")),
        "class cannot extend a trait")

    class Good with I { run(x) = x }
    assert(Good().run(2) == 2, "class still composes trait with with")
}
test_trait_cannot_be_superclass()

// 3. 抽象方法未实现 → 类定义时抛 TypeError
test_trait_abstract_unimplemented() = {
    trait I { run(x) }
    caught = false
    try {
        class C with I {}
    } catch (e) {
        caught = e.type == "TypeError"
    }
    assert(caught, "unimplemented abstract method should throw TypeError")
}
test_trait_abstract_unimplemented()

// 4. 签名不符 → 抛 TypeError（参数个数、参数名、返回类型）
test_trait_signature_mismatch() = {
    trait I { run(x, y) -> int }

    // 参数个数不符
    assert(throws(() => class with I { run(x) -> int = x }), "wrong param count should throw")

    // 参数名不符
    assert(throws(() => class with I { run(a, b) -> int = a }), "wrong param name should throw")

    // 返回类型不符
    assert(throws(() => class with I { run(x, y) -> string = "x" }), "wrong return type should throw")

    // 正确实现
    class C with I { run(x, y) -> int = x + y }
    assert(C().run(1, 2) == 3, "correct implementation failed")
}
test_trait_signature_mismatch()

// 5. 默认方法可选覆盖
test_trait_default_override() = {
    trait I {
        describe() = "default"
    }
    class A with I {}
    class B with I {
        describe() = "override"
    }
    assert(A().describe() == "default", "default method should be used")
    assert(B().describe() == "override", "override should win")
}
test_trait_default_override()

// 5b. 抽象方法带默认值/const/static → trait 定义时抛错（编译期，用 eval 捕获）
test_trait_abstract_invalid() = {
    assert(throws(() => eval("trait I1 { run(x = 1) }")), "abstract method with default param should throw")
    assert(throws(() => eval("trait I2 { const run(x) }")), "abstract method with const should throw")
    assert(throws(() => eval("trait I3 { static run(x) }")), "abstract method with static should throw")
}
test_trait_abstract_invalid()

// 6. 多 trait 组合 + 后覆盖先
test_trait_multi_trait() = {
    trait A { name() = "A" }
    trait B { name() = "B" }
    class C with A, B {}
    class D with B, A {}
    assert(C().name() == "B", "later trait should override (C with A, B)")
    assert(D().name() == "A", "later trait should override (D with B, A)")
}
test_trait_multi_trait()

// 7. trait 组合 trait + 平铺
test_trait_composition() = {
    trait Base { base() = "base" }
    trait Derived with Base { derived() = "derived" }
    class E with Derived {}
    e = E()
    assert(e.base() == "base", "composed trait method failed")
    assert(e.derived() == "derived", "own trait method failed")
    assert(isinstance(e, Base), "flattened ancestor trait isinstance failed")
    assert(isinstance(e, Derived), "direct trait isinstance failed")
}
test_trait_composition()

// 8. 父类已实现抽象方法，子类不实现也算已实现
test_trait_parent_implements() = {
    trait I { run() = "impl" }
    class Parent with I {
        run() = "parent impl"
    }
    class Child extends Parent {}
    assert(Child().run() == "parent impl", "parent implementation should be inherited")
    assert(isinstance(Child(), I), "inherited trait should be recognized")
}
test_trait_parent_implements()

// 9. isinstance 父类 with 的 trait 子类也命中
test_trait_isinstance_inheritance() = {
    trait I { m() = "m" }
    class Parent with I {}
    class Child extends Parent {}
    assert(isinstance(Child(), I), "child should inherit parent's trait")
    assert(isinstance(Parent(), I), "parent should have trait")
}
test_trait_isinstance_inheritance()

// 10. 修饰符 local/const/static 复制
test_trait_modifiers() = {
    trait I {
        local hidden() = "hidden"
        static const MAX = 100
        static get_max() = I.MAX
    }
    class C with I {}
    c = C()
    assert(C.MAX == 100, "static const should be copied")
    assert(C.get_max() == 100, "static method should be copied")
    // ★ static 只住类袋子，实例查找不经过它（docs/OOP_MODEL_DESIGN.md §2.7）。
    assert(throws(() => c.get_max()), "static method should not be reachable from an instance")
    assert(throws(() => c.MAX), "static const should not be reachable from an instance")
    assert(throws(() => c.hidden()), "local method should stay private")
}
test_trait_modifiers()

// 11. trait 字段默认值 + 冻结
test_trait_frozen() = {
    trait I {
        const version = "1.0"
        get_version() = self.version
    }
    class C with I {}
    assert(C().get_version() == "1.0", "trait field should be copied")

    // 冻结后修改成员抛错
    assert(throws(() => { trait J { m() = "m" }; J.x = 1 }), "frozen trait field modification should throw")
    assert(throws(() => { trait K { m() = "m" }; K.m = 2 }), "frozen trait method modification should throw")
}
test_trait_frozen()

// 12. trait 组合 trait：父 trait 的抽象方法由类实现（回归：曾误报未实现）
test_trait_composition_abstract() = {
    trait I { run(x) }
    trait B with I { extra() = "b" }
    class D with B { run(x) = "D" }
    d = D()
    assert(d.run(1) == "D", "class implementation of inherited abstract method failed")
    assert(d.extra() == "b", "composed trait default method failed")
    assert(isinstance(d, I), "inherited abstract trait should be recognized")
}
test_trait_composition_abstract()

// 13. trait 组合 trait：父 trait 的抽象方法由子 trait 默认实现满足
test_trait_composition_default_satisfies() = {
    trait I { run(x) }
    trait B with I { run(x) = "B" }
    class D with B {}
    assert(D().run(1) == "B", "child trait default should satisfy parent abstract method")
}
test_trait_composition_default_satisfies()

// 14. 三层 trait 组合 + 同名方法派生覆盖祖先
test_trait_composition_chain() = {
    trait A { name() = "A" }
    trait B with A { name() = "B" }
    trait C with B { }
    class D with C {}
    assert(D().name() == "B", "derived trait should override ancestor trait default")
    assert(isinstance(D(), A), "3-level flattened ancestor trait isinstance failed")
    assert(isinstance(D(), B) && isinstance(D(), C), "3-level direct trait isinstance failed")

    // 子 trait 无覆盖时沿用祖先默认实现
    trait E with A { extra() = "e" }
    class F with E {}
    assert(F().name() == "A", "ancestor default should be inherited when child does not override")
}
test_trait_composition_chain()

// 15. trait 组合后签名校验仍然生效（错误发生在继承来的抽象方法上）
test_trait_composition_signature() = {
    trait I { run(x, y) -> int }
    trait B with I { extra() = "b" }

    assert(throws(() => class with B { run(x) -> int = x }), "inherited abstract param count should be checked")
    assert(throws(() => class with B { run(a, b) -> int = a }), "inherited abstract param name should be checked")
    assert(throws(() => class with B { run(x, y) -> string = "s" }), "inherited abstract return type should be checked")

    class C with B { run(x, y) -> int = x + y }
    assert(C().run(1, 2) == 3, "valid inherited abstract implementation failed")
    assert(C().extra() == "b", "composed default method should still be copied")
}
test_trait_composition_signature()

// 15b. 默认方法被覆盖时同样要做严格的签名校验
//      回归：原先只有**抽象**方法走签名校验，trait 里的默认方法一旦被覆盖就成了
//      "随便写都行" —— 改参数个数、改参数名、改返回类型、改参数类型全部静默通过。
//      默认方法在 trait 里的签名和抽象方法一样是对外契约，覆盖必须一致。
test_trait_default_override_signature() = {
    trait I { run(x, y) -> int = x + y }

    // ① 类直接组合 trait 后覆盖默认方法
    assert(throws(() => class with I { run(x) -> int = x }), "default override: param count")
    assert(throws(() => class with I { run(a, b) -> int = a }), "default override: param name")
    assert(throws(() => class with I { run(x, y) -> string = "s" }), "default override: return type")
    assert(throws(() => class with I { run(x: string, y: string) -> int = 0 }), "default override: param type")

    // ② 子类覆盖「继承自 trait 的默认方法」（编译顺序是 继承 → 自身成员 → with，
    //    所以这条只能在方法定义处拦，不能靠 applyTrait）
    class Base with I {}
    assert(throws(() => class extends Base { run(x) -> int = x }), "subclass override: param count")
    assert(throws(() => class extends Base { run(a, b) -> int = a }), "subclass override: param name")
    assert(throws(() => class extends Base { run(x, y) -> string = "s" }), "subclass override: return type")
    class Middle extends Base {}
    assert(throws(() => class extends Middle { run(x) -> int = x }), "grandchild override: param count")

    // ③ 派生 trait 覆盖祖先 trait 的默认方法同样受约束
    trait A { g(x) -> int = x }
    assert(throws(() => trait B with A { g() -> int = 1 }), "derived trait override: param count")

    // ④ 签名一致时必须放行，且覆盖确实生效
    class Ok with I { run(x, y) -> int = x * y }
    assert(Ok().run(3, 4) == 12, "matching override should work")
    class Sub extends Base { run(x, y) -> int = x * y }
    assert(Sub().run(3, 4) == 12, "matching subclass override should work")
    class Inherit extends Base {}
    assert(Inherit().run(2, 3) == 5, "no override -> trait default still used")
    trait A2 { g2(x) -> int = x }
    trait B2 with A2 { g2(x) -> int = x * 3 }
    class E with B2 {}
    assert(E().g2(5) == 15, "derived trait default should win when signature matches")

    // ⑤ 普通继承（方法不是来自 trait）覆盖不受影响
    class Plain { f() = "plain" }
    class Plain2 extends Plain { f() = "over" }
    assert(Plain2().f() == "over", "plain override must stay unrestricted")
}
test_trait_default_override_signature()

// 16. trait 定义的 local（私有）方法可从 trait 默认方法内调用
test_trait_private_method() = {
    trait I {
        local hidden() = "h"
        call() = self.hidden()
    }
    class C with I {}
    c = C()
    assert(c.call() == "h", "trait private method should be callable from trait default method")
    assert(throws(() => c.hidden()), "trait private method should stay private")
}
test_trait_private_method()

// 17. trait 私有字段 + 私有方法组合访问
test_trait_private_state() = {
    trait Counter {
        local count = 0
        local bump() = { self.count = self.count + 1; return self.count }
        inc() = self.bump()
    }
    class C with Counter {}
    c = C()
    assert(c.inc() == 1, "trait private state first increment failed")
    assert(c.inc() == 2, "trait private state second increment failed")
    assert(c.inc() == 3, "trait private state third increment failed")
}
test_trait_private_state()

// 18. trait 的 local 成员与类的同名 local 成员互不干扰（各自的私有命名空间）
test_trait_private_namespace_isolation() = {
    trait I {
        local tag() = "trait"
        traitTag() = self.tag()
    }
    class C with I {
        local tag() = "class"
        classTag() = self.tag()
    }
    c = C()
    assert(c.classTag() == "class", "class own method should see class own private")
    assert(c.traitTag() == "trait", "trait method should see trait own private")
    assert(throws(() => c.tag()), "private members should stay private")
}
test_trait_private_namespace_isolation()

// 19. 不同 trait 的同名私有成员按**词法作用域**各自解析（确定性，不依赖哈希顺序）
//     回归：早期实现按 mangled 名后缀模糊匹配，命中哪个取决于哈希表遍历顺序。
test_trait_private_lexical_scope() = {
    trait A {
        local tag() = "A"
        readA() = self.tag()
    }
    trait B {
        local tag() = "B"
        readB() = self.tag()
    }

    // 类未定义同名私有成员：各 trait 的默认方法看到各自 trait 的私有方法
    class C2 with A, B {}
    c2 = C2()
    assert(c2.readA() == "A", "trait A method should see trait A private (A,B order)")
    assert(c2.readB() == "B", "trait B method should see trait B private (A,B order)")

    class C3 with B, A {}
    c3 = C3()
    assert(c3.readA() == "A", "trait A method should see trait A private (B,A order)")
    assert(c3.readB() == "B", "trait B method should see trait B private (B,A order)")

    // 类自身也定义同名私有成员：类的私有归类的，trait 的私有归 trait 的
    class C4 with A, B {
        local tag() = "C"
        readC() = self.tag()
    }
    c4 = C4()
    assert(c4.readC() == "C", "class own method should see class private")
    assert(c4.readA() == "A", "trait A private should stay lexically scoped to A")
    assert(c4.readB() == "B", "trait B private should stay lexically scoped to B")

    // 反复构造仍应稳定（排除依赖容器状态的偶然性）
    for (i = 0; i < 50; i = i + 1) {
        assert(C2().readA() == "A", "private resolution must be stable across instances")
        assert(C2().readB() == "B", "private resolution must be stable across instances")
    }
}
test_trait_private_lexical_scope()

// 21. trait 组合链上的私有方法按词法作用域解析（不做跨作用域兜底）
//     `trait Deep with LA` 的 body 在 LA 被组合进来之前就已编译，其中的 self.tg() 是普通
//     调用，LA 的私有 tg 对它不可见 —— 报错是词法作用域的正确结果，而不是缺陷。
test_trait_private_composed_chain() = {
    trait LA {
        local tg() = "A"
        readA() = self.tg()
    }
    trait Deep with LA {
        readD() = self.tg()
        // 要跨层复用私有逻辑，应在声明它的 trait 体内完成（readA 即如此）
    }

    class LD with Deep {}
    assert(LD().readA() == "A", "leaf trait private via its own body should work")
    assert(throws(() => LD().readD()), "composed-trait method must not see ancestor trait private")

    // 消费者类定义同名私有成员：也不会被跨作用域取用
    class LE with Deep {
        local tg() = "E"
        readOwn() = self.tg()
    }
    assert(LE().readOwn() == "E", "class own method should see class own private")
    assert(LE().readA() == "A", "leaf trait private should stay lexically scoped to LA")
    assert(throws(() => LE().readD()), "class private must not leak into composed-trait method")
}
test_trait_private_composed_chain()

// 22. trait 私有字段跨方法读写 + trait 定义后冻结
test_trait_private_state_across_methods() = {
    trait Counter {
        local hits = 0
        bump() = { self.hits = self.hits + 1; return self.hits }
        peek() = self.hits
    }
    class C with Counter {}
    c = C()
    assert(c.bump() == 1, "trait private field first bump failed")
    assert(c.bump() == 2, "trait private field second bump failed")
    assert(c.peek() == 2, "trait private field should be shared across trait methods")
    assert(throws(() => c.hits), "trait private field should stay private")

    // 冻结：定义后不可增改成员
    assert(throws(() => { trait T { static const X = 1 }; T.X = 2 }), "frozen trait static const should be read-only")
    assert(throws(() => { trait U { m() = "m" }; U.added = 1 }), "frozen trait should reject new members")
}
test_trait_private_state_across_methods()

// 23. 字段默认值初始化：多个 trait 的同名字段各归其主
//     回归：字段初始化器曾统一叫 <init>，按名复制时后组合的 trait 覆盖前一个，
//     导致两个 trait 的同名字段收敛成同一个值（读到 2 2 而不是 1 2）。
test_trait_field_defaults_distinct() = {
    trait F1 { local v = 1; get1() = self.v }
    trait F2 { local v = 2; get2() = self.v }
    class FF with F1, F2 {}
    ff = FF()
    assert(ff.get1() == 1, "trait F1 private field default should stay 1")
    assert(ff.get2() == 2, "trait F2 private field default should stay 2")

    // 反序组合同样各归其主
    class GG with F2, F1 {}
    gg = GG()
    assert(gg.get1() == 1, "reversed composition: F1 field should stay 1")
    assert(gg.get2() == 2, "reversed composition: F2 field should stay 2")

    // 每个实例各自持有一份，修改互不影响
    trait M1 { local n = 0; bump() = { self.n = self.n + 1; return self.n } }
    class MM with M1 {}
    m1 = MM()
    m2 = MM()
    assert(m1.bump() == 1 && m1.bump() == 2, "first instance private counter failed")
    assert(m2.bump() == 1, "second instance should have its own field copy")
}
test_trait_field_defaults_distinct()

// 24. 类自身 init 与 trait 字段默认值共存
//     回归：类写了 init 时，trait 的字段默认值初始化器被 init 覆盖而整个丢失（读字段报未找到）。
test_trait_field_defaults_with_user_init() = {
    trait Seeded { local seeded = 7; getSeed() = self.seeded }
    class C with Seeded {
        init() = { self.tag = "x" }
        getTag() = self.tag
    }
    c = C()
    assert(c.getTag() == "x", "user init body should run")
    assert(c.getSeed() == 7, "trait field default should survive a user-defined init")

    // 字段默认值先于用户 init：init 内可经 trait 的公开方法读到默认值
    // （trait 的 local 字段对消费者类不可见，需由 trait 自己暴露——这是既有的封装边界，
    // 与「trait 私有成员按词法作用域解析」一致）
    trait Base2 { local base = 5; getBase() = self.base }
    class D with Base2 {
        init() = { self.doubled = self.getBase() * 2 }
        getDoubled() = self.doubled
    }
    assert(D().getDoubled() == 10, "field defaults must be ready before user init runs")

    // trait 自己的默认方法内部直接读私有字段
    trait Calc { local n = 3; calc() = self.n * 7 }
    class E with Calc {
        init() = { self.r = self.calc() }
        getR() = self.r
    }
    assert(E().getR() == 21, "trait default method should read own private field")
}
test_trait_field_defaults_with_user_init()

// 25. 字段默认值沿类继承链逐级初始化（且 super.init() 仍可用）
test_field_defaults_inheritance() = {
    class Base { x = 10; getX() = self.x }
    class Mid extends Base { y = 20; getY() = self.y }
    class Leaf extends Mid { z = 30; getZ() = self.z }
    leaf = Leaf()
    assert(leaf.getX() == 10, "grandparent field default missing")
    assert(leaf.getY() == 20, "parent field default missing")
    assert(leaf.getZ() == 30, "own field default missing")

    // 子类 init 里调用 super.init() 不应报「父类没有 <init>」
    class P2 { a = 1; getA() = self.a }
    class C2 extends P2 { init() = { super.init(); self.b = 2 }; getB() = self.b }
    c2 = C2()
    assert(c2.getA() == 1, "parent field default missing when child defines init")
    assert(c2.getB() == 2, "child init body should run after super.init()")
}
test_field_defaults_inheritance()

// 26. trait 组合必须参与全部类型判定，而不只是 isinstance
//     回归：类型从属判定曾在 8 处各写一遍「沿 parent 链做指针比较」，全都漏掉 traits 表，
//     于是 `class B with A` 的实例 isinstance(B(), A) 为 true，却
//     `B <: A` 为 false、`x: A = B()` 抛 TypeError、`B() in A` 为 false——
//     同一件事实在不同入口给出互相矛盾的答案。现在统一走 ObjClass::conformsTo。
test_trait_conformance_everywhere() = {
    trait A { draw(x) }
    trait D with A { extra() }
    class B with A { draw(x) = 1 }
    class B2 with D { draw(x) = 1; extra() = 2 }
    class R extends B { r() = 3 }

    // ① 子类型运算符 <:
    assert(B <: A, "B <: A (direct trait)")
    assert(B2 <: A, "B2 <: A (flattened ancestor trait)")
    assert(B2 <: D, "B2 <: D (direct trait)")
    assert(R <: A, "R <: A (trait inherited through the class chain)")
    assert(A <: A, "trait is a subtype of itself")
    assert(!(A <: B), "A <: B must stay false (conformance is not symmetric)")

    // ② 变量 / 参数 / 返回值标注
    x: A = B()
    assert(x.draw(1) == 1, "B instance usable through an A-typed variable")
    x2: A = R()
    assert(x2.draw(1) == 1, "R instance usable through an A-typed variable")
    take(v: A) = v.draw(1)
    assert(take(B()) == 1, "trait-typed parameter accepts a composing class")
    assert(take(R()) == 1, "trait-typed parameter accepts a subclass of a composing class")
    make() -> A = B()
    assert(make().draw(1) == 1, "trait-typed return accepts a composing class")
    assert(throws(() => { bad: A = 5; }), "non-instance must still fail a trait annotation")

    // ③ 联合类型
    u(v: A | int) = 1
    assert(u(B()) == 1, "union with trait accepts composing class")
    assert(u(3) == 1, "union with trait accepts the other member")
    assert(throws(() => u("s")), "union with trait still rejects unrelated types")

    // ④ 成员测试 in 与 isinstance 必须同口径
    assert(B() in A, "'B() in A' must agree with isinstance")
    assert(isinstance(B(), A), "isinstance with trait")
    assert("draw" in B, "string needle still does member lookup on a class")
    assert(!("nope" in B), "missing member lookup still false")

    // ⑤ match 类型模式
    classify(v) = { match (v) { y: A => "A"; _ => "other" } }
    assert(classify(B()) == "A", "match type pattern with trait")
    assert(classify(5) == "other", "match type pattern with trait rejects non-instances")

    // ⑥ 异常体系也同样适用
    trait Loggable { log() = "logged" }
    class E4 extends Exception with Loggable { }
    assert(E4 <: Loggable, "exception class composing a trait")
    assert(E4 <: Exception, "exception class still derives from Exception")
}
test_trait_conformance_everywhere()

test_istrait_distinguishes_trait_from_class() = {
    // trait 与 class 共用同一个类型（type(T) is class_type 对两者都为 true），
    // 运行期差别只在"不可实例化"，所以区分手段是 istrait 谓词，不另立类型。
    trait TA { foo() = 1 }
    class CA with TA { bar() = 2 }
    trait TB with TA { extra() = 3 }

    assert(istrait(TA), "a trait definition is a trait")
    assert(istrait(TB), "a trait composed from another trait is still a trait")
    assert(!istrait(CA), "a class is not a trait")

    // 非 trait 一律 false（本族谓词的既有契约：不报错）
    assert(!istrait(CA()), "an instance is not a trait")
    assert(!istrait(5), "a number is not a trait")
    assert(!istrait("s"), "a string is not a trait")
    assert(!istrait(none), "none is not a trait")
    assert(!istrait(@[1, 2]), "a list is not a trait")

    // 不改动既有语义：trait 仍参与类型符合同一性判定
    assert(isinstance(CA(), TA), "isinstance with a trait stays true")
    assert(type(TA) is class_type, "a trait is still class_type")
    assert(type(CA) is class_type, "and so is a class")
}
test_istrait_distinguishes_trait_from_class()
}

// ── features/test_private_members.jc2 ─────────────────────────────────────────────
{
// 私有属性按声明它的类隔离
throws(f) = {
    try { f(); return false } catch (e) { return true }
}

// ── 1. 不同类的同名私有互不干扰 ──
class Alpha {
    local v = "alpha"
    init() = %{ }
    read() = self.v
}

class Beta {
    local v = "beta"
    init() = %{ }
    read() = self.v
}

test_same_private_name_across_classes() = {
    assert(Alpha().read() == "alpha", "Alpha private must stay with Alpha")
    assert(Beta().read() == "beta", "Beta private must stay with Beta")
}

// ── 2. 父子同名私有：词法解析，各自看自己那份 ──
class Parent {
    local tag = "parent"
    init() = %{ }
    readFromParent() = self.tag
}

class ChildNoOwn extends Parent {
    init() = { super.init() }
}

class ChildOwn extends Parent {
    local tag = "child"
    init() = { super.init() }
    readFromChild() = self.tag
}

// 私有属性（可调用）同样按词法解析
class CallableParent {
    local who() = "parent"
    init() = %{ }
    callWho() = self.who()
}

class CallableChild extends CallableParent {
    local who() = "child"
    init() = { super.init() }
    callWhoChild() = self.who()
}

test_inherited_private_is_lexical() = {
    assert(ChildNoOwn().readFromParent() == "parent",
           "without a subclass private, the inherited one is used")
    assert(ChildOwn().readFromParent() == "parent",
           "a parent method always sees the parent's own private")
    assert(ChildOwn().readFromChild() == "child", "subclass sees its own private")
    assert(CallableChild().callWho() == "parent",
           "a parent method calling a private property sees its own, not the override")
    assert(CallableChild().callWhoChild() == "child", "subclass sees its own private property")
}

// ── 3. 私有 static 按类隔离 ──
class Counter1 {
    local static const NAME = "c1"
    init() = %{ }
    name() = Counter1.NAME
}

class Counter2 {
    local static const NAME = "c2"
    init() = %{ }
    name() = Counter2.NAME
}

test_private_static_isolation() = {
    assert(Counter1().name() == "c1", "private static belongs to its own class")
    assert(Counter2().name() == "c2", "same-named private static does not collide")
}

// ── 4. 私有属性不出现在反射里，也不能从外部访问 ──
class Reflected {
    local hidden = 1
    local hiddenCall() = 2
    shown = 3
    init() = %{ }
}

test_private_is_not_reflected() = {
    r = Reflected()
    f = getFields(r)
    assert("shown" in f, "public property must be listed")
    assert(!("hidden" in f), "private property must not be listed")
    assert(!("hiddenCall" in f), "private property must not be listed")
    assert(!hasField(r, "hidden"), "private property is invisible to hasField")
    assert(throws(() => r.hidden), "private property is not readable from outside")
    assert(throws(() => r.hiddenCall()), "private property is not callable from outside")
}

// ── 5. 私有 const 不可改 ──
class Locked {
    local const limit = 10
    init() = %{ }
    tryBump() = self.limit = 11
    read() = self.limit
}

test_private_const_is_protected() = {
    l = Locked()
    assert(l.read() == 10, "private const initial value")
    assert(throws(() => l.tryBump()), "assigning a private const must throw")
    assert(l.read() == 10, "private const keeps its value")
}

test_same_private_name_across_classes()
test_inherited_private_is_lexical()
test_private_static_isolation()
test_private_is_not_reflected()
test_private_const_is_protected()
}

// ── features/test_lifecycle.jc2 ─────────────────────────────────────────────
{
// 构造与析构的契约
import sys

throws(f) = {
    try { f(); return false } catch (e) { return true }
}

class Base1 {
    init(v) = { self.v = v }
    read() = self.v
}
class Child1 extends Base1 { }
assert(Child1(5).read() == 5, "subclass without init uses the inherited one")

logB = @[]
class Base2 {
    init() = logB.push("base")
}
class Child2 extends Base2 {
    init() = {
        logB.push("before")
        super.init()
        logB.push("after")
    }
}
_2 = Child2()
assert(logB.join(",") == "before,base,after", "super.init runs where it is written")

class Base3 { }
class Child3 extends Base3 {
    init() = super.init()
}
assert(throws(() => Child3()), "super.init requires the parent to define init")

class Base4 {
    tag = "default"
    init() = { self.seen = self.tag }
    readSeen() = self.seen
}
assert(Base4().readSeen() == "default", "field defaults are ready before init")

log5 = @[]
class Base5 {
    init() = %{ }
    finalize() = log5.push("base")
}
class Child5 extends Base5 {
    init() = %{ }
    finalize() = log5.push("child")
}
g5 = Child5()
g5 = none
sys.gc()
assert(log5.join(",") == "child", "only the most derived finalize runs")

log6 = @[]
class Base6 {
    init() = %{ }
    finalize() = log6.push("base")
}
class Child6 extends Base6 { }
g6 = Child6()
g6 = none
sys.gc()
assert(log6.join(",") == "base", "finalize is inherited")

log7 = @[]
class Base7 {
    init() = %{ }
    finalize() = log7.push("base")
}
class Child7 extends Base7 {
    init() = %{ }
    finalize() = {
        log7.push("child")
        super.finalize()
    }
}
g7 = Child7()
g7 = none
sys.gc()
assert(log7.join(",") == "child,base", "super.finalize chains explicitly")

log8 = @[]
trait HasInit {
    init() = log8.push("trait")
}
class WithInit with HasInit { }
_8 = WithInit()
assert(log8.join(",") == "trait", "a trait can provide the constructor")

hits9 = @[]
trait HasField {
    tag = hits9.push("field")
    init() = %{ }
}
class WithField with HasField { }
_9 = WithField()
assert(hits9.len() == 1, "a trait field initializer runs exactly once")

class Reflected {
    init() = { self.v = 1 }
    finalize() = %{ }
    local hidden = 2
}
r = Reflected()
f = getFields(r)
assert(!("init" in f), "init is not listed")
assert(!("finalize" in f), "finalize is not listed")
assert(!("hidden" in f), "private property is not listed")
assert("v" in f, "ordinary properties are listed")

class LocalInit {
    local init() = { self.v = 7 }
    read() = self.v
}
assert(LocalInit().read() == 7, "init still runs when written with a modifier")
}

// ── features/test_type_assertions.jc2 ─────────────────────────────────────────────
{
// 多种类型断言的统一测试（赋值 / 属性 / 索引 / 解构 / 声明 / match 守卫 / as / in / 参数返回）

// ============ 变量赋值断言 ============
test_assign_var() = {
    x: int = 10
    assert(x == 10, "Variable assignment with int assertion should succeed")
    y: int | string = "hi"
    assert(y == "hi", "Union type assertion should succeed")
}
test_assign_var()

test_assign_var_fail() = {
    try {
        x: int = "hi"
        assert(false, "Should throw when assigning string to int")
    } catch (e) {
        assert("expected type" in str(e.message), "Wrong error for variable assertion: " + str(e.message))
    }
}
test_assign_var_fail()

// ============ 属性赋值断言 ============
test_assign_prop() = {
    d = %{a: 1}
    d.a: int = 5
    assert(d.a == 5, "Property assignment with int assertion should succeed")
}
test_assign_prop()

test_assign_prop_fail() = {
    try {
        d = %{a: 1}
        d.a: string = 1
        assert(false, "Should throw when assigning int to string-typed property")
    } catch (e) {
        assert("expected type" in str(e.message), "Wrong error for property assertion: " + str(e.message))
    }
}
test_assign_prop_fail()

// ============ 索引赋值断言 ============
test_assign_index() = {
    A = @[1, 2, 3]
    A[0]: int = 10
    assert(A[0] == 10, "Index assignment with int assertion should succeed")
}
test_assign_index()

test_assign_index_fail() = {
    try {
        A = @[1, 2, 3]
        A[0]: string = 1
        assert(false, "Should throw when assigning int to string-typed index")
    } catch (e) {
        assert("expected type" in str(e.message), "Wrong error for index assertion: " + str(e.message))
    }
}
test_assign_index_fail()

// ============ 解构断言 ============
test_destruct_assert() = {
    @[a: int, b: string] = @[1, "hi"]
    assert(a == 1 && b == "hi", "Destructuring with type assertions should succeed")
}
test_destruct_assert()

test_destruct_assert_fail() = {
    try {
        @[a: int, b: int] = @[1, "hi"]
        assert(false, "Should throw when destructuring string into int")
    } catch (e) {
        assert("expected type" in str(e.message), "Wrong error for destructuring assertion: " + str(e.message))
    }
}
test_destruct_assert_fail()

// ============ dict 解构断言 ============
test_dict_assert() = {
    d = %{a: 1, b: "x"}
    %{a: av: int, b: bv: string} = d
    assert(av == 1 && bv == "x", "Dict destructuring with type assertions should succeed")
}
test_dict_assert()

// ============ 独立声明断言 ============
test_local_decl() = {
    local x: int = 10
    assert(x == 10, "local decl with type assertion should succeed")
}
test_local_decl()

test_state_decl() = {
    state s: int = 5
    assert(s == 5, "state decl with type assertion should succeed")
}
test_state_decl()

test_ref_decl() = {
    outer = 42
    f() = {
        ref outer: int
        return outer
    }
    assert(f() == 42, "ref decl with type assertion should succeed")
}
test_ref_decl()

// ============ match 类型守卫 ============
test_match_guard() = {
    r = match (5) {
        n: int => "int",
        _ => "other"
    }
    assert(r == "int", "match guard should match int")
    r2 = match ("hi") {
        n: int => "int",
        _ => "other"
    }
    assert(r2 == "other", "match guard should fall through on non-int")
}
test_match_guard()

// ============ as 表达式断言 ============
test_as_assert() = {
    x = 5
    assert((x as int) == 5, "as assertion should return the value")
    assert(((3 + 4) as int) == 7, "as on arbitrary expression should work")
    d = %{a: 1}
    assert((d.a as int) == 1, "as on property should work")
}
test_as_assert()

test_as_assert_fail() = {
    try {
        x = "hi"
        x as int
        assert(false, "Should throw when as-asserting string as int")
    } catch (e) {
        assert("expected type" in str(e.message), "Wrong error for as assertion: " + str(e.message))
    }
}
test_as_assert_fail()

// ============ in 类型查询 ============
test_in_query() = {
    assert(5 in int, "5 should be in int")
    assert(!("hi" in int), "\"hi\" should not be in int")
    assert(5 in (int | string), "5 should be in union")
}
test_in_query()

// ============ 参数与返回类型断言 ============
test_param_assert() = {
    f(x: int) = x * 2
    assert(f(5) == 10, "param assertion should succeed")
}
test_param_assert()

test_param_assert_fail() = {
    try {
        f(x: int) = x * 2
        f("hi")
        assert(false, "Should throw when passing string to int param")
    } catch (e) {
        assert("expected type" in str(e.message), "Wrong error for param assertion: " + str(e.message))
    }
}
test_param_assert_fail()

test_return_assert() = {
    f() -> int = 5
    assert(f() == 5, "return assertion should succeed")
}
test_return_assert()

test_return_assert_fail() = {
    try {
        f() -> int = "hi"
        f()
        assert(false, "Should throw when returning string from int function")
    } catch (e) {
        assert("expected to return" in str(e.message), "Wrong error for return assertion: " + str(e.message))
    }
}
test_return_assert_fail()

// ============ 裸注解报错 ============
test_bare_annotation_error() = {
    try {
        eval("x: int")
        assert(false, "Should throw on bare annotation without assignment")
    } catch (e) {
        msg = str(e.message)
        assert("Use 'as'" in msg || "Type annotation" in msg, "Wrong error for bare annotation: " + msg)
    }
}
test_bare_annotation_error()
}
