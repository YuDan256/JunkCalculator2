// try/catch 基础与类型化 catch（原 core/test_error + syntax/test_catch_chain）

class MyError extends Exception {}
class OtherError extends Exception {}

test_catch_chain_type_match() = {
    r = try {
        throw MyError("x")
    } catch {
        e: OtherError => "other",
        e: MyError => "mine"
    }
    assert(r == "mine", "catch chain type match")
}
test_catch_chain_type_match()

test_catch_type_mismatch_rethrow() = {
    threw = false
    try {
        try {
            throw MyError("x")
        } catch {
            e: OtherError => "other"
        }
    } catch (e) {
        threw = true
    }
    assert(threw, "type mismatch rethrows")
}
test_catch_type_mismatch_rethrow()

test_catch_or_pattern() = {
    r = try {
        throw OtherError("x")
    } catch {
        e: MyError, e: OtherError => "mine or other"
    }
    assert(r == "mine or other", "or pattern")
}
test_catch_or_pattern()

test_catch_guard() = {
    r = try {
        throw MyError("big error")
    } catch {
        e: MyError if (e.message == "big error") => "big",
        e: MyError => "small"
    }
    assert(r == "big", "guard")
}
test_catch_guard()

test_catch_shorthand_keeps_type() = {
    r = try {
        throw MyError("x")
    } catch (e) {
        type(e) == MyError
    }
    assert(r, "shorthand keeps exception type")
}
test_catch_shorthand_keeps_type()

// ── try/catch 表达式与 assert ──

test_try_catch() = {
    res = try {
        throw "custom error"
        0
    } catch (e) {
        1
    }
    assert(res == 1, "try/catch expression failed")
    
    res2 = try {
        42
    } catch (e) {
        -1
    }
    assert(res2 == 42, "try/catch success path failed")
}
test_try_catch()

test_assert() = {
    caught = false
    try {
        assert(1 == 2, "Math is broken")
    } catch (e) {
        caught = true
        assert("Math is broken" in e.message, "assert message mismatch")
    }
    assert(caught, "assert failed to throw")
}
test_assert()


test_error_model() = {
    try {
        1 + "x"
    } catch (e) {
        assert(e.type == "TypeError", "builtin error type field")
        assert(type(e) == TypeError, "builtin error class")
        assert("Cannot add" in e.message, "builtin error message")
        assert(type(e.traceback) == string, "traceback is a string")
    }

    r = try {
        throw Exception("HttpError", {code: 500, detail: "down"})
    } catch (e) {
        assert(e.type == "HttpError", "structured error type")
        assert(e.message.code == 500 && e.message.detail == "down", "structured message")
        e
    }
    assert(r.type == "HttpError", "catch returns value")

    r2 = try {
        throw {code: 404, msg: "Not Found"}
    } catch (e) {
        assert(e.type == "Exception", "raw value wrapped as Exception")
        assert(e.message.code == 404, "raw dict becomes message")
        e.message.msg
    }
    assert(r2 == "Not Found", "raw dict catch value")

    assert((try { throw "x" }) == none, "bare try swallows and returns none")

    caught = false
    try {
        assert("eq", 1, 2)
    } catch (e) {
        caught = true
        assert(e.type == "RuntimeError", "three-arg assert type")
        assert("[eq]" in e.message, "three-arg assert label")
        assert("Expected" in e.message && "Got" in e.message, "three-arg assert detail")
    }
    assert(caught, "three-arg assert throws")
}
test_error_model()


test_error_hierarchy() = {
    assert(TypeError <: Exception, "builtin error class extends Exception")
    caught = false
    try { 1 + "x" } catch { e: Exception => caught = true }
    assert(caught, "base Exception catches builtin errors")
    caught = false
    try { throw TypeError("tm") } catch (e) { caught = type(e) == TypeError && e.type == "TypeError" && e.message == "tm" }
    assert(caught, "throwing an error class keeps type and message")
}
test_error_hierarchy()
