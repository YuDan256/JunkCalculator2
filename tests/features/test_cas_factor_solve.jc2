import cas
import math

// ── factor / solve 增强回归 ──
// 覆盖：有理根分母吸收、二项式分圆分解、等价判定规范化。

test_rational_roots_no_denominators() = {
    // 有理根路径曾产出 6 * (x + 1/2) * (x + 1/3)：数值对但不是惯用形式。
    // 现应把分母吸收进因子，得到整系数因式。
    x = sym("x")
    assert(str(cas.factor(6 * x ^ 2 + 5 * x + 1)) == "(2 * x + 1) * (3 * x + 1)", "absorb denominators")
    assert(str(cas.factor(2 * x ^ 2 + 7 * x + 3)) == "(2 * x + 1) * (x + 3)", "absorb one denominator")
    assert(str(cas.factor(12 * x ^ 2 + 7 * x + 1)) == "(3 * x + 1) * (4 * x + 1)", "absorb two denominators")
    // 无分母时不应改变既有输出
    assert(str(cas.factor(x ^ 2 + 5 * x + 6)) == "(x + 2) * (x + 3)", "no denominators untouched")
}
test_rational_roots_no_denominators()

test_cyclotomic_factorization() = {
    // x^n - 1 = ∏_{d|n} Φ_d(x)
    x = sym("x")
    assert(str(cas.factor(x ^ 4 - 1)) == "(x + 1) * (x - 1) * (x^2 + 1)", "x^4-1")
    assert(str(cas.factor(x ^ 3 - 1)) == "(x - 1) * (x^2 + x + 1)", "x^3-1")
    assert(str(cas.factor(x ^ 6 - 1)) == "(x + 1) * (x - 1) * (x^2 + x + 1) * (x^2 - x + 1)", "x^6-1")
    assert(str(cas.factor(x ^ 8 - 1)) == "(x + 1) * (x - 1) * (x^2 + 1) * (x^4 + 1)", "x^8-1")
}
test_cyclotomic_factorization()

test_solve_all_roots_present() = {
    // 分圆分解后 solve 走因式分解，根数必须等于次数
    x = sym("x")
    assert(len(cas.solve(x ^ 3 - 1, x)) == 3, "x^3-1 has 3 roots")
    assert(len(cas.solve(x ^ 4 - 1, x)) == 4, "x^4-1 has 4 roots")
    assert(len(cas.solve(x ^ 5 - 1, x)) == 5, "x^5-1 has 5 roots")
    // x^6-1 曾因等价判定假阳性把共轭根当成同一个，只剩 4 个根
    assert(len(cas.solve(x ^ 6 - 1, x)) == 6, "x^6-1 has 6 roots")
    assert(len(cas.solve(x ^ 7 - 1, x)) == 7, "x^7-1 has 7 roots")
    assert(len(cas.solve(x ^ 8 - 1, x)) == 8, "x^8-1 has 8 roots")
}
test_solve_all_roots_present()

test_solve_roots_sorted_and_reduced() = {
    // solveEq 出口统一做「化简 + 定序」：
    //   ① 浅层数值因子分配，把二次公式留下的 1/2 * (2*i - 2) 收敛成 -1 + i
    //      （不能用 expand/full_simplify：它们在 Cardano 嵌套根式上会失控，
    //        full_simplify 曾让 solve(x^3-3x+1) 从 0.9s 涨到 88s）
    //   ② 按 (实部, 虚部) 升序排列，实根在前、共轭对相邻，
    //      与 RootOf 自身的编号次序一致（findRootsNumeric 也是这个序）
    x = sym("x")
    assert(str(cas.solve(x ^ 4 - 1, x)) == "@[-1, -i, i, 1]", "x^4-1 sorted")
    assert(str(cas.solve(x ^ 4 + 4, x)) == "@[-i - 1, -1 + i, -i + 1, 1 + i]", "x^4+4 reduced+sorted")
    assert(str(cas.solve(x ^ 4 - 5 * x ^ 2 + 4, x)) == "@[-2, -1, 1, 2]", "quartic sorted")
    assert(str(cas.solve(x ^ 2 - 2, x)) == "@[-sqrt(2), sqrt(2)]", "quadratic sorted")
    assert(str(cas.solve(x ^ 4 + x ^ 2 + 1, x)) == "@[-1/2 * sqrt(3) * i - 1/2, 1/2 * sqrt(3) * i - 1/2, -1/2 * sqrt(3) * i + 1/2, 1/2 * sqrt(3) * i + 1/2]", "quartic conjugate pairs adjacent")

    // RootOf 只出现在不可约因子上，且编号与排序一致（不能出现 (2) 排在 (1) 前面）
    r5 = cas.solve(x ^ 5 + 1, x)
    assert(len(r5) == 5, "x^5+1 has 5 roots")
    assert(str(r5[0]) == "-1", "real root first")
    for (local k = 1; k <= 4; k += 1) {
        assert(str(r5[k]) == "RootOf(x^4 - x^3 + x^2 - x + 1, x, " + str(k) + ")", "RootOf index " + str(k) + " in order")
    }
    // RootOf(x^4-1,x,1) 这种能约的必须已经约掉（solve 先因式分解）
    assert(!("RootOf" in str(cas.solve(x ^ 4 - 1, x))), "no RootOf left for a reducible poly")
}
test_solve_roots_sorted_and_reduced()
test_solve_all_roots_present()

test_structural_equality() = {
    // 相等判定曾只比指针，代数等价一律判不等
    x = sym("x")
    y = sym("y")
    assert(x + x == 2 * x, "x+x == 2x")
    assert(2 * (x + y) == 2 * x + 2 * y, "distribute")
    assert(x * (y + 1) == x * y + x, "factor out")
    assert((x + 1) * (x - 1) == x ^ 2 - 1, "(x+1)(x-1) == x^2-1")
    assert(cas.factor(x ^ 2 - 1) == x ^ 2 - 1, "factor result equals input")
    assert((x - y) ^ 2 == (y - x) ^ 2, "square sign")
    assert((y - x) * (x + y) == (x - y) * (x + y) * -1, "sign normalization")
    assert(sqrt(4) == 2, "sqrt(4) == 2")
    assert(cas.i() ^ 2 == -1, "i^2 == -1")
}
test_structural_equality()

test_structural_inequality() = {
    // 规范化不得制造假阳性（假阳性比假阴性危险：会让 solve 吃掉不同的根）
    x = sym("x")
    y = sym("y")
    assert(!(x + 1 == x + 2), "x+1 != x+2")
    assert(!(x ^ 2 - 1 == x ^ 2 + 1), "different polys")
    assert(!((x + 1) * (x - 1) == x ^ 2 + 1), "(x+1)(x-1) != x^2+1")
    assert(!(sin(x) == cos(x)), "sin != cos")
    assert(!(x == y), "x != y")
    assert(!(cas.pi() == cas.e()), "pi != e")
    assert(!(cas.i() == 1), "i != 1")
    assert(!(sqrt(2) == sqrt(3)), "sqrt2 != sqrt3")
}
test_structural_inequality()

test_cube_identities() = {
    // A^3 ± B^3 = (A ± B)(A^2 ∓ A*B + B^2)
    // 注意：这里直接断言因式形式，而不是用 expand(...) == expand(...) 比对——
    // cas.expand 不合并同类项（expand((x+1)(x^2-x+1)) 会留下 x^2 - x^2），
    // 所以那种写法会因"相等判定拿不到规范形"而误报失败。
    x = sym("x")
    y = sym("y")
    assert(str(cas.factor(x ^ 3 + y ^ 3)) == "(-x * y + x^2 + y^2) * (x + y)", "x^3+y^3")
    assert(str(cas.factor(x ^ 3 + 1)) == "(x + 1) * (x^2 - x + 1)", "x^3+1")
    assert(str(cas.factor(x ^ 3 - y ^ 3)) != "x^3 - y^3", "x^3-y^3 factored")
    // 不匹配的形状不应被改写
    assert(str(cas.factor(x ^ 2 + y ^ 2)) == "x^2 + y^2", "x^2+y^2 untouched")
    assert(str(cas.factor(x ^ 3 + y ^ 2)) == "x^3 + y^2", "x^3+y^2 untouched")
}
test_cube_identities()

test_high_degree_roots_stay_rootof() = {
    // 4 次及以上保留 RootOf：Ferrari 展开会给出几十行嵌套根式，无可用性收益。
    // 1~3 次仍给紧凑根式。
    x = sym("x")
    assert(str(cas.solve(x ^ 5 - 1, x)) != "", "x^5-1 solvable")
    r = cas.solve(x ^ 4 + x + 1, x)
    assert(len(r) == 4, "quartic has 4 roots")
    assert(str(r) != "", "quartic roots printable")
    // RootOf 必须可数值化
    assert(cas.evalf(cas.subs(x ^ 5 - 1, x, cas.solve(x ^ 5 - 1, x)[0])) == 0, "RootOf numeric")
}
test_high_degree_roots_stay_rootof()

test_like_terms_merge_across_number_forms() = {
    // 同一个数曾有 int32(2) / BigInt(2) / 2.0 多种存储形态，导致内部化池把
    // 同一个 x^2 存成两个节点，operator+ 的同类项合并（按指针）失效：
    // 展开式化简不出正确结果，cas.simplify 曾直接崩溃。
    // 现已在 valueToCasVal 处把整数统一为 BigInt，这里锁住行为。
    x = sym("x")
    assert(str(cas.simplify(cas.expand((x + 1) * (x ^ 2 - x + 1)))) == "x^3 + 1", "expand+simplify combines like terms")
    assert(str(cas.simplify(cas.expand((x + 1) * (x - 1)))) == "x^2 - 1", "difference of squares simplifies")
    assert(cas.expand(cas.factor(x ^ 3 + 1)) == cas.expand(x ^ 3 + 1), "factor round-trip")
}
test_like_terms_merge_across_number_forms()

test_trigsimp_only_touches_trig() = {
    // trigsimp 曾在纯多项式上崩溃（cas.simplify(x^2 + 2*x)）。
    // 它现在先检查表达式是否含三角函数，不含则直接返回。
    x = sym("x")
    assert(str(cas.simplify(x ^ 2 + 2 * x)) == "x * (x + 2)", "x^2+2x")
    assert(str(cas.simplify(x ^ 2 + 2 * x + 1)) == "(x + 1)^2", "x^2+2x+1")
    assert(str(cas.simplify(x ^ 2 + x)) == "x * (x + 1)", "x^2+x")
    // 含三角时 trigsimp 仍必须正常工作
    assert(str(cas.simplify(sin(x) ^ 2 + cos(x) ^ 2)) == "1", "sin^2+cos^2")
    assert(str(cas.trigsimp(sin(x) ^ 2 + cos(x) ^ 2)) == "1", "trigsimp identity")
    assert(str(cas.simplify(tan(x) - sin(x) / cos(x))) == "0", "tan - sin/cos")
    assert(str(cas.expand(sin(2 * x))) == "2 * cos(x) * sin(x)", "sin double angle")
    // 直接调用 trigsimp（此前这条路在纯多项式上会访问越界崩溃）
    assert(str(cas.trigsimp(x ^ 2 + 2 * x)) == "x^2 + 2 * x", "trigsimp on polynomial")
    assert(str(cas.trigsimp(x ^ 2 + 2 * x + 1)) == "x^2 + 2 * x + 1", "trigsimp on polynomial 2")
}
test_trigsimp_only_touches_trig()

test_negative_imaginary_power() = {
    // i 的整数次幂折叠里，负指数曾靠 `1 / i^k` 去求倒数，而 1/i 又会走
    // operator/ → i^(-1) 回到同一个分支 —— 要算的倒数正是它自己，
    // 于是原地打转直到栈溢出（0xC00000FD）。连带 cas.integ(sin(x)*cos(x), x) 崩溃。
    // i 是高斯整数的单位，1/i^k = i^(-k)，直接按周期查表即可，无需递归。
    assert(str(cas.i() ^ 2) == "-1", "i^2")
    assert(str(cas.i() ^ 3) == "-i", "i^3")
    assert(str(cas.i() ^ 4) == "1", "i^4")
    assert(str(cas.i() ^ (-1)) == "-i", "i^-1")
    assert(str(cas.i() ^ (-2)) == "-1", "i^-2")
    assert(str(cas.i() ^ (-3)) == "i", "i^-3")
    assert(str(1 / cas.i()) == "-i", "1/i")
}
test_negative_imaginary_power()

test_integ_trig_product() = {
    x = sym("x")
    // 积分内部会碰到 i^(-1)，曾经因此栈溢出
    assert(str(cas.integ(sin(x) * cos(x), x)) == "-1/2 * cos(x)^2", "integ sin*cos")
    assert(str(cas.integ(x ^ 2, x)) == "1/3 * x^3", "integ x^2")
}
test_integ_trig_product()

// 因式分解的硬不变量：expand(factor(e)) 必须与 expand(e) 相等。
// 可以漏分解，但绝不能分解成别的多项式 —— 下面的回归都是从这条线上抓出来的。
assert_factor_preserves(expr, label) = {
    d = cas.simplify(cas.expand(cas.factor(expr)) - cas.expand(expr))
    assert(str(d) == "0", label + ": factor changed the polynomial (diff=" + str(d) + ")")
}

test_factor_cube_identity() = {
    x = sym("x")
    y = sym("y")
    // ★ 回归：asCube 曾把 MUL 的"非数值因子本身"当成立方根，
    //   把 8*x^3 读成 (2*x^3)^3 = 8*x^9，于是
    //   cas.factor(8*x^3 + 27*y^3) 返回的是 8*x^9 + 27*y^9 的分解 —— 静默错答。
    //   下面每一条都同时要求"分对了"和"没分错"。
    assert(str(cas.factor(8 * x ^ 3 + 27 * y ^ 3)) == "(-6 * x * y + 4 * x^2 + 9 * y^2) * (2 * x + 3 * y)", "8x^3+27y^3")
    assert(str(cas.factor(8 * x ^ 3 - 27 * y ^ 3)) == "-(-2 * x + 3 * y) * (6 * x * y + 4 * x^2 + 9 * y^2)", "8x^3-27y^3")
    assert(str(cas.factor(x ^ 3 * y ^ 3 + 8)) == "(x * y + 2) * (x^2 * y^2 - 2 * x * y + 4)", "x^3y^3+8")
    assert(str(cas.factor(x ^ 6 - y ^ 6)) == "-(-x * y + x^2 + y^2) * (-x + y) * (x + y) * (x^2 + x * y + y^2)", "x^6-y^6")
    assert(str(cas.factor(8 * x ^ 3 * y ^ 6 + 27)) == "(2 * y^2 * x + 3) * (4 * y^4 * x^2 - 6 * y^2 * x + 9)", "8x^3y^6+27")
    assert_factor_preserves(8 * x ^ 3 + 27 * y ^ 3, "8x^3+27y^3")
    assert_factor_preserves(8 * x ^ 3 - 27 * y ^ 3, "8x^3-27y^3")
    assert_factor_preserves(x ^ 3 * y ^ 3 + 8, "x^3y^3+8")
    assert_factor_preserves(x ^ 6 - y ^ 6, "x^6-y^6")
    assert_factor_preserves(x ^ 9 + y ^ 9, "x^9+y^9")
}
test_factor_cube_identity()

test_factor_sophie_germain() = {
    x = sym("x")
    y = sym("y")
    // a^4 + 4*b^4 = (a^2 - 2ab + 2b^2)(a^2 + 2ab + 2b^2)
    // 一元情形原本靠 Zassenhaus 侥幸命中，多元情形两条路都够不到。
    assert(str(cas.factor(x ^ 4 + 4 * y ^ 4)) == "(-2 * x * y + x^2 + 2 * y^2) * (2 * x * y + x^2 + 2 * y^2)", "x^4+4y^4")
    assert(str(cas.factor(4 * x ^ 4 + 1)) == "(2 * x^2 + 2 * x + 1) * (2 * x^2 - 2 * x + 1)", "4x^4+1")
    // x^4 + 1 在 Q 上不可约，必须原样留下
    assert(str(cas.factor(x ^ 4 + 1)) == "x^4 + 1", "x^4+1 is irreducible over Q")
    // x^4 + 4y^2 不是 Sophie Germain 形式，不能乱套
    assert(str(cas.factor(x ^ 4 + 4 * y ^ 2)) == "x^4 + 4 * y^2", "x^4+4y^2 must stay put")
    assert_factor_preserves(x ^ 4 + 4 * y ^ 4, "x^4+4y^4")
    assert_factor_preserves((x + 1) ^ 4 + 4 * y ^ 4, "(x+1)^4+4y^4")
}
test_factor_sophie_germain()

test_factor_quadratic_cyclotomic() = {
    x = sym("x")
    y = sym("y")
    // A^2 + A*B + B^2 在 A*B 为完全平方时是平方差
    assert(str(cas.factor(x ^ 4 + x ^ 2 * y ^ 2 + y ^ 4)) == "(-x * y + x^2 + y^2) * (x^2 + x * y + y^2)", "x^4+x^2y^2+y^4")
    // A*B 不是完全平方时在 Q 上不可约，必须原样留下
    assert(str(cas.factor(x ^ 2 + x * y + y ^ 2)) == "x^2 + x * y + y^2", "x^2+xy+y^2 is irreducible")
    assert(str(cas.factor(4 * x ^ 2 + 6 * x * y + 9 * y ^ 2)) == "6 * x * y + 4 * x^2 + 9 * y^2", "4x^2+6xy+9y^2 is irreducible")
    assert_factor_preserves(x ^ 4 + x ^ 2 * y ^ 2 + y ^ 4, "x^4+x^2y^2+y^4")
    assert_factor_preserves(x ^ 2 + x * y + y ^ 2, "x^2+xy+y^2")
}
test_factor_quadratic_cyclotomic()

test_factor_keeps_leading_sign() = {
    x = sym("x")
    // ★ 回归：Zassenhaus 重构阶段每个因子都除以了系数绝对值的 gcd（恒正），
    //   而 ∏ h_i 相对原多项式只差 sign(a_n)^(n-1)。次数为偶且首项为负时
    //   整体差一个负号，factor 会把多项式"分解"成自己的相反数：
    //   cas.factor(-(x^2 + 1)) 曾返回 x^2 + 1。
    //   连带 simplify((x^4+x^2+1) - (x^4+x^2+1)) 曾算成 2*x^4 + 2*x^2 + 2
    //   （full_simplify 的多重宇宙按体积取最小，选中了符号错误的 factor 候选）。
    assert(str(cas.factor(-(x ^ 2 + 1))) == "-(x^2 + 1)", "factor(-(x^2+1))")
    assert(str(cas.factor(-2 * (x + 1) ^ 2)) == "-2 * (x + 1)^2", "factor(-2(x+1)^2)")
    assert(str(cas.factor(-(x ^ 6 - 1))) == "-(-x + 1) * (-x - 1) * (x^2 + x + 1) * (x^2 - x + 1)", "factor(-(x^6-1))")
    a = x ^ 4 + x ^ 2 + 1
    assert(str(cas.simplify(a - a)) == "0", "simplify(a - a) must be 0")
    assert_factor_preserves(-(x ^ 2 + 1), "-(x^2+1)")
    assert_factor_preserves(-2 * (x + 1) ^ 2, "-2(x+1)^2")
    assert_factor_preserves(-(x ^ 4 + x ^ 2 + 1), "-(x^4+x^2+1)")
    assert_factor_preserves(-8 * x ^ 3 - 27, "-8x^3-27")
    assert_factor_preserves(-x ^ 4 + 4, "-x^4+4")
    assert_factor_preserves(-6 * x ^ 2 - 5 * x - 1, "-6x^2-5x-1")
}
test_factor_keeps_leading_sign()

// =====================================================================
// 非整数系数的保真 + factor 的幂等性
//   factorPolynomialCZ 内部会先把多项式首一化（除以首项系数）再做 Zassenhaus。
//   若在 polySquareFree 之后才检查系数是否为整数，首项系数（sqrt(2)、pi、1/2）
//   已经被吞掉了；更麻烦的是首一化之后剩下的系数又变回整数，事后检查再也发现
//   不了。上面那种用 expand 比较的断言对此无效（expand 在根式上的分配形态不
//   一致，会假阳性），所以这里改用数值代入判定。
//   同一个缺陷还让 factor 在有理式上不幂等 —— 两个方向互为反转，factor∘factor
//   是 2-循环：
//       factor((x+1)^(-1) * (x+2)^(-1))  →  (x^2 + 3*x + 2)^(-1)      分母被乘开
//       factor((x^2 + 3*x + 2)^(-1))     →  (x+1)^(-1) * (x+2)^(-1)   又乘回去
// =====================================================================
assert_factor_value_preserved(expr, v, label) = {
    d = cas.evalf(cas.subs(cas.factor(expr) - expr, v, 3))
    assert(d < 0.0000001, label + ": factor changed the value (diff=" + str(d) + ")")
    assert(d > -0.0000001, label + ": factor changed the value (diff=" + str(d) + ")")
}

test_factor_keeps_noninteger_coefficients() = {
    x = sym("x")
    // 根式系数
    assert(str(cas.factor(sqrt(2) * x)) == "x * sqrt(2)", "factor(sqrt(2)*x)")
    assert(str(cas.factor((x + 1) * sqrt(2))) == "(x + 1) * sqrt(2)", "factor((x+1)*sqrt(2))")
    assert(str(cas.factor((x ^ 2 - 1) * sqrt(2))) == "(x + 1) * (x - 1) * sqrt(2)", "factor((x^2-1)*sqrt(2))")
    assert(str(cas.factor(3 * x ^ 2 * sqrt(2) - 3 * sqrt(2))) == "3 * (x + 1) * (x - 1) * sqrt(2)", "factor(3x^2*sqrt(2)-3sqrt(2))")
    assert(str(cas.factor(x ^ 4 * sqrt(2) - sqrt(2))) == "(x + 1) * (x - 1) * (x^2 + 1) * sqrt(2)", "factor(x^4*sqrt(2)-sqrt(2))")
    assert(str(cas.factor(sqrt(8) * x)) == "2 * x * sqrt(2)", "factor(sqrt(8)*x)")
    // 符号常量系数（pi/e/i 走的是同一段 CZ 路径）
    assert(str(cas.factor(cas.pi() * x)) == "pi * x", "factor(pi*x)")
    assert(str(cas.factor(cas.pi() * (x ^ 2 - 1))) == "pi * (x + 1) * (x - 1)", "factor(pi*(x^2-1))")
    assert(str(cas.factor(cas.e() * x ^ 2 - cas.e())) == "e * (x + 1) * (x - 1)", "factor(e*x^2-e)")
    // 数值保真（这才是真正要守的不变量）
    assert_factor_value_preserved(sqrt(2) * x, x, "sqrt(2)*x")
    assert_factor_value_preserved((x + 1) * sqrt(2), x, "(x+1)*sqrt(2)")
    assert_factor_value_preserved((x ^ 2 - 1) * sqrt(2), x, "(x^2-1)*sqrt(2)")
    assert_factor_value_preserved(x ^ 4 * sqrt(2) - sqrt(2), x, "x^4*sqrt(2)-sqrt(2)")
    assert_factor_value_preserved(sqrt(2) * x ^ 2 + 2 * sqrt(2) * x + sqrt(2), x, "sqrt(2)*(x+1)^2")
    assert_factor_value_preserved(cas.pi() * x, x, "pi*x")
    assert_factor_value_preserved(cas.e() * x ^ 2 - cas.e(), x, "e*x^2-e")
}
test_factor_keeps_noninteger_coefficients()

test_factor_is_idempotent() = {
    x = sym("x")
    // 有理式：f(f(e)) 必须等于 f(e)，两个方向收敛到同一个答案
    assert(str(cas.factor(1 / ((x + 1) * (x + 2)))) == "(x + 1)^(-1) * (x + 2)^(-1)", "factor(1/((x+1)(x+2)))")
    assert(str(cas.factor(1 / (x ^ 2 + 3 * x + 2))) == "(x + 1)^(-1) * (x + 2)^(-1)", "factor(1/(x^2+3x+2))")
    assert(str(cas.factor(x ^ 2 / ((x + 1) * (x + 2)))) == "x^2 * (x + 1)^(-1) * (x + 2)^(-1)", "factor(x^2/((x+1)(x+2)))")
    assert(str(cas.factor(x ^ 4 - 1)) == str(cas.factor(cas.factor(x ^ 4 - 1))), "factor idempotent on x^4-1")
    assert(str(cas.factor(x ^ 6 - 1)) == str(cas.factor(cas.factor(x ^ 6 - 1))), "factor idempotent on x^6-1")
    assert(str(cas.factor(sqrt(2) * x)) == str(cas.factor(cas.factor(sqrt(2) * x))), "factor idempotent on sqrt(2)*x")
    assert(str(cas.factor((x ^ 2 - 1) * sqrt(2))) == str(cas.factor(cas.factor((x ^ 2 - 1) * sqrt(2)))), "factor idempotent on (x^2-1)*sqrt(2)")
    assert(str(cas.factor(1 / ((x + 1) * (x + 2)))) == str(cas.factor(cas.factor(1 / ((x + 1) * (x + 2))))), "factor idempotent on 1/((x+1)(x+2))")
}
test_factor_is_idempotent()

// =====================================================================
// 多元分解的三条新路径（每一项都对应一个曾经失败或曾经错答的形态）
// =====================================================================

// 一次项分组：xy + ax + by + c 的四个项没有公共因式，公因式藏在组合里
// （x*(y+2) + 1*(y+2)）。此前 factor 对这类表达式完全不分解。
test_factor_by_grouping() = {
    x = sym("x")
    y = sym("y")
    assert(str(cas.factor(x * y + 2 * x + y + 2)) == "(x + 1) * (y + 2)", "factor(xy+2x+y+2)")
    assert(str(cas.factor(x * y + 2 * x + 3 * y + 6)) == "(x + 3) * (y + 2)", "factor(xy+2x+3y+6)")
    assert(str(cas.factor(x * y + x + y + 1)) == "(x + 1) * (y + 1)", "factor(xy+x+y+1)")
    // ★ 不同变元分组的质量差别：按 x 分组会得到 (3*y+6)*(x+2/3)（商是分数），
    //   按 y 分组才是干净的 (3*x+2)*(y+2)。变元按字母序遍历，必须取最简的那个。
    assert(str(cas.factor(3 * x * y + 6 * x + 2 * y + 4)) == "(3 * x + 2) * (y + 2)", "factor(3xy+6x+2y+4)")
    // ★ 数值公因数不能被当作"分组"抽出来：2x+3y 关于 x 一次、首项系数是 2，
    //   若允许纯数作除数会得到 2*(x + 3/2*y)，形态反而更差。
    assert(str(cas.factor(2 * x + 3 * y)) == "2 * x + 3 * y", "factor(2x+3y) must stay put")
    assert_factor_preserves(x * y + 2 * x + y + 2, "xy+2x+y+2")
    assert_factor_preserves(3 * x * y + 6 * x + 2 * y + 4, "3xy+6x+2y+4")
    assert_factor_preserves(2 * x + 3 * y, "2x+3y")
}
test_factor_by_grouping()

// 偶次降维：奇数次系数全为 0 时令 t = mainVar^2 把次数减半再分解
test_factor_even_power_reduction() = {
    x = sym("x")
    y = sym("y")
    assert(str(cas.factor(x ^ 4 - y ^ 4)) == "-(-x + y) * (x + y) * (x^2 + y^2)", "factor(x^4-y^4)")
    assert(str(cas.factor(x ^ 8 - y ^ 8)) == "-(-x + y) * (x + y) * (x^2 + y^2) * (x^4 + y^4)", "factor(x^8-y^8)")
    assert(str(cas.factor(x ^ 4 + 2 * x ^ 2 * y ^ 2 + y ^ 4)) == "(x^2 + y^2)^2", "factor((x^2+y^2)^2)")
    assert(str(cas.factor(x ^ 6 + 3 * x ^ 4 * y ^ 2 + 3 * x ^ 2 * y ^ 4 + y ^ 6)) == "(x^2 + y^2)^3", "factor((x^2+y^2)^3)")
    // 在 ℚ 上不可约的必须原样留下，不能因为"次数是偶数"就动它
    assert(str(cas.factor(x ^ 4 + y ^ 4)) == "x^4 + y^4", "x^4+y^4 is irreducible over Q")
    assert(str(cas.factor(x ^ 4 + 1)) == "x^4 + 1", "x^4+1 is irreducible over Q")
    assert(str(cas.factor(x ^ 4 - x ^ 2 + 1)) == "x^4 - x^2 + 1", "x^4-x^2+1 is irreducible over Q")
    assert_factor_preserves(x ^ 4 - y ^ 4, "x^4-y^4")
    assert_factor_preserves(x ^ 8 - y ^ 8, "x^8-y^8")
    assert_factor_preserves(x ^ 4 + y ^ 4, "x^4+y^4")
    assert_factor_preserves(x ^ 6 + 3 * x ^ 4 * y ^ 2 + 3 * x ^ 2 * y ^ 4 + y ^ 6, "(x^2+y^2)^3")
}
test_factor_even_power_reduction()

// 分圆分解必须用真正的变元。cyclotomicPoly 固定用规范变元 x 构造 Φ_d(x)，
// 调用方漏了 "x → var" 替换时，v^n ± 1 会返回含幽灵变量 x 的"分解"
// （factor(y^8-1) 曾给出 (x+1)*(x-1)*...，结果里根本没有 y）。该漏替换已修
// （cc0863d）。
// ★ 如实说明：下面这些断言【目前无法复现那个缺陷】—— 这些输入都会先被
//   factorPolynomialCZ 分解掉，根本走不到分圆那一步；只有当分圆路径拿到内部
//   合成的变元（例如偶次降维的临时变量）时才会暴露。所以它们记录的是"变量名
//   不是 x 时也必须给出正确结果"这一要求，而不是"修复前会失败"的回归。
test_cyclotomic_uses_real_variable() = {
    y = sym("y")
    t = sym("t")
    z = sym("z")
    assert(str(cas.factor(y ^ 6 - 1)) == "(y + 1) * (y - 1) * (y^2 + y + 1) * (y^2 - y + 1)", "factor(y^6-1)")
    assert(str(cas.factor(t ^ 4 - 1)) == "(t + 1) * (t - 1) * (t^2 + 1)", "factor(t^4-1)")
    assert(str(cas.factor(y ^ 8 - 1)) == "(y + 1) * (y - 1) * (y^2 + 1) * (y^4 + 1)", "factor(y^8-1)")
    assert(str(cas.factor(y ^ 3 + 1)) == "(y + 1) * (y^2 - y + 1)", "factor(y^3+1)")
    assert(str(cas.factor(z ^ 4 - 1)) == "(z + 1) * (z - 1) * (z^2 + 1)", "factor(z^4-1)")
}
test_cyclotomic_uses_real_variable()

// =====================================================================
// 多元线性因子（多元版有理根测试）
//   这一类"某几项凑成一个因子、另几项凑成同一个因子"整体看不出来，此前完全不分解。
//   每一条都要同时守两件事：该分出来的分出来，不该分的原样留着。
// =====================================================================
test_factor_linear_factors() = {
    x = sym("x")
    y = sym("y")
    z = sym("z")
    // x^3+x^2y+y^3+y^2x = x^2(x+y) + y^2(x+y)
    assert(str(cas.factor(x ^ 3 + x ^ 2 * y + y ^ 3 + y ^ 2 * x)) == "(x + y) * (x^2 + y^2)", "factor(x^3+x^2y+y^3+y^2x)")
    // x^4+x^3y+y^4+y^3x = x^3(x+y) + y^3(x+y) = (x+y)^2 (x^2-xy+y^2)
    assert(str(cas.factor(x ^ 4 + x ^ 3 * y + y ^ 4 + y ^ 3 * x)) == "(x + y)^2 * (-x * y + x^2 + y^2)", "factor(x^4+x^3y+y^4+y^3x)")
    // x^3+x^2y-xy^2-y^3 = (x+y)^2 (x-y)
    assert(str(cas.factor(x ^ 3 + x ^ 2 * y - x * y ^ 2 - y ^ 3)) == "-(x + y)^2 * (-x + y)", "factor(x^3+x^2y-xy^2-y^3)")
    // 常数为整数的线性因子 (y+1)
    assert(str(cas.factor(x * y ^ 2 + 2 * x * y + x + y + 1)) == "(x * y + x + 1) * (y + 1)", "factor(xy^2+2xy+x+y+1)")
    // 三变元线性型 (x+y+z)
    assert(str(cas.factor((x + y + z) * (x ^ 2 + y ^ 2 + z ^ 2))) == "(x + y + z) * (x^2 + y^2 + z^2)", "factor((x+y+z)(x^2+y^2+z^2))")
    // 不可约的必须原样留下 —— 线性因子搜索不能"硬分"
    assert(str(cas.factor(x ^ 2 + 2 * x * y + y ^ 2 + 1)) == "2 * x * y + x^2 + y^2 + 1", "x^2+2xy+y^2+1 is irreducible over Q")
    assert(str(cas.factor(x ^ 2 + x * y + y ^ 2)) == "x^2 + x * y + y^2", "x^2+xy+y^2 is irreducible")
    assert(str(cas.factor(x ^ 4 + y ^ 4 + 1)) == "x^4 + y^4 + 1", "x^4+y^4+1 is irreducible")
    assert(str(cas.factor(x * y + 1)) == "x * y + 1", "xy+1 is irreducible")
    assert(str(cas.factor(x ^ 3 + y ^ 3 + 1)) == "x^3 + y^3 + 1", "x^3+y^3+1 is irreducible")
    // 既有能力不能被这条策略改坏（顺序/形态都要一致）
    assert(str(cas.factor(x ^ 2 - y ^ 2)) == "-(-x + y) * (x + y)", "factor(x^2-y^2) unchanged")
    assert(str(cas.factor(x ^ 4 - y ^ 4)) == "-(-x + y) * (x + y) * (x^2 + y^2)", "factor(x^4-y^4) unchanged")
    assert(str(cas.factor(x ^ 3 + y ^ 3)) == "(-x * y + x^2 + y^2) * (x + y)", "factor(x^3+y^3) unchanged")
    assert(str(cas.factor(x * y + 2 * x + y + 2)) == "(x + 1) * (y + 2)", "grouping unchanged")
    assert(str(cas.factor(x ^ 2 + 2 * x * y + y ^ 2 + 3 * x + 3 * y + 2)) == "(x + y + 1) * (x + y + 2)", "linear form unchanged")
    // 值与幂等
    assert_factor_preserves(x ^ 3 + x ^ 2 * y + y ^ 3 + y ^ 2 * x, "x^3+x^2y+y^3+y^2x")
    assert_factor_preserves(x ^ 4 + x ^ 3 * y + y ^ 4 + y ^ 3 * x, "x^4+x^3y+y^4+y^3x")
    assert_factor_preserves(x * y ^ 2 + 2 * x * y + x + y + 1, "xy^2+2xy+x+y+1")
    assert_factor_preserves((x + y + z) * (x ^ 2 + y ^ 2 + z ^ 2), "(x+y+z)(x^2+y^2+z^2)")
    assert(str(cas.factor(x ^ 3 + x ^ 2 * y + y ^ 3 + y ^ 2 * x)) == str(cas.factor(cas.factor(x ^ 3 + x ^ 2 * y + y ^ 3 + y ^ 2 * x))), "idempotent")
    assert(str(cas.factor((x + y + z) * (x ^ 2 + y ^ 2 + z ^ 2))) == str(cas.factor(cas.factor((x + y + z) * (x ^ 2 + y ^ 2 + z ^ 2)))), "idempotent 3-var")
}
test_factor_linear_factors()

// =====================================================================
// 下游算法必须返回 cas.simplify 的规范形
//   即 simplify(f(e)) == f(e)（f = integ / diff）。
//   此前 integ / diff 的出口用的是轻量 simplify、limit / taylor 出口什么都不做，
//   于是这个不变量被打破，下游之间按结构做的去重/缓存建立在不一致的表示上。
//   实测 21 个下游用例里 2 个不一致：
//       integ(x*log(x)) = 1/2*x^2*log(x) - 1/4*x^2     （规范形提出公共 x^2）
//       diff(exp(x)/x)  = exp(x)*x^(-1) - exp(x)*x^(-2)（规范形合并成 exp(x)*(x-1)/x^2）
//   规范形还明显更紧凑，下面若干条同时钉住"是规范形"和"确实压缩了"。
// =====================================================================
test_downstream_returns_canonical_form() = {
    x = sym("x")

    // 精确形态：既规范、又比展开形紧凑
    assert(str(cas.diff((x + 1) ^ 6, x)) == "6 * (x + 1)^5", "diff((x+1)^6)")
    assert(str(cas.diff((x - 2) ^ 4, x)) == "4 * (x - 2)^3", "diff((x-2)^4)")
    assert(str(cas.diff(x ^ 2 * exp(x), x)) == "exp(x) * x * (x + 2)", "diff(x^2*exp(x))")
    assert(str(cas.diff(exp(x) / x, x)) == "exp(x) * (x - 1) * x^(-2)", "diff(exp(x)/x)")
    assert(str(cas.integ(x * log(x), x)) == "x^2 * (1/2 * log(x) - 1/4)", "integ(x*log(x))")
    assert(str(cas.integ(x * exp(x), x)) == "exp(x) * (x - 1)", "integ(x*exp(x))")
    assert(str(cas.integ(cos(x) * sin(x), x)) == "-1/2 * cos(x)^2", "integ(cos(x)*sin(x))")
    assert(str(cas.integ(1 / (x ^ 2 - 1), x)) == "-1/2 * log(x + 1) + 1/2 * log(x - 1)", "integ(1/(x^2-1))")

    // 不变量本体：simplify(f(e)) 必须等于 f(e)
    can(name, r) = {
        assert(str(cas.simplify(r)) == str(r),
               name + ": downstream result is not in canonical form; simplify gave " + str(cas.simplify(r)));
    }
    can("integ x^2", cas.integ(x ^ 2, x))
    can("integ 1/x", cas.integ(1 / x, x))
    can("integ sin(x)", cas.integ(sin(x), x))
    can("integ cos(x)*sin(x)", cas.integ(cos(x) * sin(x), x))
    can("integ x*exp(x)", cas.integ(x * exp(x), x))
    can("integ x*log(x)", cas.integ(x * log(x), x))
    can("integ 1/(x^2+1)", cas.integ(1 / (x ^ 2 + 1), x))
    can("integ 1/(x^2-1)", cas.integ(1 / (x ^ 2 - 1), x))
    can("integ (x^5-1)/(x-1)", cas.integ((x ^ 5 - 1) / (x - 1), x))
    can("integ exp(x)*sin(x)", cas.integ(exp(x) * sin(x), x))
    can("integ (x+1)/(x^2+2x+1)", cas.integ((x + 1) / (x ^ 2 + 2 * x + 1), x))
    can("diff x^2", cas.diff(x ^ 2, x))
    can("diff (x+1)^6", cas.diff((x + 1) ^ 6, x))
    can("diff exp(x)/x", cas.diff(exp(x) / x, x))
    can("diff sin(x)*cos(x)", cas.diff(sin(x) * cos(x), x))
    can("diff (x^2-1)/(x+1)", cas.diff((x ^ 2 - 1) / (x + 1), x))
}
test_downstream_returns_canonical_form()

// =====================================================================
// expand 必须合并同类项
//   多项式定理天然会产出同类的项（(A+C) 与 B² 都可能给出 x^2*y^2），而幂次展开的
//   出口曾为了省开销直接 makeAdd、绕过 operator+ 的合并，于是重复的单项式一直挂在
//   树里 —— 这正是「expand 出来的树压不下去」。下面每条都钉住合并后的精确形态。
//   顺带钉住完全幂嗅探的读法：它的 R = nextCoeff/(N*lead) 曾用 simplifyCore 而留下
//   1/3*(3*y+3*z) 这种形态（值对，但读不出来）。
// =====================================================================
test_expand_merges_like_terms() = {
    x = sym("x")
    y = sym("y")
    z = sym("z")

    // 同类项合并：旧输出里 2*x^2*y^2 与 4*x^2*y^2 并存
    assert(str(cas.expand(((x + y) ^ 2 + z) ^ 2)) ==
           "4 * x^3 * y + 4 * y^3 * x + 6 * x^2 * y^2 + x^4 + y^4 + 2 * x^2 * z + 2 * y^2 * z + 4 * x * y * z + z^2",
           "expand(((x+y)^2+z)^2) must merge x^2*y^2 terms")
    // 旧输出里 2*x*y 出现两次
    assert(str(cas.expand((x * y + x + y + 1) ^ 2)) ==
           "x^2 * y^2 + 2 * x^2 * y + 2 * y^2 * x + 4 * x * y + x^2 + y^2 + 2 * x + 2 * y + 1",
           "expand((xy+x+y+1)^2) must merge x*y terms")
    // 旧输出里 x^2*y^2 出现两次
    assert(str(cas.expand((x ^ 2 + x * y + y ^ 2) ^ 2)) ==
           "2 * x^3 * y + 2 * y^3 * x + 3 * x^2 * y^2 + x^4 + y^4",
           "expand((x^2+xy+y^2)^2) must merge x^2*y^2 terms")
    // 其余既有形态不能被合并改动
    assert(str(cas.expand((x + y) ^ 2 * (x - y) ^ 2)) == "-2 * x^2 * y^2 + x^4 + y^4", "expand((x+y)^2(x-y)^2)")
    assert(str(cas.expand((x + y) * (x + z) * (y + z))) ==
           "2 * x * y * z + x^2 * y + x^2 * z + y^2 * x + y^2 * z + z^2 * x + z^2 * y", "expand((x+y)(x+z)(y+z))")
    assert(str(cas.expand((x + y) ^ 3)) == "3 * x^2 * y + 3 * y^2 * x + x^3 + y^3", "expand((x+y)^3)")
    assert(str(cas.expand((x + y + z) ^ 3)) ==
           "3 * x^2 * y + 3 * x^2 * z + 3 * y^2 * x + 3 * y^2 * z + 3 * z^2 * x + 3 * z^2 * y + 6 * x * y * z + x^3 + y^3 + z^3",
           "expand((x+y+z)^3)")
    // 超越函数与根式同样要合并
    assert(str(cas.expand((exp(x) + x) ^ 2)) == "2 * exp(x) * x + exp(x)^2 + x^2", "expand((exp(x)+x)^2)")
    assert(str(cas.expand((sqrt(x) + 1) ^ 2)) == "x + 2 * sqrt(x) + 1", "expand((sqrt(x)+1)^2)")

    // 完全幂嗅探的读法：R 必须约分干净、首项系数的 N 次根要分配进底数
    assert(str(cas.simplify(cas.expand((x + y + z) ^ 3))) == "(x + y + z)^3", "perfect cube of a 3-term sum")
    assert(str(cas.simplify(cas.expand(((x + y) ^ 2 + z) ^ 2))) == "(2 * x * y + x^2 + y^2 + z)^2", "perfect square with a multi-term base")
    assert(str(cas.simplify(cas.expand((2 * x + 3 * y) ^ 3))) == "(2 * x + 3 * y)^3", "perfect cube with a leading coefficient")
    assert(str(cas.simplify(cas.expand((x + y) ^ 4))) == "(x + y)^4", "perfect 4th power")

    // 展开必须保值：expand(e) 与 e 的差化简后为零
    assert(str(cas.simplify(cas.expand(((x + y) ^ 2 + z) ^ 2) - ((x + y) ^ 2 + z) ^ 2)) == "0", "expand preserves value (1)")
    assert(str(cas.simplify(cas.expand((x * y + x + y + 1) ^ 2) - (x * y + x + y + 1) ^ 2)) == "0", "expand preserves value (2)")
    assert(str(cas.simplify(cas.expand((x + y + z) ^ 3) - (x + y + z) ^ 3)) == "0", "expand preserves value (3)")
}
test_expand_merges_like_terms()

// =====================================================================
// 多项式的完全幂（底面是高次多项式的 P = Q^N）
//   此前只能识别底面为 (mainVar + c) 的完全幂，(x^2+x*y+y^2)^2 这种够不着。
//   实现用"逐项剥皮"开方，最后一定验证 Q^N == P 才返回，所以既要钉住"该认的认出来"，
//   也要钉住"不可约的不能被硬开方"（开方的验证一旦写松就会静默错答）。
// =====================================================================
test_factor_polynomial_perfect_power() = {
    x = sym("x")
    y = sym("y")

    // 底面为高次多项式的完全幂
    assert(str(cas.factor(2 * x ^ 3 * y + 2 * y ^ 3 * x + 3 * x ^ 2 * y ^ 2 + x ^ 4 + y ^ 4)) == "(x^2 + x * y + y^2)^2",
           "factor((x^2+xy+y^2)^2) by expanding")
    assert(str(cas.simplify(2 * x ^ 3 * y + 2 * y ^ 3 * x + 3 * x ^ 2 * y ^ 2 + x ^ 4 + y ^ 4)) == "(x^2 + x * y + y^2)^2",
           "simplify((x^2+xy+y^2)^2) by expanding")
    assert(str(cas.factor(x ^ 4 + 2 * x ^ 2 * y ^ 2 + y ^ 4)) == "(x^2 + y^2)^2", "factor((x^2+y^2)^2)")
    assert(str(cas.factor((x ^ 2 + x * y + y ^ 2) ^ 2)) == "(x^2 + x * y + y^2)^2", "factor of the factored form")

    // ★ 底面必须继续分解：不能返回"底数尚可再分解"的完全幂。
    //   (x-1)^2*(x-2)^2 若被写成 (x^2-3*x+2)^2，就把两个线性因子的根藏进了一个
    //   二次式，而且节点数一样多、尺寸守卫拦不住。
    assert(str(cas.factor((x - 1) ^ 2 * (x - 2) ^ 2)) == "(x - 1)^2 * (x - 2)^2", "base must be factored (1)")
    assert(str(cas.factor((x + 1) ^ 3 * (x - 2) ^ 3)) == "(x + 1)^3 * (x - 2)^3", "base must be factored (2)")

    // 不可约的必须原样留下 —— 开方的验证不能写松
    assert(str(cas.factor(x ^ 2 + x * y + y ^ 2)) == "x^2 + x * y + y^2", "x^2+xy+y^2 is irreducible")
    assert(str(cas.factor(x ^ 4 + y ^ 4)) == "x^4 + y^4", "x^4+y^4 is irreducible")
    assert(str(cas.factor(x ^ 4 + x * y + y ^ 4)) == "x^4 + y^4 + x * y", "x^4+xy+y^4 is irreducible")
    assert(str(cas.factor(x ^ 2 + 2 * x * y + y ^ 2 + 1)) == "2 * x * y + x^2 + y^2 + 1", "x^2+2xy+y^2+1 is irreducible")
    assert(str(cas.factor(x ^ 4 + y ^ 4 + 1)) == "x^4 + y^4 + 1", "x^4+y^4+1 is irreducible")
    assert(str(cas.factor(x ^ 4 + 2 * x ^ 2 * y + y ^ 2 + 1)) == "x^4 + 2 * x^2 * y + y^2 + 1", "not a perfect square")

    // 既有能力不能被改坏
    assert(str(cas.factor(8 * x ^ 3 + 27 * y ^ 3)) == "(-6 * x * y + 4 * x^2 + 9 * y^2) * (2 * x + 3 * y)", "cube identity unchanged")
    assert(str(cas.factor(x ^ 4 - y ^ 4)) == "-(-x + y) * (x + y) * (x^2 + y^2)", "difference of squares unchanged")
    assert(str(cas.factor((x + y) * (x + y))) == "(x + y)^2", "perfect square of a linear form unchanged")
    assert(str(cas.factor(x ^ 6 + 3 * x ^ 4 * y ^ 2 + 3 * x ^ 2 * y ^ 4 + y ^ 6)) == "(x^2 + y^2)^3", "perfect cube")

    // 值保真
    assert_factor_preserves(2 * x ^ 3 * y + 2 * y ^ 3 * x + 3 * x ^ 2 * y ^ 2 + x ^ 4 + y ^ 4, "(x^2+xy+y^2)^2")
    assert_factor_preserves(x ^ 4 + x * y + y ^ 4, "x^4+xy+y^4")
}
test_factor_polynomial_perfect_power()
