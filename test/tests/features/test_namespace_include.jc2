// Include merge must not partially mutate on conflict.
caught = false
try {
    namespace Bad {
        include namespace { a = 1 }
        include namespace { a = 2 }
        c = 3
    }
} catch (e) {
    caught = true
    assert("Include conflict" in e.message, "include conflict message")
}
assert(caught, "include conflict must throw")

namespace Good {
    include namespace { a = 1 }
    include namespace { b = 2 }
    c = 3
}
assert(Good.a == 1 && Good.b == 2 && Good.c == 3, "include success")

// A failed namespace construction must not leave a pending include context.
try {
    namespace Leak {
        include namespace { x = 1 }
        throw ValueError("boom")
    }
} catch (e) {}

leaked = false
try {
    include namespace { y = 2 }
} catch (e) {
    leaked = true
}
assert(leaked, "pending namespace context must be cleaned")

// 	ry include import math must still bind math in the namespace.
namespace WithTry {
    try include import math
}
assert(WithTry.math != none, "try include import binds math")

// local import must stay local even inside try/include.
namespace WithLocal {
    try include local import math
}
assert(!("math" in getFields(WithLocal)), "local import must not become a field")
assert(WithLocal.PI != none, "include still merges math fields")

// Private fields stay private; const fields keep their constness.
namespace ConstSrc {
    const c = 1
    local hidden = 2
    vis = 3
    get() = hidden
}
namespace ConstDst {
    include ConstSrc
}
assert(ConstDst.c == 1, "include copies const field")
assert(ConstDst.vis == 3, "include copies public field")
assert(ConstDst.get() == 2, "include keeps closure over private field")
assert(!("hidden" in getFields(ConstDst)), "include does not copy private field")
threw = false
try { ConstDst.c = 9 } catch (e) { threw = true }
assert(threw, "included const field remains read-only")

// A direct namespace field must not overwrite an included member.
try {
    namespace BadBefore {
        c = 1
        include ConstSrc
    }
    assert(false, "direct field before include must conflict")
} catch (e) {
    assert("Include conflict" in e.message, "direct-before conflict message")
}
try {
    namespace BadAfter {
        include ConstSrc
        c = 1
    }
    assert(false, "direct field after include must conflict")
} catch (e) {
    assert("Include conflict" in e.message, "direct-after conflict message")
}

// Namespace functions are lexical closures: exported x is the final value,
// but later N.x writes do not rewrite the captured binding.
namespace Lex {
    x = 1
    f() = x
    x = 2
}
assert(Lex.x == 2, "namespace exports captured final value")
assert(Lex.f() == 2, "namespace function sees captured value")
Lex.x = 5
assert(Lex.f() == 2, "namespace function keeps lexical capture")

print("namespace include battery OK")
