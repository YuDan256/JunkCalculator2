// ═══════════════════════════════════════════════════════════════
// Coroutines: spawn/yield execution bodies
// ═══════════════════════════════════════════════════════════════

{
test_task_basic() = {
    f() = {
        local sent = yield 1
        yield sent + 10
        return 99
    }
    job = spawn f()
    assert(job.resume() == 1, "first yield")
    assert(job.resume(5) == 15, "resume send value")
    assert(job.join() == 99, "join result")
    assert(!job.isAlive(), "finished task is not alive")
}
test_task_basic()

test_task_for() = {
    rangeLike(n) = {
        local i = 0
        while (i < n) {
            yield i
            i += 1
        }
    }
    job = spawn rangeLike(3)
    out = @[]
    while (job.isAlive()) {
        local v = job.resume()
        if (job.isAlive()) out.push(v)
    }
    assert(out == @[0, 1, 2], "manual iteration over task yields")
}
test_task_for()

test_task_conditional_yield() = {
    maybe(x) = {
        if (x) yield 1
        return 2
    }
    job = spawn maybe(true)
    assert(job.resume() == 1, "conditional yield")
    assert(job.join() == 2, "conditional join")

    direct = spawn maybe(false)
    assert(direct.join() == 2, "non-yielding task result")
}
test_task_conditional_yield()

test_task_cancel() = {
    t = spawn {
        yield 1
        yield 2
    }
    assert(t.isAlive(), "new task alive")
    assert(t.resume() == 1, "cancel first yield")
    t.cancel()
    assert(!t.isAlive(), "cancelled task not alive")
    caught = false
    try {
        t.join()
    } catch (e) {
        caught = true
    }
    assert(caught, "join cancelled task raises")
}
test_task_cancel()

test_task_spawn_block() = {
    t = spawn {
        return 7
    }
    assert(t.join() == 7, "spawn block result")
}
test_task_spawn_block()

test_task_nested_body() = {
    inner() = {
        yield 1
    }
    outer() = {
        inner()
        return 2
    }
    job = spawn outer()
    assert(job.resume() == 1, "nested yield suspends whole body")
    assert(job.join() == 2, "nested body resumes")
}
test_task_nested_body()

test_task_nested_join() = {
    inner() = {
        yield 1
        return 20
    }
    t = spawn {
        local sub = spawn inner()
        return sub.join() + 2
    }
    assert(t.join() == 22, "nested task join")
}
test_task_nested_join()

test_task_failure() = {
    t = spawn {
        yield 1
        throw "task-boom"
    }
    assert(t.resume() == 1, "failure first yield")
    firstMessage = ""
    try {
        t.join()
    } catch (e) {
        firstMessage = e.message
    }
    assert(firstMessage != "", "task failure propagates")
    assert(t.done(), "failed task is terminal")
    assert(t.failed(), "failed task flag")
    secondMessage = ""
    try {
        t.join()
    } catch (e) {
        secondMessage = e.message
    }
    assert(secondMessage == firstMessage, "failed task rethrows original error")
    assert(t.error() != none, "failed task keeps error")
}
test_task_failure()

test_task_gc() = {
    import sys
    f() = {
        local payload = @[10, 20, 30]
        local sent = yield payload[0]
        return payload[1] + sent
    }
    job = spawn f()
    assert(job.resume() == 10, "gc stress first value")
    sys.gc()
    sys.gc()
    assert(job.resume(5) == 25, "gc preserves suspended frames")

    inner() = {
        local p = @[1, 2]
        yield p[0]
        return p[1]
    }
    outer() = {
        local x = inner()
        return x + 1
    }
    nested = spawn outer()
    assert(nested.resume() == 1, "gc nested first value")
    sys.gc()
    sys.gc()
    assert(nested.resume(5) == 3, "gc preserves nested frame stack")
}
test_task_gc()

test_task_type_values() = {
    t = spawn { return 1 }
    assert(type(t) == task, "task builtin type")
    assert(str(t) == "<task>", "task representation")
}
test_task_type_values()

test_task_jit_deopt() = {
    f() = { yield 1 }
    local i = 0
    while (i < 1100) {
        f()
        i += 1
    }
    assert(!__dbg_is_jitted(f), "task functions must deopt to interpreter")
}
test_task_jit_deopt()
}
