import bytes
import decimal
import tensor
// 测试类型反射与向后兼容性
test_type_reflection() = {
    assert(type(5) == int, "type(5) should be int")
    assert(type("hello") == string, "type('hello') should be string")
    assert(type(int) == type, "type(int) should be type")
    
    // 类型查询用 in 运算符（type == string 已废除）
    assert(5 in int, "5 in int should work")
    assert(!("hello" in int), "'hello' should not be in int")
    
    class Point {}
    p = Point()
    assert(type(Point) == class_type, "type of class definition should be class_type")
    assert(type(p) == Point, "type of instance should be the class")
}
test_type_reflection()

// 测试类型代数（并集、交集与隐式提升）
test_type_algebra() = {
    U = int | string
    assert(str(U) == "<type 'int | string'>" || str(U) == "<type 'string | int'>", "Union string representation")
    
    I = (int | string) & int
    assert(I == int, "Intersection should simplify to int")
    
    E = int & string
    assert(str(E) == "<type 'never'>", "Empty intersection should be never")
    
    class Point {}
    C = int | Point
    assert(type(C) == type, "Implicit class promotion should result in a type object")
}
test_type_algebra()

// 测试函数参数与返回值的类型注解断言
test_type_annotations() = {
    f(x: int | string) = x
    
    assert(f(5) == 5, "Annotation should accept int")
    assert(f("hi") == "hi", "Annotation should accept string")
    
    caught_param = false
    try {
        f(3.14)
    } catch (e) {
        caught_param = true
        assert(e.type == "TypeError", "Should throw TypeError for float")
    }
    assert(caught_param, "Should throw on invalid param type")
    
    g(x) -> float = x
    assert(g(3.14) == 3.14, "Return type float accepted")
    
    caught_return = false
    try {
        g("hi")
    } catch (e) {
        caught_return = true
        assert(e.type == "TypeError", "Should throw TypeError on invalid return type")
    }
    assert(caught_return, "Should throw on invalid return type")
}
test_type_annotations()

// 测试类型对象的可调用性（作为构造函数）
test_callable_types() = {
    assert(int(3.14) == 3, "int type should be callable")
    assert(string(42) == "42", "string type should be callable")
    assert(list(1, 2) == @[1, 2], "list type should be callable")
}
test_callable_types()

// 空矩阵为假，非空矩阵（即使全 0）为真
test_matrix_truthiness() = {
    assert(bool(zeros(1, 0)) == false, "1x0 matrix is falsy")
    assert(bool(zeros(0, 1)) == false, "0x1 matrix is falsy")
    assert(bool(zeros(0, 0)) == false, "0x0 matrix is falsy")
    assert(bool(zeros(1, 1)) == true, "1x1 zero matrix is still truthy")
    assert(bool(zeros(2, 2)) == true, "2x2 zero matrix is still truthy")
    assert(!zeros(0, 1), "empty matrix negates as falsy")

    if (zeros(0, 1)) { assert(false, "empty matrix must not take the if-branch") }
    assert(zeros(5, 5) ? true : false, "non-empty matrix takes the if-branch")
}
test_matrix_truthiness()

// 空 range 为假
test_range_truthiness() = {
    assert(bool(range(0)) == false, "range(0) is falsy")
    assert(bool(range(5)) == true, "range(5) is truthy")
    assert(bool(range(3, 3)) == false, "range(3,3) is empty and falsy")
    assert(bool(range(0, 0)) == false, "range(0,0) is empty and falsy")
    assert(bool(range(5, 1)) == false, "range(5,1) is empty and falsy")
    assert(bool(range(5, 1, -1)) == true, "range(5,1,-1) has elements and is truthy")
    assert(!range(0), "empty range negates as falsy")

    if (range(0)) { assert(false, "empty range must not take the if-branch") }
    assert(range(4) ? true : false, "non-empty range takes the if-branch")
}
test_range_truthiness()
// 原生容器类：空为假，非空为真
test_native_container_truthiness() = {
    assert(bool(bytes.Bytes(0)) == false, "empty Bytes is falsy")
    assert(bool(bytes.Bytes(4)) == true, "non-empty Bytes is truthy")
    assert(bool(bytes.fromHex("")) == false, "empty fromHex result is falsy")
    assert(len(bytes.Bytes(3)) == 3, "Bytes __len__")

    assert(bool(decimal.Decimal("0")) == false, "Decimal zero is falsy")
    assert(bool(decimal.Decimal("1")) == true, "Decimal one is truthy")
    assert(bool(tensor.zeros(@[0])) == false, "empty Tensor is falsy")
    assert(bool(tensor.zeros(@[3])) == true, "non-empty Tensor is truthy")
}
test_native_container_truthiness()

// getFields 只列出可访问的成员
class Reflected {
    shown = 7
    local hidden() = return 1
    init() = %{ }
}

test_getfields_lists_only_accessible() = {
    r = Reflected()
    f = getFields(r)
    assert("shown" in f, "public field must be listed")
    assert(!("hidden" in f), "private method must not be listed")
    for (k in f) {
        assert(hasField(r, k), "every listed field must be accessible: " + k)
        assert(!k.startsWith("<"), "internal name must not be listed: " + k)
    }
}
test_getfields_lists_only_accessible()

test_basic_truthiness() = {
    assert(!list(), "empty list is falsy")
    assert(!dict(), "empty dict is falsy")
    assert(!set(), "empty set is falsy")
    assert(!"", "empty string is falsy")
    assert(!none, "none is falsy")
    assert(!0 && !0.0, "numeric zero is falsy")

    assert(list(1), "non-empty list is truthy")
    assert(%{a: 1}, "non-empty dict is truthy")
    assert(set(1), "non-empty set is truthy")
    assert("x", "non-empty string is truthy")
    assert(1 && -1, "non-zero numbers are truthy")
}
test_basic_truthiness()

test_type_identity_and_union() = {
    assert(type(1) == int, "type(1) == int")
    assert(type(1.0) == float, "type(1.0) == float")
    assert(type(int) == type, "type of a type is type")
    assert(1 in int, "primitive membership in int")
    assert(!isinstance(1, int), "isinstance is for class instances, not primitives")

    x: int | float = 1
    y: int | float = 1.0
    assert(x == 1 && y == 1.0, "union type accepts both")

    threw = false
    try { eval("bad: int = true") } catch (e) { threw = true }
    assert(threw, "bool is not int for type assertions")
}
test_type_identity_and_union()


test_value_copy_and_index() = {
    a = @[1, 2]
    b = a
    b.push(3)
    assert(a.len() == 3, "assignment shares the list")

    n = @[@[1]]
    d = copy(n)
    d[0].push(2)
    assert(n[0].len() == 1 && d[0].len() == 2, "copy is deep")

    u = copy(n, false)
    u[0].push(3)
    assert(n[0].len() == 1 && u[0].len() == 2, "copy false is mutable")

    f = copy(n, true)
    threw = false
    try { f[0].push(4) } catch (e) { threw = true }
    assert(threw, "copy true is frozen")

    l = @[10, 20, 30]
    assert(l[-1] == 30, "negative index")
    assert(l[1:3] == @[20, 30], "slice")
    threw = false
    try { l[9] } catch (e) { threw = true }
    assert(threw, "out of bounds")

    assert("abc"[1] == "b", "string index")
    assert("abc"[1:3] == "bc", "string slice")
}
test_value_copy_and_index()
