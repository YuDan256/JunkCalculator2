test_basic_class() = {
    class Point {
        init(x, y) = {
            self.x = x
            self.y = y
        }
        move(dx, dy) = {
            self.x += dx
            self.y += dy
        }
    }
    p = Point(10, 20)
    assert(p.x == 10 && p.y == 20, "Class init failed")
    
    p.move(5, -5)
    assert(p.x == 15 && p.y == 15, "Class method failed")
}
test_basic_class()

test_inheritance() = {
    class Animal {
        speak() = "..."
    }
    class Dog extends Animal {
        speak() = "Woof"
    }
    a = Animal()
    d = Dog()
    assert(a.speak() == "...", "Base method failed")
    assert(d.speak() == "Woof", "Overridden method failed")
}
test_inheritance()

test_dunder_methods() = {
    class Vector {
        init(x, y) = { 
            self.x = x
            self.y = y 
        }
        __add__(other) = Vector(self.x + other.x, self.y + other.y)
        __eq__(other) = self.x == other.x && self.y == other.y
    }
    v1 = Vector(1, 2)
    v2 = Vector(3, 4)
    v3 = v1 + v2
    assert(v3 == Vector(4, 6), "Dunder __add__ or __eq__ failed")
}
test_dunder_methods()

test_super_call() = {
    class Base {
        greet() = "Hello from Base"
    }
    class Derived extends Base {
        greet() = super.greet() + " and Derived"
    }
    obj = Derived()
    assert(obj.greet() == "Hello from Base and Derived", "Super method call failed")
}
test_super_call()

test_anonymous_class_and_self_ref() = {
    const Point = class {
        init(x, y) = { 
            self.x = x
            self.y = y 
        }
        // 使用 class 关键字进行自引用实例化
        clone() = class(self.x, self.y)
        // 返回当前类对象
        get_class() = class
    }
    
    p1 = Point(10, 20)
    p2 = p1.clone()
    
    assert(p1 != p2, "Clone should be a new instance (reference inequality)")
    assert(p2.x == 10 && p2.y == 20, "Clone should have the same field values")
    assert(p1.get_class() == Point, "The 'class' keyword should evaluate to the class object itself")
}
test_anonymous_class_and_self_ref()

test_anonymous_class_keeps_its_name() = {
    // 回归：匿名 class / trait 的显示名必须来自定义本身，不能来自绑定位置。
    // 曾把赋值目标名写进 Class 节点，于是 `a = class {}` 显示 <class a>，
    // 且换绑（b = a）仍显示 <class a> —— 名字成了绑定的属性而非对象的属性。
    // 现在保持空名，统一显示 <anonymous class>，与匿名 enum 的既有做法一致。
    local A = class {}
    local B = trait {}
    local C = class {}
    assert(str(A) == "<anonymous class>", "an anonymous class does not inherit the variable name")
    assert(str(B) == "<anonymous class>", "nor does an anonymous trait")
    assert(str(C) == "<anonymous class>", "nor a second one bound elsewhere")
    assert(str(A) == str(C), "two anonymous classes display the same way")
    assert(A != C, "but they are still distinct objects")

    // 匿名 namespace 同一口径（class / trait / namespace 一致的规则）
    local NS = namespace {}
    assert(str(NS) == "<anonymous namespace>", "an anonymous namespace does not inherit the variable name")

    // 具名定义不受影响
    local Named = class Named {}
    assert(str(Named) == "<class Named>", "a named class still shows its name")
    local NamedNS = namespace NamedNS {}
    assert(str(NamedNS) == "<namespace NamedNS>", "a named namespace still shows its name")
    // 匿名 trait 仍是 trait
    assert(istrait(B), "an anonymous trait is still a trait")
}
test_anonymous_class_keeps_its_name()

test_access_control() = {
    throws(f) = { try { f(); return false } catch (e) { return true } }
    class Account {
        const id = 12345
        local balance = 0
        static local const MAX = 999
        static const MIN = 0
        
        init(b) = {
            self.balance = b
        }
        
        local helper() = self.balance * 2
        
        get_balance() = self.balance
        get_helper() = self.helper()
        static get_max() = Account.MAX
        
        test_reflection() = {
            assert(self["balance"] == 100, "Reflection read failed inside class")
            self["balance"] = 300
            assert(self.balance == 300, "Reflection write failed inside class")
            assert("balance" in self, "Reflection 'in' failed inside class")
            self.balance = 100 // restore
        }
    }
    
    acc = Account(100)
    
    // Public const
    assert(acc.id == 12345, "Public const read failed")
    assert(throws(() => acc.id = 54321), "Public const should be read-only")
    
    // Private instance field
    assert(acc.get_balance() == 100, "Private field internal read failed")
    acc.test_reflection()
    assert(throws(() => acc.balance), "Private field should be invisible externally")
    acc.balance = 200
    assert(acc.balance == 200, "Public property can shadow private name externally")
    assert(acc.get_balance() == 100, "Private field remains unaffected by public shadowing")
    
    // Private instance method
    assert(acc.get_helper() == 200, "Private method internal call failed")
    assert(throws(() => acc.helper()), "Private method should be invisible externally")
    
    // Static const
    assert(Account.MIN == 0, "Static const read failed")
    assert(throws(() => Account.MIN = 1), "Static const should be read-only")
    
    // Static private const
    assert(Account.get_max() == 999, "Static private const internal read failed")
    assert(throws(() => Account.MAX), "Static private const should be invisible externally")
    
    // Static method tearing
    f = Account.get_max
    assert(f() == 999, "Static method tearing lost class context")
}
test_access_control()

test_private_inheritance() = {
    throws(f) = { try { f(); return false } catch (e) { return true } }
    class Parent {
        local secret = 42
        local hidden() = 100
        get_secret() = self.secret
    }
    class Child extends Parent {
        init() = { super.init() }
        try_access() = self.secret
        try_call() = self.hidden()
    }
    
    c = Child()
    assert(c.get_secret() == 42, "Parent method should access its own private field")
    assert(throws(() => c.try_access()), "Child should not access parent's private field")
    assert(throws(() => c.try_call()), "Child should not access parent's private method")
}
test_private_inheritance()
