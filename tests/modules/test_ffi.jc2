import ffi
import bytes

test_ffi_load_error() = {
    try {
        ffi.FFILibrary("non_existent_library_12345.dll")
        assert(false, "Should throw error for non-existent library")
    } catch (e) {
        assert("Failed to load library" in e.message, "Wrong error message thrown for FFILibrary")
    }
}
test_ffi_load_error()

test_ffi_real_call() = {
    lib = none
    
    try {
        lib = ffi.FFILibrary("msvcrt.dll") // Windows x64
    } catch (e) {
        print("Warning: msvcrt.dll not found, skipping real FFI tests.")
        return
    }
    
    if (lib != none) {
        // Test 1: Math function (f64)
        // double pow(double x, double y)
        c_pow = lib.bind("pow", "f64", "f64", "f64")
        assert(isinstance(c_pow, ffi.FFIFunction), "bind should return FFIFunction")
        
        res = c_pow(2.0, 10.0)
        assert(res == 1024.0, "FFI pow(2.0, 10.0) failed")

        // Test 2: String function (string -> u64)
        // size_t strlen(const char *str)
        c_strlen = lib.bind("strlen", "u64", "string")
        len_res = c_strlen("hello ffi")
        assert(len_res == 9, "FFI strlen failed")

        // Test 3: Pointer and Buffer interaction
        // void *memset(void *dest, int c, size_t count)
        c_memset = lib.bind("memset", "pointer", "pointer", "i32", "u64")
        
        buf = bytes.alloc(10)
        c_memset(buf, 255, buf.len())
        
        buf.seek(0)
        assert(buf.readU8() == 255, "FFI memset failed to modify buffer start")
        buf.seek(9)
        assert(buf.readU8() == 255, "FFI memset failed to modify buffer end")

        // Test readMemory / writeMemory
        ffi.writeMemory(buf, "i32", 123456789)
        assert(ffi.readMemory(buf, "i32") == 123456789, "ffi.readMemory/writeMemory failed")

        // Test 4: Variadic function
        // int printf(const char *format, ...)
        c_printf = lib.bind("printf", "i32", "string", "...")
        // We can't easily assert stdout, but we can assert it doesn't crash and returns > 0
        printed_chars = c_printf("FFI Variadic Test: %d, %f, %s\n", 42, 3.14, "success")
        assert(printed_chars > 0, "FFI printf failed")

        // Test 5: Struct by Value and Pointer
        Point = ffi.Struct({x: "i32", y: "i32"})
        p = Point()
        p.x = 10
        p.y = 20
        assert(p.x == 10, "Struct getattr failed")
        assert(p.y == 20, "Struct getattr failed")
        
        // Test passing struct pointer to memset
        c_memset(p, 0, 8)
        assert(p.x == 0, "Struct memory modification failed")
        assert(p.y == 0, "Struct memory modification failed")

        // Test 6: Struct Return by Value (<= 8 bytes)
        // div_t div(int numer, int denom);
        DivT = ffi.Struct({quot: "i32", rem: "i32"})
        c_div = lib.bind("div", DivT, "i32", "i32")
        div_res = c_div(10, 3)
        assert(div_res.quot == 3, "Struct return by value failed (quot)")
        assert(div_res.rem == 1, "Struct return by value failed (rem)")
    }

    // Test 7: Struct Pass by Value (Windows API)
    try {
        user32 = ffi.FFILibrary("user32.dll")
        Rect = ffi.Struct({left: "i32", top: "i32", right: "i32", bottom: "i32"})
        Point = ffi.Struct({x: "i32", y: "i32"})
        
        // BOOL PtInRect(const RECT *lprc, POINT pt);
        // RECT is passed by pointer, POINT is passed by value (8 bytes)
        PtInRect = user32.bind("PtInRect", "i32", "pointer", Point)
        
        r = Rect()
        r.left = 0; r.top = 0; r.right = 100; r.bottom = 100
        
        p1 = Point(); p1.x = 50; p1.y = 50
        p2 = Point(); p2.x = 150; p2.y = 50
        
        assert(PtInRect(r, p1) != 0, "PtInRect should return true for p1")
        assert(PtInRect(r, p2) == 0, "PtInRect should return false for p2")
    } catch (e) {
        print("Warning: user32.dll not found or failed, skipping PtInRect test.")
    }

    // Test 8: Callbacks (qsort)
    if (lib != none) {
        c_qsort = lib.bind("qsort", "void", "pointer", "u64", "u64", "pointer")
        
        arr_buf = bytes.alloc(16) // 4 ints
        arr_buf.writeI32(40)
        arr_buf.writeI32(10)
        arr_buf.writeI32(30)
        arr_buf.writeI32(20)
        
        cmp_func(p1, p2) = {
            v1 = ffi.readMemory(p1, "i32")
            v2 = ffi.readMemory(p2, "i32")
            if (v1 > v2) return 1
            if (v1 < v2) return -1
            return 0
        }
        
        cb = ffi.Callback(cmp_func, "i32", "pointer", "pointer")
        
        // Reset buffer cursor to 0 before passing its address to C
        arr_buf.seek(0)
        c_qsort(arr_buf, 4, 4, cb)
        
        arr_buf.seek(0)
        assert(arr_buf.readI32() == 10, "qsort callback failed")
        assert(arr_buf.readI32() == 20, "qsort callback failed")
        assert(arr_buf.readI32() == 30, "qsort callback failed")
        assert(arr_buf.readI32() == 40, "qsort callback failed")
    }
}
test_ffi_real_call()
