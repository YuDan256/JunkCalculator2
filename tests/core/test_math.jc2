test_basic_math() = {
    assert(1 + 1 == 2, "Addition failed")
    assert(2 * 3 == 6, "Multiplication failed")
    assert(10 / 2 == 5, "Division failed")
    assert(2 ^ 3 == 8, "Power failed")
    assert(10 % 3 == 1, "Modulo failed")
}
test_basic_math()

test_abs_preserves_numeric_type() = {
    // ★ 回归：abs 曾漏掉 int32 分支，径直落到 std::abs(asFloat())，于是
    //   abs(1) → 1.0（float），而同族的 round/floor/ceil/trunc/sgn 都保持 int，
    //   同一语言两种口径。精确整数值必须在取绝对值后仍是精确整数。
    assert(type(abs(1)) == int, "abs(1) stays int")
    assert(type(abs(-1)) == int, "abs(-1) stays int")
    assert(type(abs(0)) == int, "abs(0) stays int")
    assert(abs(-1) == 1, "and the value is right")
    assert(abs(0) == 0, "abs(0) = 0")

    // 与 round 族口径一致
    assert(type(abs(round(1))) == int, "abs of an int from round() is still int")

    // 边界：INT32_MIN 取绝对值不溢出（经 BigInt 取值）
    assert(abs(-2147483648) == 2147483648, "abs(INT32_MIN) does not overflow")

    // 其它类型的既有行为不变
    assert(type(abs(1 / 2)) == fraction, "abs of a fraction stays fraction")
    assert(str(abs(-1 / 2)) == "1/2", "fraction absolute value")
    assert(type(abs(10 ^ 30)) == int, "abs of a big integer stays int")
    assert(abs(-2.5) == 2.5, "abs of a float stays float")
    assert(type(abs(-2.5)) == float, "and its type is float")
    assert(abs(3 + 4i) == 5.0, "complex modulus is still 5")
}
test_abs_preserves_numeric_type()

test_complex() = {
    c1 = 3 + 4i
    c2 = 1 - 2i
    assert(c1 + c2 == 4 + 2i, "Complex addition failed")
    assert(c1 - c2 == 2 + 6i, "Complex subtraction failed")
    assert(c1 * c2 == 11 - 2i, "Complex multiplication failed")
}
test_complex()

test_fraction() = {
    f1 = frac(1, 2)
    f2 = frac(1, 3)
    assert(f1 + f2 == frac(5, 6), "Fraction addition failed")
    assert(f1 * f2 == frac(1, 6), "Fraction multiplication failed")
    assert(f1 / f2 == frac(3, 2), "Fraction division failed")
}
test_fraction()

test_matrix_math() = {
    m1 = [1, 2; 3, 4]
    m2 = [2, 0; 0, 2]
    
    m_add = m1 + m2
    assert(m_add == [3, 2; 3, 6], "Matrix addition failed")
    
    m_mul = m1 * m2
    assert(m_mul == [2, 4; 6, 8], "Matrix multiplication failed")
    
    m_scale = m1 * 10
    assert(m_scale == [10, 20; 30, 40], "Matrix scalar multiplication failed")
}
test_matrix_math()

// ── 非有限值：nan() / inf() ──
// JC2 禁止除零（0/0、1.0/0.0 均抛 MathError），因此 NaN 只能由 nan() 构造；
// 没有这两个构造器时 isnan/isinf 不可达。
throws(f) = { try { f(); return false } catch (e) { return true } }

test_non_finite() = {
    assert(isnan(nan()), "nan() should be NaN")
    assert(!isnan(1.0), "finite value should not be NaN")
    assert(!isnan("abc"), "non-float should not be NaN")

    assert(isinf(inf()), "inf() should be infinite")
    assert(isinf(-inf()), "-inf() should be infinite")
    assert(!isinf(1.0), "finite value should not be infinite")

    assert(!isfinite(inf()), "inf is not finite")
    assert(!isfinite(nan()), "nan is not finite")
    assert(isfinite(1.0), "1.0 is finite")

    // 除零仍然报错（不是靠产生 inf 来"绕过"）
    assert(throws(() => 1.0 / 0.0), "float division by zero should throw")
    assert(throws(() => 0.0 / 0.0), "0.0/0.0 should throw")

    // 与无穷的算术
    assert(1.0 / inf() == 0.0, "1.0 / inf() should be 0.0")
    assert(inf() > 1.0e308, "inf() should exceed max double")
}
test_non_finite()
