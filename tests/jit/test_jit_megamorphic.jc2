import sys

test_megamorphic() = {
    m = [1, 2; 3, 4]
    s = "A"
    b = 10^30
    c = BaseNum(0, 2) // 使用 BaseNum 确保触发超态位运算回退
    
    n = 0
    while (n < 2000) {
        // 1. Matrix Arithmetic (Megamorphic Math)
        m = m + [1, 1; 1, 1]
        m = m * [1, 0; 0, 1]
        m = m - [0, 0; 0, 0]
        
        // 2. String Concatenation (Monomorphic String)
        if (n % 500 == 0) {
            s = s + "B"
        }
        
        // 3. BigInt Arithmetic (Megamorphic Math)
        b = b + 10^10
        b = b * 2
        b = b ~/ 2
        
        // 4. Bitwise (Megamorphic Bitwise)
        c = BaseNum(n, 2)
        c = (c | 0b1010) & 0b1111
        c = c ^^ 0b0101
        
        // 5. Comparisons (Megamorphic Comparison)
        if (b > 10^35) {
            b = 10^30
        }
        if (s == "ABBBBB") {
            s = "A"
        }
        
        n += 1
    }
    
    return {
        matrix_res: m,
        string_res: s,
        bigint_res: b,
        bitwise_res: c
    }
}

println("==================================================")
println("Step 93: Megamorphic Fallbacks JIT Test")
println("==================================================")

start = sys.clock()
res = test_megamorphic()
end = sys.clock()

println("Result Matrix: ", res.matrix_res)
println("Result String: ", res.string_res)
println("Result BigInt: ", res.bigint_res)
println("Result Bitwise: ", res.bitwise_res)
println(f"Time elapsed: {end - start::.4f} seconds")

// Verify correctness
assert(res.string_res == "ABBBB", "String concatenation failed")
assert(res.matrix_res[0, 0] > 1, "Matrix calculation failed")
assert(res.bigint_res > 10^30, "BigInt calculation failed")

println("==================================================")
println("SUCCESS: Megamorphic JIT Test Passed!")
println("==================================================")
