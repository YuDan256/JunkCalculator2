// 调用窗口解耦的专项回归：尾调用、非尾递归、kwargs、方法调用、调用期 GC、闭包捕获、JIT 热路径
// 背景：VM 的建帧从 "base + 1" 改为"调用方窗口之上"，参数可以待在任意寄存器；
// 只要某个调用形式仍然把基址当帧锚点或写回基址，就会在这组用例里暴露。

// ── 1. 尾调用：帧复用，参数与新帧重叠 ──
sum_tail(n, acc) = {
    if (n == 0) {
        return acc
    }
    return sum_tail(n - 1, acc + n)
}

// ── 2. 非尾递归：窗口叠加 ──
fact(n) = {
    if (n <= 1) {
        return 1
    }
    return n * fact(n - 1)
}

// ── 3. kwargs 与默认值 ──
kw(a, b = 10, c = 20) = a + b + c

// ── 4. 方法与 super ──
class Base {
    init(v) = { self.v = v }
    add(x, y = 1) = self.v + x + y
}
class Derived extends Base {
    init(v) = { super.init(v) }
    twice(x) = self.add(x) + self.add(x, 2)
}

give(x) = {
    // ── 5. 调用期分配：参数 x 必须在 GC 下存活 ──
    junk = @[]
    for (i in range(50)) {
        junk.push(@[i, str(i)])
    }
    return @[x, junk.len()]
}

// ── 6. 闭包捕获：调用不能覆盖被捕获的槽 ──
make_adder(n) = {
    return (x) => x + n
}

// ── 7. JIT 热路径：重复调用小函数 ──
hot(x) = x * 2 + 1

// ── 变量实参：避免常量直写，逼出真实的参数打包 ──
a = 1
b = 2
c = 3

assert(sum_tail(200, 0) == 20100, "tail-position call (200 frames)")
// 真正的 TCO：这个深度远超 1024 帧上限，没有帧复用必然爆栈
assert(sum_tail(20000, 0) == 200010000, "tail call must reuse the frame (TCO)")

// ── 尾调用与异常：try 内不做 TCO，catch 必须还能接住 ──
boom() = { throw "x" }
safe() = {
    try {
        return boom()
    } catch (e) {
        return -1
    }
}
assert(safe() == -1, "tail position inside try keeps the handler")

// ── 尾调用到类构造：实例写在 dst 后再收尾，不能被 init 帧覆盖 ──
class Point2 {
    init(v) = { self.v = v }
}
make_point(v) = { return Point2(v) }
assert(make_point(3).v == 3, "tail call to a class constructor")

// ── 尾调用到原生函数 ──
tail_native(x) = { return len(x) }
assert(tail_native(@[1, 2, 3, 4]) == 4, "tail call to a native builtin")
assert(fact(15) == 1307674368000, "non-tail recursion")
assert(kw(a, b = b, c = c) == 6, "kwargs with all named")
assert(kw(5) == 35, "kwargs defaults")
assert(kw(1, 2) == 23, "positional + default")

d = Derived(10)
assert(d.twice(5) == 33, "method calls with defaults and super.init")

r = give(@[a, b, c])
assert(r[0] == @[1, 2, 3] && r[1] == 50, "argument survives GC during the call")

add7 = make_adder(7)
assert(add7(5) == 12, "closure capture")
assert(add7(a) == 8, "closure capture with variable arg")

s = 0
for (i in range(20000)) {
    s = s + hot(i)
}
assert(s == 400000000, "hot path sum")
print("call window battery OK")
