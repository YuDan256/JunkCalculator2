// discrete.jc2 — Discrete Mathematics Standard Library v2.2.2
// Pure JC2 Implementation with Strict Type Contracts
// ═══════════════════════════════════════════════════════════════

import collections

// ┌────────────────────────────────────────────────────────┐
// │ 1. COMBINATORICS                                       │
// └────────────────────────────────────────────────────────┘

permutations(arr: any) -> list = {
    n = arr.len()
    if (n <= 1) return @[arr]
    res = @[]
    for (i in range(n)) {
        curr = arr[i]
        rest = @[]
        for (j in range(n)) { if (i != j) rest.push(arr[j]) }
        for (p in permutations(rest)) {
            new_p = @[curr]
            for (x in p) new_p.push(x)
            res.push(new_p)
        }
    }
    return res
}

combinations(arr: any, k: int | float) -> list = {
    k = round(k)
    if (k == 0) return @[@[]]
    if (arr.len() < k) return @[]
    if (arr.len() == k) return @[toList(arr)]
    
    res = @[]
    first = arr[0]
    rest = arr[1:]
    
    for (c in combinations(rest, k - 1)) {
        new_c = @[first]
        for (x in c) new_c.push(x)
        res.push(new_c)
    }
    for (c in combinations(rest, k)) { res.push(c) }
    return res
}

// ┌────────────────────────────────────────────────────────┐
// │ 2. PROPOSITIONAL LOGIC (class Prop)                    │
// └────────────────────────────────────────────────────────┘

// 三值求值（模块级私有函数）：未赋值变量返回 none，用于搜索剪枝
local _propEval3(node: any, env: dict) -> any = {
    tp = node.tp
    if (tp == "var") {
        if (node.a in env) return env[node.a] ? true : false
        return none
    }
    if (tp == "not") {
        v = _propEval3(node.a, env)
        if (v is none) return none
        return v ? false : true
    }
    ea = _propEval3(node.a, env)
    eb = _propEval3(node.b, env)
    if (tp == "and") {
        if (ea == false || eb == false) return false
        if (ea == true && eb == true) return true
        return none
    }
    if (tp == "or") {
        if (ea == true || eb == true) return true
        if (ea == false && eb == false) return false
        return none
    }
    if (tp == "imp") {
        if (ea == false || eb == true) return true
        if (ea == true && eb == false) return false
        return none
    }
    if (tp == "iff") {
        if (ea is none || eb is none) return none
        return ea == eb ? true : false
    }
    return none
}

// ── 命题范式：NNF 下推 + 分布律（模块级私有函数）──
// 字面量表示为 @[变量名, 是否取反]；CNF 为子句之合取（@[] 表示 TRUE，含空子句表示 FALSE）；
// DNF 为项之析取（@[] 表示 FALSE，含空项表示 TRUE）。重言子句会被剪除。

local _propNnf(node: any, negate: bool) -> dict = {
    tp = node.tp
    if (tp == "var") return {t: "lit", name: node.a, neg: negate}
    if (tp == "not") return _propNnf(node.a, !negate)
    if (tp == "and") return {t: negate ? "or" : "and", kids: @[_propNnf(node.a, negate), _propNnf(node.b, negate)]}
    if (tp == "or")  return {t: negate ? "and" : "or", kids: @[_propNnf(node.a, negate), _propNnf(node.b, negate)]}
    if (tp == "imp") {
        // a -> b 等价于 !a | b；其否定为 a & !b
        if (negate) return {t: "and", kids: @[_propNnf(node.a, false), _propNnf(node.b, true)]}
        return {t: "or", kids: @[_propNnf(node.a, true), _propNnf(node.b, false)]}
    }
    if (tp == "iff") {
        // a <-> b 等价于 (a & b) | (!a & !b)；其否定为 (a & !b) | (!a & b)
        // 注意两者必须分别写死：若用同一个 negate 参数套两遍，取反分支会退化成原式
        if (negate) return {t: "or", kids: @[
            {t: "and", kids: @[_propNnf(node.a, false), _propNnf(node.b, true)]},
            {t: "and", kids: @[_propNnf(node.a, true), _propNnf(node.b, false)]}
        ]}
        return {t: "or", kids: @[
            {t: "and", kids: @[_propNnf(node.a, false), _propNnf(node.b, false)]},
            {t: "and", kids: @[_propNnf(node.a, true), _propNnf(node.b, true)]}
        ]}
    }
    return {t: "lit", name: "?", neg: false}
}

// 子句/项是否含互补字面量（重言子句 / 矛盾项）
local _hasComplement(lits: list) -> bool = {
    i = 0
    while (i < lits.len()) {
        j = i + 1
        while (j < lits.len()) {
            if (lits[i][0] == lits[j][0] && lits[i][1] != lits[j][1]) return true
            j += 1
        }
        i += 1
    }
    return false
}

local _propToCnf(n: dict) -> list = {
    if (n.t == "lit") return @[@[@[n.name, n.neg]]]
    if (n.t == "and") {
        out = @[]
        for (k in n.kids) { for (cl in _propToCnf(k)) { out.push(cl) } }
        return out
    }
    if (n.t == "or") {
        left = _propToCnf(n.kids[0]); right = _propToCnf(n.kids[1])
        out = @[]
        for (l in left) {
            for (r in right) {
                m = @[]
                for (x in l) { m.push(x) }
                for (y in r) { m.push(y) }
                if (_hasComplement(m)) continue      // 重言子句恒真，可从合取中剪除
                out.push(m)
            }
        }
        return out
    }
    return @[]
}

local _propToDnf(n: dict) -> list = {
    if (n.t == "lit") return @[@[@[n.name, n.neg]]]
    if (n.t == "or") {
        out = @[]
        for (k in n.kids) { for (tm in _propToDnf(k)) { out.push(tm) } }
        return out
    }
    if (n.t == "and") {
        left = _propToDnf(n.kids[0]); right = _propToDnf(n.kids[1])
        out = @[]
        for (l in left) {
            for (r in right) {
                m = @[]
                for (x in l) { m.push(x) }
                for (y in r) { m.push(y) }
                if (_hasComplement(m)) continue      // 矛盾项恒假，可从析取中剪除
                out.push(m)
            }
        }
        return out
    }
    return @[]
}

// 子句级 DPLL：化简 + 单元传播 + 分裂。clauses 为子句列表，字面量 @[变量名, 是否取反]；
// assign 为部分赋值。返回 {sat: bool, env: dict}
local _dpllSolve(clauses: list, assign: dict) -> dict = {
    work = @[]
    for (cl in clauses) {
        satisfied = false
        rest = @[]
        for (lit in cl) {
            if (lit[0] in assign) {
                if (assign[lit[0]] != lit[1]) { satisfied = true; break }   // 字面量已真
            } else {
                rest.push(lit)
            }
        }
        if (satisfied) continue
        if (rest.len() == 0) return {sat: false, env: {}}                   // 空子句：冲突
        work.push(rest)
    }
    if (work.len() == 0) return {sat: true, env: assign}                    // 子句全部满足

    // 单元传播
    for (cl in work) {
        if (cl.len() == 1) {
            assign[cl[0][0]] = !cl[0][1]
            return _dpllSolve(work, assign)
        }
    }

    // 分裂（取第一个子句的第一个字面量）
    v = work[0][0][0]
    a1 = {}
    for (k in assign.keys()) { a1[k] = assign[k] }
    a1[v] = true
    r1 = _dpllSolve(work, a1)
    if (r1.sat) return r1
    a2 = {}
    for (k in assign.keys()) { a2[k] = assign[k] }
    a2[v] = false
    return _dpllSolve(work, a2)
}

// ── 命题文本解析（递归下降）：优先级 <=> 最低，其次 =>，再 |、&、~，原子为变量或括号 ──
// 字符串不支持大小比较（帮助：ordering throws），故字符分类一律用 contains。
_ppSkip(st: dict) = {
    while (st.pos < st.text.len()) {
        c = st.text[st.pos]
        if (c == " " || c == "\t" || c == "\n") { st.pos += 1 } else { break }
    }
}

_ppMatch(st: dict, tok: string) -> bool = {
    _ppSkip(st)
    if (st.text.substr(st.pos, tok.len()) == tok) { st.pos += tok.len(); return true }
    return false
}

_ppAtom(st: dict) -> any = {
    _ppSkip(st)
    if (_ppMatch(st, "(")) {
        e = _ppIff(st)
        if (!_ppMatch(st, ")")) throw ValueError("Prop.parse: missing ')' at position " + str(st.pos))
        return e
    }
    if (_ppMatch(st, "!") || _ppMatch(st, "~")) return -(_ppAtom(st))
    _ppSkip(st)
    start = st.pos
    letters = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_"
    digits = "0123456789"
    while (st.pos < st.text.len()) {
        c = st.text[st.pos]
        if (letters.contains(c)) { st.pos += 1 }
        else if (st.pos > start && digits.contains(c)) { st.pos += 1 }
        else { break }
    }
    if (st.pos == start) throw ValueError("Prop.parse: expected a variable or '(' at position " + str(start))
    return Prop("var", st.text.substr(start, st.pos - start), none)
}

_ppNot(st: dict) -> any = {
    if (_ppMatch(st, "!") || _ppMatch(st, "~")) return -(_ppNot(st))
    return _ppAtom(st)
}

_ppAnd(st: dict) -> any = {
    left = _ppNot(st)
    while (_ppMatch(st, "&")) { left = left & _ppNot(st) }
    return left
}

_ppOr(st: dict) -> any = {
    left = _ppAnd(st)
    while (_ppMatch(st, "|")) { left = left | _ppAnd(st) }
    return left
}

_ppImp(st: dict) -> any = {
    left = _ppOr(st)
    while (true) {
        if (_ppMatch(st, "=>")) { left = left.implies(_ppOr(st)) }
        else if (_ppMatch(st, "->")) { left = left.implies(_ppOr(st)) }
        else { break }
    }
    return left
}

_ppIff(st: dict) -> any = {
    left = _ppImp(st)
    while (true) {
        if (_ppMatch(st, "<=>")) { left = left.iff(_ppImp(st)) }
        else if (_ppMatch(st, "<->")) { left = left.iff(_ppImp(st)) }
        else { break }
    }
    return left
}

class Prop {
    init(tp: string, a: any, b: any) = {
        self.tp = tp
        self.a = a    
        self.b = b    
    }

    __bitand__(other: Prop) -> Prop = return Prop("and", self, other)
    __bitor__(other: Prop) -> Prop  = return Prop("or",  self, other)
    __neg__() -> Prop               = return Prop("not", self, "null")

    implies(other: Prop) -> Prop    = return Prop("imp", self, other)
    iff(other: Prop) -> Prop        = return Prop("iff", self, other)

    eval(env: dict) -> bool = {
        tp = self.tp
        if (tp == "var") return env[self.a] ? true : false
        if (tp == "not") return self.a.eval(env) ? false : true
        
        ea = self.a.eval(env)
        eb = self.b.eval(env)
        if (tp == "and") return (ea && eb) ? true : false
        if (tp == "or")  return (ea || eb) ? true : false
        if (tp == "imp") return (!ea || eb) ? true : false
        if (tp == "iff") return ea == eb ? true : false
        return false
    }

    vars() -> set = {
        tp = self.tp
        if (tp == "var") return set(self.a)
        if (tp == "not") return self.a.vars()
        return self.a.vars() | self.b.vars()
    }

    isTautology() -> bool = {
        // 重言 <=> 取反后不可满足（-p 是 Prop 的取反糖；!p 会得到 bool）
        return !(-self).satisfiableDpll().sat
    }

    isContradiction() -> bool = return !self.satisfiableDpll().sat

    isSatisfiable() -> bool       = return self.satisfiableDpll().sat
    equiv(other: Prop) -> bool    = return self.iff(other).isTautology()

    __call__(env: dict) -> bool    = return self.eval(env)

    table() -> list = {
        varList = toList(self.vars()).sort(); n = varList.len()
        total = 2 ^ n
        results = @[]
        for (i in range(total)) {
            env = {}
            for (j in range(n)) { env[varList[j]] = int(i / (2^(n-1-j))) % 2 }
            res = self.eval(env)
            results.push({env: env, result: res})
        }
        return results
    }

    printTable() = {
        varList = toList(self.vars()).sort(); n = varList.len()
        formula = str(self)
        sep = "-" * (n * 4 + formula.len() + 5)
        header = ""
        for (v in varList) { header += " " + str(v) + "  " }
        header += " | " + formula
        print(sep); print(header); print(sep)
        
        data = self.table()
        for (row in data) {
            env = row.env; rowStr = ""
            for (v in varList) { rowStr += " " + str(env[v]) + "  " }
            rowStr += " | " + str(row.result)
            print(rowStr)
        }
        print(sep)
    }

    __str__() -> string = {
        tp = self.tp
        if (tp == "var") return str(self.a)
        if (tp == "not") {
            sA = str(self.a)
            if (self.a.tp == "var") return "~" + sA
            return "~(" + sA + ")"
        }
        opStr = " ? "
        if (tp == "and") opStr = " & "
        if (tp == "or")  opStr = " | "
        if (tp == "imp") opStr = " => "
        if (tp == "iff") opStr = " <=> "
        return "(" + str(self.a) + opStr + str(self.b) + ")"
    }

    __eq__(other: any) -> bool = {
        if (!other.isinstance(Prop)) return false
        if (self.tp != other.tp) return false
        if (self.tp == "var" || self.tp == "not") return self.a == other.a
        return (self.a == other.a) && (self.b == other.b)
    }
    // 三值求值：未赋值的变量返回 none（用于搜索剪枝）
    // DPLL 风格的分裂搜索：部分赋值下先做三值化简，已判假的分支不再展开；
    // 找到第一组可满足赋值即返回。返回 {found: bool, env: dict}
    satisfiableBySearch() -> dict = {
        varList = toList(self.vars()).sort()
        return self._search(varList, 0, {})
    }

    local _search(vars: list, idx: int, env: dict) -> dict = {
        partial = _propEval3(self, env)
        if (partial == false) return {found: false, env: {}}      // 剪枝：该分支已假
        if (partial == true) {
            // 剪枝：已真 —— 把剩余未定变量补成 false，保证返回的是一组完整赋值（可直接交给 eval）
            i = idx
            while (i < vars.len()) { if (!(vars[i] in env)) env[vars[i]] = false; i += 1 }
            return {found: true, env: env}
        }
        if (idx >= vars.len()) return {found: false, env: {}}

        v = vars[idx]
        env[v] = true
        r = self._search(vars, idx + 1, env)
        if (r.found) return r
        env[v] = false
        r2 = self._search(vars, idx + 1, env)
        if (r2.found) return r2
        return {found: false, env: {}}
    }

    // 合取范式 / 析取范式（重言子句与矛盾项已剪除；@[] 分别表示 TRUE / FALSE）
    cnf() -> list = return _propToCnf(_propNnf(self, false))
    dnf() -> list = return _propToDnf(_propNnf(self, false))

    // 子句级 DPLL（对 cnf() 求解），返回 {sat: bool, env: dict}；env 为完整赋值
    satisfiableDpll() -> dict = {
        r = _dpllSolve(self.cnf(), {})
        if (!r.sat) return {sat: false, env: {}}
        env = r.env
        for (v in toList(self.vars())) { if (!(v in env)) env[v] = false }
        return {sat: true, env: env}
    }

    // 变量代入：把 env 中已赋值的变量替换为内联常量公式（true 用 (v | -v)、false 用 (v & -v)），
    // 因此不需要引入新的节点类型，eval / cnf / dnf / 三个判定全部自动适用
    substitute(env: dict) -> Prop = {
        tp = self.tp
        if (tp == "var") {
            if (!(self.a in env)) return self
            return env[self.a] ? (self | -self) : (self & -self)
        }
        if (tp == "not") return -(self.a.substitute(env))
        if (tp == "and") return self.a.substitute(env) & self.b.substitute(env)
        if (tp == "or")  return self.a.substitute(env) | self.b.substitute(env)
        if (tp == "imp") return self.a.substitute(env).implies(self.b.substitute(env))
        if (tp == "iff") return self.a.substitute(env).iff(self.b.substitute(env))
        return self
    }

    // 从文本解析命题（与 str() 互逆）：变量、括号、~ / !、&、|、=> / ->、<=> / <->
    // 变量名以字母或下划线开头，可含数字

    // 类上可调的静态入口（帮助 [class]：static 成员在类定义时求值、从类上调用）
    static parse(text: string) -> Prop = return parseProp(text)

}

// 从文本解析命题（与 Prop 的 str() 互逆）：变量、括号、~ / !、&、|、=> / ->、<=> / <->
// 变量名以字母或下划线开头，可含数字。以模块级函数提供：Prop 的实例成员无法从类上调用，
// 静态成员虽可见但取回后不可调用（实测 Target is not callable），故这里用模块命名空间。
parseProp(text: string) -> Prop = {
    st = {text: text, pos: 0}
    e = _ppIff(st)
    _ppSkip(st)
    if (st.pos < st.text.len()) throw ValueError("parseProp: unexpected trailing text at position " + str(st.pos))
    return e
}


Var(name: string) -> Prop = return Prop("var", name, "null")

// ┌────────────────────────────────────────────────────────┐
// │ 3. BINARY RELATIONS (class Relation)                   │
// └────────────────────────────────────────────────────────┘

class Relation {
    init(S: set, pairs: any = none) = {
        self.S = S
        self.R = @{}

        if (pairs != none) {
            src = isinstance(pairs, set) ? toList(pairs) : pairs
            for (p in src) self.addPair(p[0], p[1])
        }
    }

    local _mp(a: any, b: any) -> any = return copy(@[a, b], true)

    // ── Public Facing API (Safe CRUD) ──

    addPair(a: any, b: any) = { 
        if (!(a in self.S) || !(b in self.S)) {
            throw RelationError(f"Relation Error: Both elements '{a}' and '{b}' must exist in the base set S.")
        }
        self.R.add(self._mp(a, b))
        return self 
    }

    removePair(a: any, b: any) = {
        self.R.discard(self._mp(a, b))
        return self
    }

    clearPairs() = {
        self.R = @{}
        return self
    }
    
    hasPair(a: any, b: any) -> bool = return self._mp(a, b) in self.R
    __call__(a: any, b: any) -> bool = return self.hasPair(a, b)

    // ── Property Tests ──
    isReflexive() -> bool = {
        for (x in self.S) { if (!self.hasPair(x, x)) return false }
        return true
    }
    isIrreflexive() -> bool = {
        for (x in self.S) { if (self.hasPair(x, x)) return false }
        return true
    }
    isSymmetric() -> bool = {
        for (p in self.R) { @[a, b] = p; if (!self.hasPair(b, a)) return false }
        return true
    }
    isAntiSymmetric() -> bool = {
        for (p in self.R) { @[a, b] = p; if (a != b && self.hasPair(b, a)) return false }
        return true
    }
    isTransitive() -> bool = {
        for (p1 in self.R) {
            for (p2 in self.R) {
                @[a, b] = p1; @[c, d] = p2
                if (b == c && !self.hasPair(a, d)) return false
            }
        }
        return true
    }

    // ── Compound Tests ──
    isEquivalence() -> bool  = return self.isReflexive() && self.isSymmetric() && self.isTransitive()
    isPartialOrder() -> bool = return self.isReflexive() && self.isAntiSymmetric() && self.isTransitive()
    
    isTotalOrder() -> bool = {
        if (!self.isPartialOrder()) return false
        for (a in self.S) {
            for (b in self.S) {
                if (!self.hasPair(a, b) && !self.hasPair(b, a)) return false
            }
        }
        return true
    }

    // ── Algebraic Operations ──
    inverse() -> Relation = {
        r = Relation(self.S)
        for (p in self.R) { @[a, b] = p; r.R.add(r._mp(b, a)) }
        return r
    }

    compose(other: Relation) -> Relation = {
        r = Relation(self.S)
        for (p1 in self.R) {
            for (p2 in other.R) {
                @[a, b] = p1; @[c, d] = p2
                if (b == c) r.R.add(r._mp(a, d))
            }
        }
        return r
    }

    // ── Closure Operations ──
    reflexiveClosure() -> Relation = {
        r = Relation(self.S)
        for (p in self.R) r.R.add(p)
        for (x in self.S) r.R.add(r._mp(x, x))
        return r
    }

    symmetricClosure() -> Relation = {
        r = Relation(self.S)
        for (p in self.R) { @[a, b] = p; r.R.add(p); r.R.add(r._mp(b, a)) }
        return r
    }

    transitiveClosure() -> Relation = {
        current = @{}
        for (p in self.R) current.add(p)
        
        changed = true
        while (changed) {
            changed = false
            toAdd = @{}
            for (p1 in current) {
                for (p2 in current) {
                    @[a, b] = p1; @[c, d] = p2
                    if (b == c) {
                        np = self._mp(a, d)
                        if (!(np in current) && !(np in toAdd)) toAdd.add(np)
                    }
                }
            }
            if (toAdd.len() > 0) {
                for (p in toAdd) current.add(p)
                changed = true
            }
        }
        r = Relation(self.S); r.R = current
        return r
    }

    // ── Equivalence Classes ──
    equivalenceClasses() -> list = {
        if (!self.isEquivalence()) throw RelationError("equivalenceClasses subject must be an equivalence relation.")
        assigned = @{}
        classes = @[]
        for (x in self.S) {
            if (x in assigned) continue
            cls = @{}
            for (y in self.S) {
                if (self.hasPair(x, y)) { cls.add(y); assigned.add(y) }
            }
            classes.push(cls)
        }
        return classes
    }

    // ── Dunder Methods ──
    __contains__(pair: any) -> bool = return pair in self.R
    __len__() -> int                = return self.R.len()
    __str__() -> string             = return f"Relation(|S|={self.S.len()}, |R|={self.R.len()})"
    // ── 定义域 / 值域 / 像与原像（序对以 @[a, b] 存放，直接解构）──
    domain() -> set = {
        out = @{}
        for (p in self.R) { @[a, b] = p; out.add(a) }
        return out
    }

    range() -> set = {
        out = @{}
        for (p in self.R) { @[a, b] = p; out.add(b) }
        return out
    }

    image(subset: any) -> set = {
        out = @{}
        for (p in self.R) { @[a, b] = p; if (a in subset) { out.add(b) } }
        return out
    }

    preimage(subset: any) -> set = {
        out = @{}
        for (p in self.R) { @[a, b] = p; if (b in subset) { out.add(a) } }
        return out
    }

    // ── 函数性质（陪域取本关系的全集 S）──
    // 函数：每个源至多一个像；单射：每个像至多一个源；满射：值域恰为 S
    isFunction() -> bool = {
        seen = {}
        for (p in self.R) {
            @[a, b] = p
            if (a in seen) { if (!(seen[a] == b)) return false } else { seen[a] = b }
        }
        return true
    }

    isInjective() -> bool = {
        seen = {}
        for (p in self.R) {
            @[a, b] = p
            if (b in seen) { if (!(seen[b] == a)) return false } else { seen[b] = a }
        }
        return true
    }

    isSurjective() -> bool = {
        r = self.range()
        for (x in r) { if (!(x in self.S)) return false }
        return r.len() == self.S.len()
    }

    isBijective() -> bool = return self.isFunction() && self.isInjective() && self.isSurjective()

    // ── 关系运算（结果关系的 S 为两者之并；complement 在 S×S 内取补）──
    local _unionS(other: Relation) -> set = {
        out = @{}
        for (x in self.S) { out.add(x) }
        for (x in other.S) { out.add(x) }
        return out
    }

    unionOf(other: Relation) -> Relation = {
        r = Relation(self._unionS(other))
        for (p in self.R) { r.R.add(p) }
        for (p in other.R) { r.R.add(p) }
        return r
    }

    intersect(other: Relation) -> Relation = {
        r = Relation(self._unionS(other))
        for (p in self.R) { if (p in other.R) { r.R.add(p) } }
        return r
    }

    difference(other: Relation) -> Relation = {
        r = Relation(self._unionS(other))
        for (p in self.R) { if (!(p in other.R)) { r.R.add(p) } }
        return r
    }

    // 在 S×S 内取补：保留 S 中所有不属于 R 的序对
    complement() -> Relation = {
        r = Relation(self.S)
        for (a in self.S) {
            for (b in self.S) {
                p = self._mp(a, b)
                if (!(p in self.R)) { r.R.add(p) }
            }
        }
        return r
    }

    // 限制：只保留源落在 subset 内的序对
    restrict(subset: any) -> Relation = {
        r = Relation(self.S)
        for (p in self.R) { @[a, b] = p; if (a in subset) { r.R.add(p) } }
        return r
    }

    // Hasse 图：偏序的覆盖关系（a ≺ b 当且仅当 aRb 且不存在严格居中的 c）。
    // 返回 {nodes: list, covers: list}，covers 中的元素为 @[a, b]。O(|S|^3)。
    hasseDiagram() -> dict = {
        if (!self.isPartialOrder()) throw RelationError("hasseDiagram subject must be a partial order")
        nodes = toList(self.S)
        covers = @[]
        for (a in nodes) {
            for (b in nodes) {
                if (!(self.hasPair(a, b))) continue
                if (a == b) continue
                covered = true
                for (c in nodes) {
                    if (c == a || c == b) continue
                    if (self.hasPair(a, c) && self.hasPair(c, b)) { covered = false; break }
                }
                if (covered) { covers.push(@[a, b]) }
            }
        }
        return {nodes: nodes, covers: covers}
    }

}

// ┌────────────────────────────────────────────────────────┐
// │ 4. GRAPH THEORY (class Graph)                          │
// └────────────────────────────────────────────────────────┘

class Graph {
    init(directed: bool = true) = {
        self.adj = {}
        self.directed = directed
        self._ec = 0
    }

    // ── Construction & Erasure (CRUD API) ──
    addVertex(v: any) = {
        if (!(v in self.adj)) self.adj[v] = @[]
        return self
    }

    removeVertex(v: any) = {
        if (!(v in self.adj)) return self
        self.adj.discard(v) 
        
        // Cleanup orphans
        for (u in self.adj.keys()) {
            new_edges = @[]
            for (e in self.adj[u]) {
                if (e[0] != v) new_edges.push(e)
            }
            self.adj[u] = new_edges
        }
        
        c = 0
        for (u in self.adj.keys()) c += self.adj[u].len()
        self._ec = self.directed ? c : c / 2
        
        return self
    }

    addEdge(u: any, v: any, w: any = 1) = {
        self.addVertex(u); self.addVertex(v)
        
        self.adj[u].push(@[v, w])
        if (!self.directed) self.adj[v].push(@[u, w])
        self._ec += 1
        return self
    }

    removeEdge(u: any, v: any) = {
        removed = false
        if ((u in self.adj)) {
            new_u = @[]
            for (e in self.adj[u]) {
                if (e[0] != v) new_u.push(e)
                else removed = true
            }
            self.adj[u] = new_u
        }
        if (!self.directed && (v in self.adj)) {
            new_v = @[]
            for (e in self.adj[v]) {
                if (e[0] != u) new_v.push(e)
            }
            self.adj[v] = new_v
        }
        if (removed) self._ec -= 1
        return self
    }

    clear() = {
        self.adj = {}
        self._ec = 0
        return self
    }

    // ── Queries ──
    vertices() -> list           = return toList(self.adj.keys())
    edgeCount() -> int           = return self._ec
    hasVertex(v: any) -> bool    = return (v in self.adj)

    hasEdge(u: any, v: any) -> bool = {
        if (!(u in self.adj)) return false
        for (e in self.adj[u]) { if (e[0] == v) return true }
        return false
    }
    
    __call__(u: any, v: any) -> bool = return self.hasEdge(u, v)

    getWeight(u: any, v: any) -> any = {
        if ((u in self.adj)) {
            for (e in self.adj[u]) { if (e[0] == v) return e[1] }
        }
        return none
    }

    neighbors(v: any) -> list = {
        if (!(v in self.adj)) return @[]
        return self.adj[v].map((e) => e[0])
    }

    edges() -> list = {
        res = @[]
        for (k in self.adj.keys()) {
            for (e in self.adj[k]) res.push(@[k, e[0], e[1]])
        }
        return res
    }

    outDegree(v: any) -> int = {
        return (v in self.adj) ? self.adj[v].len() : 0
    }

    inDegree(v: any) -> int = {
        c = 0
        for (k in self.adj.keys()) {
            for (e in self.adj[k]) { if (e[0] == v) c += 1 }
        }
        return c
    }

    // ── Traversals ──
    bfs(start: any) -> list = {
        visited = set(start); q = @[start]; res = @[]
        h = 0
        while (h < q.len()) {
            curr = q[h]; h += 1; res.push(curr)
            if ((curr in self.adj)) {
                for (e in self.adj[curr]) {
                    if (!(e[0] in visited)) { visited.add(e[0]); q.push(e[0]) }
                }
            }
        }
        return res
    }

    dfs(start: any) -> list = {
        visited = @{}; res = @[]
        _go(v: any) = {
            if (v in visited) return none
            visited.add(v); res.push(v)
            if ((v in self.adj)) {
                for (e in self.adj[v]) _go(e[0])
            }
        }
        _go(start)
        return res
    }

    // ── Path Algorithms ──
    findPath(start: any, end: any) -> list = {
        if (start == end) return @[start]
        
        visited = set(start); q = @[@[start]]
        h = 0
        while (h < q.len()) {
            path = q[h]; h += 1; curr = path.last()
            if ((curr in self.adj)) {
                for (e in self.adj[curr]) {
                    nbr = e[0]
                    np = @[]; for (p in path) np.push(p); np.push(nbr)
                    if (nbr == end) return np
                    if (!(nbr in visited)) { visited.add(nbr); q.push(np) }
                }
            }
        }
        return @[]
    }

    dijkstra(start: any) -> dict = {
        // 二叉堆版：O((V + E) log V)。旧实现每轮按 dist 线性找最小顶点，为 O(V^2)。
        dist = {}; prev = {}
        for (v in toList(self.adj.keys())) dist[v] = none
        dist[start] = 0

        pq = collections.PriorityQueue((a, b) => a[0] < b[0])
        pq.push(@[0, start])
        while (!pq.isEmpty()) {
            top = pq.pop()
            d = top[0]; u = top[1]
            if (dist[u] is none || d > dist[u]) continue      // 惰性删除：跳过已被松弛的过期条目
            if ((u in self.adj)) {
                for (e in self.adj[u]) {
                    nbr = e[0]; w = e[1]
                    alt = dist[u] + w
                    if (dist[nbr] is none || alt < dist[nbr]) {
                        dist[nbr] = alt; prev[nbr] = u
                        pq.push(@[alt, nbr])
                    }
                }
            }
        }
        return {dist: dist, prev: prev}
    }
    shortestPath(start: any, end: any) -> dict = {
        r = self.dijkstra(start)
        if (r.dist[end] is none) return {path: @[], dist: none}

        path = @[]; curr = end
        while (!(curr is none)) {
            path.push(curr)
            curr = (curr in r.prev) ? r.prev[curr] : none
        }
        return {path: path.reverse(), dist: r.dist[end]}
    }


    hasCycle() -> bool = {
        vs = toList(self.adj.keys())
        found = @[false]

        if (self.directed) {
            color = {}; for (v in vs) color[v] = 0
            _visit(v: any) = {
                if (found[0]) return none
                color[v] = 1
                if ((v in self.adj)) {
                    for (e in self.adj[v]) {
                        if (color[e[0]] == 1) { found[0] = true; return none }
                        if (color[e[0]] == 0) _visit(e[0])
                    }
                }
                color[v] = 2
            }
            for (v in vs) { if (color[v] == 0) _visit(v) }
        } else {
            visited = @{}
            _visit(v: any, parent: any) = {
                if (found[0]) return none
                visited.add(v)
                if ((v in self.adj)) {
                    for (e in self.adj[v]) {
                        if (e[0] == parent) continue
                        if (e[0] in visited) { found[0] = true; return none }
                        _visit(e[0], v)
                    }
                }
            }
            for (v in vs) { if (!(v in visited)) _visit(v, none) }
        }
        return found[0]
    }

    topSort() -> list = {
        if (!self.directed) throw GraphError("topSort() requires a directed graph.")
        
        vs = toList(self.adj.keys())
        inDeg = {}; for (v in vs) inDeg[v] = 0
        for (v in vs) {
            if ((v in self.adj)) {
                for (e in self.adj[v]) inDeg[e[0]] = inDeg[e[0]] + 1
            }
        }
        
        q = @[]
        h = 0
        for (v in vs) { if (inDeg[v] == 0) q.push(v) }
        res = @[]
        
        while (h < q.len()) {
            v = q[h]; h += 1; res.push(v)
            if ((v in self.adj)) {
                for (e in self.adj[v]) {
                    inDeg[e[0]] = inDeg[e[0]] - 1
                    if (inDeg[e[0]] == 0) q.push(e[0])
                }
            }
        }
        if (res.len() != vs.len()) throw GraphError("Cycle detected, topological sort impossible.")
        return res
    }

    components() -> list = {
        if (self.directed) throw GraphError("components() requires an undirected graph.")
        
        visited = @{}; comps = @[]
        for (v in toList(self.adj.keys())) {
            if (v in visited) continue
            comp = @[]; q = @[v]; visited.add(v)
            h = 0
            while (h < q.len()) {
                curr = q[h]; h += 1; comp.push(curr)
                if ((curr in self.adj)) {
                    for (e in self.adj[curr]) {
                        if (!(e[0] in visited)) { visited.add(e[0]); q.push(e[0]) }
                    }
                }
            }
            comps.push(comp)
        }
        return comps
    }

    __contains__(v: any) -> bool = return self.hasVertex(v)
    __len__() -> int             = return self.adj.keys().len()
    __str__() -> string          = return f"<Graph({self.directed ? 'directed' : 'undirected'}) V={len(self)} E={self._ec}>"
    // Kruskal 最小生成树：边按权升序（二叉堆）+ 并查集判环。O(E log E)
    kruskal() -> dict = {
        pq = collections.PriorityQueue((a, b) => a[2] < b[2])
        for (e in self.edges()) { pq.push(e) }
        uf = collections.UnionFind()
        // 先登记全部顶点：无边孤立顶点也是一个连通分量（生成森林要把它算进去）
        for (v in self.vertices()) { uf.makeSet(v) }
        chosen = @[]
        total = 0
        while (!pq.isEmpty()) {
            e = pq.pop()
            if (uf.union(e[0], e[1])) {
                chosen.push(e)
                total += e[2]
            }
        }
        return {edges: chosen, weight: total, components: uf.componentCount()}
    }

    // Floyd–Warshall 全源最短路，O(V^3)；返回 {dist: {u: {v: d}}, negativeCycle: bool}
    floydWarshall() -> dict = {
        vs = self.vertices()
        d = {}
        for (u in vs) {
            row = {}
            for (v in vs) { row[v] = u == v ? 0 : none }
            d[u] = row
        }
        for (e in self.edges()) {
            u = e[0]; v = e[1]; w = e[2]
            if (d[u][v] is none || w < d[u][v]) { d[u][v] = w }
            if (!self.directed) { if (d[v][u] is none || w < d[v][u]) { d[v][u] = w } }
        }
        for (k in vs) {
            for (i in vs) {
                if (d[i][k] is none) continue
                for (j in vs) {
                    if (d[k][j] is none) continue
                    alt = d[i][k] + d[k][j]
                    if (d[i][j] is none || alt < d[i][j]) { d[i][j] = alt }
                }
            }
        }
        neg = false
        for (v in vs) { if (d[v][v] < 0) neg = true }
        return {dist: d, negativeCycle: neg}
    }

    // Bellman–Ford 单源最短路，支持负权并检测负环，O(V*E)。edges() 对无向图已给出双向边，
    // 故此处不再额外反向松弛；注意无向图中的负边必然构成负环（来回各一次）
    bellmanFord(start: any) -> dict = {
        vs = self.vertices()
        dist = {}; prev = {}
        for (v in vs) dist[v] = none
        dist[start] = 0
        es = self.edges()
        round = 0
        while (round < vs.len() - 1) {
            changed = false
            for (e in es) {
                u = e[0]; v = e[1]; w = e[2]
                if (dist[u] is none) continue
                alt = dist[u] + w
                if (dist[v] is none || alt < dist[v]) { dist[v] = alt; prev[v] = u; changed = true }
            }
            if (!changed) break
            round += 1
        }
        negCycle = false
        for (e in es) {
            u = e[0]; v = e[1]; w = e[2]
            if (!(dist[u] is none) && (dist[v] is none || dist[u] + w < dist[v])) { negCycle = true }
        }
        return {dist: dist, prev: prev, negativeCycle: negCycle}
    }

    // Kosaraju 强连通分量：反图 + 两次 DFS。O(V + E)
    stronglyConnectedComponents() -> list = {
        if (!self.directed) throw GraphError("stronglyConnectedComponents() requires a directed graph.")
        vs = self.vertices()

        // 反图
        radj = {}
        for (v in vs) { radj[v] = @[] }
        for (u in toList(self.adj.keys())) {
            for (e in self.adj[u]) { radj[e[0]].push(u) }
        }

        // 第一趟：原图上按完成时间入栈
        visited = @{}
        order = @[]
        for (v in vs) { if (!(v in visited)) self._finishOrder(v, visited, order) }

        // 第二趟：按完成时间逆序在反图上收集分量
        seen = @{}
        comps = @[]
        i = order.len() - 1
        while (i >= 0) {
            v = order[i]
            if (!(v in seen)) {
                comp = @[]
                self._collectComponent(v, radj, seen, comp)
                comps.push(comp)
            }
            i -= 1
        }
        return comps
    }

    local _finishOrder(v: any, visited: any, order: list) = {
        visited.add(v)
        if (v in self.adj) {
            for (e in self.adj[v]) { if (!(e[0] in visited)) self._finishOrder(e[0], visited, order) }
        }
        order.push(v)
    }

    local _collectComponent(v: any, radj: dict, seen: any, comp: list) = {
        seen.add(v)
        comp.push(v)
        if (v in radj) {
            for (u in radj[v]) { if (!(u in seen)) self._collectComponent(u, radj, seen, comp) }
        }
    }

}

// ┌────────────────────────────────────────────────────────┐
// │ 5. STANDALONE TRUTH TABLE                              │
// └────────────────────────────────────────────────────────┘

truthTable(n: int | float, fn: function) -> list = {
    n = round(n)
    total = 2 ^ n; res_list = @[]
    for (i in range(total)) {
        vars = @[0 for (i2 in range(n))]
        for (j in range(n)) { vars[j] = int(i / (2^(n - 1 - j))) % 2 }
        res_list.push({inputs: vars, output: vars.apply(fn) ? 1 : 0})
    }
    return res_list
}

printTruthTable(n: int | float, fn: function) = {
    n = round(n)
    total = 2 ^ n
    print(f"\nTruth Table ({n} variables):")
    print("-" * (n * 7 + 10))
    header = ""
    for (i in range(n)) { header += f"V{i}     " }
    header += "|   Out"
    print(header); print("-" * (n * 7 + 10))
    for (i in range(total)) {
        vars = @[0 for (i2 in range(n))]
        for (j in range(n)) { vars[j] = int(i / (2^(n - 1 - j))) % 2 }
        rowStr = ""
        for (v in vars) { rowStr += f" {v}     " }
        rowStr += f"|    {vars.apply(fn) ? 1 : 0}"
        print(rowStr)
    }
    print("-" * (n * 7 + 10))
}

// ┌────────────────────────────────────────────────────────┐
// │ 6. HELP TEXT REGISTRATION                              │
// └────────────────────────────────────────────────────────┘

const local import sys

class GraphError extends Exception {
    init(msg) = { super.init(msg) }
}

class RelationError extends Exception {
    init(msg) = { super.init(msg) }
}

try {
    sys.register_help("discrete", r"DOC(
═══ Discrete Mathematics Standard Library ═══

  Requires: import discrete

  A pure JC2 implementation covering Combinatorics, Graph Theory, 
  Binary Relations, and Boolean Logic.

  Combinatorics
  ──────────────────────
    arr.permutations()         Returns all permutations of elements.
    arr.combinations(k)        Returns all k-subsets.

  Propositional Logic (class Prop)
  ──────────────────────
    Var("p")                   Create an atomic proposition variable
    A & B  /  A | B  /  -A     AND, OR, NOT (operator overloading)
    A.implies(B) / A.iff(B)    Material implication and Biconditional

    p.eval(env) / p(env)       Evaluate with a variable binding Dict (Callable)
    p.vars()                   Collect all variables (Set)
    p.table()                  Return full truth table data
    p.printTable()             Print formatted truth table
    p.isTautology()            True for all assignments
    p.isContradiction()        False for all assignments
    p.isSatisfiable()          True for at least one assignment
    p.equiv(other)             Logically equivalent to other Prop

  Standalone Truth Tables
  ──────────────────────
    truthTable(n, fn)          Returns truth table data for an n-ary function
    printTruthTable(n, fn)     Prints a formatted truth table for the function

  Binary Relations (class Relation)
  ──────────────────────
    r = Relation(set(1,2))     Create relation over base Set S
    r.addPair(a, b)            Add relation (checks bounds in S)
    r.removePair(a, b)         Remove relation securely
    r.hasPair(a, b) / r(a, b)  Presence query (Callable)
    r.clearPairs()             Delete all relations

    r.isReflexive()            r.isSymmetric()      r.isTransitive()
    r.isAntiSymmetric()        r.isIrreflexive()
    r.isEquivalence()          r.isPartialOrder()   r.isTotalOrder()
    
    r.inverse()                R^{-1} = {(b,a)|(a,b) in R}
    r.compose(other)           R ; S composition
    r.reflexiveClosure()       r.symmetricClosure() r.transitiveClosure()
    r.equivalenceClasses()     Partition into sets of equivalence classes

  Graph Theory (class Graph)
  ──────────────────────
    g = Graph(directed: bool)  Create Graph (True by default)
    g.addVertex(v)             Add vertex
    g.removeVertex(v)          Remove vertex & prune related edges
    g.addEdge(u, v, w=1)       Add edge (creates missing vertices)
    g.removeEdge(u, v)         Remove edge
    g.clear()                  Clear all vertices and edges
    
    g.vertices()               Return all vertices (List)
    g.edges()                  Return all edges (List)
    g.neighbors(v)             Return all adjacent vertices (List)
    g.hasVertex(v)             Vertex presence check
    g.hasEdge(u, v) / g(u, v)  Edge presence check (Callable)
    g.getWeight(u, v)          Edge weight retrieval
    g.inDegree(v)              g.outDegree(v)
    
    g.bfs(start)               g.dfs(start)
    g.findPath(start, end)     Unweighted shortest path
    g.dijkstra(start)          Weighted shortest paths (returns dict)
    g.shortestPath(start, end) Weighted path + minimum distance
    
    g.hasCycle()               Cycle detection
    g.topSort()                Topological sort (DAG only)
    g.components()             Connected components (undirected only)

  Errors
  ──────────────────────
    GraphError      Graph algorithm preconditions (directedness, cycles).
    RelationError   Relation and equivalence-class preconditions.

  Relation Extras
  ──────────────────────
    domain() / range() / image(subset) / preimage(subset)   Sets of first/second components
    isFunction / isInjective / isSurjective / isBijective   Codomain is the relation's own S
    hasseDiagram()                                          Covering pairs of a partial
                                                            order, as {nodes, covers}
    unionOf / intersect / difference / complement / restrict
                                                            complement is taken inside S x S;
                                                            results carry the union of both S

  Complexity
  ──────────────────────
    Graph.bfs / dfs / findPath / components / topSort        O(V + E)
                                                            (traversal queues keep a head
                                                            index; elements are never
                                                            shifted, so no O(n) dequeue)
    Graph.hasCycle                                          O(V + E)
    Graph.stronglyConnectedComponents (Kosaraju, two DFS)   O(V + E)
    Graph.kruskal (binary heap + UnionFind)                 O(E log E)
    Graph.bellmanFord (V-1 relaxation rounds)               O(V * E)
    Graph.floydWarshall (all pairs)                         O(V^3)
    Graph.dijkstra (binary heap, lazy deletion)             O((V + E) log V)
    Graph.shortestPath                                      dijkstra + O(V) rebuild
    Relation.transitiveClosure / reflexive / symmetric      O(n^3) / O(n^2) / O(n^2)
    Prop negation is the unary minus (-p); !p coerces to bool
    Prop.table (full enumeration)                           exponential in the number
                                                            of distinct variables
    Prop.isTautology / isContradiction / isSatisfiable      clause-level DPLL over
                                                            cnf() (unit propagation +
                                                            splitting); worst case is
                                                            still exponential, but
                                                            pruning skips most of it
)DOC")
}
