import prob

test_prob_normal() = {
    d = prob.Normal(0, 1)
    assert(abs(d.mean() - 0.0) < 1e-5, "Normal mean failed")
    assert(abs(d.var() - 1.0) < 1e-5, "Normal var failed")
    assert(abs(d.pdf(0) - 0.398942) < 1e-5, "Normal pdf failed")
    assert(abs(d.cdf(0) - 0.5) < 1e-5, "Normal cdf failed")
    assert(abs(d.quantile(0.5) - 0.0) < 1e-5, "Normal quantile failed")
    
    s = d.sample(10)
    assert(s.cols() == 10, "Normal sample failed")
}
test_prob_normal()

test_prob_binom() = {
    d = prob.Binom(10, 0.5)
    assert(abs(d.mean() - 5.0) < 1e-5, "Binom mean failed")
    assert(abs(d.var() - 2.5) < 1e-5, "Binom var failed")
    assert(abs(d.pmf(5) - 0.24609375) < 1e-5, "Binom pmf failed")
}
test_prob_binom()

test_prob_math() = {
    assert(abs(prob.gamma(5) - 24.0) < 1e-5, "gamma failed")
    assert(abs(prob.betaFn(2, 5) - 0.0333333) < 1e-5, "betaFn failed")
    assert(abs(prob.erf(0) - 0.0) < 1e-5, "erf failed")
}
test_prob_math()

test_prob_ttest() = {
    data = [1.2, 1.4, 1.3, 1.5, 1.4]
    res = prob.ttest(data, 1.0)
    assert(res.cols() == 3, "ttest result shape failed")
    assert(res[0, 1] == 4.0, "ttest df failed") // df = n - 1 = 4
}
test_prob_ttest()
