{
    "For Loop": {
        "prefix": "for",
        "body": [
            "for (${1:i} = 0; ${1:i} < ${2:10}; ${1:i} += 1) {",
            "\t$0",
            "}"
        ],
        "description": "Standard for loop"
    },
    "For-In Loop": {
        "prefix": "forin",
        "body": [
            "for (${1:item} in ${2:iterable}) {",
            "\t$0",
            "}"
        ],
        "description": "For-in loop"
    },
    "While Loop": {
        "prefix": "while",
        "body": [
            "while (${1:condition}) {",
            "\t$0",
            "}"
        ],
        "description": "While loop"
    },
    "If Statement": {
        "prefix": "if",
        "body": [
            "if (${1:condition}) {",
            "\t$0",
            "}"
        ],
        "description": "If statement"
    },
    "If Else Statement": {
        "prefix": "ifelse",
        "body": [
            "if (${1:condition}) {",
            "\t$2",
            "} else {",
            "\t$0",
            "}"
        ],
        "description": "If-Else statement"
    },
    "Class Definition": {
        "prefix": "class",
        "body": [
            "class ${1:ClassName} {",
            "\tinit(${2:args}) = {",
            "\t\t$0",
            "\t}",
            "}"
        ],
        "description": "Class definition"
    },
    "Namespace Definition": {
        "prefix": "namespace",
        "body": [
            "namespace ${1:Name} {",
            "\t$0",
            "}"
        ],
        "description": "Namespace definition"
    },
    "Enum Definition": {
        "prefix": "enum",
        "body": [
            "enum ${1:Name} {",
            "\t$0",
            "}"
        ],
        "description": "Enum definition"
    },
    "Function Definition": {
        "prefix": "func",
        "body": [
            "${1:name}(${2:args}) = {",
            "\t$0",
            "}"
        ],
        "description": "Function definition"
    },
    "Match Expression": {
        "prefix": "match",
        "body": [
            "match (${1:expr}) {",
            "\t${2:pattern} => ${3:body},",
            "\t_ => ${0:fallback}",
            "}"
        ],
        "description": "Pattern matching expression"
    },
    "Macro Definition": {
        "prefix": "macro",
        "body": [
            "macro ${1:name}(${2:node}) = {",
            "\treturn quote {",
            "\t\t$0",
            "\t}",
            "}"
        ],
        "description": "AST Macro definition"
    },
    "Syntax Macro Definition": {
        "prefix": "syntax",
        "body": [
            "syntax ${1:name}(${2:stream}) = {",
            "\t$0",
            "\treturn ${2:stream}.parse()",
            "}"
        ],
        "description": "Syntax Macro definition"
    },
    "Try Catch": {
        "prefix": "try",
        "body": [
            "try {",
            "\t$1",
            "} catch (${2:e}) {",
            "\t$0",
            "}"
        ],
        "description": "Try-Catch block"
    }
}
