// ★ 成员模型不变式（docs/OOP_MODEL_DESIGN.md §八 的验证点，逐条落成断言）
//   这些断言在第二阶段（模板冻结 / 实例成员编号 / 桶预留）落地后仍然成立。

throws(f) = {
    try { f(); return false } catch (e) { return true }
}

test_member_read_is_raw() = {
    class A {
        v = 7
        who() = self.v
        static tag() = "tag"
    }
    a = A()
    // §八 1：读两次是同一个函数对象（不复制、不包装、不绑定）
    assert(a.who == a.who, "reading a member twice must yield the same function object")
    // §八 4
    assert(a.who() == 7, "member call still works")
    // §八 2：取出来再调用没有接收者
    g = a.who
    assert(throws(() => g()), "extracted method has no self")
    // §八 3：字典的键作为 self，不占实参位
    d = { "f": sin }
    assert(abs(d.f(1.0) - 0.841471) < 1e-6, "dict key's closure gets the dict as self")
    // §八 5：挂上去的闭包拿实例当 self，取出来就没有
    h = A()
    h.cb = () => self
    assert(h.cb() == h, "hung closure gets the instance as self")
    k = h.cb
    assert(throws(() => k()), "extracted hung closure has no self")
}
test_member_read_is_raw()

test_class_exposes_only_statics() = {
    class A {
        v = 7
        who() = self.v
        static tag() = "tag"
    }
    a = A()
    // §八 6：类上只有 static 域，实例方法模板不从类上取
    assert(throws(() => A.who), "instance method template is not readable from the class")
    assert(throws(() => A.who()), "and not invokable from the class")
    assert(throws(() => A.who(a)), "and not invokable with an explicit receiver")
    // §八 7 / static 照旧
    assert(A.tag() == "tag", "static method still callable from the class")
    assert(throws(() => a.tag), "static member is not reachable from an instance")
    assert(throws(() => a.tag()), "and not invokable from an instance")
}
test_class_exposes_only_statics()

test_dot_call_fills_self() = {
    // §八 8 / 9：点号调用把接收者交给隐藏通道 self，不占实参位
    free_self() = self
    assert(throws(() => free_self()), "plain call has no self")
    assert(5.free_self() == 5, "dot call passes the receiver through self")
    echo_self(x) = self
    assert(1.echo_self(0) == 1, "receiver does not occupy an argument slot")
}
test_dot_call_fills_self()

test_receiver_is_not_an_argument() = {
    // §八 10 / 12：接收者不再被隐式填进实参位
    assert(throws(() => 1.0.sin()), "dot call to a global math function needs the argument explicitly")
    assert(abs(sin(1.0) - 0.841471) < 1e-6, "sin(1.0) works")
    // §八 11 / 12：长度与原型成员照旧
    assert(@[1, 2, 3].len() == 3, "list length via prototype method")
    assert(len(@[1, 2, 3]) == 3, "and via the global function")
    assert(@[1, 2, 3].sum() == 6, "prototype methods keep working")
    assert("ab".upper() == "AB", "string prototype methods keep working")
    assert("ab".reverse() == "ba", "chained prototype calls keep working")
    assert(len({ x: 1 }.keys()) == 1, "dict prototype methods keep working")
    // §八 18：0 参原生方法不再静默吞掉多余实参
    assert(throws(() => @[1, 2, 3].sum(5)), "extra args to a 0-param native are rejected")
    assert(throws(() => "ab".upper(5)), "same for string natives")
}
test_receiver_is_not_an_argument()

test_const_and_static_boundaries() = {
    class K {
        const cf = 1
        const cm() = 2
        static const scf = 3
        nf = 4
        nm() = 5
    }
    k = K()
    // §八 13：const 只管它所在的那个域
    assert(throws(() => { k.cf = 11 }), "instance write to a const field is rejected")
    assert(throws(() => { k.cm = 12 }), "instance write to a const method is rejected")
    // §2.6：const 只管它所在的那个域——实例域的 const 不管类上的写入
    K.cm = 22
    assert(K.cm == 22, "class write to a const method template creates a static")
    assert(k.cm() == 2, "the instance still uses its own method template")
    assert(throws(() => { K.scf = 23 }), "class write to a static const is rejected")
    assert(throws(() => k.scf), "static const is not reachable from an instance")
    // §八 14：字段声明名在类上写 => 新建一个 static
    K.cf = 21
    assert(K.cf == 21, "class write to a field declaration name creates a static")
    // 非 const 成员照旧可写
    k.nf = 41
    assert(k.nf == 41, "non-const instance field stays writable")
    k.nm = 51
    assert(k.nm == 51, "non-const instance member can be shadowed")
}
test_const_and_static_boundaries()

test_class_writes_only_touch_the_static_domain() = {
    // §2.6 统一写规则：C.名字 = 值 命中 static 就覆盖、没命中就新建一个 static；
    // 它写不到实例成员模板，所以模板永远不改，新对象仍用老方法
    class T {
        m() = 1
    }
    t0 = T()
    T.m = () => 2
    assert(T.m() == 2, "the assignment created a static m")
    assert(t0.m() == 1, "an existing instance keeps its own template")
    t1 = T()
    assert(t1.m() == 1, "a new instance still uses the method template")
    T["m"] = () => 3
    assert(T.m() == 3, "index write follows the same rule")
    // static 域与模板互不干扰
    T.s = 5
    assert(T.s == 5, "statics stay writable")
    t = T()
    assert(throws(() => t.s), "statics are not reachable from an instance")
    assert(t.m() == 1, "the method template is untouched")
}
test_class_writes_only_touch_the_static_domain()

test_snapshot_intent() = {
    // §八 19 的意图：改类（重新定义 = 换一个新类对象）不影响已经造出来的对象
    class A {
        v = 1
        who() = "old"
    }
    a = A()
    A = class {
        v = 2
        who() = "new"
    }
    b = A()
    assert(a.who() == "old", "old object keeps its old method")
    assert(a.v == 1, "old object keeps its old field")
    assert(b.who() == "new", "new object uses the new method")
    assert(b.v == 2, "new object uses the new field")
    assert(!isinstance(a, A), "old object is not an instance of the redefined class")
    assert(isinstance(b, A), "new object is an instance of the redefined class")
}
test_snapshot_intent()

test_lookup_order_is_shared() = {
    // §八 23 / §2.1：自己的袋子 -> 原型 -> 全局，读与调用同一条顺序
    d = { keys: 5 }
    assert(d.keys == 5, "dict key shadows the prototype method for reads")
    assert(throws(() => d.keys()), "and for calls the key's value is used (not callable)")
    l = @[1, 2]
    assert(l.len() == 2, "prototype method works when no key shadows it")
}
test_lookup_order_is_shared()

test_containers_are_not_instances() = {
    // §八 22：原生容器不受实例语义影响
    l1 = @[1]
    l2 = @[2]
    assert(l1.append == l2.append, "prototype methods are one shared function object")
    assert(throws(() => { l1.x = 1 }), "containers cannot take new fields")
    d = { a: 1 }
    d.x = 1
    assert(d.x == 1, "a dict takes a new key")
    assert(l1.len() == 1, "and reading still works")
}
test_containers_are_not_instances()

test_freeze_covers_the_whole_class() = {
    class F {
        v = 1
        m() = 2
    }
    f = F()
    assert(!isfrozen(F), "a plain class is not frozen")
    freeze(F)
    assert(isfrozen(F), "freeze() marks the class frozen")
    assert(throws(() => { F.s = 1 }), "a frozen class rejects static writes")
    assert(throws(() => { F.m = () => 3 }), "a frozen class rejects template writes")
    assert(f.m() == 2, "existing instances keep working after the class is frozen")
    f.v = 9
    assert(f.v == 9, "instance-domain writes are unaffected by the class freeze")
    trait FT {
        tm() = 1
    }
    assert(isfrozen(FT), "a trait is frozen at definition")
}
test_freeze_covers_the_whole_class()

test_members_are_snapshotted_per_instance() = {
    // §2.4 / §六 第 9 步：类体里的每个成员定义 = 构造时对这个实例求值一次
    class S {
        v = 1
        who() = "old"
    }
    a = S()
    b = S()
    // 实例能改自己那份，别的实例不受影响
    a.who = () => "shadow"
    assert(a.who() == "shadow", "an instance can shadow its own member")
    assert(b.who() == "old", "other instances keep their own copy")
    a.v = 5
    assert(b.v == 1, "fields stay per instance")
    // 无捕获的方法共享同一个函数对象（可观察等价）
    class T {
        f() = 42
    }
    assert(T().f == T().f, "capture-free methods share one function object")
    assert(T().f() == 42, "and still call correctly")
    // 私有字段的状态不跨实例
    class C {
        local n = 0
        local bump() = { self.n = self.n + 1; return self.n }
        inc() = self.bump()
    }
    c1 = C()
    c2 = C()
    assert(c1.inc() == 1 && c1.inc() == 2, "first instance counts on its own")
    assert(c2.inc() == 1, "second instance starts from its own default")
    assert(c1.inc() == 3, "and the first instance keeps counting")
}
test_members_are_snapshotted_per_instance()

test_dunders_resolve_in_the_class_domain_only() = {
    // §2.1 的例外：dunder 是语言协议，只在类域解析，不看实例袋子里的那份
    class D {
        v = 1
        __str__() = "D(" + str(self.v) + ")"
        __len__() = 7
    }
    d = D()
    assert(str(d) == "D(1)", "dunder comes from the class template")
    assert(len(d) == 7, "len() goes through __len__")
    // 实例影子读得到，但派发不用它（与 Python 一致）
    d.__len__ = () => 99
    assert(d.__len__() == 99, "the shadow is readable and callable on its own")
    assert(len(d) == 7, "but len() keeps using the class template")
    assert(len(D()) == 7, "other instances are unaffected")
    // 类上写同名只新建 static：既碰不到模板，也碰不到实例袋子
    c0 = D()
    D.__len__ = () => 5
    assert(D.__len__() == 5, "the class write created a static")
    assert(len(c0) == 7, "an existing instance is unaffected")
    assert(len(D()) == 7, "and a new instance still uses the template")
}
test_dunders_resolve_in_the_class_domain_only()
