// ═══════════════════════════════════════════════════════════════
// Coroutines: yield/resume/send/for-in
// ═══════════════════════════════════════════════════════════════

{
test_coroutine_basic() = {
    f() = {
        local sent = yield 1
        yield sent + 10
        return 99
    }
    c = f()
    assert(c.resume() == 1, "first yield")
    assert(c.send(5) == 15, "send value")
    caught = false
    try {
        c.resume()
    } catch (e) {
        caught = true
    }
    assert(caught, "completed coroutine must raise StopIteration")
}
test_coroutine_basic()

test_coroutine_for() = {
    rangeLike(n) = {
        local i = 0
        while (i < n) {
            yield i
            i += 1
        }
    }
    out = @[]
    for (x in rangeLike(3)) out.push(x)
    assert(out == @[0, 1, 2], "for-in over coroutine")
}
test_coroutine_for()

test_coroutine_conditional_yield() = {
    maybe(x) = {
        if (x) yield 1
        return 2
    }
    c = maybe(true)
    assert(c.resume() == 1, "conditional yield")
    assert(maybe(false) == 2, "non-yielding path returns a value")
}
test_coroutine_conditional_yield()
test_coroutine_lifecycle() = {
    f() = {
        yield 1
        yield 2
    }
    c = f()
    assert(!c.done(), "new coroutine is not done")
    assert(c.resume() == 1, "first value")
    c.close()
    assert(c.done(), "close marks done")
    caught = false
    try {
        c.resume()
    } catch (e) {
        caught = true
    }
    assert(caught, "closed coroutine raises StopIteration")
}
test_coroutine_lifecycle()
test_coroutine_await() = {
    inner() = {
        yield 1
        return 42
    }
    outer() = {
        local x = await inner()
        return x + 1
    }
    assert(outer() == 43, "await drives coroutine to completion")
}
test_coroutine_await()
test_coroutine_spawn() = {
    t = spawn {
        return 7
    }
    assert(await t == 7, "spawn task result")
}
test_coroutine_spawn()
test_coroutine_delegate() = {
    inner() = {
        yield 1
        yield 2
        return 9
    }
    outer() = {
        local x = yield ...inner()
        return x + 1
    }
    o = outer()
    assert(o.resume() == 1, "delegated first yield")
    assert(o.resume() == 2, "delegated second yield")
    caught = false
    try {
        o.resume()
    } catch (e) {
        caught = true
    }
    assert(caught, "delegation completes")
    assert(o.result() == 10, "delegation return value")
}
test_coroutine_delegate()
test_coroutine_throw() = {
    f() = {
        yield 1
        return 2
    }
    c = f()
    assert(c.resume() == 1, "throw handle")
    caught = false
    try {
        c.throw("boom")
    } catch (e) {
        caught = true
    }
    assert(caught, "throw injects an error")
}
test_coroutine_throw()
test_coroutine_task_lifecycle() = {
    t = spawn {
        return 11
    }
    assert(!t.done(), "new task not done")
    t.cancel()
    assert(t.done(), "cancelled task is done")
    caught = false
    try {
        await t
    } catch (e) {
        caught = true
    }
    assert(caught, "await cancelled task raises")
}
test_coroutine_task_lifecycle()
test_coroutine_gc() = {
    import sys
    f() = {
        local payload = @[10, 20, 30]
        local sent = yield payload[0]
        return payload[1] + sent
    }
    c = f()
    assert(c.resume() == 10, "gc stress first value")
    sys.gc()
    sys.gc()
    caught = false
    try {
        c.send(5)
    } catch (e) {
        caught = true
    }
    assert(caught, "gc stress completion")
    assert(c.result() == 25, "gc preserves suspended registers")
}
test_coroutine_gc()
test_coroutine_close_defer() = {
    events = @[]
    f() = {
        defer events.push("defer")
        yield 1
        events.push("body")
    }
    c = f()
    assert(c.resume() == 1, "close defer first value")
    c.close()
    assert(events == @["defer"], "close runs defer without resuming body")
}
test_coroutine_close_defer()
test_coroutine_type_values() = {
    f() = { yield 1 }
    c = f()
    assert(type(c) == coroutine, "coroutine builtin type")
    assert(str(c) == "<coroutine>", "coroutine representation")
    t = spawn { return 1 }
    assert(type(t) == task, "task builtin type")
    assert(str(t) == "<task>", "task representation")
}
test_coroutine_type_values()
test_coroutine_try_across_yield() = {
    f() = {
        try {
            yield 1
            yield 2
        } catch (e) {
            return "caught"
        }
        return "no"
    }
    c = f()
    assert(c.resume() == 1, "try across yield first")
    caught = false
    try {
        c.throw("x")
    } catch (e) {
        caught = true
    }
    assert(caught, "throw completes the coroutine")
    assert(c.result() == "caught", "catch block runs after resume")
}
test_coroutine_try_across_yield()
test_coroutine_jit_deopt() = {
    f() = { yield 1 }
    local i = 0
    while (i < 1100) {
        c = f()
        c.close()
        i += 1
    }
    assert(!__dbg_is_jitted(f), "coroutine functions must deopt to interpreter")
}
test_coroutine_jit_deopt()
test_coroutine_nested_await() = {
    inner() = {
        yield 1
        return 20
    }
    t = spawn {
        local v = await inner()
        return v + 2
    }
    assert(await t == 22, "nested await inside spawn")
}
test_coroutine_nested_await()
}
