namespace A {
    a = 1
    include namespace { b = 2 }
}
assert(A.a == 1, "namespace own member")
assert(A.b == 2, "include into namespace")

namespace O {
    namespace I {
        include namespace { x = 3 }
    }
}
assert(O.I.x == 3, "nested namespace include")

namespace C {
    include namespace D { e = 1 }
}
assert(C.e == 1, "include named namespace contents")
assert(C.D.e == 1, "include named namespace binding")

print("namespace include battery OK")

f(flag) = {
    if (flag) include namespace { x = 1 }
    else include namespace { y = 2 }
}
namespace C { f(true) }
assert(C.x == 1, "conditional include true branch")
namespace D { f(false) }
assert(D.y == 2, "conditional include false branch")
