// ── features/test_functions.jc2 ─────────────────────────────────────────────
{


check(name, actual, expected) = {
    assert(str(actual) == str(expected), f"[{name}] Expected {expected}, got {actual}")
}

test_const_params() = {
    try {
        eval("f(const x) = { x = 2 }; f(1)")
        assert(false, "Should throw when modifying const param")
    } catch (e) {
        assert("Cannot modify const variable" in e.message, "Wrong error for const param")
    }
}
test_const_params()

test_destruct_params() = {
    // 测试函数参数直接解构
    get_info(const %{name, age=20}) = f"{name} is {age}"
    
    assert(get_info(%{name: "Bob"}) == "Bob is 20", "Destruct param with default")
    assert(get_info(%{name: "Charlie", age: 30}) == "Charlie is 30", "Destruct param provided")
}
test_destruct_params()

test_partial_application() = {
    my_add(a, b) = a + b
    add_five = my_add(5, _)
    assert(add_five(10) == 15, "Basic partial application failed")

}
test_partial_application()

// 闭包捕获局部变量。
// 回归：JIT 的 CLOSURE callout 走「变参 callout」约定（首个形参是值数组指针），
// 但 jc2_jit_closure 少声明了这个形参，于是 CodeEmitter 放进 rcx 的数组指针被
// 当成 fnIdx —— 任何捕获局部变量的闭包在 --jit 下都会以
// InternalError: Invalid function index 崩掉（解释器侧则完全正常）。
// 本段在解释器与 --jit 两种模式下都必须给出同样结果（测试套件两种模式都会跑）。
test_closure_capture() = {
    make_adder(n) = {
        add(x) = x + n
        return add
    }
    assert(make_adder(10)(5) == 15, "closure captures a parameter")

    outer(a) = {
        local base = a * 2
        inner(b) = base + b
        return inner
    }
    assert(outer(3)(4) == 10, "closure captures a local")

    // 多个闭包共享同一份捕获环境
    make_pair(n) = {
        inc() = n + 1
        dec() = n - 1
        return @[inc, dec]
    }
    p = make_pair(7)
    assert(p[0]() == 8 && p[1]() == 6, "sibling closures share the capture")

    // 循环里反复建闭包（逼 JIT 编译该函数）
    total = 0
    for (local i = 0; i < 300; i += 1) {
        total += make_adder(i)(1)
    }
    assert(total == 300 + 299 * 300 / 2, "repeated closure creation")
}
test_closure_capture()

test_basic_kwargs() = {
    f(a, b, c) = a * 100 + b * 10 + c
    assert(f(1, 2, 3) == 123, "Positional failed")
    assert(f(a=1, b=2, c=3) == 123, "Basic kwargs failed")
    assert(f(c=3, a=1, b=2) == 123, "Out of order kwargs failed")
    assert(f(1, c=3, b=2) == 123, "Mixed kwargs failed")
}
test_basic_kwargs()

test_duplicate_parameter_names_are_rejected() = {
    // ★ 回归：形参重复检查此前只覆盖"位置参数段"，rest / 仅关键字 / kwargs
    //   三段都漏了，于是跨分区同名被放行，且不是无害的——它静默产生错误语义：
    //     f(x, ...x) = x     → f(1,2,3) 返回 @[2,3]（rest 覆盖位置参数）
    //     f(x; ...x) = x     → f(1) 返回 {}（kwargs 字典遮蔽位置参数）
    //   现在四段同口径，一律 SyntaxError。
    throws(f) = { try { f(); return false } catch (e) { return true } }
    assert(throws(() => eval("f(x, x) = x")), "positional duplicate rejected")
    assert(throws(() => eval("f(x; x) = x")), "positional vs keyword-only duplicate rejected")
    assert(throws(() => eval("f(x; x = 1) = x")), "positional vs kwarg-with-default rejected")
    assert(throws(() => eval("f(x, y; x) = x")), "cross-partition duplicate rejected")
    assert(throws(() => eval("f(x; y, x) = x")), "keyword-only duplicate rejected")
    assert(throws(() => eval("f(x, ...x) = x")), "rest shadowing a positional rejected")
    assert(throws(() => eval("f(x; ...x) = x")), "kwargs shadowing a positional rejected")
    assert(throws(() => eval("f(...x; x) = x")), "keyword-only shadowing rest rejected")
    assert(throws(() => eval("f(x; y, ...x) = x")), "kwargs shadowing duplicate rejected")
}
test_duplicate_parameter_names_are_rejected()

test_legal_parameter_shapes_still_work() = {
    // 反面：合法的形参组合不得被误伤
    legal = @[
        "f(x, y) = x",
        "f(x; y) = x",
        "f(x, ...rest) = x",
        "f(x; y, z = 1) = y",
        "f(x, ...rest; y, ...kw) = y",
        "f(a, b = 2, ...rest) = a",
        "f(_; _) = 1",
        "f(x; ...kw) = kw",
    ]
    for (src in legal) {
        try {
            eval(src)
        } catch (e) {
            assert(false, f"legal parameter shape rejected: {src} -> {e}")
        }
    }
}
test_legal_parameter_shapes_still_work()

test_kwargs_with_defaults() = {
    f(a, b=2, c=3) = a * 100 + b * 10 + c
    assert(f(1) == 123, "Defaults failed")
    assert(f(1, c=9) == 129, "Kwarg skipping default failed")
    assert(f(a=5) == 523, "Kwarg only failed")
}
test_kwargs_with_defaults()

test_kwargs_with_rest() = {
    f(a, b=2, ...rest) = a + b + rest.sum()
    assert(f(10, 20, 1, 2, 3) == 36, "Rest positional failed")
    assert(f(10, b=5) == 15, "Rest with kwarg failed")
    // Note: rest does not collect kwargs.
}
test_kwargs_with_rest()

test_kwargs_errors() = {
    f(a, b, c) = a + b + c
    
    try {
        eval("f(a=1, 2, 3)")
        assert(false, "Should throw SyntaxError for positional after kwarg")
    } catch (e) {
        assert("Positional argument cannot follow keyword argument" in e.message, "Wrong error for positional after kwarg")
    }
    
    try {
        f(1, 2, 3, d=4)
        assert(false, "Should throw TypeError for unknown kwarg")
    } catch (e) {
        assert("Unexpected keyword argument 'd'" in e.message, "Wrong error for unknown kwarg")
    }
    
    try {
        f(1, 2, b=99)
        assert(false, "Should throw TypeError for multiple values")
    } catch (e) {
        assert("Multiple values for argument 'b'" in e.message, "Wrong error for multiple values")
    }
}
test_kwargs_errors()

test_kwargs_escape_hatch() = {
    f(x) = x
    a = 0
    assert(f((a = 42)) == 42, "Escape hatch failed")
    assert(a == 42, "Variable not assigned in escape hatch")
}
test_kwargs_escape_hatch()

test_native_kwargs() = {
    // isapprox(a, b, rtol, atol)
    assert(isapprox(1.0, 1.001, atol=0.01), "Native kwarg failed")
    assert(!isapprox(1.0, 1.001, atol=0.0001), "Native kwarg failed (should be false)")
}
test_native_kwargs()

test_dict_defaults() = {
    %{a, b = 20, c: d = 30} = %{a: 10}
    assert(a == 10 && b == 20 && d == 30, "Dict Default Failed")

    %{x = 99, y = 88} = %{x: 1, y: 88}
    assert(x == 1 && y == 88, "Dict Default (Existing Key) Failed")
}
test_dict_defaults()

test_list_defaults() = {
    @[l1, l2 = 2, l3 = 3] = @[10]
    assert(l1 == 10 && l2 == 2 && l3 == 3, "List Default Failed")

    @[l4 = 4, l5 = 5] = @[40, 50]
    assert(l4 == 40 && l5 == 50, "List Default (Existing Index) Failed")
}
test_list_defaults()

test_matrix_defaults() = {
    [m1, m2 = 2; m3 = 3, m4 = 4] = [10]
    assert(m1 == 10 && m2 == 2 && m3 == 3 && m4 == 4, "Matrix Default Failed")
}
test_matrix_defaults()

test_lazy_eval() = {
    side_effect_count = 0
    get_default() = {
        ref side_effect_count += 1
        return 999
    }

    %{val1 = get_default()} = %{val1: 1}
    assert(val1 == 1 && side_effect_count == 0, "Lazy Eval (Dict Existing) Failed")

    %{val2 = get_default()} = %{}
    assert(val2 == 999 && side_effect_count == 1, "Lazy Eval (Dict Missing) Failed")

    @[val3 = get_default()] = @[1]
    assert(val3 == 1 && side_effect_count == 1, "Lazy Eval (List Existing) Failed")

    @[val4, val5 = get_default()] = @[1]
    assert(val5 == 999 && side_effect_count == 2, "Lazy Eval (List Missing) Failed")
}
test_lazy_eval()

test_modifiers_defaults() = {
    outer_var = 0
    inner() = {
        @[local ma = 10, ref outer_var = 20, const mc = 30] = @[]
        return @[ma, outer_var, mc]
    }
    res = inner()
    assert(res[0] == 10 && res[1] == 20 && res[2] == 30, "Modifiers with Defaults Failed")
}
test_modifiers_defaults()

test_rest_defaults() = {
    @[ra = 1, rb = 2, ...r_rest] = @[99]
    assert(ra == 99 && rb == 2 && r_rest == @[], "Rest Pattern with Defaults Failed")
}
test_rest_defaults()

test_nested_defaults() = {
    @[@[na, nb = 2] = @[1], nc = 3] = @[]
    assert(na == 1 && nb == 2 && nc == 3, "Nested Destructuring Defaults Failed")

    %{nested: %{nx, ny = 20} = %{nx: 10}} = %{}
    assert(nx == 10 && ny == 20, "Nested Dict Destructuring Defaults Failed")
}
test_nested_defaults()

// ── 管道、自动柯里化与 UFCS（原 syntax/test_pipe_curry） ──

test_pipe() = {
    res = [1, 2, 3] |> .sum()
    assert(res == 6, "Basic pipe operator failed")
    
    res2 = @[3, 1, 2] |> .sorted() |> .first()
    assert(res2 == 1, "Chained pipe operator failed")

    class PipeObj { x = 7 }
    assert((PipeObj() |> .x) == 7, ".field pipe reads a property")

    inc(x) = x + 1
    assert((5 |> inc) == 6, "function pipe")

    add(a, b) = a + b
    assert((2 |> add(3, _)) == 5, "placeholder pipe")
}
test_pipe()

test_curry() = {
    my_add(a, b) = a + b
    add_five = my_add(_, 5)
    assert(add_five(10) == 15, "Auto-currying (placeholder) failed")
}
test_curry()

test_ufcs() = {
    // 点号调用：接收者进隐藏通道 self，实参就是实参（不再隐式当第 0 个实参）。
    // 这里两个用例都是原生原型上的成员，所以形如 .sum() / .upper() 的链式调用照旧。
    res = [1, 2, 3].sum()
    assert(res == 6, "UFCS basic failed")
    
    res2 = "hello".upper().reversed()
    assert(res2 == "OLLEH", "UFCS chained failed")
}
test_ufcs()


param_default_calls = 0
param_side() = { param_default_calls += 1; return 10 }
test_destructured_params() = {
    dist(%{x, y}) = x + y
    assert(dist(%{x: 3, y: 4}) == 7, "dict destructured parameter")

    process(@[a, b = 10, ...rest]) = a + b + rest.sum()
    assert(process(@[5]) == 15, "list destructured parameter default")
    assert(process(@[5, 20, 1, 2]) == 28, "list destructured parameter rest")

    get_info(const %{name, age = 20}) = name + ":" + str(age)
    assert(get_info(%{name: "Bob"}) == "Bob:20", "const destructured parameter")

    threw = false
    try { eval("f(const %{x}) = { x = 9 }; f(%{x: 1})") } catch (e) { threw = true }
    assert(threw, "const destructured parameter is read-only")

    threw = false
    try { eval("a = @[0]; f(const @[a[0]]) = a[0]") } catch (e) { threw = true }
    assert(threw, "const complex parameter target rejected")

    f(@[a, b = param_side()]) = @[a, b]
    assert(f(@[1, 2]) == @[1, 2], "provided parameter skips default")
    assert(param_default_calls == 0, "provided parameter default not evaluated")
    assert(f(@[1]) == @[1, 10], "missing parameter default")
    assert(param_default_calls == 1, "parameter default evaluated once")
}
test_destructured_params()


test_ref_param_defaults() = {
    threw = false
    try { eval("f(ref x = 1) = x") } catch (e) { threw = true }
    assert(threw, "ref parameter default must be rejected")

    threw = false
    try { eval("g = (ref x = 1) => x") } catch (e) { threw = true }
    assert(threw, "lambda ref parameter default must be rejected")

    threw = false
    try { eval("class C { m(ref x = 1) = x }") } catch (e) { threw = true }
    assert(threw, "method ref parameter default must be rejected")

    a = 5
    h(const ref x) = x
    assert(h(a) == 5, "const ref parameter reads")

    threw = false
    try { eval("a = 1; bad(const ref x) = { x = 2; return x }") } catch (e) { threw = true }
    assert(threw, "const ref parameter is read-only")
}
test_ref_param_defaults()

test_partial_all_holes() = {
    f(a, b, c) = @[a, b, c]
    p = f(_, _, _)
    assert(p(1, 2, 3) == @[1, 2, 3], "all placeholders in one call")
    threw = false
    try { p(1)(2)(3) } catch (e) { threw = true }
    assert(threw, "partial application requires all holes in one call")
}
test_partial_all_holes()


test_param_default_evaluation() = {
    order = list()
    d(n) = { order.push(n); return n }
    f(a = d("a"), b = d("b"), c = d("c")) = @[a, b, c]

    assert(f() == @["a", "b", "c"], "all defaults")
    assert(order == @["a", "b", "c"], "defaults evaluate in parameter order")

    while (order.len() > 0) { order.pop() }
    assert(f(c = 9) == @["a", "b", 9], "kwarg skips its default")
    assert(order == @["a", "b"], "only missing defaults evaluate")

    while (order.len() > 0) { order.pop() }
    assert(f(b = 8, a = 7) == @[7, 8, "c"], "reverse kwarg order")
    assert(order == @["c"], "provided kwargs do not evaluate defaults")

    threw = false
    try { f(z = 1) } catch (e) { threw = true }
    assert(threw, "unknown keyword")

    threw = false
    try { f(1, a = 2) } catch (e) { threw = true }
    assert(threw, "duplicate positional/keyword")
}
test_param_default_evaluation()
}

// ── features/test_destructuring.jc2 ─────────────────────────────────────────────
{


test_basic_1d() = {
    @[a, b, c] = @[10, 20, 30]
    assert(a == 10 && b == 20 && c == 30, "1D Array Destructuring Failed")
    @[la, lb] = list("hello", "world")
    assert(la == "hello" && lb == "world", "List Destructuring Failed")
    // 字符串不参与解构：历史遗留的"string 当 char 矩阵"分支已删除
    threw = false
    try { @[s1, s2, s3] = "ABC" } catch (e) { threw = true }
    assert(threw, "String Destructuring should be rejected")
}
test_basic_1d()

test_matrix_2d() = {
    [m1, m2; m3, m4] = [1, 2; 3, 4]
    assert(m1 == 1 && m2 == 2 && m3 == 3 && m4 == 4, "2D Matrix Destructuring Failed")
}
test_matrix_2d()

test_rest_1d() = {
    @[head, ...tail] = @[1, 2, 3, 4]
    assert(head == 1 && tail == @[2, 3, 4], "1D Tail Rest Failed")
    @[first, ...mid, last] = @[1, 2, 3, 4, 5]
    assert(first == 1 && mid == @[2, 3, 4] && last == 5, "1D Middle Rest Failed")
    @[...all] = @[7, 8, 9]
    assert(all == @[7, 8, 9], "1D Full Rest Failed")
}
test_rest_1d()

test_rest_2d() = {
    [tl, ...top_right; ...bottom_rows] = [1, 2, 3; 4, 5, 6; 7, 8, 9]
    assert(tl == 1, "2D Rest TL Failed")
    assert(top_right == [2, 3], "2D Rest Top Right Failed")
    assert(bottom_rows == [4, 5, 6; 7, 8, 9], "2D Rest Bottom Rows Failed")
}
test_rest_2d()

test_dict() = {
    obj = %{x: 100, y: 200, z: 300, w: 400}
    %{x, y: y_val, ...dict_rest} = obj
    assert(x == 100, "Dict Shorthand Destructuring Failed")
    assert(y_val == 200, "Dict Alias Destructuring Failed")
    assert(dict_rest.z == 300 && dict_rest.w == 400, "Dict Rest Failed")
}
test_dict()

test_complex_lvalues() = {
    arr = @[0, 0]
    target = %{val: 0}
    @[arr[0], target.val] = @[99, 88]
    assert(arr[0] == 99 && target.val == 88, "Complex L-Value Destructuring Failed")
}
test_complex_lvalues()

global_counter = 0
test_modifiers() = {
    inner() = {
        @[local a, ref global_counter, state c] = @[10, 20, 30]
        c += 5
        return c
    }
    res1 = inner()
    res2 = inner()
    assert(global_counter == 20, "Ref Modifier Failed")
    assert(res1 == 35 && res2 == 40, "State Modifier Failed")
}
test_modifiers()

test_forin() = {
    sum_keys = ""
    sum_vals = 0
    for (@[k, v] in %{A: 1, B: 2, C: 3}) {
        sum_keys += k
        sum_vals += v
    }
    assert(sum_keys == "ABC" && sum_vals == 6, "For-In Dict Destructuring Failed")

    row_sum = 0
    for (@[r1, ...r_rest] in @[@[1, 2, 3], @[4, 5, 6]]) {
        row_sum += r1 + r_rest.sum()
    }
    assert(row_sum == 21, "For-In Matrix Rest Destructuring Failed")
}
test_forin()

test_comprehension() = {
    comp_res = [x * y for (@[x, y] in @[@[1, 2], @[3, 4], @[5, 6]])]
    assert(comp_res == [2, 12, 30], "List Comprehension Destructuring Failed")

    comp_dict = @[k + str(v) for (%{k, v} in @[%{k: "X", v: 1}, %{k: "Y", v: 2}])]
    assert(comp_dict == @["X1", "Y2"], "List Comprehension Dict Destructuring Failed")
}
test_comprehension()

test_match() = {
    match_test(val) = {
        return match (val) {
            [a, b; c, d] => a + d,
            @[head, ...tail] if (head == 99) => tail.sum(),
            %{type: t, ...data} => t + str(data.id),
            _ => -1
        }
    }
    assert(match_test([1, 2; 3, 4]) == 5, "Match 2D Failed")
    assert(match_test(@[99, 10, 20]) == 30, "Match 1D Rest + Guard Failed")
    assert(match_test(%{type: "User", id: 42, active: true}) == "User42", "Match Dict Failed")
    assert(match_test("unknown") == -1, "Match Fallback Failed")
}
test_match()

test_strict_shape() = {
    try { [a, b, c] = [1, 2]; assert(false, "Should fail") } catch (e) {}
    try { [a, b] = [1, 2, 3]; assert(false, "Should fail") } catch (e) {}
    try { [a; b] = [1, 2]; assert(false, "Should fail") } catch (e) {}
}
test_strict_shape()

test_edge_cases() = {
    [] = []
    assert(true, "Empty Matrix Destructuring Failed")
    
    block_res = {
        a = 10
        b = 20
        a + b
    }
    assert(block_res == 30, "Block vs Dict Ambiguity Failed")
}
test_edge_cases()

check(name, actual, expected) = {
    assert(str(actual) == str(expected), f"[{name}] Expected {expected}, got {actual}")
}

test_list_destruct() = {
    @[a, b, ...rest] = @[1, 2, 3, 4, 5]
    assert(a == 1, "List destruct a")
    assert(b == 2, "List destruct b")
    check("List destruct rest", rest, @[3, 4, 5])
    
    // 默认值测试
    @[x, y=10] = @[1]
    assert(x == 1, "List destruct x")
    assert(y == 10, "List destruct default y")
}
test_list_destruct()

test_dict_destruct() = {
    %{name, age=18, ...other} = %{name: "Alice", city: "Wonderland"}
    assert(name == "Alice", "Dict destruct name")
    assert(age == 18, "Dict destruct default age")
    check("Dict destruct rest", other, %{city: "Wonderland"})
}
test_dict_destruct()

test_nested_destruct() = {
    %{user: %{id, role="guest"}} = %{user: %{id: 42}}
    assert(id == 42, "Nested destruct id")
    assert(role == "guest", "Nested destruct default role")
}
test_nested_destruct()

test_destruct_const() = {
    try {
        eval("f() = { const %{a, b} = %{a: 1, b: 2}; a = 10 }; f()")
        assert(false, "Should throw when modifying const destructured variable")
    } catch (e) {
        assert("Cannot modify const variable" in e.message, "Wrong error for const destruct")
    }
}
test_destruct_const()

// 位置解包（list）
test_spread_positional_list() = {
    f(a, ...rest) = a + rest.sum()
    args = @[2, 3, 4]
    assert(f(...args) == 9, "list spread failed")
    assert(f(1, ...args) == 10, "list spread with leading arg failed")
    assert(f(0, ...args, 9) == 18, "mid spread failed")
}
test_spread_positional_list()

// set 解包
test_spread_set() = {
    g(a, b) = a + b
    assert(g(...@{3, 4}) == 7, "set spread failed")
}
test_spread_set()

// 1D matrix 解包
test_spread_matrix() = {
    h(a, b, c) = a * 100 + b * 10 + c
    assert(h(...@[1, 2, 3]) == 123, "matrix spread failed")
}
test_spread_matrix()

// 字符串解包
test_spread_string() = {
    j(a, b, c) = str(a) + str(b) + str(c)
    assert(j(..."abc") == "abc", "string spread failed")
}
test_spread_string()

// 关键字解包（dict，写在 ; 后）
test_spread_keyword() = {
    k(a, b, c) = a * 100 + b * 10 + c
    opts = %{b: 2, c: 3}
    assert(k(1; ...opts) == 123, "kw spread failed")
    assert(k(a=1; ...opts) == 123, "kw spread with named arg failed")
}
test_spread_keyword()

// 位置 + 关键字混合解包
test_spread_mixed() = {
    m(a, ...rest; c, ...kw) = a + rest.sum() + c + kw.len()
    args = @[2, 3]
    opts = %{x: 5}
    assert(m(...args; c=4, ...opts) == 10, "mixed spread failed")
}
test_spread_mixed()

// 多个位置解包 + 空解包
test_spread_multi_empty() = {
    n(a, b, c, d) = a + b + c + d
    assert(n(...@[1, 2], ...@[3, 4]) == 10, "multi spread failed")
    assert(n(1, 2, ...@[], 3, 4) == 10, "empty spread failed")
}
test_spread_multi_empty()

// 不写分号的关键字传参保持现状
test_spread_no_semicolon() = {
    f(a, b) = a + b
    assert(f(a=1, b=2) == 3, "no semicolon kwargs failed")
}
test_spread_no_semicolon()

// __unpack__ / __mapping__ dunder
test_spread_dunder() = {
    class Pair {
        init(x, y) = { self.x = x; self.y = y }
        __unpack__() = @[self.x, self.y]
        __mapping__() = dict("a", self.x, "b", self.y)
    }
    p = Pair(7, 8)
    g(a, b) = a + b
    assert(g(...p) == 15, "__unpack__ spread failed")
    h(a; b) = a + b
    assert(h(; ...p) == 15, "__mapping__ spread failed")
}
test_spread_dunder()

// 解包错误
test_spread_errors() = {
    f(a, b) = a + b

    try {
        f(...1)
        assert(false, "should throw for non-iterable positional spread")
    } catch (e) {
        assert("positional spread expects" in e.message, "wrong error for positional spread")
    }

    try {
        f(1; ...2)
        assert(false, "should throw for non-dict keyword spread")
    } catch (e) {
        assert("keyword spread expects" in e.message, "wrong error for keyword spread")
    }
}
test_spread_errors()

// 字面量解包（列表/集合/字典）
test_literal_spread() = {
    a = @[1, 2]
    s = @{3, 4}
    d = %{x: 1, y: 2}
    assert(@[...a, 5] == @[1, 2, 5], "list literal spread failed")
    assert(@{...s, 9} == @{3, 4, 9}, "set literal spread failed")

    // 字典解包：后者覆盖，显式 key 优先级最高
    d1 = %{a: 1, b: 2}
    d2 = %{b: 9, c: 3}
    r = %{...d1, ...d2}
    assert(r["a"] == 1 && r["b"] == 9 && r["c"] == 3, "dict spread cover failed")
    r2 = %{...d1, a: 99}
    assert(r2["a"] == 99 && r2["b"] == 2, "dict spread explicit key priority failed")

    // 字面量里的 __unpack__ / __mapping__ dunder
    class P {
        init(x, y) = { self.x = x; self.y = y }
        __unpack__() = @[self.x, self.y]
        __mapping__() = dict("m", self.x, "n", self.y)
    }
    p = P(7, 8)
    assert(@[...p, 9] == @[7, 8, 9], "list literal __unpack__ failed")
    r3 = %{...p, q: 1}
    assert(r3["m"] == 7 && r3["n"] == 8 && r3["q"] == 1, "dict literal __mapping__ failed")
}
test_literal_spread()


test_modifier_conflict() = {
    threw = false
    try {
        eval("local @[ref a] = @[1]")
    } catch (e) {
        threw = true
        assert("modifier conflict" in e.message, "conflict message")
    }
    assert(threw, "mismatched pattern/target modifiers must fail")

    local @[local a] = @[1]
    assert(a == 1, "matching pattern/target modifiers")
}
test_modifier_conflict()


test_atomic_destructuring() = {
    a = 10
    b = 20
    threw = false
    try {
        @[a, b: int] = @[1, "x"]
    } catch (e) {
        threw = true
    }
    assert(threw, "type mismatch must fail")
    assert(a == 10 && b == 20, "failed destructuring must not commit")

    @[a, b = a] = @[1]
    assert(a == 1 && b == 1, "default may read earlier staged target")
}
test_atomic_destructuring()


test_state_targets() = {
    f() = {
        @[state a, state b] = @[1, 2]
        return a + b
    }
    assert(f() == 3, "target state init")
    assert(f() == 3, "target state persists")

    outer = 1
    g() = {
        @[ref outer, state s] = @[7, 8]
        return s
    }
    assert(g() == 8, "ref + state target")
    assert(outer == 7, "ref writes outer")

    bad() = {
        @[ref outer, state s: int] = @[9, "x"]
    }
    threw = false
    try { bad() } catch (e) { threw = true }
    assert(threw, "mixed state/ref failure")
    assert(outer == 7, "failed mixed pattern must not write ref")
}
test_state_targets()


pattern_state_calls = 0
pattern_retry_calls = 0
test_pattern_state() = {
    f() = {
        state @[a, b] = @[ (pattern_state_calls += 1), 2 ]
        return a + b + pattern_state_calls
    }
    assert(f() == 4, "pattern state first")
    assert(f() == 4, "pattern state cached")
    assert(pattern_state_calls == 1, "pattern state expr once")

    bad() = {
        state @[c, d: int] = @[ (pattern_retry_calls += 1), "x" ]
        return c
    }
    threw = 0
    try { bad() } catch (e) { threw += 1 }
    try { bad() } catch (e) { threw += 1 }
    assert(threw == 2, "pattern state retries after failure")
    assert(pattern_retry_calls == 2, "pattern state retry evaluates expr again")

    threw = false
    try {
        eval("f() = { const state @[x, y] = @[1, 2]; x = 9 }")
    } catch (e) {
        threw = true
    }
    assert(threw, "const state pattern is read-only")
}
test_pattern_state()


test_commit_preflight() = {
    a = 1
    f() = { ref @[a, missing] = @[9, 8] }
    threw = false
    try { f() } catch (e) { threw = true }
    assert(threw, "missing ref must fail")
    assert(a == 1, "missing ref must not partially commit")

    threw = false
    try {
        eval("a = 1; const b = 2; f() = { ref @[a, b] = @[9, 8] }; f()")
    } catch (e) {
        threw = true
    }
    assert(threw, "ref to const must fail before writes")
}
test_commit_preflight()


test_complex_lvalue_modifiers() = {
    a = @[0]
    b = @[0]
    @[a[0], b[0]] = @[5, 6]
    assert(a[0] == 5 && b[0] == 6, "plain complex l-values")

    cases = @[
        "a = @[0]; local @[a[0]] = @[5]",
        "a = @[0]; ref @[a[0]] = @[5]",
        "a = @[0]; const @[a[0]] = @[5]",
        "a = @[0]; local @[{k: a[0]}] = @[{k: 5}]",
        "a = @[0]; local @[a[0] = 1] = @[5]",
        "f() = { local a = @[0]; state @[a[0]] = @[5] }"
    ]
    for (src in cases) {
        threw = false
        try { eval(src) } catch (e) { threw = true }
        assert(threw, "modifier on complex l-value must fail: " + src)
    }
}
test_complex_lvalue_modifiers()


state_default_calls = 0
state_default_side() = { state_default_calls += 1; return 8 }
test_state_default_once() = {
    f() = { @[state a, state b = state_default_side()] = @[1]; return @[a, b] }
    assert(f() == @[1, 8], "state default first")
    assert(f() == @[1, 8], "state default cached")
    assert(state_default_calls == 1, "state default must not re-evaluate")
}
test_state_default_once()


test_forin_complex_modifiers() = {
    cases = @[
        "a = @[0]; for (const @[a[0]] in @[@[1]]) {}",
        "a = @[0]; for (local @[a[0]] in @[@[1]]) {}"
    ]
    for (src in cases) {
        threw = false
        try { eval(src) } catch (e) { threw = true }
        assert(threw, "for-in modifier on complex l-value must fail")
    }

    a = @[0]
    for (@[a[0]] in @[@[7]]) {
    }
    assert(a[0] == 7, "plain complex for-in target")
}
test_forin_complex_modifiers()


test_match_forward_ref() = {
    b = 99
    f(x) = match (x) {
        @[a = b, b = 1] => @[a, b],
        _ => @[-1, -1]
    }
    assert(f(@[]) == @[-1, -1], "match forward ref must not read outer name")

    g(x) = match (x) {
        @[a, b = a] => @[a, b],
        _ => @[-1, -1]
    }
    assert(g(@[7]) == @[7, 7], "match backward default still works")
}
test_match_forward_ref()


test_match_comp_local_scopes() = {
    x = 100
    r = [x for (x in @[1, 2, 3])]
    assert(r[0, 0] == 1 && r[0, 1] == 2 && r[0, 2] == 3, "comprehension values")
    assert(x == 100, "comprehension variable shadows outer local")

    f() = {
        y = 100
        q = [y for (y in @[1, 2])]
        return y
    }
    assert(f() == 100, "comprehension variable does not mutate outer")

    m(v) = match (v) {
        @[a] => a,
        _ => 0
    }
    assert(m(@[1]) == 1, "match branch value")

    threw = false
    try { eval("n(v) = match (v) { @[a] => a, _ => 0 }; n(@[1]); a") } catch (e) { threw = true }
    assert(threw, "match branch variable is local")

    threw = false
    try { eval("p(v) = match (v) { @[const c] => { c = 9 }, _ => 0 }; p(@[1])") } catch (e) { threw = true }
    assert(threw, "match const target is read-only")
}
test_match_comp_local_scopes()


test_matrix_default_rest() = {
    [a, b = 10, ...rest] = [5]
    assert(a == 5, "matrix default: first column")
    assert(b == 10, "matrix default: missing column uses default")
    assert(rest == [], "matrix default: rest is empty")
}
test_matrix_default_rest()
}

// ── features/test_call_window.jc2 ─────────────────────────────────────────────
{
// 调用窗口解耦的专项回归：尾调用、非尾递归、kwargs、方法调用、调用期 GC、闭包捕获、JIT 热路径
// 背景：VM 的建帧从 "base + 1" 改为"调用方窗口之上"，参数可以待在任意寄存器；
// 只要某个调用形式仍然把基址当帧锚点或写回基址，就会在这组用例里暴露。

// ── 1. 尾调用：帧复用，参数与新帧重叠 ──
sum_tail(n, acc) = {
    if (n == 0) {
        return acc
    }
    return sum_tail(n - 1, acc + n)
}

// ── 2. 非尾递归：窗口叠加 ──
fact(n) = {
    if (n <= 1) {
        return 1
    }
    return n * fact(n - 1)
}

// ── 3. kwargs 与默认值 ──
kw(a, b = 10, c = 20) = a + b + c

// ── 4. 方法与 super ──
class Base {
    init(v) = { self.v = v }
    add(x, y = 1) = self.v + x + y
}
class Derived extends Base {
    init(v) = { super.init(v) }
    twice(x) = self.add(x) + self.add(x, 2)
}

give(x) = {
    // ── 5. 调用期分配：参数 x 必须在 GC 下存活 ──
    junk = @[]
    for (i in range(50)) {
        junk.push(@[i, str(i)])
    }
    return @[x, junk.len()]
}

// ── 6. 闭包捕获：调用不能覆盖被捕获的槽 ──
make_adder(n) = {
    return (x) => x + n
}

// ── 7. JIT 热路径：重复调用小函数 ──
hot(x) = x * 2 + 1

// ── 变量实参：避免常量直写，逼出真实的参数打包 ──
a = 1
b = 2
c = 3

assert(sum_tail(200, 0) == 20100, "tail-position call (200 frames)")
// 真正的 TCO：这个深度远超 1024 帧上限，没有帧复用必然爆栈
assert(sum_tail(20000, 0) == 200010000, "tail call must reuse the frame (TCO)")

// A tail call reuses the caller frame; open ref upvalues must be closed
// before the reused window is overwritten by callee locals.
ref_tail_capture() = {
    local x = 7
    b() = {
        ref x
        f = 1
        return x
    }
    return b()
}
assert(ref_tail_capture() == 7, "ref upvalue must survive tail-call frame reuse")

ref_tail_closure() = {
    local x = 7
    b() = {
        ref x
        f = () => x
        return f()
    }
    return b()
}
assert(ref_tail_closure() == 7, "ref closure must read the closed upvalue across a tail call")

// ── 尾调用与异常：try 内不做 TCO，catch 必须还能接住 ──
boom() = { throw "x" }
safe() = {
    try {
        return boom()
    } catch (e) {
        return -1
    }
}
assert(safe() == -1, "tail position inside try keeps the handler")

// ── 尾调用到类构造：实例写在 dst 后再收尾，不能被 init 帧覆盖 ──
class Point2 {
    init(v) = { self.v = v }
}
make_point(v) = { return Point2(v) }
assert(make_point(3).v == 3, "tail call to a class constructor")

// ── 尾调用到原生函数 ──
tail_native(x) = { return len(x) }
assert(tail_native(@[1, 2, 3, 4]) == 4, "tail call to a native builtin")
assert(fact(15) == 1307674368000, "non-tail recursion")
assert(kw(a, b = b, c = c) == 6, "kwargs with all named")
assert(kw(5) == 35, "kwargs defaults")
assert(kw(1, 2) == 23, "positional + default")

d = Derived(10)
assert(d.twice(5) == 33, "method calls with defaults and super.init")

r = give(@[a, b, c])
assert(r[0] == @[1, 2, 3] && r[1] == 50, "argument survives GC during the call")

add7 = make_adder(7)
assert(add7(5) == 12, "closure capture")
assert(add7(a) == 8, "closure capture with variable arg")

s = 0
for (i in range(20000)) {
    s = s + hot(i)
}
assert(s == 400000000, "hot path sum")
}

// ── features/test_binding.jc2 ─────────────────────────────────────────────
{
local functionSample(x) = x + 1
assert(functionSample(1) == 2, "function binding")

const constFunction(x) = x * 2
assert(constFunction(3) == 6, "const function binding")

class StaticSample {
    static const X = 1
}
assert(StaticSample.X == 1, "static const initializer")

namespace A {
    class C {}
    namespace N {}
    enum E { x, y }
    local class Hidden {}
}

assert("C" in getFields(A), "class binding")
assert("N" in getFields(A), "namespace binding")
assert("E" in getFields(A), "enum binding")
assert(!("Hidden" in getFields(A)), "local class is not a field")
}

// ── features/test_hoist.jc2 ─────────────────────────────────────────────
{
// Auto-local assignments nested in expressions must be hoisted to function scope.
f() = {
    if (true) {
        (x = 1)
    }
    return x
}
assert(f() == 1, "grouping assignment hoist")

g() = {
    if (true) {
        (y = 2)
    }
    return y
}
assert(g() == 2, "call argument assignment hoist")

h() = {
    try (z = 3)
    return z
}
assert(h() == 3, "try expression assignment hoist")

k() = {
    if (true) {
        local v = (w = 4) + 1
    }
    return w
}
assert(k() == 4, "binary operand assignment hoist")
}

// ── features/test_named_literal_def.jc2 ─────────────────────────────────────────────
{
// 具名但不绑定变量的定义形式：class "N" {...}
throws(f) = {
    try { f(); return false } catch (e) { return true }
}

undefined(name) = {
    try {
        eval(name)
        return false
    } catch (e) {
        return true
    }
}

// ── 1. class "N"：有名字、但不产生变量 ──
P = class "Point" {
    init(x, y) = { self.x = x; self.y = y }
    sum() = self.x + self.y
}
assert(P(1, 2).sum() == 3, "the value of a string-named class is usable")
assert(str(P(1, 2)).startsWith("<Point "), "the class keeps its name")
assert(undefined("Point"), "no variable is bound for class \"Point\"")

// ── 2. 语句位置：值被丢弃，但定义本身合法 ──
class Base {
    init(v) = { self.v = v }
    read() = self.v
}
class "Anonymous" extends Base {
    init() = { super.init(7) }
}
assert(Base(3).read() == 3, "ordinary binding form still works")

// ── 3. namespace "N" ──
NS = namespace "Geo" {
    origin = "0,0"
}
assert(NS.origin == "0,0", "the value of a string-named namespace is usable")
assert(undefined("Geo"), "no variable is bound for namespace \"Geo\"")

// ── 4. enum "N" ──
E = enum "Color" { RED, GREEN, BLUE }
assert(E.GREEN == 1, "the value of a string-named enum is usable")
assert(undefined("Color"), "no variable is bound for enum \"Color\"")

// ── 5. trait "N" ──
D = trait "Drawable" {
    draw() = "drawing"
}
class Widget with D {
    init() = %{ }
}
assert(Widget().draw() == "drawing", "a string-named trait can be composed")
assert(undefined("Drawable"), "no variable is bound for trait \"Drawable\"")

// ── 6. 原有形式不受影响 ──
class Bound { init() = { } }
assert(!undefined("Bound"), "identifier form still binds")
Anon = class { init() = { } }
assert(str(Anon()) != "", "anonymous form still works")

// ── 7. 空名字与修饰符报错 ──
assert(throws(() => eval("class \"\" { }")), "empty class name is rejected")
assert(throws(() => eval("namespace \"\" { }")), "empty namespace name is rejected")
assert(throws(() => eval("enum \"\" { }")), "empty enum name is rejected")
assert(throws(() => eval("local class \"X\" { }")), "a modifier needs a variable")

// ── 8. 定义名字：raw string 可用，f-string 拒绝 ──
Raw = class r"Raw\Name" { init() = { } }
assert(str(Raw()).startsWith(r"<Raw\Name"), "raw-string class name keeps backslashes")
RawNS = namespace r"Raw\NS" { x = 1 }
assert(RawNS.x == 1, "raw-string namespace name")
RawE = enum r"Raw\E" { A }
assert(RawE.A == 0, "raw-string enum name")
RawT = trait r"Raw\T" { m() = 1 }
assert(!undefined("RawT"), "raw-string trait name value")
assert(throws(() => eval("class f\"X\" { }")), "f-string class name rejected")
assert(throws(() => eval("namespace f\"X\" { }")), "f-string namespace name rejected")
assert(throws(() => eval("enum f\"X\" { A }")), "f-string enum name rejected")
assert(throws(() => eval("enum Dup { A, A }")), "duplicate enum member rejected")
}

// ── auto-local use before assignment ───────────────────────────
test_auto_local_forward_reference() = {
    cases = @[
        "f() = { print(y); y = 1 }; f()",
        "f() = { x = y; y = 1; x }; f()",
        "f() = { print(1 + y); y = 1 }; f()",
        "y = 42; f() = { print(y); y = 1 }; f()"
    ]
    for (src in cases) {
        caught = false
        try { eval(src) } catch (e) { caught = true }
        assert(caught, "auto-local forward reference must be a compile error")
    }

    assert(eval("f() = { y = 1; y }; f()") == 1, "assignment before read remains valid")
}
test_auto_local_forward_reference()

// ── auto-local maybe-unbound branch ─────────────────────────────
test_auto_local_branch_unbound() = {
    assert(eval("f(c) = { if (c) { y = 1 }; y }; f(true)") == 1,
           "assigned branch must be readable")

    caught = false
    try { eval("f(c) = { if (c) { y = 1 }; y }; f(false)") } catch (e) {
        caught = true
    }
    assert(caught, "unassigned branch must fail at the checked read")

    assert(eval("f(c) = { if (c) { y = 1 } else { y = 2 }; y }; f(false)") == 2,
           "both branches assign")
}
test_auto_local_branch_unbound()

// ── captured auto-local runtime check ───────────────────────────
test_auto_local_closure_unbound() = {
    assert(eval("f(c) = { if (c) { y = 1 }; g() = y; g() }; f(true)") == 1,
           "captured bound value must be readable")

    caught = false
    try { eval("f(c) = { if (c) { y = 1 }; g() = y; g() }; f(false)") } catch (e) {
        caught = true
    }
    assert(caught, "captured unbound value must fail at the checked read")
}
test_auto_local_closure_unbound()
