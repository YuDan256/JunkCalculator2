test_basic_quote() = {
    macro twice(node) = {
        return quote {
            $node
            $node
        }
    }
    
    counter = 0
    @twice { counter += 1 }
    assert(counter == 2, "Basic quote/unquote failed")
}
test_basic_quote()

test_ast_manipulation() = {
    macro swap(node) = {
        match (node) {
            {type: "Block", statements: stmts} => {
                a = stmts[0]
                b = stmts[1]
                return quote {
                    local temp = $a
                    $a = $b
                    $b = temp
                }
            }
            _ => throw "Expected a block"
        }
    }
    
    x = 10
    y = 20
    @swap { x; y }
    assert(x == 20 && y == 10, "AST manipulation (swap) failed")
}
test_ast_manipulation()

test_quote_returns_ast() = {
    node = quote { 1 + 2 }
    assert(node.type == "Block", "Quote should return ASTNode Block")
    
    bin_op = node.statements[0]
    assert(bin_op.type == "Binary" && bin_op.op == "+", "Quote inner AST structure failed")
    assert(bin_op.left.value == "1" && bin_op.right.value == "2", "Quote inner AST values failed")
}
test_quote_returns_ast()

test_macro_errors() = {
    try {
        eval("macro bad(n) = { return 1 }; @bad { 1 }")
        assert(false, "Should throw when macro doesn't return ASTNode")
    } catch (e) {
        assert("Macro Error: Expected ASTNode instance" in e.message || "did not return a valid ASTNode" in e.message, "Wrong error for invalid macro return")
    }

    try {
        eval("x = 1; $x")
        assert(false, "Should throw when unquote is used outside quote")
    } catch (e) {
        assert("Syntax Error" in e.message, "Wrong error for unquote outside quote")
    }
    
    try {
        eval("macro foo(n) = { return quote { 1 } }; foo(1)")
        assert(false, "Should throw when macro is called as a normal function")
    } catch (e) {
        assert("Undefined" in e.message || "not defined" in e.message, "Wrong error for normal macro call")
    }
}
test_macro_errors()

test_macro_expr_arg() = {
    macro square_macro(node) = {
        return quote {
            $node * $node
        }
    }
    
    res = @square_macro(5 + 2)
    assert(res == 49, "Macro with expression argument failed")
}
test_macro_expr_arg()

test_ast_tamper() = {
    macro tamper(node) = {
        match (node) {
            {type: "Block", statements: stmts} => {
                bin_op = stmts[0]
                // 把加号强行篡改为乘号
                bin_op.op = "*"
                return quote { $bin_op }
            }
            _ => throw "Expected a block"
        }
    }

    res = @tamper { 2 + 3 }
    assert(res == 6, "AST tampering failed")
}
test_ast_tamper()

test_macro_control_flow() = {
    macro repeat_three(node) = {
        i_var = gensym("i")
        return quote {
            for (local $i_var = 0; $i_var < 3; $i_var += 1) {
                $node
            }
        }
    }
    
    count = 0
    @repeat_three { count += 10 }
    assert(count == 30, "Macro generating control flow failed")
}
test_macro_control_flow()

test_macro_generate_function() = {
    macro make_adder(node) = {
        return quote {
            (x) => x + $node
        }
    }
    
    add_five = @make_adder(5)
    assert(add_five(10) == 15, "Macro generating function failed")
}
test_macro_generate_function()

test_no_arg_macro() = {
    macro inject_logger() = {
        return quote {
            logger = (msg) => msg
        }
    }
    
    @inject_logger()
    assert(logger("hello") == "hello", "No-arg macro failed")
    
    @inject_logger
    assert(logger("world") == "world", "No-arg macro without parens failed")
}
test_no_arg_macro()

test_no_arg_macro_safety() = {
    macro get_one() = {
        return quote { 1 }
    }
    
    // 确保无参宏后面的 { 2 } 不会被当作宏参数吃掉
    arr = [@get_one, { 2 }]
    assert(arr[0] == 1, "No-arg macro safety failed")
}
test_no_arg_macro_safety()

test_multi_arg_macro() = {
    macro repeat(n_node, body_node) = {
        i_var = gensym("i")
        return quote {
            for (local $i_var = 0; $i_var < $n_node; $i_var += 1) {
                $body_node
            }
        }
    }
    
    count = 0
    @repeat(3) {
        count += 5
    }
    assert(count == 15, "Multi-arg macro with trailing block failed")
    
    count2 = 0
    @repeat(2, { count2 += 10 })
    assert(count2 == 20, "Multi-arg macro with standard call failed")
}
test_multi_arg_macro()

test_variadic_macro() = {
    macro build_list(...nodes) = {
        return ASTNode("Call", 0, {
            callee: "list",
            arguments: nodes
        })
    }
    
    res = @build_list(1, 2, 3)
    assert(len(res) == 3 && res[0] == 1 && res[2] == 3, "Variadic macro failed")
    
    res2 = @build_list(10) { 20 }
    assert(len(res2) == 2 && res2[0] == 10 && res2[1] == 20, "Variadic macro with trailing block failed")
}
test_variadic_macro()

test_macro_identifier_unquote() = {
    macro def_memo(func_name, arg_name, body) = {
        cache_var = gensym("cache")
        res_var = gensym("res")
        return quote {
            local $cache_var = {}
            $func_name($arg_name) = {
                if ($arg_name in $cache_var) {
                    return $cache_var[$arg_name]
                }
                local $res_var = $body
                $cache_var[$arg_name] = $res_var
                return $res_var
            }
            none
        }
    }
    
    eval_count = 0
    local my_fib
    @def_memo(my_fib, n, {
        ref eval_count += 1;
        if (n <= 1) n else my_fib(n - 1) + my_fib(n - 2)
    })
    
    res = my_fib(10)
    assert(res == 55, "Memoized function returned wrong result")
    assert(eval_count == 11, "Memoized function evaluated too many times")
}
test_macro_identifier_unquote()

test_hygienic_macro() = {
    macro hygienic_swap(a_node, b_node) = {
        temp_var = gensym("temp")
        return quote {
            local $temp_var = $a_node
            $a_node = $b_node
            $b_node = $temp_var
        }
    }
    
    temp = 100
    x = 10
    @hygienic_swap(temp, x)
    assert(temp == 10 && x == 100, "Hygienic macro failed")
}
test_hygienic_macro()

test_local_macro_scope() = {
    // 测试局部宏在块级作用域内有效
    res = eval("{ macro local_mac() = quote { 42 }; @local_mac() }")
    assert(res == 42, "Local macro should work inside its scope")
    
    // 测试局部宏不会泄漏到外部作用域
    try {
        eval("@local_mac()")
        assert(false, "Local macro should not leak outside its scope")
    } catch (e) {
        assert("not defined" in e.message || "Undefined" in e.message, "Expected undefined macro error")
    }
}
test_local_macro_scope()

test_macro_shadowing() = {
    macro shadow_mac() = quote { 1 }
    res1 = @shadow_mac()
    assert(res1 == 1, "Global macro should return 1")
    
    res2 = 0
    {
        // 内部作用域定义同名宏，形成遮蔽 (Shadowing)
        macro shadow_mac() = quote { 2 }
        res2 = @shadow_mac()
    }
    assert(res2 == 2, "Local macro should shadow global macro")
    
    // 离开内部作用域后，外部宏恢复可见
    res3 = @shadow_mac()
    assert(res3 == 1, "Global macro should be restored after block")
}
test_macro_shadowing()

test_macro_deletion() = {
    // 定义一个宏然后立即使用 delete @macro 卸载它
    eval("macro temp_mac() = quote { 99 }; delete @temp_mac")
    
    // 验证卸载后该宏不再可用
    try {
        eval("@temp_mac()")
        assert(false, "Deleted macro should not be accessible")
    } catch (e) {
        assert("not defined" in e.message || "Undefined" in e.message, "Expected undefined macro error after deletion")
    }
}
test_macro_deletion()

test_macro_splicing() = {
    macro declare_two() = {
        // 返回一个 List，实现多语句平铺注入（不引入作用域）
        return [
            quote local splice_a = 100,
            quote local splice_b = 200
        ]
    }
    
    @declare_two()
    assert(splice_a == 100 && splice_b == 200, "Macro list splicing failed")
}
test_macro_splicing()

test_comptime_import() = {
    import io
    // 动态创建一个包含辅助函数和宏的库文件
    lib_code = "make_prefix(name) = \"PREFIX_\" + name\n" +
               "macro generate_var(name) = {\n" +
               "    new_name = make_prefix(name.value)\n" +
               "    return quote local $new_name = 42\n" +
               "}\n"
    io.writeFile("temp_macro_lib.jc2", lib_code)
    
    // 在编译期导入该库，并调用宏
    res = eval("import @temp_macro_lib\n@generate_var(\"test\")\nPREFIX_test")
    assert(res == 42, "Compile-time import and execution failed")
    
    io.deleteFile("temp_macro_lib.jc2")
}
test_comptime_import()
