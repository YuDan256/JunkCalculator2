{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "JC2",
    "scopeName": "source.jc2",
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#fstrings"
        },
        {
            "include": "#rstrings"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#property-access"
        },
        {
            "include": "#function-def"
        },
        {
            "include": "#enum-block"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#class-def"
        },
        {
            "include": "#function-call"
        },
        {
            "include": "#constants"
        },
        {
            "include": "#builtin-types"
        },
        {
            "include": "#builtin-functions"
        },
        {
            "include": "#operators"
        },
        {
            "include": "#punctuation"
        },
        {
            "include": "#macros"
        },
        {
            "include": "#identifiers"
        }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.jc2",
                    "match": "//.*$"
                },
                {
                    "name": "comment.block.jc2",
                    "begin": "/\\*",
                    "end": "\\*/",
                    "patterns": [
                        {
                            "include": "#comments"
                        }
                    ]
                },
                {
                    "name": "comment.line.shebang.jc2",
                    "match": "^#!.*$"
                },
                {
                    "name": "comment.line.directive.jc2",
                    "match": "^#[A-Za-z_][A-Za-z0-9_]*.*$"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.triple.double.jc2",
                    "begin": "\"\"\"",
                    "end": "\"\"\"",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.begin.jc2"
                        }
                    },
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.end.jc2"
                        }
                    },
                    "patterns": [
                        {
                            "name": "constant.character.escape.jc2",
                            "match": "\\\\[nrt\\\\\"'0]"
                        }
                    ]
                },
                {
                    "name": "string.quoted.triple.single.jc2",
                    "begin": "'''",
                    "end": "'''",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.begin.jc2"
                        }
                    },
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.end.jc2"
                        }
                    },
                    "patterns": [
                        {
                            "name": "constant.character.escape.jc2",
                            "match": "\\\\[nrt\\\\\"'0]"
                        }
                    ]
                },
                {
                    "name": "string.quoted.double.jc2",
                    "begin": "\"",
                    "end": "\"",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.begin.jc2"
                        }
                    },
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.end.jc2"
                        }
                    },
                    "patterns": [
                        {
                            "name": "constant.character.escape.jc2",
                            "match": "\\\\[nrt\\\\\"0]"
                        }
                    ]
                },
                {
                    "name": "string.quoted.single.jc2",
                    "begin": "'",
                    "end": "'",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.begin.jc2"
                        }
                    },
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.end.jc2"
                        }
                    },
                    "patterns": [
                        {
                            "name": "constant.character.escape.jc2",
                            "match": "\\\\[nrt\\\\\\'0]"
                        }
                    ]
                }
            ]
        },
        "fstrings": {
            "patterns": [
                {
                    "name": "string.interpolated.triple.double.jc2",
                    "begin": "f\"\"\"",
                    "end": "\"\"\"",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.begin.jc2"
                        }
                    },
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.end.jc2"
                        }
                    },
                    "patterns": [
                        {
                            "name": "constant.character.escape.jc2",
                            "match": "\\\\[nrt\\\\\"'0]"
                        },
                        {
                            "include": "#fstring-interpolation"
                        }
                    ]
                },
                {
                    "name": "string.interpolated.triple.single.jc2",
                    "begin": "f'''",
                    "end": "'''",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.begin.jc2"
                        }
                    },
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.end.jc2"
                        }
                    },
                    "patterns": [
                        {
                            "name": "constant.character.escape.jc2",
                            "match": "\\\\[nrt\\\\\"'0]"
                        },
                        {
                            "include": "#fstring-interpolation"
                        }
                    ]
                },
                {
                    "name": "string.interpolated.double.jc2",
                    "begin": "f\"",
                    "end": "\"",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.begin.jc2"
                        }
                    },
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.end.jc2"
                        }
                    },
                    "patterns": [
                        {
                            "name": "constant.character.escape.jc2",
                            "match": "\\\\[nrt\\\\\"0]"
                        },
                        {
                            "include": "#fstring-interpolation"
                        }
                    ]
                },
                {
                    "name": "string.interpolated.single.jc2",
                    "begin": "f'",
                    "end": "'",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.begin.jc2"
                        }
                    },
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.end.jc2"
                        }
                    },
                    "patterns": [
                        {
                            "name": "constant.character.escape.jc2",
                            "match": "\\\\[nrt\\\\\\'0]"
                        },
                        {
                            "include": "#fstring-interpolation"
                        }
                    ]
                }
            ]
        },
        "fstring-interpolation": {
            "patterns": [
                {
                    "name": "meta.interpolation.jc2",
                    "begin": "\\{",
                    "end": "\\}",
                    "contentName": "source.jc2.embedded",
                    "patterns": [
                        {
                            "include": "source.jc2"
                        }
                    ]
                }
            ]
        },
        "rstrings": {
            "patterns": [
                {
                    "comment": "Custom Delimiter Raw String: r\"TAG(content)TAG\"",
                    "name": "string.raw.delimited.double.jc2",
                    "begin": "r\"([a-zA-Z0-9_]*)\\(",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.begin.jc2"
                        }
                    },
                    "end": "\\)\\1\"",
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.end.jc2"
                        }
                    }
                },
                {
                    "comment": "Custom Delimiter Raw String: r'TAG(content)TAG'",
                    "name": "string.raw.delimited.single.jc2",
                    "begin": "r'([a-zA-Z0-9_]*)\\(",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.begin.jc2"
                        }
                    },
                    "end": "\\)\\1'",
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.end.jc2"
                        }
                    }
                },
                {
                    "comment": "Triple Double Raw String: r\"\"\"content\"\"\"",
                    "name": "string.raw.triple.double.jc2",
                    "begin": "r\"\"\"",
                    "end": "\"\"\"",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.begin.jc2"
                        }
                    },
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.end.jc2"
                        }
                    }
                },
                {
                    "comment": "Triple Single Raw String: r'''content'''",
                    "name": "string.raw.triple.single.jc2",
                    "begin": "r'''",
                    "end": "'''",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.begin.jc2"
                        }
                    },
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.end.jc2"
                        }
                    }
                },
                {
                    "comment": "Simple Raw String: r\"content\"",
                    "name": "string.raw.simple.double.jc2",
                    "begin": "r\"",
                    "end": "\"",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.begin.jc2"
                        }
                    },
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.end.jc2"
                        }
                    }
                },
                {
                    "comment": "Simple Raw String: r'content'",
                    "name": "string.raw.simple.single.jc2",
                    "begin": "r'",
                    "end": "'",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.begin.jc2"
                        }
                    },
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.end.jc2"
                        }
                    }
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.imaginary.jc2",
                    "match": "\\b\\d+(\\.\\d+)?([eE][+-]?\\d+)?[iI]\\b"
                },
                {
                    "name": "constant.numeric.float.jc2",
                    "match": "\\b\\d+\\.\\d+([eE][+-]?\\d+)?\\b"
                },
                {
                    "name": "constant.numeric.scientific.jc2",
                    "match": "\\b\\d+[eE][+-]?\\d+\\b"
                },
                {
                    "name": "constant.numeric.integer.jc2",
                    "match": "\\b\\d+[\\d_]*\\b"
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.jc2",
                    "match": "\\b(if|else|while|for|in|is|as|break|continue|return|switch|case|default|throw|try|catch|match|defer)\\b"
                },
                {
                    "name": "keyword.declaration.jc2",
                    "match": "\\b(class|extends|const|state|delete|ref|import|local|namespace|macro|syntax|quote|enum|static)\\b"
                }
            ]
        },
        "enum-block": {
            "patterns": [
                {
                    "begin": "\\b(enum)\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
                    "beginCaptures": {
                        "1": {
                            "name": "keyword.declaration.enum.jc2"
                        },
                        "2": {
                            "name": "entity.name.type.enum.jc2"
                        }
                    },
                    "end": "\\}",
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.bracket.curly.jc2"
                        }
                    },
                    "patterns": [
                        {
                            "include": "#comments"
                        },
                        {
                            "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\b",
                            "name": "variable.other.enummember.jc2"
                        },
                        {
                            "include": "#numbers"
                        },
                        {
                            "include": "#strings"
                        },
                        {
                            "include": "#operators"
                        },
                        {
                            "include": "#punctuation"
                        }
                    ]
                },
                {
                    "begin": "\\b(enum)\\s*(?=\\{)",
                    "beginCaptures": {
                        "1": {
                            "name": "keyword.declaration.enum.jc2"
                        }
                    },
                    "end": "\\}",
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.bracket.curly.jc2"
                        }
                    },
                    "patterns": [
                        {
                            "include": "#comments"
                        },
                        {
                            "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\b",
                            "name": "variable.other.enummember.jc2"
                        },
                        {
                            "include": "#numbers"
                        },
                        {
                            "include": "#strings"
                        },
                        {
                            "include": "#operators"
                        },
                        {
                            "include": "#punctuation"
                        }
                    ]
                }
            ]
        },
        "class-def": {
            "patterns": [
                {
                    "match": "\\b(class)\\s+([A-Za-z_][A-Za-z0-9_]*)(?:\\s+(extends)\\s+([A-Za-z_][A-Za-z0-9_]*))?",
                    "captures": {
                        "1": {
                            "name": "keyword.declaration.class.jc2"
                        },
                        "2": {
                            "name": "entity.name.type.class.jc2"
                        },
                        "3": {
                            "name": "keyword.declaration.extends.jc2"
                        },
                        "4": {
                            "name": "entity.other.inherited-class.jc2"
                        }
                    }
                },
                {
                    "match": "\\b(namespace)\\s+([A-Za-z_][A-Za-z0-9_]*)",
                    "captures": {
                        "1": {
                            "name": "keyword.declaration.namespace.jc2"
                        },
                        "2": {
                            "name": "entity.name.namespace.jc2"
                        }
                    }
                }
            ]
        },
        "function-def": {
            "patterns": [
                {
                    "match": "\\b(__[A-Za-z_][A-Za-z0-9_]*__)\\s*(?=\\()",
                    "captures": {
                        "1": {
                            "name": "support.function.magic.jc2"
                        }
                    }
                },
                {
                    "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\([^)]*\\)(?:\\s*->\\s*[A-Za-z_][A-Za-z0-9_]*)?\\s*=)",
                    "captures": {
                        "1": {
                            "name": "entity.name.function.definition.jc2"
                        }
                    }
                }
            ]
        },
        "function-call": {
            "patterns": [
                {
                    "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
                    "captures": {
                        "1": {
                            "name": "entity.name.function.call.jc2"
                        }
                    }
                }
            ]
        },
        "constants": {
            "patterns": [
                {
                    "name": "constant.language.jc2",
                    "match": "\\b(true|false|none)\\b"
                },
                {
                    "name": "variable.language.jc2",
                    "match": "\\b(self|super|_)\\b"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.pipe.jc2",
                    "match": "\\|>"
                },
                {
                    "name": "keyword.operator.arrow.jc2",
                    "match": "=>"
                },
                {
                    "name": "keyword.operator.spread.jc2",
                    "match": "\\.\\.\\."
                },
                {
                    "name": "keyword.operator.integer-division.jc2",
                    "match": "~/"
                },
                {
                    "name": "keyword.operator.shift-assign.jc2",
                    "match": "<<=|>>="
                },
                {
                    "name": "keyword.operator.shift.jc2",
                    "match": "<<|>>"
                },
                {
                    "name": "keyword.operator.comparison.jc2",
                    "match": "==|!=|<=|>=|<|>"
                },
                {
                    "name": "keyword.operator.logical.jc2",
                    "match": "&&|\\|\\||!"
                },
                {
                    "name": "keyword.operator.assignment.jc2",
                    "match": "\\+=|-=|\\*=|/=|%=|\\^\\^=|\\^=|&=|\\|=|="
                },
                {
                    "name": "keyword.operator.arithmetic.jc2",
                    "match": "\\+|-|\\*|/|%|\\^\\^|\\^|\\\\|~|&|\\|"
                },
                {
                    "name": "keyword.operator.ternary.jc2",
                    "match": "\\?|:"
                }
            ]
        },
        "punctuation": {
            "patterns": [
                {
                    "name": "punctuation.bracket.round.jc2",
                    "match": "[()]"
                },
                {
                    "name": "punctuation.bracket.square.jc2",
                    "match": "@?\\[|\\]"
                },
                {
                    "name": "punctuation.bracket.curly.jc2",
                    "match": "@?\\{|\\}"
                },
                {
                    "name": "punctuation.separator.jc2",
                    "match": "[,;]"
                },
                {
                    "name": "punctuation.accessor.jc2",
                    "match": "\\."
                }
            ]
        },
        "macros": {
            "patterns": [
                {
                    "name": "entity.name.function.macro.jc2",
                    "match": "@[a-zA-Z_][a-zA-Z0-9_]*\\b"
                },
                {
                    "name": "variable.other.unquote.jc2",
                    "match": "\\$[a-zA-Z_][a-zA-Z0-9_]*\\b"
                }
            ]
        },
        "identifiers": {
            "patterns": [
                {
                    "name": "variable.other.quoted.jc2",
                    "match": "`[^`\\n]*`"
                },
                {
                    "name": "variable.other.jc2",
                    "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
                }
            ]
        },
        "property-access": {
            "patterns": [
                {
                    "match": "(\\.)\\s*(\\$?[a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
                    "captures": {
                        "1": {
                            "name": "punctuation.accessor.jc2"
                        },
                        "2": {
                            "name": "entity.name.function.call.jc2"
                        }
                    }
                },
                {
                    "match": "(\\.)\\s*(\\$?[a-zA-Z_][a-zA-Z0-9_]*)",
                    "captures": {
                        "1": {
                            "name": "punctuation.accessor.jc2"
                        },
                        "2": {
                            "name": "variable.other.property.jc2"
                        }
                    }
                }
            ]
        },
        "builtin-types": {
            "patterns": [
                {
                    "name": "support.type.jc2",
                    "match": "\\b(int|double|string|bool|list|dict|set|fraction|complex|realmatrix|complexmatrix|symmatrix|function|class_type|instance|namespace_type|type|slice)\\b"
                }
            ]
        },
        "builtin-functions": {
            "patterns": [
                {
                    "name": "support.function.builtin.jc2",
                    "match": "\\b(pi|e|i|complex|double|int|abs|sqrt|cbrt|root|sqrtD|cbrtD|rootD|pow|log|ln|round|floor|ceil|trunc|sgn|deg|rad|idiv|sin|cos|tan|sec|csc|cot|asin|acos|atan|atan2|sinh|cosh|tanh|asinh|acosh|atanh|exp|erf|fresnel_s|fresnel_c|Si|Ci|Ei|Li|Re|Im|arg|conj|frac|toFrac|num|den|matrix|symmatrix|det|inv|trans|ctrans|gauss|rank|tr|norm|cond|adj|sum|prod|null|orth|mpow|charPoly|kron|jacobian|hessian|id|ones|zeros|eig|eigvec|diag|lsolve|lstsq|dim|dot|vnorm|normalize|cross|angle|sproj|vproj|triple|isperp|isparallel|mean|var|svar|std|sstd|max|min|span|perc|median|mode|cov|corr|rsq|regress|str|string|len|length|size|format|type|list|dict|set|print|assert|help|sym|symbolics|clear|add|remove|discard|eval|concat|chr|range|fill|linspace|toList|toArray|toMatrix|zip|cat|isinstance|getClass|getParent|freeze|isFrozen|hash|copy|isalpha|isdigit|isalnum|isspace|isupper|islower|iscallable|ishashable|isindexable|isiterable|isempty|isnan|isinf|isfinite|isprime|iseven|isodd|ispositive|isnegative|isapprox|iszero|addE|subE|mulE|divE|idivE|powE|modE|eqE|neqE|ltE|leE|gtE|geE|maxE|minE|andE|orE|xorE|atan2E|hypotE|whereE|perm|getElement|setElement|getSlice|setSlice|getR|getC|delR|delC|swapR|swapC|multiR|multiC|addR|addC|sub|cof|Acof|blkdiag|qr|lu|residual|gcinfo|bool|not|and|or|seq|error|input|table|matpow|toSet|init|finalize|gensym)\\b(?=\\()"
                }
            ]
        }
    }
}