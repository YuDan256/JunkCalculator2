// discrete 标准库冒烟：组合数学 / 命题逻辑 / 关系 / 图 / 真值表 + 类型化错误。

import discrete

test_permutations_and_combinations() = {
    assert(str(discrete.permutations(@[1, 2])) == "@[@[1, 2], @[2, 1]]", "permutations of 2")
    assert(discrete.permutations(@[1, 2, 3]).len() == 6, "permutations of 3")
    assert(str(discrete.combinations(@[1, 2, 3], 2)) == "@[@[1, 2], @[1, 3], @[2, 3]]", "combinations")
    assert(discrete.combinations(@[1, 2], 0) == @[@[]], "k = 0 yields the empty pick")
}
test_permutations_and_combinations()

test_propositional_logic() = {
    p = discrete.Var("p")
    q = discrete.Var("q")
    andpq = p & q
    assert(str(andpq) == "(p & q)", "expression printing")
    assert(andpq.vars() == @{"p", "q"}, "vars() collects symbols")
    assert(andpq.eval({"p": 1, "q": 1}) == 1, "eval true case")
    assert(andpq.eval({"p": 1, "q": 0}) == 0, "eval false case")
    assert((p | (-p)).isTautology(), "p | !p is a tautology")
    assert((p & (-p)).isContradiction(), "p & !p is a contradiction")
    assert((p | q).table().len() == 4, "table() enumerates 2^n rows")
}
test_propositional_logic()

test_relation() = {
    r = discrete.Relation(@{1, 2, 3}, @[@[1, 2], @[2, 3]])
    assert(str(r) == "Relation(|S|=3, |R|=2)", "relation __str__")
    assert(!r.isReflexive(), "not reflexive")
    assert(!r.isTransitive(), "not transitive as given")
    assert(str(r.transitiveClosure()) == "Relation(|S|=3, |R|=3)", "transitive closure grows")
    assert(r(1, 2), "call syntax tests membership")
    assert(!r.hasPair(2, 1), "missing pair")
}
test_relation()

test_graph() = {
    g = discrete.Graph()
    g.addVertex("a")
    g.addVertex("b")
    g.addEdge("a", "b", 5)
    assert(g.hasVertex("a") && !g.hasVertex("c"), "vertex membership")
    assert(g.hasEdge("a", "b") && !g.hasEdge("b", "a"), "directed edge")
    assert(g.getWeight("a", "b") == 5, "edge weight")
    assert(g.topSort() == @["a", "b"], "topological order")
    assert(g.vertices() == @["a", "b"], "vertices()")
}
test_graph()

test_truth_table() = {
    tt = discrete.truthTable(2, (a, b) => a & b)
    assert(tt.len() == 4, "4 rows for 2 variables")
    assert(tt[3]["output"] == 1 && tt[0]["output"] == 0, "conjunction column")
    assert(tt[3]["inputs"] == @[1, 1], "input column")
}
test_truth_table()

test_typed_errors() = {
    caught = false
    try {
        discrete.Relation(@{1, 2}, @[@[1, 2]]).equivalenceClasses()
    } catch (e) {
        caught = e.type == "RelationError"
    }
    assert(caught, "equivalenceClasses requires an equivalence relation")

    caught = false
    try {
        discrete.Graph(true).components()
    } catch (e) {
        caught = e.type == "GraphError"
    }
    assert(caught, "components() requires an undirected graph")
}
test_typed_errors()

test_internal_pair_normalizer_is_private() = {
    r = discrete.Relation(@{1, 2}, @[@[1, 2]])
    caught = false
    try {
        r._mp(1, 2)
    } catch (e) {
        caught = "Cannot invoke method" in e.message
    }
    assert(caught, "_mp is private to Relation")
    assert(r(1, 2), "public membership check still works")
}
test_internal_pair_normalizer_is_private()

// dijkstra（堆版）：手算经典图 + 不可达 + 单点 + 与独立 Floyd-Warshall 差分
test_dijkstra_heap() = {
    g = discrete.Graph(true)
    g.addEdge("a", "b", 4); g.addEdge("a", "c", 2)
    g.addEdge("c", "b", 1); g.addEdge("c", "d", 8)
    g.addEdge("b", "d", 5); g.addEdge("d", "e", 3)
    r = g.dijkstra("a")
    assert(r.dist["a"] == 0, "source distance is 0")
    assert(r.dist["c"] == 2, "a->c = 2")
    assert(r.dist["b"] == 3, "a->c->b = 3 (beats direct 4)")
    assert(r.dist["d"] == 8, "a->c->b->d = 8 (beats a->c->d = 10)")
    assert(r.dist["e"] == 11, "a->c->b->d->e = 11")
    assert(r.prev["b"] == "c", "predecessor of b is c")

    sp = g.shortestPath("a", "e")
    assert(sp.dist == 11 && sp.path.len() == 5, "shortestPath stays consistent")

    // 不可达顶点
    g2 = discrete.Graph(true)
    g2.addEdge(1, 2, 7)
    g2.addVertex(99)
    r2 = g2.dijkstra(1)
    assert(r2.dist[99] is none, "unreachable vertex keeps none")
    assert(g2.shortestPath(1, 99).dist is none, "unreachable path reports none")

    // 单点图
    g3 = discrete.Graph(true); g3.addVertex("x")
    r3 = g3.dijkstra("x")
    assert(r3.dist["x"] == 0, "single vertex distance 0")

    // 差分：与独立实现的 Floyd-Warshall 逐点比对（含等权与多路径）
    g4 = discrete.Graph(true)
    for (e in @[@["s","a",1], @["s","b",4], @["a","b",2], @["a","c",5], @["b","c",1], @["c","d",2], @["b","d",9]]) {
        g4.addEdge(e[0], e[1], e[2])
    }
    vs = g4.vertices().sort()
    n = vs.len()
    INF = 1000000
    M = @[]
    i = 0
    while (i < n) { row = @[]; j = 0; while (j < n) { row.push(i == j ? 0 : INF); j += 1 }; M.push(row); i += 1 }
    idx = (v) => { k = 0; while (k < n) { if (vs[k] == v) return k; k += 1 }; return -1 }
    for (e in g4.edges()) {
        u = idx(e[0]); v = idx(e[1])
        if (e[2] < M[u][v]) { M[u][v] = e[2] }
    }
    k = 0
    while (k < n) {
        i = 0
        while (i < n) {
            j = 0
            while (j < n) { if (M[i][k] + M[k][j] < M[i][j]) { M[i][j] = M[i][k] + M[k][j] }; j += 1 }
            i += 1
        }
        k += 1
    }
    r4 = g4.dijkstra("s")
    si = idx("s")
    t = 0
    while (t < n) {
        want = M[si][t] >= INF ? none : M[si][t]
        got = r4.dist[vs[t]]
        assert(got == want, "dijkstra vs Floyd-Warshall at " + str(vs[t]) + ": " + str(got) + " vs " + str(want))
        t += 1
    }
}

test_dijkstra_heap()
