// ═══════════════════════════════════════════════════════════════
// net.jc2 — TCP Native Networking Standard Library
// Pure, Zero-Dependency Socket Engine (Client & Server)
// ═══════════════════════════════════════════════════════════════

const local import socket

class NetworkError extends Exception {
    init(msg) = { super.init(msg) }
}


// ─── Socket Object (Client) ───────────────────────────────────

class TcpSocket {
    init(host: string, port: int | float) = {
        self.host = host
        self.port = round(port)
        self.sock = none
    }

    connect() -> TcpSocket = {
        self.sock = socket.connect(self.host, self.port)
        return self
    }

    close() = {
        if (!(self.sock is none)) {
            self.sock.close()
            self.sock = none
        }
    }

    send(text: string) -> TcpSocket = {
        if (self.sock is none) throw NetworkError("Socket is not connected!")
        self.sock.send(text)
        return self
    }

    recv(max_bytes: int | float = 4096) -> string = {
        max_bytes = round(max_bytes)
        if (self.sock is none) throw NetworkError("Socket is not connected!")
        return self.sock.recv(max_bytes)
    }

    __str__() -> string = return f"<TcpSocket host=\"{self.host}\" port={self.port} connected={!(self.sock is none)}>"
}

// ─── Server Object (Daemon) ───────────────────────────────────

class TcpServer {
    init(host: string, port: int | float) = {
        self.host = host
        self.port = round(port)
        self.sock = none
    }

    bind() -> TcpServer = {
        self.sock = socket.server(self.host, self.port)
        return self
    }

    accept() -> TcpSocket = {
        if (self.sock is none) throw NetworkError("TCP Server is not bound to a port!")
        native_client = self.sock.accept()
        
        client = TcpSocket(self.host, self.port)
        client.sock = native_client
        return client
    }

    close() = {
        if (!(self.sock is none)) {
            self.sock.close()
            self.sock = none
        }
    }
}

// ─── TLS 1.3 套接字（thin wrapper over the native tls module）───

const local import tls

class TlsSocket {
    init(host: string, port: int | float, options: any = none) = {
        self.host = host
        self.port = round(port)
        opts = options is none ? {"serverName": host, "verifyChain": true} : options
        self.sock = tls.connect(host, self.port, opts)
    }

    send(text: string) -> int = return self.sock.send(text)

    recv(max_bytes: int | float = 4096) -> string = return self.sock.recv(max_bytes)

    close() = {
        if (self.sock is none) return none
        self.sock.close()
        self.sock = none
        return none
    }

    // 服务器叶子证书（DER 的十六进制）
    certificate() -> string = return self.sock.certificate()

    // 与 TcpSocket 对齐的状态查询
    isConnected() -> bool = return !(self.sock is none)

    __str__() -> string = return f"<TlsSocket host=\"{self.host}\" port={self.port} connected={self.isConnected()}>"
}
// ─── Dynamic Help Registry ────────────────────────────────────

const local import sys
try {
    sys.registerHelp("net", r"DOC(
═══ Network (Standard Library) ═══

  Requires: import net

  The `net` module provides a comprehensive object-oriented API for zero-dependency 
  TCP networking. It supports both outbound Client requests and inbound Server hosting.

  [1] Client Mode (TcpSocket)
  ──────────────────────
    client = TcpSocket("example.com", 80).connect()
    client.send("GET / HTTP/1.1\r\n\r\n")
    data = client.recv(4096)
    client.close()

  [2] Server Mode (TcpServer)
  ──────────────────────
    server = TcpServer("127.0.0.1", 8080).bind()
    
    while (true) {
        client = server.accept()     // Blocks until a browser/client connects
        req = client.recv(1024)      // Read incoming HTTP request
        
        client.send("HTTP/1.1 200 OK\r\n\r\nHello from JC2!")
        client.close()               // Hang up to finalize the HTTP transmission
    }

  [3] TLS 1.3 Client Mode (TlsSocket)
  ──────────────────────
    s = TlsSocket("example.com", 443)          // dials TCP and performs the handshake
    s.send("GET / HTTP/1.1\r\nHost: example.com\r\nConnection: close\r\n\r\n")
    while (true) { chunk = s.recv(4096); if (chunk == "") break; print(chunk) }
    s.close()                                   // sends close_notify

    The certificate chain is verified against the system trust store by default;
    pass a third argument to override, e.g. {"serverName": "host", "verifyChain": false}.
    s.certificate() returns the peer leaf certificate as hex-encoded DER.

  Transmission Mechanics
  ──────────────────────
    client.send(string)
        Transmits raw string/byte payload over the TCP stream.
    client.recv(max_bytes = 4096)
        Blocks and waits until data is received. Returns an EMPTY STRING ("") 
        if the remote server closed the connection.

  Errors
  ──────────────────────
    NetworkError    Connection closed while reading, socket not connected,
                    or a TCP server that is not bound to a port.
)DOC")
}
