import cas

throws(f) = {
    try { f(); return false } catch (e) { return true }
}

x = sym("x")
y = sym("y")

// Arithmetic lowers directly to bytecode.
f = cas.toFunc(x^2 + y, @["x", "y"])
assert(f(3, 4) == 13, "toFunc arithmetic")
assert(f(0, 1) == 1, "toFunc constant path")

// Warm enough for the Tier 2 JIT path when the suite runs with --jit.
n = 0
i = 0
while (i < 2000) { n += f(0, 1); i += 1 }
assert(n == 2000, "toFunc hot call")

// Exact fraction remains exact.
g = cas.toFunc(x/3, "x")
assert(g(1) == 1/3, "toFunc keeps fraction semantics")

// Math builtin resolves through GetGlobal and CALL.
h = cas.toFunc(sin(x), "x")
assert(abs(h(0.0)) < 1e-12, "toFunc math builtin")

// A free symbolic variable must be rejected at compile time.
assert(throws(() => cas.toFunc(x + y, @["x"])), "toFunc unknown variable")

