// ═══════════════════════════════════════════════════════════════
// http.jc2 — Modern HTTP Client Standard Library
// Built with strict JC2 Lexer / Scope standards
//
// 四件事：响应定界（none / length / chunked / eof）、keep-alive 连接池、
// gzip+deflate 解码、方法/重定向。解析与网络两层共用同一套解析器：
// 网络层只负责按定界规则切出**第一条响应**的字节，然后把这段字节交给
// httpParseResponse 走同一份代码。
// ═══════════════════════════════════════════════════════════════

const local import net
const local import bytes

class HttpError extends Exception {
    init(msg) = { super.init(msg) }
}

// 调用方脚本的顶层绑定会进同一张全局表并覆盖内建（例如顶层 for (round in ...)），
// 所以模块先把用到的内建绑成自己的私有名，避免被劫持（见设计文档开放项）。
const local _round = round

// 一个正文的上限：分块/CL 都按它截断，避免恶意长度字段把内存吃光
const local _MAX_BODY = 67108864        // 64 MiB
const local _MAX_HEADER = 262144        // 256 KiB
const local _MAX_LINE = 65536           // 单行（状态行/块长行/trailer）
const local _READ_CHUNK = 65536         // 一次 recv 的上限

// ─── Response Class ───────────────────────────────────────────

class HttpResponse {
    init(status: int | float, headers: dict, body: string, raw: string,
         url: string = "", redirects: any = none) = {
        self.status = _round(status)
        self.headers = headers
        self.body = body
        self.raw = raw
        self.url = url                  // 最终地址（跟随重定向后）
        self.redirects = redirects is none ? @[] : redirects
    }

    json() -> any = {
        const import json
        return json.parse(self.body)
    }

    __str__() -> string = return f"<HttpResponse [{self.status}] body_len={self.body.len()}>"
}

// ─── Internal Parsers (local: 不导出) ──────────────────────────

local namespace _Http {
    // 字符串的 UTF-8 字节数（JC2 的 len() 数的是码点，而 HTTP 的长度字段数的是字节）
    utf8_bytes(s: string) -> int = {
        scratch = bytes.alloc(s.len() * 4 + 4)
        scratch.writeStr(s)
        return _round(scratch.tell())
    }

    // 整个响应放进字节缓冲：正文按字节提取，最后一次性解码成字符串
    // （分块边界可能把多字节字符切开，逐块解码会得到替换字符）
    to_buffer(raw: string) -> any = {
        buf = bytes.alloc(raw.len() * 4 + 8)
        buf.writeStr(raw)
        return buf
    }

    // 从字节缓冲的 off 起取 len 字节并解码；若结尾落在半个字符上，向后借最多 3 字节。
    // 返回 @[文本, 实际消耗的字节数]
    read_exact(buf: any, off: int | float, len: int | float) -> any = {
        borrow = 0
        while (true) {
            buf.seek(off)
            text = buf.readStr(len + borrow)
            consumed = utf8_bytes(text)
            if (consumed == len + borrow || borrow >= 3) {
                return @[text, len + borrow]
            }
            borrow += 1
        }
        return @["", len]
    }

    // 字符串 → 小写十六进制（inflate 模块的二进制出入口格式）
    text_to_hex(s: string) -> string = {
        n = utf8_bytes(s)
        buf = bytes.alloc(n + 4)
        buf.writeStr(s)
        buf.truncate(n)
        return buf.toHex()
    }

    // 小写十六进制 → 字符串
    hex_to_text(hex: string) -> string = {
        buf = bytes.fromHex(hex)
        return buf.readStr(buf.len())
    }

    // 严格的十进制解析：HTTP 头里的数字字段绝不允许把 RuntimeError 漏出去
    parse_uint(text: string, what: string) -> int = {
        t = text.trim()
        if (t.len() == 0 || t.len() > 10) {
            throw HttpError(f"Invalid {what}: \"{text}\"")
        }
        value = 0
        for (i in range(t.len())) {
            d = "0123456789".find(t.substr(i, 1), 0)
            if (d == -1) throw HttpError(f"Invalid {what}: \"{text}\"")
            value = value * 10 + d
        }
        return value
    }

    // 十六进制块长（允许扩展，例如 "1a3;foo=bar"）
    chunk_size(line: string) -> int = {
        semi = line.find(";", 0)
        hex_part = (semi == -1) ? line : line.substr(0, semi)
        hex_part = hex_part.trim()
        if (hex_part.len() == 0 || hex_part.len() > 8) {
            throw HttpError(f"Invalid chunk size line: \"{line}\"")
        }
        digits = "0123456789abcdef"
        value = 0
        for (i in range(hex_part.len())) {
            d = digits.find(hex_part.substr(i, 1).lower(), 0)
            if (d == -1) {
                throw HttpError(f"Invalid chunk size line: \"{line}\"")
            }
            value = value * 16 + d
        }
        return value
    }

    // 分块扫描：解码正文，并且**算出正文在哪里结束**（字节偏移）。
    // 返回 @[正文, 结束偏移]。离线解析与流式读取都靠它判断"读到哪儿为止"。
    chunked_span(raw: string, body_start: int | float) -> any = {
        buf = to_buffer(raw)
        total = utf8_bytes(raw)
        char_off = body_start          // 头部是 ASCII：字符偏移与字节偏移相等
        byte_off = body_start
        out = ""
        while (true) {
            line_end = raw.find("\r\n", char_off)
            if (line_end == -1) {
                throw HttpError("Truncated chunked body (no chunk size line)")
            }
            line = raw.substr(char_off, line_end - char_off)
            size = chunk_size(line)
            // 块长行是纯 ASCII，所以它的字节数等于字符数
            line_bytes = line_end + 2 - char_off
            byte_off += line_bytes
            char_off = line_end + 2

            if (size == 0) {
                // trailer：读到空行为止（也接受直接结束）
                while (true) {
                    tl_end = raw.find("\r\n", char_off)
                    if (tl_end == -1) return @[out, byte_off]
                    if (tl_end == char_off) return @[out, byte_off + 2]
                    byte_off += tl_end + 2 - char_off
                    char_off = tl_end + 2
                }
                return @[out, byte_off]
            }

            // 块数据必须完整躺在给到的字节里（to_buffer 的容量比数据长，越界读会读到填充的 0）
            avail = total - byte_off
            if (avail < size) {
                throw HttpError(
                    f"Truncated chunked body: a chunk of {size} bytes was declared but only {avail} bytes arrived")
            }

            read = read_exact(buf, byte_off, size)
            out += read[0]
            byte_off += read[1]
            char_off += read[0].len()

            if (char_off + 2 > raw.len() || raw.substr(char_off, 2) != "\r\n") {
                throw HttpError("Malformed chunked body (chunk data not followed by CRLF)")
            }
            char_off += 2
            byte_off += 2
        }
        return @[out, byte_off]
    }

    // 只取正文（旧调用面的兼容壳）
    decode_chunked(raw: string, body_start: int | float) -> string = {
        return chunked_span(raw, body_start)[0]
    }

    // 头部字段名大小写不敏感
    header(headers: dict, name: string) -> string = {
        want = name.lower()
        for (k in headers.keys()) {
            if (k.lower() == want) return headers[k]
        }
        return ""
    }

    // options 字典的浅拷贝（httpPost 之类要给调用方的字典加字段，不能改原件）
    copy(options: dict) -> dict = {
        out = {}
        for (k in options.keys()) out[k] = options[k]
        return out
    }

    // 解析时要知道请求方法（HEAD 无正文），这里把 method 塞进 options 的副本
    copy_with(options: dict, method: string) -> dict = {
        out = copy(options)
        out["method"] = method
        return out
    }

    parse_url(url_str: string) -> dict = {
        u = url_str
        scheme = "http"
        if (u.startsWith("https://")) {
            scheme = "https"
            u = u.substr(8)
        } else if (u.startsWith("http://")) {
            u = u.substr(7)
        }

        url_host = ""
        url_path = "/"
        slash_idx = u.find("/", 0)

        if (slash_idx == -1) {
            url_host = u
        } else {
            url_host = u.substr(0, slash_idx)
            url_path = u.substr(slash_idx)
        }

        url_port = (scheme == "https") ? 443 : 80
        colon_idx = url_host.find(":", 0)
        if (colon_idx != -1) {
            port_str = url_host.substr(colon_idx + 1)
            url_port = int(port_str.parseNum())
            url_host = url_host.substr(0, colon_idx)
        }

        if (url_host.len() == 0) {
            throw HttpError(f"URL has no host: \"{url_str}\"")
        }
        return {"scheme": scheme, "host": url_host, "port": url_port, "path": url_path}
    }

    // 连接池的键：scheme://host:port
    origin_key(target: dict) -> string = {
        return target["scheme"] + "://" + target["host"] + ":" + str(target["port"])
    }

    // 最后一次出现的位置（JC2 字符串没有 findRev）
    last_index_of(s: string, sub: string) -> int = {
        idx = -1
        pos = 0
        while (true) {
            hit = s.find(sub, pos)
            if (hit == -1) return idx
            idx = hit
            pos = hit + 1
        }
        return idx
    }

    // 把 Location 解析成绝对地址；base 是当前请求地址
    resolve_location(base_url: string, location: string) -> string = {
        loc = location.trim()
        if (loc.startsWith("http://") || loc.startsWith("https://")) return loc
        base = parse_url(base_url)
        if (loc.startsWith("//")) return base["scheme"] + ":" + loc
        if (loc.startsWith("/")) {
            return base["scheme"] + "://" + base["host"] + ":" + str(base["port"]) + loc
        }
        // 相对路径：拼到当前目录上
        dir_end = last_index_of(base["path"], "/")
        dir = (dir_end == -1) ? "/" : base["path"].substr(0, dir_end + 1)
        return base["scheme"] + "://" + base["host"] + ":" + str(base["port"]) + dir + loc
    }

    // 规范化成 host[:port]/path，用于跳转去重（避免死循环）
    normalize(url_str: string) -> string = {
        p = parse_url(url_str)
        port = ":" + str(p["port"])
        if ((p["scheme"] == "http" && p["port"] == 80) || (p["scheme"] == "https" && p["port"] == 443)) {
            port = ""
        }
        return p["scheme"] + "://" + p["host"] + port + p["path"]
    }

    // ─── 响应定界 ────────────────────────────────────────────
    // 规则（RFC 9112 §6）：HEAD / 204 / 304 / 1xx 无正文；Transfer-Encoding: chunked
    // 到 0 块 + trailer 结束；有 Content-Length 就恰好读 n 字节；都没有才读到对端关闭。
    // 这是**纯函数**：平台无关，离线可测。
    plan_read(status: int | float, headers: dict, method: string) -> dict = {
        m = method.upper()
        if (m == "HEAD" || status == 204 || status == 304 ||
            (status >= 100 && status < 200)) {
            return {"mode": "none", "length": 0}
        }
        te = header(headers, "Transfer-Encoding").lower()
        if (te.find("chunked", 0) != -1) {
            return {"mode": "chunked", "length": 0}
        }
        cl_text = header(headers, "Content-Length")
        if (cl_text != "") {
            return {"mode": "length", "length": parse_uint(cl_text, "Content-Length")}
        }
        return {"mode": "eof", "length": 0}
    }

    // HTTP/1.1 且响应没说 Connection: close 才能把连接放回池子
    keep_alive_ok(raw: string, headers: dict) -> bool = {
        line_end = raw.find("\r\n", 0)
        status_line = (line_end == -1) ? raw : raw.substr(0, line_end)
        if (!status_line.contains("HTTP/1.1")) return false
        if (header(headers, "Connection").lower().contains("close")) return false
        return true
    }

    // ─── Content-Encoding ───────────────────────────────────
    gunzip_text(body: string) -> string = {
        const import inflate
        try {
            return hex_to_text(inflate.gunzip(text_to_hex(body)))
        } catch (e) {
            throw HttpError("Failed to gunzip the response body: " + e.message)
        }
    }

    unzlib_text(body: string) -> string = {
        const import inflate
        return hex_to_text(inflate.unzlib(text_to_hex(body)))
    }

    inflate_text(body: string) -> string = {
        const import inflate
        return hex_to_text(inflate.inflate(text_to_hex(body)))
    }

    decode_content_encoding(body: string, headers: dict) -> string = {
        if (body == "") return body
        ce = header(headers, "Content-Encoding").trim().lower()
        if (ce == "") return body
        if (ce.find("gzip", 0) != -1) return gunzip_text(body)
        if (ce.find("deflate", 0) != -1) {
            // 现实里的服务器两种容器都有：先按 zlib（RFC 1950）试，失败再按裸 DEFLATE（RFC 1951）
            try {
                return unzlib_text(body)
            } catch (e1) {
                try {
                    return inflate_text(body)
                } catch (e2) {
                    throw HttpError(
                        "Failed to inflate the response body (tried zlib and raw DEFLATE): " + e2.message)
                }
            }
        }
        return body                 // br / zstd 等没协商过的编码：原样返回
    }

    // 解析头部，返回 {"status", "headers", "header_bytes"}
    split_head(raw: string) -> dict = {
        header_end = raw.find("\r\n\r\n", 0)
        if (header_end == -1) {
            throw HttpError("Response has no header terminator (\\r\\n\\r\\n)")
        }

        head_part = raw.substr(0, header_end)
        header_bytes = header_end + 4          // 头部是 ASCII：字节偏移 == 字符偏移

        lines = head_part.split("\r\n")
        status_code = 0
        if (lines.len() > 0) {
            parts = lines[0].split(" ")
            if (parts.len() > 1) status_code = parse_uint(parts[1], "status code")
        }

        headers_dict = {}
        for (i in range(1, lines.len())) {
            line = lines[i]
            colon = line.find(":", 0)
            if (colon != -1) {
                k = line.substr(0, colon).trim()
                v = line.substr(colon + 1).trim()
                headers_dict[k] = v
            }
        }
        return {"status": status_code, "headers": headers_dict, "header_bytes": header_bytes}
    }

    // raw 是**恰好一条**响应的字节（离线喂夹具，网络侧喂定界切出来的那一段）
    parse_response(raw: string, url: string = "", options: dict = {}) -> HttpResponse = {
        head = split_head(raw)

        method = "GET"
        if ("method" in options) method = str(options["method"])
        decompress = true
        if ("decompress" in options) decompress = (options["decompress"] == true)

        plan = plan_read(head["status"], head["headers"], method)
        mode = plan["mode"]
        body = ""

        if (mode == "length") {
            want = plan["length"]
            avail = utf8_bytes(raw) - head["header_bytes"]
            if (avail < want) {
                throw HttpError(
                    f"Truncated response body: Content-Length={want} but only {avail} bytes arrived")
            }
            body = read_exact(to_buffer(raw), head["header_bytes"], want)[0]
        } else if (mode == "chunked") {
            body = decode_chunked(raw, head["header_bytes"])
        } else if (mode == "eof") {
            // 没有长度信息：读到给到的字节末尾（网络侧就是读到对端关闭）
            body = read_exact(to_buffer(raw), head["header_bytes"], utf8_bytes(raw) - head["header_bytes"])[0]
        }

        if (decompress) body = decode_content_encoding(body, head["headers"])
        return HttpResponse(head["status"], head["headers"], body, raw, url)
    }
}

// ─── Public API: 解析 / 规划 ───────────────────────────────────

// 解析一段完整的 HTTP 响应字节（离线可用；也方便自己拿 socket 收发的人复用）。
// 契约：**任何**畸形输入都只以 HttpError 出现，绝不漏出其它异常类型。
// options: {"method": "GET"|"HEAD"|..., "decompress": bool}
httpParseResponse(raw: string, url: string = "", options: dict = {}) -> HttpResponse = {
    try {
        return _Http.parse_response(raw, url, options)
    } catch (e) {
        if (e.type == "HttpError") throw e
        throw HttpError("Malformed HTTP response: " + e.type + ": " + e.message)
    }
}

// 这条响应该怎么收尾？（纯函数，平台无关）
//   status  状态码    headers 响应头    method 请求方法（HEAD 无正文）
// 返回 {"mode": "none"|"length"|"chunked"|"eof", "length": n}
//   none    无正文（HEAD / 204 / 304 / 1xx），length 恒为 0
//   length  Content-Length: n，恰好读 n 字节，length == n
//   chunked 分块传输，read until the 0 chunk + trailer，length 恒为 0
//   eof     既无 CL 也无 chunked：只能读到对端关闭（连接**不可复用**），length 恒为 0
httpPlanRead(status: int | float, headers: dict, method: string = "GET") -> dict = {
    return _Http.plan_read(_round(status), headers, method)
}

// 3xx 的下一个地址；不是重定向或缺少 Location 时返回 none
httpPlanRedirect(res: HttpResponse, current_url: string) -> any = {
    if (res.status != 301 && res.status != 302 && res.status != 303 &&
        res.status != 307 && res.status != 308) {
        return none
    }
    loc = _Http.header(res.headers, "Location")
    if (loc == "") return none

    next_url = _Http.resolve_location(current_url, loc)
    from_parts = _Http.parse_url(current_url)
    to_parts = _Http.parse_url(next_url)
    if (from_parts["scheme"] == "https" && to_parts["scheme"] == "http") {
        throw HttpError(f"Refusing to follow a redirect from https down to http: {next_url}")
    }
    return next_url
}

// 重定向的**下一步请求**怎么发（纯函数）：
//   301/302/303 → 改成 GET 且丢弃请求体（keepBody=false）
//   307/308     → 保留方法与请求体（keepBody=true）
// 返回 {"url": 下一个地址, "method": 方法, "keepBody": bool}；不是重定向时 none
httpPlanRedirectRequest(res: HttpResponse, current_url: string, method: string = "GET") -> any = {
    next_url = httpPlanRedirect(res, current_url)
    if (next_url is none) return none
    m = method.upper()
    if (res.status == 307 || res.status == 308) {
        return {"url": next_url, "method": m, "keepBody": true}
    }
    return {"url": next_url, "method": "GET", "keepBody": false}
}

// ─── 可增长的字节缓冲（顺序读大正文时避免 O(n^2) 的字符串拼接）──

local class _Buf {
    init(cap: int | float) = {
        self.cap = _round(cap)
        self.used = 0
        self.buf = bytes.alloc(self.cap)
    }

    push(text: string) = {
        need = _Http.utf8_bytes(text)
        if (self.used + need > _MAX_BODY) {
            throw HttpError("Response body is larger than the " + str(_MAX_BODY) + " byte limit")
        }
        if (self.used + need > self.cap) {
            new_cap = (self.used + need) * 2 + 64
            bigger = bytes.alloc(new_cap)
            self.buf.seek(0)
            if (self.used > 0) bigger.writeStr(self.buf.readStr(self.used))
            self.buf = bigger
            self.cap = new_cap
        }
        self.buf.writeStr(text)
        self.used += need
        return none
    }

    text() -> string = {
        self.buf.seek(0)
        return self.buf.readStr(self.used)
    }
}

// ─── 一条连接：明文 TCP 与 TLS 共用同一套收发 ──────────────────

local class _Conn {
    init(origin: string, scheme: string, host: string, port: int | float, options: dict) = {
        self.origin = origin
        self.got_bytes = false      // 本次请求是否已经收到过响应字节（决定能否重试）
        self.reused = false
        if (scheme == "https") {
            tls_opts = {"serverName": host, "verifyChain": true}
            // timeoutMs 只在 https 生效：它落到 TcpStream 的 connect/read/write 超时上
            if ("timeoutMs" in options) tls_opts["timeoutMs"] = options["timeoutMs"]
            self.client = net.TlsSocket(host, _round(port), tls_opts)
        } else {
            // 明文走 socket 模块：阻塞 connect/recv，该模块没有超时接口
            self.client = net.TcpSocket(host, _round(port)).connect()
        }
    }

    send(text: string) = {
        self.got_bytes = false
        self.client.send(text)
        return none
    }

    recv(max_bytes: int | float) -> string = {
        chunk = self.client.recv(_round(max_bytes))
        if (chunk.len() > 0) self.got_bytes = true
        return chunk
    }

    close() = {
        if (self.client is none) return none
        c = self.client
        self.client = none
        try {
            c.close()
        } catch (e) {
            closed_with_error = true
        }
        return none
    }
}

// ─── 空闲连接池：每个源最多 2 条 ───────────────────────────────

const local _POOL_MAX = 2
local _pool = {}                    // "scheme://host:port" -> @[连接, ...]

local namespace _Pool {
    take(origin: string) -> any = {
        if (!(origin in _pool)) return none
        idle = _pool[origin]
        if (idle.len() == 0) return none
        conn = idle.pop()
        conn.reused = true
        return conn
    }

    put(origin: string, conn: any) = {
        if (!(origin in _pool)) _pool[origin] = @[]
        idle = _pool[origin]
        if (idle.len() >= _POOL_MAX) {
            conn.close()            // 池满就关掉（不做 LRU/年龄调优）
            return none
        }
        idle.push(conn)
        return none
    }

    // 诊断用：当前空闲连接数
    size() -> int = {
        total = 0
        for (k in _pool.keys()) total += _pool[k].len()
        return total
    }
}

// ─── 流式读取：按定界规则把**恰好一条**响应切出来 ──────────────

local namespace _Read {
    // 读一行（不含 CRLF）；对端中途关闭算连接级失败
    line(conn: any, what: string) -> string = {
        text = ""
        while (true) {
            b = conn.recv(1)
            if (b.len() == 0) {
                throw net.NetworkError("the connection was closed while reading " + what)
            }
            if (b == "\n") {
                if (text.len() > 0 && text.substr(text.len() - 1, 1) == "\r") {
                    return text.substr(0, text.len() - 1)
                }
                return text
            }
            text += b
            if (text.len() > _MAX_LINE) {
                throw HttpError(what + " is longer than " + str(_MAX_LINE) + " bytes")
            }
        }
        return text
    }

    // 头部：读到空行为止，返回原始字节（含最后的 CRLF CRLF）
    header(conn: any) -> string = {
        head = ""
        while (true) {
            l = line(conn, "the response header")
            head += l + "\r\n"
            if (l.len() == 0) return head
            if (head.len() > _MAX_HEADER) {
                throw HttpError("Response headers are larger than " + str(_MAX_HEADER) + " bytes")
            }
        }
        return head
    }

    // 恰好 n 字节（绝不多读一个字节：多读就会破坏下一条响应）
    exact(conn: any, n: int | float) -> string = {
        want = _round(n)
        if (want <= 0) return ""
        if (want > _MAX_BODY) {
            throw HttpError("Response body is larger than the " + str(_MAX_BODY) + " byte limit")
        }
        buf = bytes.alloc(want + 4)
        got = 0
        while (got < want) {
            ask = want - got
            if (ask > _READ_CHUNK) ask = _READ_CHUNK
            chunk = conn.recv(ask)
            if (chunk.len() == 0) {
                throw HttpError(
                    f"Truncated response body: {want} bytes expected but the connection closed after {got}")
            }
            buf.writeStr(chunk)
            got += _Http.utf8_bytes(chunk)
        }
        buf.seek(0)
        return buf.readStr(want)
    }

    // 分块：读回**原始传输字节**（块长行 + 数据 + CRLF + trailer），
    // 交给 _Http.chunked_span 做与离线完全一致的解码与结束判定
    chunked_wire(conn: any) -> string = {
        b = _Buf(4096)
        while (true) {
            size_line = line(conn, "a chunk size line")
            size = _Http.chunk_size(size_line)
            b.push(size_line + "\r\n")
            if (size == 0) {
                // trailer：读到空行为止
                while (true) {
                    t = line(conn, "a chunk trailer")
                    b.push(t + "\r\n")
                    if (t.len() == 0) break
                }
                return b.text()
            }
            b.push(exact(conn, size))
            crlf = exact(conn, 2)
            b.push(crlf)
            if (crlf != "\r\n") {
                throw HttpError("Malformed chunked body (chunk data not followed by CRLF)")
            }
        }
        return b.text()
    }

    // 没有长度信息：只能读到对端关闭
    to_eof(conn: any) -> string = {
        b = _Buf(4096)
        while (true) {
            chunk = conn.recv(_READ_CHUNK)
            if (chunk.len() == 0) break
            b.push(chunk)
        }
        return b.text()
    }

    // 网络侧的一条完整响应：先切字节，再走与离线同一个解析器
    response(conn: any, method: string, url: string, options: dict) -> HttpResponse = {
        head_raw = header(conn)
        head = _Http.split_head(head_raw)
        plan = _Http.plan_read(head["status"], head["headers"], method)
        mode = plan["mode"]
        wire = ""
        if (mode == "length") {
            wire = exact(conn, plan["length"])
        } else if (mode == "chunked") {
            wire = chunked_wire(conn)
        } else if (mode == "eof") {
            wire = to_eof(conn)
        }
        return _Http.parse_response(head_raw + wire, url, _Http.copy_with(options, method))
    }
}

// ─── 请求构造 / 连接调度 ───────────────────────────────────────

local _method_has_body(method: string) -> bool = {
    return method == "POST" || method == "PUT" || method == "PATCH"
}

local _host_header(target: dict) -> string = {
    p = target["port"]
    if ((target["scheme"] == "http" && p == 80) || (target["scheme"] == "https" && p == 443)) {
        return target["host"]
    }
    return target["host"] + ":" + str(p)
}

local _options_flag(options: dict, key: string, fallback: bool) -> bool = {
    if (key in options) return options[key] == true
    return fallback
}

local _want_keep_alive(options: dict, user_headers: dict) -> bool = {
    if (!_options_flag(options, "keepAlive", true)) return false
    if (_Http.header(user_headers, "Connection").lower() == "close") return false
    return true
}

// options["headers"] 里同名的头**覆盖**默认头（大小写不敏感）
local _build_request(method: string, target: dict, user_headers: dict, body: string, options: dict) -> string = {
    decompress = _options_flag(options, "decompress", true)
    keep = _want_keep_alive(options, user_headers)

    names = @["Host", "User-Agent", "Accept", "Connection"]
    values = @[_host_header(target), "JC2-HTTP", "*/*", keep ? "keep-alive" : "close"]
    if (decompress) {
        names.push("Accept-Encoding")
        values.push("gzip, deflate")
    }
    if (body.len() > 0 || _method_has_body(method)) {
        names.push("Content-Length")
        values.push(str(_Http.utf8_bytes(body)))
    }

    req = f"{method} {target['path']} HTTP/1.1\r\n"
    emitted = {}
    for (i in range(names.len())) {
        name = names[i]
        value = _Http.header(user_headers, name)
        if (value == "") value = values[i]
        req += f"{name}: {value}\r\n"
        emitted[name.lower()] = true
    }
    for (k in user_headers.keys()) {
        if (!(k.lower() in emitted)) req += f"{k}: {user_headers[k]}\r\n"
    }
    return req + "\r\n" + body
}

// 用完一条连接：可复用就入池，否则关掉
local _finish(conn: any, res: HttpResponse, method: string, keep: bool) = {
    if (!keep) {
        conn.close()
        return none
    }
    plan = _Http.plan_read(res.status, res.headers, method)
    if (plan["mode"] == "eof") {            // 读到对端关闭：连接已经不可复用
        conn.close()
        return none
    }
    if (!_Http.keep_alive_ok(res.raw, res.headers)) {
        conn.close()
        return none
    }
    _Pool.put(conn.origin, conn)
    return none
}

// 同一个源上的一次请求/响应往返（含一次换新连接重试）
local _exchange(method: string, url: string, target: dict, user_headers: dict, body: string,
          options: dict) -> HttpResponse = {
    origin = _Http.origin_key(target)
    keep = _want_keep_alive(options, user_headers)
    retried = false
    while (true) {
        // keepAlive=false 的请求要发 Connection: close，那就**不能**再从池子里捡旧连接
        conn = keep ? _Pool.take(origin) : none
        if (conn is none) {
            conn = _Conn(origin, target["scheme"], target["host"], target["port"], options)
        }
        was_reused = conn.reused
        try {
            conn.send(_build_request(method, target, user_headers, body, options))
            res = _Read.response(conn, method, url, options)
            _finish(conn, res, method, keep)
            return res
        } catch (e) {
            conn.close()                    // 任何异常/半途失败都丢弃这条连接
            // 复用连接在**收到任何响应字节之前**就失败（空闲连接被服务端关掉是常态）：
            // 只有幂等的 GET/HEAD 允许换一条新连接重试一次，非幂等方法不重试。
            if (was_reused && !conn.got_bytes && !retried &&
                (method == "GET" || method == "HEAD") &&
                (e.type == "NetworkError" || e.type == "TlsError" || e.type == "HttpError")) {
                retried = true
                continue
            }
            throw e
        }
    }
    return HttpResponse(0, {}, "", "", url)
}

// ─── Public API: 请求 ─────────────────────────────────────────

// 任意方法发一个请求；默认跟随最多 5 次重定向。
// options:
//   followRedirects  int   最多跟几次（默认 5）
//   headers          dict  覆盖同名默认头
//   body             string 请求体（httpPost 会替你塞）
//   decompress       bool  Accept-Encoding: gzip, deflate + 按 Content-Encoding 解码（默认 true）
//   timeoutMs        int   **仅 https 生效**：连接/读超时；明文 http 走 socket 模块，没有超时
//   keepAlive        bool  默认 true（Connection: keep-alive + 空闲连接池）
httpRequest(method: string, url: string, options: dict = {}) -> HttpResponse = {
    m = method.upper()
    max_redirects = 5
    if ("followRedirects" in options) max_redirects = int(options["followRedirects"])
    user_headers = {}
    if ("headers" in options) user_headers = options["headers"]
    body = ""
    if ("body" in options) body = str(options["body"])

    current = url
    visited = @[]
    redirects = @[]
    hops = 0
    while (true) {
        key = _Http.normalize(current)
        if (key in visited) {
            throw HttpError(f"Redirect loop detected at {current}")
        }
        visited.push(key)

        target = _Http.parse_url(current)
        res = _exchange(m, current, target, user_headers, body, options)
        res.redirects = redirects

        plan = httpPlanRedirectRequest(res, current, m)
        if (plan is none) return res

        redirects.push(plan["url"])
        if (hops >= max_redirects) {
            throw HttpError(
                f"Too many redirects (>{max_redirects}) while fetching {url}")
        }
        hops += 1
        current = plan["url"]
        m = plan["method"]
        if (!plan["keepBody"]) body = ""     // 303 之类：请求体丢掉
    }
    return HttpResponse(0, {}, "", "", url)
}

// GET 一个 URL；默认跟随最多 5 次重定向。
// options: {"followRedirects": int, "headers": dict, "decompress": bool,
//           "timeoutMs": int (仅 https), "keepAlive": bool}
httpGet(url: string, options: dict = {}) -> HttpResponse = {
    return httpRequest("GET", url, options)
}

// HEAD：响应无正文（定界规则第一条），Content-Length 只当元信息
httpHead(url: string, options: dict = {}) -> HttpResponse = {
    return httpRequest("HEAD", url, options)
}

// POST 一个请求体；options 与 httpGet 相同（会被浅拷贝，不改调用方的字典）
httpPost(url: string, body: string, options: dict = {}) -> HttpResponse = {
    opts = _Http.copy(options)
    opts["body"] = body
    return httpRequest("POST", url, opts)
}

// ─── Dynamic Help Registry ────────────────────────────────────

const local import sys
try {
    sys.register_help("http", r"DOC(
═══ HTTP Client (Standard Library) ═══

  Requires: import http

  A modern, high-level HTTP client: URL parsing, request dispatch, response
  framing, connection reuse and content decoding, cleanly separating HTTP
  metadata from the payload body.

  Supports both http:// (plain TCP) and https:// (TLS 1.3, certificate chain
  verified against the system trust store). Both schemes go through the exact
  same framing and reuse logic.

  Functions
  ──────────────────────
    res = httpRequest(method, url)            // any method; follows up to 5 redirects by default
    res = httpRequest(method, url, options)
    res = httpGet(url)                        // options as below
    res = httpGet(url, options)
    res = httpHead(url, options)              // no body; Content-Length is metadata only
    res = httpPost(url, body, options)        // request body + Content-Length
    res = parseResponse(raw_bytes)            // parse one complete response offline
    res = parseResponse(raw_bytes, url, {"method": "HEAD", "decompress": false})
    plan = planRead(status, headers, method)  // pure: how this response must be read out
    next_url = planRedirect(res, current_url) // next URL for 3xx, none if absent
    step = planRedirectRequest(res, current_url, method)
                                              // {"url", "method", "keepBody"}, none if absent

  options (dict)
  ──────────────────────
    followRedirects  int    max redirects to follow (default 5)
    headers          dict   override default headers by name (case-insensitive)
    body             string request body (filled in by httpPost)
    decompress       bool   default true: sends Accept-Encoding: gzip, deflate and
                            decodes gzip / deflate per Content-Encoding; false sends
                            no such header and decodes nothing
    timeoutMs        int    **https only**: connect and read/write timeout (ms)
    keepAlive        bool   default true: sends Connection: keep-alive and pools
                            reusable idle connections (max 2 per origin)

  Response framing (RFC 9112 §6)
  ──────────────────────
    planRead(status, headers, method) returns {"mode", "length"}:
      "none"     HEAD / 204 / 304 / 1xx - no body, not a single byte is read
      "length"   Content-Length: n - read exactly n bytes (one byte too many would
                 corrupt the next response on the same connection), length == n
      "chunked"  Transfer-Encoding: chunked —— read until the 0 chunk + trailer
      "eof"      neither CL nor chunked - read until the peer closes; the connection is **not reusable**

  Connection reuse
  ──────────────────────
    Responses that are HTTP/1.1 and do not say Connection: close are returned to
    an idle pool keyed by scheme://host:port (at most 2 connections per origin);
    the next request to that origin reuses them and skips the handshake.
    HTTP/1.0 responses, Connection: close and "eof" framing close the connection.
    Any exception or half-finished response discards the connection.
    A *reused* connection that fails **before a single response byte arrives**
    (an idle connection killed by the server is normal) is retried once on a
    fresh connection for GET and HEAD only; non-idempotent methods are not
    retried (POST/PUT/PATCH responses can never be safely replayed here).

  Compression
  ──────────────────────
    Accept-Encoding: gzip, deflate is sent by default. gzip is decoded with
    inflate.gunzip; "deflate" is first tried as a zlib container then as raw
    DEFLATE (real servers send both). res.body is the decoded text while
    res.raw and res.headers keep the bytes as they arrived. A body that fails to
    decode raises HttpError; other encodings (br, zstd, ...) are returned as-is.
    Bodies are capped at 64 MiB.

  Redirects
  ──────────────────────
    301/302/303 rewrite the next request to GET and drop the body; 307/308 keep
    both the method and the body. Redirect loops are detected, https -> http
    downgrades are refused, and the chain is exposed as res.redirects.

  Timeouts — an honest limit
  ──────────────────────
    https honours options["timeoutMs"] (connect + read + write).  **Plain http
    has no timeout at all**: it goes through the socket module, which exposes no
    timeout/setsockopt interface, so connect() and recv() block until the peer
    answers or the OS gives up. Do not read timeoutMs as protection for http://.

  HttpResponse Object Properties
  ──────────────────────
    res.status          Integer (e.g., 200, 404, 500)
    res.headers         Dict of response headers (as received)
    res.body            Decoded payload body (chunked reassembled, compression decoded)
    res.raw             String containing the raw response bytes (exactly one response)
    res.url             Final URL (after redirects)
    res.redirects       List of URLs that were followed
    res.json()          Helper: maps JSON text to dictionary via C++ parser

  Example
  ──────────────────────
    import http
    response = http.httpGet("https://example.com/")
    print(response.status, response.body.len())
    head = http.httpHead("https://example.com/")
    print(head.headers["Content-Length"], head.body.len())

  Errors
  ──────────────────────
    HttpError         HTTP protocol failures: malformed or truncated response,
                      redirect loops, oversized headers or body.
    net.NetworkError  Thrown when the peer closes the connection while a body is
                      being read (defined by the net module, as its name implies).
)DOC")
}
