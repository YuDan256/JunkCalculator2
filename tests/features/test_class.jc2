test_basic_class() = {
    class Point {
        init(x, y) = {
            self.x = x
            self.y = y
        }
        move(dx, dy) = {
            self.x += dx
            self.y += dy
        }
    }
    p = Point(10, 20)
    assert(p.x == 10 && p.y == 20, "Class init failed")
    
    p.move(5, -5)
    assert(p.x == 15 && p.y == 15, "Class method failed")
}
test_basic_class()

test_inheritance() = {
    class Animal {
        speak() = "..."
    }
    class Dog extends Animal {
        speak() = "Woof"
    }
    a = Animal()
    d = Dog()
    assert(a.speak() == "...", "Base method failed")
    assert(d.speak() == "Woof", "Overridden method failed")
}
test_inheritance()

test_dunder_methods() = {
    class Vector {
        init(x, y) = { 
            self.x = x
            self.y = y 
        }
        __add__(other) = Vector(self.x + other.x, self.y + other.y)
        __eq__(other) = self.x == other.x && self.y == other.y
    }
    v1 = Vector(1, 2)
    v2 = Vector(3, 4)
    v3 = v1 + v2
    assert(v3 == Vector(4, 6), "Dunder __add__ or __eq__ failed")
}
test_dunder_methods()

test_super_call() = {
    class Base {
        greet() = "Hello from Base"
    }
    class Derived extends Base {
        greet() = super.greet() + " and Derived"
    }
    obj = Derived()
    assert(obj.greet() == "Hello from Base and Derived", "Super method call failed")
}
test_super_call()

test_anonymous_class_and_self_ref() = {
    const Point = class {
        init(x, y) = { 
            self.x = x
            self.y = y 
        }
        // 使用 class 关键字进行自引用实例化
        clone() = class(self.x, self.y)
        // 返回当前类对象
        get_class() = class
    }
    
    p1 = Point(10, 20)
    p2 = p1.clone()
    
    assert(p1 != p2, "Clone should be a new instance (reference inequality)")
    assert(p2.x == 10 && p2.y == 20, "Clone should have the same field values")
    assert(p1.get_class() == Point, "The 'class' keyword should evaluate to the class object itself")
}
test_anonymous_class_and_self_ref()

test_access_control() = {
    class Account {
        const id = 12345
        local balance = 0
        static local const MAX = 999
        static const MIN = 0
        
        init(b) = {
            self.balance = b
        }
        
        local helper() = self.balance * 2
        
        get_balance() = self.balance
        get_helper() = self.helper()
        static get_max() = Account.MAX
        
        test_reflection() = {
            assert(self["balance"] == 100, "Reflection read failed inside class")
            self["balance"] = 300
            assert(self.balance == 300, "Reflection write failed inside class")
            assert("balance" in self, "Reflection 'in' failed inside class")
            self.balance = 100 // restore
        }
    }
    
    acc = Account(100)
    
    // Public const
    assert(acc.id == 12345, "Public const read failed")
    assert(isError(pcall(() => acc.id = 54321)), "Public const should be read-only")
    
    // Private instance field
    assert(acc.get_balance() == 100, "Private field internal read failed")
    acc.test_reflection()
    assert(isError(pcall(() => acc.balance)), "Private field should be invisible externally")
    acc.balance = 200
    assert(acc.balance == 200, "Public property can shadow private name externally")
    assert(acc.get_balance() == 100, "Private field remains unaffected by public shadowing")
    
    // Private instance method
    assert(acc.get_helper() == 200, "Private method internal call failed")
    assert(isError(pcall(() => acc.helper())), "Private method should be invisible externally")
    
    // Static const
    assert(Account.MIN == 0, "Static const read failed")
    assert(isError(pcall(() => Account.MIN = 1)), "Static const should be read-only")
    
    // Static private const
    assert(Account.get_max() == 999, "Static private const internal read failed")
    assert(isError(pcall(() => Account.MAX)), "Static private const should be invisible externally")
}
test_access_control()

test_private_inheritance() = {
    class Parent {
        local secret = 42
        local hidden() = 100
        get_secret() = self.secret
    }
    class Child extends Parent {
        init() = { super.init() }
        try_access() = self.secret
        try_call() = self.hidden()
    }
    
    c = Child()
    assert(c.get_secret() == 42, "Parent method should access its own private field")
    assert(isError(pcall(() => c.try_access())), "Child should not access parent's private field")
    assert(isError(pcall(() => c.try_call())), "Child should not access parent's private method")
}
test_private_inheritance()
